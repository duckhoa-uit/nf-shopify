{% comment %}
  EComposer placement adapter for the perfume product-family picker.

  EComposer owns the underlying product form, variant data, and add-to-cart
  runtime. Perfume volume is represented by sibling products, so the generated
  Color presentation and singleton Size presentation are hidden for perfume
  family products while their values remain in the variant data.

  Accepts:
  - product: {Object} Current product.
  - instance_id: {String} Unique component instance identifier.
  - show_color: {Boolean} Optional. Set to true to keep EComposer's Color
    presentation visible. Defaults to false.

  Usage:
  {% render 'perfume-product-family-picker-ecomposer', product: product, instance_id: 'EComposerPerfumeFamilyPicker' %}

  Show EComposer's Color presentation:
  {% render 'perfume-product-family-picker-ecomposer', product: product, instance_id: 'EComposerPerfumeFamilyPicker', show_color: true %}
{% endcomment %}

{%- liquid
  assign perfume_group = product.metafields.custom.parfum_group.value
  assign family_products = perfume_group.products.value

  if family_products == blank
    assign family_products = product.metafields.custom.product_in_group.value
  endif

  assign ecomposer_size_option_handle = blank
  assign ecomposer_size_option_index = blank
  assign ecomposer_color_option_handle = blank
  assign ecomposer_color_option_index = blank
  assign picker_instance_id = instance_id | default: 'EComposerPerfumeFamilyPicker'
  assign hide_ecomposer_color = true

  if show_color == true
    assign hide_ecomposer_color = false
  endif

  if family_products != blank
    for option in product.options_with_values
      if hide_ecomposer_color
        capture is_color_option
          render 'is-color-option', option: option, product: product
        endcapture
        assign is_color_option = is_color_option | strip

        if is_color_option == 'true'
          assign ecomposer_color_option_handle = option.name | handleize
          assign ecomposer_color_option_index = option.position | minus: 1
        endif
      endif

      capture is_size_option
        render 'is-size-option', option: option, product: product
      endcapture
      assign is_size_option = is_size_option | strip

      if is_size_option == 'true' and option.values.size == 1
        assign ecomposer_size_option_handle = option.name | handleize
        assign ecomposer_size_option_index = option.position | minus: 1
      endif
    endfor

    if hide_ecomposer_color and ecomposer_color_option_handle == blank
      assign color_option = product.options_by_name.Color
      if color_option != blank
        assign ecomposer_color_option_handle = color_option.name | handleize
        assign ecomposer_color_option_index = color_option.position | minus: 1
      endif
    endif

    if ecomposer_size_option_handle == blank
      assign size_option = product.options_by_name.Size
      if size_option != blank and size_option.values.size == 1
        assign ecomposer_size_option_handle = size_option.name | handleize
        assign ecomposer_size_option_index = size_option.position | minus: 1
      endif
    endif
  endif
-%}

{{ 'perfume-product-family-picker.css' | asset_url | stylesheet_tag }}

{%- if hide_ecomposer_color and ecomposer_color_option_handle != blank -%}
  <style data-perfume-ecomposer-color-ownership>
    .ecom-product-single__variant-picker .ecom-product-single__picker-option-{{ ecomposer_color_option_handle }},
    .ecom-product-single__variant-picker .selector-wrapper:has(.single-option-selector[data-option-index="{{ ecomposer_color_option_index }}"]) {
      /* Preserve EComposer's variant runtime while hiding the perfume PDP Color presentation. */
      display: none !important;
    }
  </style>
{%- endif -%}

{%- if ecomposer_size_option_handle != blank -%}
  <style data-perfume-ecomposer-size-ownership>
    .ecom-product-single__variant-picker .ecom-product-single__picker-option-{{ ecomposer_size_option_handle }},
    .ecom-product-single__variant-picker .selector-wrapper:has(.single-option-selector[data-option-index="{{ ecomposer_size_option_index }}"]) {
      /* EComposer's generated rules otherwise re-display its duplicate volume control. */
      display: none !important;
    }
  </style>
{%- endif -%}

{% render 'perfume-product-family-picker', product: product, instance_id: picker_instance_id %}
