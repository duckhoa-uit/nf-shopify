{% comment %}
  Settings tab content (Basic Info and Password Change)

  Accepts:
  - customer: The customer object
{% endcomment %}

<div id="settings" class="tab-content active" role="tabpanel">
  <h2 class="section-title">{{ 'customer.account.basic_info' | t }}</h2>

  <div class="form-section">
    {%- form 'customer', customer, id: 'CustomerInfoForm' -%}
      <input type="hidden" name="custom_form" value="true">
      {%- if form.posted_successfully? -%}
        <div class="success-message" tabindex="-1" autofocus>
          {{ 'customer.account.success' | t | default: 'Basic information updated successfully!' }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="form-error-message" role="alert">
          <h2 class="form-error-heading">{{ 'customer.form_errors.error' | t }}</h2>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ field }}" class="field-error-link">
                    {{- form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="form-row">
        <div class="form-group">
          {%
            render 'form-field',
            type: 'text',
            id: 'CustomerFirstName',
            name: 'customer[first_name]',
            value: customer.first_name,
            label: 'customer.account.first_name' | t,
            required: true
          %}
        </div>

        <div class="form-group">
          {%
            render 'form-field',
            type: 'text',
            id: 'CustomerLastName',
            name: 'customer[last_name]',
            value: customer.last_name,
            label: 'customer.account.last_name' | t,
            required: true
          %}
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          {%
            render 'form-field',
            type: 'email',
            id: 'CustomerEmail',
            name: 'customer[email]',
            value: customer.email,
            label: 'customer.account.email' | t,
            required: true,
            class: 'email-field'
          %}
        </div>

        <div class="form-group">
          {%
            render 'form-field',
            type: 'tel',
            id: 'CustomerPhone',
            name: 'customer[phone]',
            value: customer.phone,
            label: 'customer.account.phone' | t
          %}
        </div>
      </div>

      <div class="form-group birthdate-field">
        {%- assign birth_date = customer.metafields.facts.birth_date | default: '' -%}
        {%
          render 'form-field',
          type: 'text',
          id: 'CustomerBirthdate',
          name: 'birthdate',
          value: birth_date,
          label: 'customer.account.birthdate' | t,
          placeholder: 'DD.MM.RRRR',
          class: 'flatpickr-input'
        %}
        <div class="date-picker-icon" id="birthdateCalendarIcon">
          {{- 'icon-calendar.svg' | inline_asset_content -}}
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {{ 'customer.account.save' | t }}
          <span class="btn-spinner"></span>
        </button>
      </div>
    {%- endform -%}
  </div>

  <div class="form-divider"></div>

  <div class="form-section">
    <h3 class="form-section-title">{{ 'customer.account.change_password' | t }}</h3>
    {%- form 'customer', customer, id: 'CustomerPasswordForm' -%}
      <input type="hidden" name="form_type" value="customer_password">

      {%- if form.posted_successfully? -%}
        <div class="success-message" tabindex="-1" autofocus>
          {{ 'customer.account.password_changed' | t | default: 'Password updated successfully!' }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="form-error-message" role="alert">
          <h2 class="form-error-heading">{{ 'customer.form_errors.error' | t }}</h2>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ field }}" class="field-error-link">
                    {{- form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="form-group">
        {%
          render 'form-field',
          type: 'password',
          id: 'CustomerCurrentPassword',
          name: 'customer[current_password]',
          value: '',
          label: 'customer.account.current_password' | t,
          required: true
        %}
      </div>

      <div class="form-row">
        <div class="form-group">
          {%
            render 'form-field',
            type: 'password',
            id: 'CustomerNewPassword',
            name: 'customer[password]',
            value: '',
            label: 'customer.account.new_password' | t,
            required: true
          %}
        </div>

        <div class="form-group">
          {%
            render 'form-field',
            type: 'password',
            id: 'CustomerConfirmPassword',
            name: 'customer[password_confirmation]',
            value: '',
            label: 'customer.account.confirm_password' | t,
            required: true
          %}
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {{ 'customer.account.save' | t }}
          <span class="btn-spinner"></span>
        </button>
      </div>
    {%- endform -%}
  </div>
</div>
