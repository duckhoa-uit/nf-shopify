{% comment %}
  Settings tab content (Basic Info)

  Accepts:
  - customer: The customer object
{% endcomment %}

<div id="settings" class="tab-content" role="tabpanel">
  <h2 class="section-title">{{ 'customer.account.basic_info' | t }}</h2>

  <div class="form-section">
    {%- form 'customer', customer, id: 'CustomerInfoForm', data-proxy-form: '/apps/nf-data-management/update_customer' -%}
      <input type="hidden" name="custom_form" value="true">
      {%- if form.posted_successfully? -%}
        <div class="success-message" tabindex="-1" autofocus>
          {{ 'customer.account.info_update_success' | t | default: 'Basic information updated successfully!' }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="form-error-message" role="alert">
          <h2 class="form-error-heading">{{ 'customer.form_errors.error' | t }}</h2>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#{{ field }}" class="field-error-link">
                    {{- form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const form = document.getElementById('CustomerInfoForm');
          if (!form) return;

          // Form state tracking functionality
          let initialFormState = {};
          let isFormModified = false;
          const submitButton = form.querySelector('button[type="submit"]');

          // Function to get current form state
          function getFormState() {
            const state = {};
            const formData = new FormData(form);

            // Get all form inputs
            const inputs = form.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
              if (input.type === 'checkbox' || input.type === 'radio') {
                state[input.name] = input.checked;
              } else if (input.type === 'hidden' && input.classList.contains('phone-international-format')) {
                // For phone international format, use the hidden input value
                state[input.name] = input.value;
              } else if (input.name && !input.name.includes('_display')) {
                // Skip display inputs for phone fields
                state[input.name] = input.value;
              }
            });

            return state;
          }

          // Function to compare form states
          function compareFormStates(state1, state2) {
            const keys1 = Object.keys(state1);
            const keys2 = Object.keys(state2);

            if (keys1.length !== keys2.length) return false;

            for (let key of keys1) {
              if (state1[key] !== state2[key]) return false;
            }

            return true;
          }

          // Function to update submit button state
          function updateSubmitButtonState() {
            const currentState = getFormState();
            isFormModified = !compareFormStates(initialFormState, currentState);

            if (submitButton) {
              submitButton.disabled = !isFormModified;
              submitButton.style.opacity = isFormModified ? '1' : '0.6';
              submitButton.style.cursor = isFormModified ? 'pointer' : 'not-allowed';
            }
          }

          // Capture initial form state after a short delay to ensure all fields are initialized
          setTimeout(function() {
            initialFormState = getFormState();
            updateSubmitButtonState();
          }, 500);

          // Add event listeners for form changes
          const inputs = form.querySelectorAll('input, select, textarea');
          inputs.forEach(input => {
            // Use different events based on input type
            if (input.type === 'checkbox' || input.type === 'radio') {
              input.addEventListener('change', updateSubmitButtonState);
            } else {
              input.addEventListener('input', updateSubmitButtonState);
              input.addEventListener('change', updateSubmitButtonState);
            }
          });

          // Special handling for phone field changes
          const phoneInput = document.getElementById('CustomerPhone');
          if (phoneInput) {
            // Listen for country changes in phone field
            phoneInput.addEventListener('countrychange', function() {
              setTimeout(updateSubmitButtonState, 100);
            });
          }

          // Add real-time validation for phone input
          if (phoneInput && window.phoneInputHandler) {
            // Debounce function to avoid too many validations while typing
            function debounce(func, wait) {
              let timeout;
              return function(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
              };
            }

            // Validate after user has typed a few characters and paused
            const debouncedValidate = debounce(function() {
              if (phoneInput.value.length >= 3) { // Only validate if there's enough input
                const instance = window.intlTelInputGlobals.getInstance(phoneInput);
                if (instance) {
                  window.phoneInputHandler.validatePhoneInput(phoneInput, instance);
                }
              }
            }, 500); // 500ms delay

            // Clear error when user starts typing
            phoneInput.addEventListener('input', function() {
              // Clear any existing error when user starts typing
              if (phoneInput.value.length < 3) {
                window.phoneInputHandler.hideErrorMessage(phoneInput);
              }
            });

            // Add input event listener for validation after typing
            phoneInput.addEventListener('input', debouncedValidate);
          }

          // Note: Form submission is handled in assets/account-forms.js
        });
      </script>

      <div class="form-row mb-0">
        <div class="form-group md:mb-1">
          {%
            render 'form-field',
            type: 'text',
            id: 'CustomerFirstName',
            name: 'customer[first_name]',
            value: customer.first_name,
            label: 'customer.account.first_name' | t,
            required: true,
          %}
        </div>

        <div class="form-group mb-1">
          {%
            render 'form-field',
            type: 'text',
            id: 'CustomerLastName',
            name: 'customer[last_name]',
            value: customer.last_name,
            label: 'customer.account.last_name' | t,
            required: true,
          %}
        </div>
      </div>

      <div class="form-row">
        <div class="form-group pt-7">
          {%
            render 'form-field',
            type: 'email',
            id: 'CustomerEmail',
            name: 'customer[email]',
            value: customer.email,
            label: 'customer.account.email' | t,
            required: true,
            readonly: true,
            class: 'email-field'
          %}
        </div>

        <div class="form-group">
          {%
            render 'phone-field',
            id: 'CustomerPhone',
            name: 'customer[phone]',
            value: customer.phone,
            label: 'customer.account.phone' | t,
            required: true
          %}
        </div>
      </div>

      <div class="form-group birthdate-field">
        {%- assign birth_date = customer.metafields.facts.birth_date | default: '' -%}
        {%
          render 'form-field',
          type: 'text',
          id: 'CustomerBirthdate',
          name: 'birthdate',
          value: birth_date,
          label: 'customer.account.birthdate' | t,
          placeholder: 'DD.MM.YYYY',
          class: 'flatpickr-input'
        %}
        <div class="date-picker-icon" id="birthdateCalendarIcon">
          {{- 'icon-calendar.svg' | inline_asset_content -}}
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled style="opacity: 0.6; cursor: not-allowed;">
          <span class="btn-text">{{ 'customer.account.save' | t }}</span>
          <span class="btn-spinner">
            {{- 'loading-spinner.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    {%- endform -%}
  </div>
</div>
