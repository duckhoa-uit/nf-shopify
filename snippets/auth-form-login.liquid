{% comment %}
  Login form. Rendered inside auth-modal as a tabpanel and as the standalone /account/login template.

  Accepts:
    none

  Usage:
    {% render 'auth-form-login' %}
{% endcomment %}

<div id="login-messages" class="auth-modal__messages" aria-live="polite">
  {% if form.errors %}
    <div class="auth-modal__error">
      {{ form.errors | default_errors }}
    </div>
  {% endif %}
</div>

{% form 'customer_login', return_to: request.path, id: 'customer_login_form', class: 'auth-modal__form' %}
  <div class="field">
    <input
      type="email"
      name="customer[email]"
      id="customer_email"
      required
      placeholder=" "
      autocomplete="email"
      {% if form.errors contains 'email' %}
        aria-invalid="true"
      {% endif %}
    >
    <label for="customer_email">{{ 'customer.login_page.email' | t }}</label>
  </div>

  <div class="field">
    <input
      type="password"
      name="customer[password]"
      id="customer_password"
      required
      placeholder=" "
      autocomplete="current-password"
      {% if form.errors contains 'password' %}
        aria-invalid="true"
      {% endif %}
    >
    <label for="customer_password">{{ 'customer.login_page.password' | t }}</label>
  </div>

  <button type="submit" class="button auth-modal__submit">
    {{ 'customer.login_page.sign_in' | t }}
  </button>

  {%- comment -%} Social login - Loaded only when modal is opened {%- endcomment -%}
  <div class="oxi-social-login" data-lazy-load="true"></div>

  <p class="auth-modal__forgot">
    {{ 'customer.login_page.forgot_password_message' | t }}
    <a
      href="{{ routes.account_recover_url }}"
      rel="nofollow"
      class="auth-modal__link"
      data-auth-switch="recover"
    >
      {{- 'customer.login_page.forgot_password' | t -}}
    </a>
  </p>
{% endform %}
