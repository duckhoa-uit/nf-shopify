{% comment %}
  Wishlist tab content

  Accepts:
  - No specific parameters
{% endcomment %}

<div id="wishlist" class="tab-content" role="tabpanel">
  <h2 class="section-title">{{ 'customer.account.wishlist' | t }}</h2>

  {% comment %} <div class="wishlist-empty">
    <p>{{ 'customer.account.wishlist_empty' | t }}</p>
  </div> {% endcomment %}

  <wishlist-page
    show-product-title
    show-price
    product-options="dropdowns"
    move-to-cart
    wishlist-empty-link="{{ routes.all_products_collection_url }}"
  ></wishlist-page>
</div>
