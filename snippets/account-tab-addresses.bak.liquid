<!-- Add Address Form Template -->
<template id="AddAddressFormTemplate">
{%- form 'customer_address', customer.new_address -%}
  <div class="address-form">
    <div class="form-row">
      <div class="form-group">
        <div class="field">
          <input
            type="text"
            id="AddressFirstName"
            name="address[first_name]"
            class="field__input"
            value="{{ form.first_name }}"
            placeholder=" "
            required
            pattern="[A-Za-z\s]{2,}"
            title="First name should contain at least 2 letters"
          >
          <label class="field__label" for="AddressFirstName">
            {{- 'customer.addresses.first_name' | t -}}
          </label>
        </div>
      </div>

      <div class="form-group">
        <div class="field">
          <input
            type="text"
            id="AddressLastName"
            name="address[last_name]"
            class="field__input"
            value="{{ form.last_name }}"
            placeholder=" "
            required
            pattern="[A-Za-z\s]{2,}"
            title="Last name should contain at least 2 letters"
          >
          <label class="field__label" for="AddressLastName">
            {{- 'customer.addresses.last_name' | t -}}
          </label>
        </div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <div class="field">
          <input
            type="text"
            id="AddressCompany"
            name="address[company]"
            class="field__input"
            value="{{ form.company }}"
            placeholder=" "
          >
          <label class="field__label" for="AddressCompany">{{ 'customer.addresses.company' | t }}</label>
        </div>
      </div>

      <div class="form-group">
        <div class="field">
          <input
            type="tel"
            id="AddressPhone"
            name="address[phone]"
            class="field__input"
            value="{{ form.phone }}"
            placeholder=" "
            pattern="[0-9\+\-\s]{7,}"
            title="Phone number should contain at least 7 digits"
          >
          <label class="field__label" for="AddressPhone">{{ 'customer.addresses.phone' | t }}</label>
        </div>
      </div>
    </div>

    <div class="form-group">
      <div class="field">
        <input
          type="text"
          id="AddressAddress1"
          name="address[address1]"
          class="field__input"
          value="{{ form.address1 }}"
          placeholder=" "
          required
          minlength="5"
          title="Address should be at least 5 characters long"
        >
        <label class="field__label" for="AddressAddress1">{{ 'customer.addresses.address1' | t }}</label>
      </div>
    </div>

    <div class="form-group">
      <div class="field">
        <input
          type="text"
          id="AddressAddress2"
          name="address[address2]"
          class="field__input"
          value="{{ form.address2 }}"
          placeholder=" "
        >
        <label class="field__label" for="AddressAddress2">{{ 'customer.addresses.address2' | t }}</label>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <div class="field">
          <input
            type="text"
            id="AddressCity"
            name="address[city]"
            class="field__input"
            value="{{ form.city }}"
            placeholder=" "
            required
            pattern="[A-Za-z\s\-]{2,}"
            title="City name should contain at least 2 letters"
          >
          <label class="field__label" for="AddressCity">{{ 'customer.addresses.city' | t }}</label>
        </div>
      </div>

      <div class="form-group">
        <div class="field">
          <input
            type="text"
            id="AddressZip"
            name="address[zip]"
            class="field__input"
            value="{{ form.zip }}"
            placeholder=" "
            required
            pattern="[0-9A-Za-z\s\-]{3,10}"
            title="Postal/ZIP code should be 3-10 characters"
          >
          <label class="field__label" for="AddressZip">{{ 'customer.addresses.zip' | t }}</label>
        </div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="AddressCountry">{{ 'customer.addresses.country' | t }}</label>
        <div class="select-wrapper">
          <select
            id="AddressCountry"
            name="address[country]"
            data-address-country-select
            data-default="{{ form.country }}"
          >
            {{ all_country_option_tags }}
          </select>
        </div>
      </div>

      <div class="form-group" id="AddressProvinceContainer" style="display:none;">
        <label for="AddressProvince">{{ 'customer.addresses.province' | t }}</label>
        <div class="select-wrapper">
          <select
            id="AddressProvince"
            name="address[province]"
            data-default="{{ form.province }}"
          ></select>
        </div>
      </div>
    </div>

    <div class="form-group">
      <div class="checkbox-wrapper">
        <input type="checkbox" id="address_default_address_new" name="address[default]" value="1">
        <label for="address_default_address_new">Set as default address</label>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="button" id="AddressSubmit">
        <span class="btn-text">Add Address</span>
        <span class="btn-spinner"></span>
      </button>
      <button type="button" class="button button--tertiary modal-cancel">
        Cancel
      </button>
    </div>
  </div>
{%- endform -%}
</template>

