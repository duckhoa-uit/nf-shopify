              type="text"
              id="EditAddress_{{ address.id }}_FirstName"
              name="address[first_name]"
              class="field__input"
              value="{{ address.first_name }}"
              placeholder=" "
              required
              pattern="[A-Za-z\s]{2,}"
              title="First name should contain at least 2 letters"
            >
            <label class="field__label" for="EditAddress_{{ address.id }}_FirstName">
              {{- 'customer.addresses.first_name' | t -}}
            </label>
          </div>
        </div>

        <div class="form-group">
          <div class="field">
            <input
              type="text"
              id="EditAddress_{{ address.id }}_LastName"
              name="address[last_name]"
              class="field__input"
              value="{{ address.last_name }}"
              placeholder=" "
              required
              pattern="[A-Za-z\s]{2,}"
              title="Last name should contain at least 2 letters"
            >
            <label class="field__label" for="EditAddress_{{ address.id }}_LastName">
              {{- 'customer.addresses.last_name' | t -}}
            </label>
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <div class="field">
            <input
              type="text"
              id="EditAddress_{{ address.id }}_Company"
              name="address[company]"
              class="field__input"
              value="{{ address.company }}"
              placeholder=" "
            >
            <label class="field__label" for="EditAddress_{{ address.id }}_Company">
              {{- 'customer.addresses.company' | t -}}
            </label>
          </div>
        </div>

        <div class="form-group">
          <div class="field">
            <input
              type="tel"
              id="EditAddress_{{ address.id }}_Phone"
              name="address[phone]"
              class="field__input"
              value="{{ address.phone }}"
              placeholder=" "
              pattern="[0-9\+\-\s]{7,}"
              title="Phone number should contain at least 7 digits"
            >
            <label class="field__label" for="EditAddress_{{ address.id }}_Phone">
              {{- 'customer.addresses.phone' | t -}}
            </label>
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="field">
          <input
            type="text"
            id="EditAddress_{{ address.id }}_Address1"
            name="address[address1]"
            class="field__input"
            value="{{ address.address1 }}"
            placeholder=" "
            required
            minlength="5"
            title="Address should be at least 5 characters long"
          >
          <label class="field__label" for="EditAddress_{{ address.id }}_Address1">
            {{- 'customer.addresses.address1' | t -}}
          </label>
        </div>
      </div>

      <div class="form-group">
        <div class="field">
          <input
            type="text"
            id="EditAddress_{{ address.id }}_Address2"
            name="address[address2]"
            class="field__input"
            value="{{ address.address2 }}"
            placeholder=" "
          >
          <label class="field__label" for="EditAddress_{{ address.id }}_Address2">
            {{- 'customer.addresses.address2' | t -}}
          </label>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <div class="field">
            <input
              type="text"
              id="EditAddress_{{ address.id }}_City"
              name="address[city]"
              class="field__input"
              value="{{ address.city }}"
              placeholder=" "
              required
              pattern="[A-Za-z\s\-]{2,}"
              title="City name should contain at least 2 letters"
            >
            <label class="field__label" for="EditAddress_{{ address.id }}_City">
              {{- 'customer.addresses.city' | t -}}
            </label>
          </div>
        </div>

        <div class="form-group">
          <div class="field">
            <input
              type="text"
              id="EditAddress_{{ address.id }}_Zip"
              name="address[zip]"
              class="field__input"
              value="{{ address.zip }}"
              placeholder=" "
              required
              pattern="[0-9A-Za-z\s\-]{3,10}"
              title="Postal/ZIP code should be 3-10 characters"
            >
            <label class="field__label" for="EditAddress_{{ address.id }}_Zip">
              {{- 'customer.addresses.zip' | t -}}
            </label>
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="EditAddress_{{ address.id }}_Country">{{ 'customer.addresses.country' | t }}</label>
          <div class="select-wrapper">
            <select
              id="EditAddress_{{ address.id }}_Country"
              name="address[country]"
              data-address-country-select
              data-default="{{ address.country }}"
            >
              {{ all_country_option_tags }}
            </select>
          </div>
        </div>

        <div class="form-group" id="EditAddress_{{ address.id }}_ProvinceContainer" style="display:none;">
          <label for="EditAddress_{{ address.id }}_Province">
            {{- 'customer.addresses.province' | t -}}
          </label>
          <div class="select-wrapper">
            <select
              id="EditAddress_{{ address.id }}_Province"
              name="address[province]"
              data-default="{{ address.province }}"
            ></select>
          </div>
        </div>
      </div>

      <div class="form-group">
        <div class="checkbox-wrapper">
          <input
            type="checkbox"
            id="EditAddress_{{ address.id }}_Default"
            name="address[default]"
            value="1"
            {% if address == customer.default_address %}
              checked
            {% endif %}
          >
          <label for="EditAddress_{{ address.id }}_Default">
            {{- 'customer.addresses.set_default' | t -}}
          </label>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="button" id="EditAddressSubmit_{{ address.id }}">
          <span class="btn-text">{{ 'customer.addresses.update' | t }}</span>
          <span class="btn-spinner"></span>
        </button>
        <button type="button" class="button button--tertiary modal-cancel">
          {{ 'customer.addresses.cancel' | t }}
        </button>
      </div>
    </div>
  {%- endform -%}
</template>
{% endfor %}

<!-- Delete Address Confirmation Modal -->
<div id="deleteConfirmModal" class="modal">
<div class="modal-overlay"></div>
<div class="modal-container modal-small">
  <div class="modal-header">
    <h3 class="modal-title">{{ 'customer.addresses.delete' | t }}</h3>
    <button type="button" class="modal-close" aria-label="Close">&times;</button>
  </div>
  <div class="modal-content">
    <p>{{ 'customer.addresses.delete_confirm' | t }}</p>

    <div class="form-actions">
      <form id="deleteAddressForm" method="post" action="" class="inline">
        <input type="hidden" name="_method" value="delete">
        <button type="submit" class="button button--secondary" id="confirmDeleteBtn">
          <span class="btn-text">{{ 'customer.addresses.delete' | t }}</span>
          <span class="btn-spinner"></span>
        </button>
      </form>
      <button type="button" class="button button--tertiary modal-cancel">
        {{ 'customer.addresses.cancel' | t }}
      </button>
    </div>
  </div>
</div>
</div>

{%- if paginate.pages > 1 -%}
<nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
  <ul>
    {%- if paginate.previous -%}
      <li>
        <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
          <span class="svg-wrapper">
            {{ 'chevron-left.svg' | inline_asset_content }}
          </span>
        </a>
      </li>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
            {{- part.title -}}
          </a>
        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <span
              aria-current="page"
              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
            >
              {{- part.title -}}
            </span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endif -%}
      </li>
    {%- endfor -%}

    {%- if paginate.next -%}
      <li>
        <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
          <span class="svg-wrapper">
            {{ 'chevron-right.svg' | inline_asset_content }}
          </span>
        </a>
      </li>
    {%- endif -%}
  </ul>
</nav>
{%- endif -%}
{% endpaginate %}
</div>
