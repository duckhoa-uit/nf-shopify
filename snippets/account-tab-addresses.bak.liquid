<div class="address-section-header">
  <h3 class="section-title">{{ 'customer.addresses.billing_address' | t }}</h3>
  <button type="button" class="button button--small" id="AddBillingAddress">
    <span class="svg-wrapper">
      {{ 'icon-plus.svg' | inline_asset_content }}
    </span>
    {{ 'customer.addresses.add_new' | t }}
  </button>
</div>

<div class="address-cards" id="billing-address-cards">
  {% for address in customer.addresses %}
    {% unless address == customer.default_address %}
      <div class="address-wrapper" data-address-id="{{ address.id }}">
        <div class="address-card">
          <h3 class="address-card-title">
            {{ address.first_name }}
            {{ address.last_name }},
          </h3>
          <p class="address-card-summary">{{ address.address1 }}, {{ address.city }}</p>

          <div class="address-divider"></div>

          <div class="address-details">
            <div class="address-field">
              <span class="field-label">{{ 'customer.addresses.name' | t }}</span>
              <span class="field-value">{{ address.first_name }} {{ address.last_name }}</span>
            </div>

            <div class="address-field">
              <span class="field-label">{{ 'customer.addresses.email' | t }}</span>
              <span class="field-value">{{ customer.email }}</span>
            </div>

            <div class="address-field">
              <span class="field-label">{{ 'customer.addresses.phone' | t }}</span>
              <span class="field-value">{{ address.phone }}</span>
            </div>

            <div class="address-field">
              <span class="field-label">{{ 'customer.addresses.address1' | t }}</span>
              <span class="field-value">{{ address.address1 }}</span>
            </div>

            <div class="address-field">
              <span class="field-label">{{ 'customer.addresses.city' | t }}</span>
              <span class="field-value">{{ address.city }}</span>
            </div>

            <div class="address-field">
              <span class="field-label">{{ 'customer.addresses.zip' | t }}</span>
              <span class="field-value">{{ address.zip }}</span>
            </div>

            <div class="address-field">
              <span class="field-label">{{ 'customer.addresses.country' | t }}</span>
              <span class="field-value">{{ address.country }}</span>
            </div>
          </div>

          <div class="address-actions">
            <button
              type="button"
              class="btn-edit"
              aria-controls="EditAddress_{{ address.id }}"
              aria-expanded="false"
              data-address-id="{{ address.id }}"
            >
              <span class="svg-wrapper">
                {{ 'icon-edit.svg' | inline_asset_content }}
              </span>
              {{ 'customer.addresses.edit' | t }}
            </button>

            <button
              type="button"
              class="btn-delete"
              aria-controls="DeleteAddress_{{ address.id }}"
              aria-expanded="false"
              data-address-id="{{ address.id }}"
            >
              <span class="svg-wrapper">
                {{ 'icon-trash.svg' | inline_asset_content }}
              </span>
            </button>

            <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" class="inline">
              <input type="hidden" name="form_type" value="customer_address">
              <input type="hidden" name="utf8" value="✓">
              <input type="hidden" name="_method" value="put">
              <input type="hidden" name="address[id]" value="{{ address.id }}">
              <input type="hidden" name="address[default]" value="true">
              <button type="submit" class="button button--tertiary button--small btn-default">
                {{ 'customer.addresses.set_default' | t }}
              </button>
            </form>
          </div>
        </div>

        <div class="address-edit-form" id="EditAddress_{{ address.id }}" style="display: none;">
          {%- form 'customer_address', address -%}
            <div class="address-form">
              <div class="form-row">
                <div class="form-group">
                  <div class="field">
                    <input
                      type="text"
                      id="EditAddress_{{ address.id }}_FirstName"
                      name="address[first_name]"
                      class="field__input"
                      value="{{ address.first_name }}"
                      placeholder=" "
                      required
                    >
                    <label class="field__label" for="EditAddress_{{ address.id }}_FirstName">
                      {{- 'customer.addresses.first_name' | t -}}
                    </label>
                  </div>
                </div>

                <div class="form-group">
                  <div class="field">
                    <input
                      type="text"
                      id="EditAddress_{{ address.id }}_LastName"
                      name="address[last_name]"
                      class="field__input"
                      value="{{ address.last_name }}"
                      placeholder=" "
                      required
                    >
                    <label class="field__label" for="EditAddress_{{ address.id }}_LastName">
                      {{- 'customer.addresses.last_name' | t -}}
                    </label>
                  </div>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <div class="field">
                    <input
                      type="text"
                      id="EditAddress_{{ address.id }}_Company"
                      name="address[company]"
                      class="field__input"
                      value="{{ address.company }}"
                      placeholder=" "
                    >
                    <label class="field__label" for="EditAddress_{{ address.id }}_Company">
                      {{- 'customer.addresses.company' | t -}}
                    </label>
                  </div>
                </div>

                <div class="form-group">
                  <div class="field">
                    <input
                      type="tel"
                      id="EditAddress_{{ address.id }}_Phone"
                      name="address[phone]"
                      class="field__input"
                      value="{{ address.phone }}"
                      placeholder=" "
                    >
                    <label class="field__label" for="EditAddress_{{ address.id }}_Phone">
                      {{- 'customer.addresses.phone' | t -}}
                    </label>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <div class="field">
                  <input
                    type="text"
                    id="EditAddress_{{ address.id }}_Address1"
                    name="address[address1]"
                    class="field__input"
                    value="{{ address.address1 }}"
                    placeholder=" "
                    required
                  >
                  <label class="field__label" for="EditAddress_{{ address.id }}_Address1">
                    {{- 'customer.addresses.address1' | t -}}
                  </label>
                </div>
              </div>

              <div class="form-group">
                <div class="field">
                  <input
                    type="text"
                    id="EditAddress_{{ address.id }}_Address2"
                    name="address[address2]"
                    class="field__input"
                    value="{{ address.address2 }}"
                    placeholder=" "
                  >
                  <label class="field__label" for="EditAddress_{{ address.id }}_Address2">
                    {{- 'customer.addresses.address2' | t -}}
                  </label>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <div class="field">
                    <input
                      type="text"
                      id="EditAddress_{{ address.id }}_City"
                      name="address[city]"
                      class="field__input"
                      value="{{ address.city }}"
                      placeholder=" "
                      required
                    >
                    <label class="field__label" for="EditAddress_{{ address.id }}_City">
                      {{- 'customer.addresses.city' | t -}}
                    </label>
                  </div>
                </div>

                <div class="form-group">
                  <div class="field">
                    <input
                      type="text"
                      id="EditAddress_{{ address.id }}_Zip"
                      name="address[zip]"
                      class="field__input"
                      value="{{ address.zip }}"
                      placeholder=" "
                      required
                    >
                    <label class="field__label" for="EditAddress_{{ address.id }}_Zip">
                      {{- 'customer.addresses.zip' | t -}}
                    </label>
                  </div>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="EditAddress_{{ address.id }}_Country">{{ 'customer.addresses.country' | t }}</label>
                  <div class="select-wrapper">
                    <select
                      id="EditAddress_{{ address.id }}_Country"
                      name="address[country]"
                      data-address-country-select
                      data-default="{{ address.country }}"
                    >
                      {{ all_country_option_tags }}
                    </select>
                  </div>
                </div>

                <div class="form-group" id="EditAddress_{{ address.id }}_ProvinceContainer" style="display:none;">
                  <label for="EditAddress_{{ address.id }}_Province">{{ 'customer.addresses.province' | t }}</label>
                  <div class="select-wrapper">
                    <select
                      id="EditAddress_{{ address.id }}_Province"
                      name="address[province]"
                      data-default="{{ address.province }}"
                    ></select>
                  </div>
                </div>
              </div>

              {% if address == customer.default_address %}
                <div class="form-group">
                  <div class="default-address-message">
                    <p>{{ 'customer.addresses.default' | t }}</p>
                  </div>
                </div>
              {% else %}
                <div class="form-group">
                  <div class="checkbox-wrapper">
                    <input type="checkbox" id="address_default_address_{{ address.id }}" name="address[default]" value="1">
                    <label for="address_default_address_{{ address.id }}">Set as default address</label>
                  </div>
                </div>
              {% endif %}

              <div class="form-actions">
                <button type="submit" class="button">
                  <span class="btn-text">Update Address</span>
                  <span class="btn-spinner"></span>
                </button>
                <button type="button" class="button button--tertiary cancel-edit" data-address-id="{{ address.id }}">
                  Cancel
                </button>
              </div>
            </div>
          {%- endform -%}
        </div>
      </div>
    {% endunless %}
  {% endfor %}
</div>
</div>

