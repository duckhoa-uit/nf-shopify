{% doc %}
  Renders a 128px square photo tile image for a menu link.

  Resolution order:
    1. link.object.metafields.menu.image (file_reference, optional override)
    2. link.object.featured_image (collection / product / article)
    3. link.object.image (page)
    4. gray-100 placeholder

  @param {object} link - Liquid link object from a linklist
  @param {string} [size] - Image source width hint (defaults to 256)

  @example
    {% render 'menu-link-image', link: childlink %}
{% enddoc %}

{%- liquid
  assign img = blank
  if link.object.metafields.menu.image.value != blank
    assign img = link.object.metafields.menu.image.value
  elsif link.object.featured_image
    assign img = link.object.featured_image
  elsif link.object.image
    assign img = link.object.image
  endif

  assign target_width = size | default: 256
-%}

{%- if img != blank -%}
  {{
    img
    | image_url: width: target_width
    | image_tag:
      class: 'menu-drawer__tile-img',
      loading: 'lazy',
      widths: '128,256',
      sizes: '128px',
      alt: link.title
  }}
{%- else -%}
  <span class="menu-drawer__tile-img--placeholder" aria-hidden="true"></span>
{%- endif -%}
