{% doc %}
  Renders one fused sale chip: compare-at percent or SALE plus promotion names.

  @param {product} product - Product whose sale prefix and promotion names are rendered.
  @param {variant} [variant] - Variant used for discount calculations.
  @param {string} [context] - `card` or `pdp`; defaults to `card`.

  @example
  {% render 'product-badge-row', product: product, context: 'pdp' %}
{% enddoc %}

{%- liquid
  assign badge_context = context | default: 'card'
  assign minimum_discount = 15
  assign sale_prefix = ''
  assign fused_names = ''
  assign fused_label = ''
  assign promotion_filter_param = 'filter.p.m.custom_features.promotion'
  assign promotion_filters = null

  if badge_context == 'pdp'
    assign discount_badge_class = 'product-discount-badge product-badge-row__badge product-badge-row__badge--discount'
  else
    assign discount_badge_class = 'product-badge-row__badge product-badge-row__badge--discount'
  endif

  if variant != blank
    assign compare_price = variant.compare_at_price
    assign current_price = variant.price
  else
    assign compare_price = product.compare_at_price
    assign current_price = product.price
  endif

  if compare_price > current_price
    assign savings = compare_price | minus: current_price | times: 100.0 | divided_by: compare_price | round
    if savings >= minimum_discount
      assign sale_prefix = '-' | append: savings | append: '%'
    else
      assign sale_prefix = 'products.product.sale_badge' | t | default: 'SALE'
    endif
  endif

  if product.metafields.custom_features.promotion.value != blank
    for promotion in product.metafields.custom_features.promotion.value
      capture promotion_name
        echo promotion.name
      endcapture
      assign promotion_name = promotion_name | strip
      if promotion_name != blank
        if fused_names != blank
          assign fused_names = fused_names | append: ' ' | append: promotion_name
        else
          assign fused_names = promotion_name
        endif
      endif
    endfor
  endif

  if collection.filters != blank
    assign promotion_filters = collection.filters
  elsif search.filters != blank
    assign promotion_filters = search.filters
  endif

  if promotion_filters != blank and product.metafields.custom_features.promotion.value != blank
    for filter in promotion_filters
      if filter.param_name == promotion_filter_param
        for value in filter.values
          if value.active
            assign selected_name = ''
            for promotion in product.metafields.custom_features.promotion.value
              capture promotion_name
                echo promotion.name
              endcapture
              assign promotion_name = promotion_name | strip
              assign promotion_gid = promotion.id | append: ''
              assign promotion_system_gid = 'gid://shopify/Metaobject/' | append: promotion.system.id
              if value.value == promotion_gid or value.value == promotion_system_gid or value.label == promotion_name
                assign selected_name = promotion_name
                break
              endif
            endfor
            if selected_name != blank
              assign padded_names = ' ' | append: fused_names | append: ' '
              assign selected_needle = ' ' | append: selected_name | append: ' '
              unless padded_names contains selected_needle
                if fused_names != blank
                  assign fused_names = fused_names | append: ' ' | append: selected_name
                else
                  assign fused_names = selected_name
                endif
              endunless
            endif
          endif
        endfor
      endif
    endfor
  endif

  assign fused_label = sale_prefix
  if fused_names != blank
    if fused_label != blank
      assign fused_label = fused_label | append: ' ' | append: fused_names
    else
      assign fused_label = fused_names
    endif
  endif
-%}

<div class="product-badge-row product-badge-row--{{ badge_context }}">
  {%- if fused_label != blank -%}
    <span class="{{ discount_badge_class }}" title="{{ fused_label | escape }}">
      <span class="product-badge-row__label">{{ fused_label }}</span>
    </span>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-badge-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .product-badge-row--card {
    min-height: 2rem;
    margin-bottom: 0.375rem;
  }

  .product-badge-row__badge {
    display: inline-flex;
    flex: 0 1 auto;
    align-items: center;
    max-width: 100%;
    min-width: 0;
    padding: 0.25rem 0.5rem;
    overflow: hidden;
    border: 1px solid var(--product-badge-border-color);
    border-radius: 0.125rem;
    background-color: var(--product-badge-background-color);
    color: var(--product-badge-text-color);
    line-height: 1rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-badge-row__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-badge-row__badge--discount {
    --product-badge-background-color: var(--color-accent);
    --product-badge-border-color: var(--color-accent);
    --product-badge-text-color: var(--color-white);

    font-size: 0.9375rem;
    font-weight: 700;
  }
{% endstylesheet %}
