{% comment %}
  Renders product's benefits

  Accepts:
  - product: {Object} Product Liquid object (optional)

  Usage:
  {% render 'product-benefit', product: product %}
{% endcomment %}

{% assign benefits_count = 0 %}
{% assign has_breathability = false %}
{% assign has_elasticity = false %}
{% assign has_windproofness = false %}
{% assign has_warmth = false %}

{% comment %} Use system.handle for language-independent comparison {% endcomment %}
{% assign breathability_name = '' %}
{% if product.metafields.features.breathability.value %}
  {% for breathability_obj in product.metafields.features.breathability.value %}
    {% assign breathability_name = breathability_obj.system.handle %}
    {% break %}
  {% endfor %}
{% endif %}

{% assign breathability_level_map = 0 %}
{% comment %} Use pattern matching for resilient data migration handling - maintain priority order {% endcomment %}
{% if breathability_name contains 'extremely' and breathability_name contains 'high' -%}
  {%- assign breathability_level_map = 5 %}
{% elsif breathability_name contains 'medium' and breathability_name contains 'high' -%}
  {%- assign breathability_level_map = 3 %}
{% elsif breathability_name contains 'high' -%}
  {%- assign breathability_level_map = 4 %}
{% elsif breathability_name contains 'very' and breathability_name contains 'low' -%}
  {%- assign breathability_level_map = 1 %}
{% elsif breathability_name contains 'low' -%}
  {%- assign breathability_level_map = 2 %}
{% endif %}

{% if breathability_level_map > 0 %}
  {% assign has_breathability = true %}
  {% assign benefits_count = benefits_count | plus: 1 %}
{% endif %}

{% comment %} Use system.handle for language-independent comparison {% endcomment %}
{% assign elasticity_name = '' %}
{% if product.metafields.features.elasticity.value %}
  {% for elasticity_obj in product.metafields.features.elasticity.value %}
    {% assign elasticity_name = elasticity_obj.system.handle %}
    {% break %}
  {% endfor %}
{% endif %}

{% assign elasticity_level_map = 0 %}
{% comment %} Use pattern matching for resilient data migration handling - maintain priority order {% endcomment %}
{% if elasticity_name contains 'extremely' and elasticity_name contains 'high' -%}
  {%- assign elasticity_level_map = 5 %}
{% elsif elasticity_name contains 'medium' and elasticity_name contains 'high' -%}
  {%- assign elasticity_level_map = 3 %}
{% elsif elasticity_name contains 'high' -%}
  {%- assign elasticity_level_map = 4 %}
{% elsif elasticity_name contains 'very' and elasticity_name contains 'low' -%}
  {%- assign elasticity_level_map = 1 %}
{% elsif elasticity_name contains 'low' -%}
  {%- assign elasticity_level_map = 2 %}
{% endif %}

{% if elasticity_level_map > 0 %}
  {% assign has_elasticity = true %}
  {% assign benefits_count = benefits_count | plus: 1 %}
{% endif %}

{% comment %} Use system.handle for language-independent comparison {% endcomment %}
{% assign windproofness_name = '' %}
{% if product.metafields.features.windproofness.value %}
  {% for windproofness_obj in product.metafields.features.windproofness.value %}
    {% assign windproofness_name = windproofness_obj.system.handle %}
    {% break %}
  {% endfor %}
{% endif %}

{% assign windproofness_level_map = 0 %}
{% comment %} Use pattern matching for resilient data migration handling - maintain priority order {% endcomment %}
{% if windproofness_name contains 'extremely' and windproofness_name contains 'high' -%}
  {%- assign windproofness_level_map = 5 %}
{% elsif windproofness_name contains 'medium' and windproofness_name contains 'high' -%}
  {%- assign windproofness_level_map = 3 %}
{% elsif windproofness_name contains 'high' -%}
  {%- assign windproofness_level_map = 4 %}
{% elsif windproofness_name contains 'very' and windproofness_name contains 'low' -%}
  {%- assign windproofness_level_map = 1 %}
{% elsif windproofness_name contains 'low' -%}
  {%- assign windproofness_level_map = 2 %}
{% endif %}

{% if windproofness_level_map > 0 %}
  {% assign has_windproofness = true %}
  {% assign benefits_count = benefits_count | plus: 1 %}
{% endif %}

{% comment %} Use system.handle for language-independent comparison {% endcomment %}
{% assign warmth_name = '' %}
{% if product.metafields.features.warmth.value %}
  {% for warmth_obj in product.metafields.features.warmth.value %}
    {% assign warmth_name = warmth_obj.system.handle %}
    {% break %}
  {% endfor %}
{% endif %}

{% assign warmth_level_map = 0 %}
{% comment %} Use pattern matching for resilient data migration handling - maintain priority order {% endcomment %}
{% if warmth_name contains 'extremely' and warmth_name contains 'high' -%}
  {%- assign warmth_level_map = 5 %}
{% elsif warmth_name contains 'medium' and warmth_name contains 'high' -%}
  {%- assign warmth_level_map = 3 %}
{% elsif warmth_name contains 'high' -%}
  {%- assign warmth_level_map = 4 %}
{% elsif warmth_name contains 'very' and warmth_name contains 'low' -%}
  {%- assign warmth_level_map = 1 %}
{% elsif warmth_name contains 'low' -%}
  {%- assign warmth_level_map = 2 %}
{% endif %}

{% if warmth_level_map > 0 %}
  {% assign has_warmth = true %}
  {% assign benefits_count = benefits_count | plus: 1 %}
{% endif %}

{% if benefits_count > 0 %}
  <div class="mt-12 flex flex-col w-full">
    <h5 class="text-lg my-2 text-[#0F0F0F] font-bold leading-7">Benefits</h5>

    <style>
      /* Hide benefits beyond first 2 by default to prevent flash */
      #product-benefits-list li:not(:first-child):not(:nth-child(2)):not(:last-child) {
        display: none;
      }

      /* On mobile, always show all benefits */
      @media (max-width: 768px) {
        #product-benefits-list li {
          display: block !important;
        }
        #product-benefits-list li:last-child {
          display: none !important;
        }
      }
    </style>

    <ul class="flex flex-col w-full relative" id="product-benefits-list">
      {% if has_breathability %}
        <li class="break-inside-avoid mb-9 ml-8">
          <img
            class="absolute left-0 size-4"
            width="16"
            height="16"
            src="{{ 'BREATHABILITY.svg' | asset_url }}"
            loading="lazy"
          >

          <div class="text-[#0F0F0F] text-base font-semibold leading-4 capitalize">
            Breathability
            <span class="font-medium">({{ breathability_level_map }}/5)</span>
          </div>

          {% capture breathability_descriptions %}
        {% case breathability_level_map %}
          {% when 1 %}The material offers minimal breathability, suitable for casual use
          {% when 2 %}The material provides basic breathability, allowing some air circulation
          {% when 3 %}The material offers good breathability, ensuring comfortable air flow during activity
          {% when 4 %}The material delivers excellent breathability with enhanced moisture-wicking properties
          {% when 5 %}The material features superior breathability, ideal for high-intensity activities
          {% else %}No breathability information available
        {% endcase %}
      {% endcapture %}

          <div class="text-[#3D3D3D] text-sm leading-4 my-2">
            {{ breathability_descriptions | strip }}
          </div>
          {% render 'benefit-indicator', input: breathability_level_map %}
        </li>
      {% endif %}

      {% if has_elasticity %}
        <li class="break-inside-avoid mb-9 ml-8">
          <img
            class="absolute left-0 size-4"
            width="16"
            height="16"
            src="{{ 'ELASTICITY.svg' | asset_url }}"
            loading="lazy"
          >

          <div class="text-[#0F0F0F] text-base font-semibold leading-4 capitalize">
            Elasticity
            <span class="font-medium">({{ elasticity_level_map }}/5)</span>
          </div>

          {% capture elasticity_descriptions %}
        {% case elasticity_level_map %}
          {% when 1 %}The material has minimal stretch properties, best suited for structured garments
          {% when 2 %}The material has limited stretch properties, providing basic movement flexibility
          {% when 3 %}The material offers good stretch properties, allowing comfortable range of motion
          {% when 4 %}The material provides excellent stretch properties with enhanced movement flexibility
          {% when 5 %}The material features superior 4-way stretch properties, offering maximum flexibility and comfort
          {% else %}No elasticity information available
        {% endcase %}
      {% endcapture %}

          <div class="text-[#3D3D3D] text-sm leading-4 my-2">
            {{ elasticity_descriptions | strip }}
          </div>
          {% render 'benefit-indicator', input: elasticity_level_map %}
        </li>
      {% endif %}

      {% if has_windproofness %}
        <li class="break-inside-avoid mb-9 ml-8">
          <img
            class="absolute left-0 size-4"
            width="16"
            height="16"
            src="{{ 'WINDPROOFNESS.svg' | asset_url }}"
            loading="lazy"
          >

          <div class="text-[#0F0F0F] text-base font-semibold leading-4 capitalize">
            Windproofness
            <span class="font-medium">({{ windproofness_level_map }}/5)</span>
          </div>

          {% capture windproofness_descriptions %}
        {% case windproofness_level_map %}
          {% when 1 %}Provides minimal protection against light breezes
          {% when 2 %}Offers basic protection against everyday wind conditions
          {% when 3 %}Provides good protection in moderate wind conditions
          {% when 4 %}Delivers strong protection in windy conditions with specialized materials
          {% when 5 %}Offers superior protection against strong winds with advanced wind-blocking technology
          {% else %}No windproofness information available
        {% endcase %}
      {% endcapture %}

          <div class="text-[#3D3D3D] text-sm leading-4 my-2">
            {{ windproofness_descriptions | strip }}
          </div>
          {% render 'benefit-indicator', input: windproofness_level_map %}
        </li>
      {% endif %}

      {% if has_warmth %}
        <li class="break-inside-avoid mb-9 ml-8">
          <img
            class="absolute left-0 size-4"
            width="16"
            height="16"
            src="{{ 'WARMTH.svg' | asset_url }}"
            loading="lazy"
          >

          <div class="text-[#0F0F0F] text-base font-semibold leading-4 capitalize">
            Warmth
            <span class="font-medium">({{ warmth_level_map }}/5)</span>
          </div>

          {% capture warmth_descriptions %}
        {% case warmth_level_map %}
          {% when 1 %}The material provides minimal insulation, best for mild conditions or high activity
          {% when 2 %}The material offers light insulation, suitable for cool weather activities
          {% when 3 %}The material provides moderate insulation, ideal for everyday cold weather use
          {% when 4 %}The material provides good insulation, keeping you warm in cold conditions
          {% when 5 %}The material offers superior insulation, designed for extreme cold weather protection
          {% else %}No warmth information available
        {% endcase %}
      {% endcapture %}

          <div class="text-[#3D3D3D] text-sm leading-4 my-2">
            {{ warmth_descriptions | strip }}
          </div>
          {% render 'benefit-indicator', input: warmth_level_map %}
        </li>
      {% endif %}

      {% if benefits_count > 2 %}
        <li class="break-inside-avoid mb-9 ml-8">
          <button id="show-more-benefits" class="text-[#0F0F0F] text-base leading-7 underline cursor-pointer">
            Show all benefits
          </button>
          <button
            id="show-less-benefits"
            class="text-[#0F0F0F] text-base leading-7 underline cursor-pointer"
            style="display: none;"
          >
            Show less benefits
            <span class="*:-rotate-90 *:inline *:ml-1 *:size-3">
              {{- 'icon-chevron.svg' | inline_asset_content -}}
            </span>
          </button>
        </li>
      {% endif %}
    </ul>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const benefitsList = document.getElementById('product-benefits-list');
      const benefitItems = benefitsList.querySelectorAll('li:not(:last-child)');
      const showMoreBtn = document.getElementById('show-more-benefits');
      const showLessBtn = document.getElementById('show-less-benefits');

      // Check if we're on mobile
      function isMobile() {
        return window.innerWidth <= 768;
      }

      // Function to show only the first 2 benefits
      function showLessBenefits() {
        if (!isMobile()) {
          benefitItems.forEach((item, index) => {
            if (index >= 2) {
              item.style.display = 'none';
            }
          });
          showMoreBtn.style.display = 'block';
          showLessBtn.style.display = 'none';
        }
      }

      // Function to show all benefits
      function showAllBenefits() {
        benefitItems.forEach((item) => {
          item.style.display = 'block';
        });
        showMoreBtn.style.display = 'none';
        showLessBtn.style.display = 'block';
      }

      // Handle responsive behavior
      function handleResponsive() {
        if (isMobile()) {
          // On mobile, show all benefits and hide controls
          benefitItems.forEach((item) => {
            item.style.display = 'block';
          });
          showMoreBtn.style.display = 'none';
          showLessBtn.style.display = 'none';
        } else {
          // On desktop, respect the current state
          if (showMoreBtn.style.display === 'none') {
            showAllBenefits();
          } else {
            showLessBenefits();
          }
        }
      }

      // Add click event listeners
      showMoreBtn.addEventListener('click', showAllBenefits);
      showLessBtn.addEventListener('click', showLessBenefits);

      // Handle window resize for responsive behavior
      window.addEventListener('resize', handleResponsive);

      // Initialize the UI
      handleResponsive();
    });
  </script>
{% endif %}
