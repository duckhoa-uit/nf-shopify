{% comment %}
  Renders metaobject-based filters

  Usage:
  {% render 'metaobject-filters' %}
{% endcomment %}

{%- liquid
  # Simulate metaobject filters since they are created in admin
  assign size_filter = 'Size'
  assign size_values = shop.metaobjects['shopify--size'].values

  assign color_filter = 'Color'
  assign color_values = shop.metaobjects['shopify--color-pattern'].values

  assign activities_filter = 'Activities'
  assign activities_values = shop.metaobjects.product_feature.activities.values

  assign material_filter = 'Material'
  assign material_values = 'Cotton,Polyester,Nylon,Wool,Down' | split: ','

  assign features_filter = 'Features'
  assign features_values = 'Waterproof,Breathable,Windproof,Insulated,Lightweight' | split: ','

  assign activity_filter = 'Activity'
  assign activity_values = 'Hiking,Skiing,Running,Climbing,Casual' | split: ','
-%}

<script>console.log({{ shop.metaobjects.product_feature_preset | json }});</script>
<script>console.log({{ shop.metaobjects.product_feature_preset.pink | json }});</script>


{% comment %} Size Filter {% endcomment %}
<details
  id="Details-metaobject-size-{{ section.id }}"
  class="{% if filter_type == 'horizontal' %}disclosure-has-popup facets__disclosure{% else %} facets__disclosure-vertical{% endif %} js-filter"
  data-index="size"
  {% if filter_type == 'vertical' %}
    open
  {% endif %}
>
  <summary class="facets__summary caption-large focus-offset">
    <div>
      <span>{{ size_filter }}</span>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </div>
  </summary>
  <div class="parent-display {% if filter_type == 'horizontal' %}facets__display{% else %}facets__display-vertical{% endif %}">
    <fieldset class="facets-wrap parent-wrap">
      <ul class="facets-layout facets-layout-list facets__list list-unstyled" role="list">
        {%- for size in size_values -%}
          {%- assign product_count = size.referenced_by | size -%}
          <li class="list-menu__item facets__item">
            <label class="facets__label">
              <input
                type="checkbox"
                name="filter.v.meta.size"
                value="{{ size.label | handleize }}"
                id="Filter-size-{{ forloop.index }}"
              >
              <span class="facet-checkbox__text">{{ size.label }} ({{ product_count }})</span>
            </label>
          </li>
        {%- endfor -%}
      </ul>
    </fieldset>
  </div>
</details>

