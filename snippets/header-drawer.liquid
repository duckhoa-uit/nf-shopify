{% comment %}
  Renders a mobile mega-menu drawer with image tiles and push-stack navigation.

  - Level 1: top-level links from section.settings.menu.
    * First 2 links with children are rendered as hero tiles (large image + label).
    * Remaining links render as flat rows.
  - Level 2 and 3: each panel slides in from the right with a "back" arrow header
    and "All <category>" CTA at the bottom that links to the parent's URL.
  - Tile images come from link.object.featured_image (auto for collections),
    with optional override via metafield `menu.image`.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

{%- liquid
  assign menu_links = section.settings.menu.links
  assign hero_links = empty
  assign list_links = empty

  if menu_links.size > 0
    assign hero_links = menu_links | slice: 0, 2
    if menu_links.size > 2
      assign hero_count = menu_links.size | minus: 2
      assign list_links = menu_links | slice: 2, hero_count
    endif
  endif

  assign announcement_section = sections['announcement-bar']
-%}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            {%- if hero_links.size > 0 -%}
              <div class="menu-drawer__hero">
                {%- for link in hero_links -%}
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-hero-{{ forloop.index }}">
                      <summary class="menu-drawer__tile" id="HeaderDrawer-{{ link.handle }}">
                        {% render 'menu-link-image', link: link %}
                        <span class="menu-drawer__tile-label">
                          {{ link.title | escape }}
                          <span class="svg-wrapper">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                        </span>
                      </summary>
                      {% render 'menu-drawer-panel', link: link %}
                    </details>
                  {%- else -%}
                    <a href="{{ link.url }}" class="menu-drawer__tile">
                      {% render 'menu-link-image', link: link %}
                      <span class="menu-drawer__tile-label">
                        {{ link.title | escape }}
                        <span class="svg-wrapper">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                      </span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if list_links.size > 0 -%}
              <ul class="menu-drawer__list" role="list">
                {%- for link in list_links -%}
                  <li class="menu-drawer__list-item">
                    {%- if link.links != blank -%}
                      <details id="Details-menu-drawer-menu-item-{{ forloop.index | plus: hero_links.size }}">
                        <summary
                          id="HeaderDrawer-{{ link.handle }}"
                          class="menu-drawer__list-row link link--text focus-inset"
                        >
                          <span class="menu-drawer__list-label">{{ link.title | escape }}</span>
                          <span class="svg-wrapper menu-drawer__list-chevron">
                            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                          </span>
                        </summary>
                        {% render 'menu-drawer-panel', link: link %}
                      </details>
                    {%- else -%}
                      <a
                        id="HeaderDrawer-{{ link.handle }}"
                        href="{{ link.url }}"
                        class="menu-drawer__list-row link link--text focus-inset"
                        {% if link.current %}aria-current="page"{% endif %}
                      >
                        <span class="menu-drawer__list-label">{{ link.title | escape }}</span>
                        <span class="svg-wrapper menu-drawer__list-chevron">
                          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                        </span>
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="menu-drawer__extras">
              {% if announcement_section.settings.blog_link != blank %}
                <a href="{{ announcement_section.settings.blog_link }}">
                  {{- 'general.navigation.blog' | t | default: 'Blog' -}}
                </a>
              {% else %}
                <a href="{{ blog.url | default: '/blogs/news' }}">
                  {{- 'general.navigation.blog' | t | default: 'Blog' -}}
                </a>
              {% endif %}
              {% if announcement_section.settings.faq_link != blank %}
                <a href="{{ announcement_section.settings.faq_link }}">
                  {{- 'general.navigation.faq' | t | default: 'FAQ' -}}
                </a>
              {% else %}
                <a href="/pages/faq">{{ 'general.navigation.faq' | t | default: 'FAQ' }}</a>
              {% endif %}
            </div>
          </nav>

          <div class="menu-drawer__utility-links">
            <div class="menu-drawer__auth">
              {% if customer %}
                <a
                  href="{{ routes.account_url }}"
                  class="menu-drawer__auth-btn menu-drawer__auth-btn--primary"
                >
                  <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
                  {{ 'customer.account.title' | t | default: 'Customer Zone' }}
                </a>
                <a
                  href="{{ routes.account_logout_url }}"
                  class="menu-drawer__auth-btn menu-drawer__auth-btn--secondary"
                >
                  <span class="svg-wrapper">{{ 'icon-logout.svg' | inline_asset_content }}</span>
                  {{ 'customer.log_out' | t | default: 'Log out' }}
                </a>
              {% else %}
                <a
                  href="{{ routes.account_register_url }}"
                  class="menu-drawer__auth-btn menu-drawer__auth-btn--primary"
                >
                  {{ 'customer.register.title' | t | default: 'Register' }}
                </a>
                <a
                  href="{{ routes.account_login_url }}"
                  class="menu-drawer__auth-btn menu-drawer__auth-btn--secondary"
                >
                  {{ 'customer.login_page.sign_in' | t | default: 'Login' }}
                </a>
              {% endif %}
            </div>

            {%- if localization.available_countries or localization.available_languages -%}
              <div class="menu-drawer__localization menu-drawer__localization--mobile">
                {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

{% stylesheet %}
  .menu-drawer__localization--mobile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0 1.5rem;
    margin-top: 1rem;
  }

  .menu-drawer__localization--mobile localization-form,
  .menu-drawer__localization--mobile .localization-form,
  .menu-drawer__localization--mobile .disclosure {
    display: block;
    width: 100%;
    position: relative;
  }

  .menu-drawer .menu-drawer__localization--mobile .localization-form__select {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    min-height: var(--touch-target-min);
    height: auto;
    padding: 0.5rem;
    margin: 0;
    border: 1px solid #ADACAB;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--color-foreground);
    background-color: transparent;
    text-align: left;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer .menu-drawer__localization--mobile .localization-form__select::before,
  .menu-drawer .menu-drawer__localization--mobile .localization-form__select::after {
    content: none;
  }

  .menu-drawer .menu-drawer__localization--mobile .localization-form__select:active {
    transform: scale(0.98);
  }

  .menu-drawer .menu-drawer__localization--mobile .localization-form__select .icon-caret {
    position: static;
    width: 0.5625rem;
    height: 0.5rem;
    right: auto;
    top: auto;
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer .menu-drawer__localization--mobile .localization-form__select[aria-expanded='true'] .icon-caret {
    transform: rotate(180deg);
  }

  .menu-drawer__localization--mobile localization-form .disclosure__list-wrapper {
    bottom: auto;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    width: 100%;
    max-width: none;
    max-height: 50vh;
    transform: translateY(0);
    border-radius: 0.5rem;
    border: 1px solid rgba(var(--color-base-foreground), 0.1);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 4px 12px rgba(0, 0, 0, 0.06),
      0 16px 32px rgba(0, 0, 0, 0.08);
    z-index: 5;
    transform-origin: top center;
    animation: menuDrawerLocOpen 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer__localization--mobile localization-form .disclosure__list {
    width: 100%;
    max-width: none;
    min-width: 0;
    max-height: none;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }

  .menu-drawer__localization--mobile .disclosure__item .disclosure__link {
    min-height: var(--touch-target-min);
    display: flex;
    align-items: center;
    padding: 0.625rem 0.875rem;
  }

  @keyframes menuDrawerLocOpen {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-drawer__localization--mobile .disclosure__list-wrapper,
    .menu-drawer__localization--mobile .localization-form__select,
    .menu-drawer__localization--mobile .localization-form__select .icon-caret {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}
