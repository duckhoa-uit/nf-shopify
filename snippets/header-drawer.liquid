{% comment %}
  Renders a mobile mega-menu drawer with image tiles and push-stack navigation.

  - Level 1: top-level links from section.settings.menu.
    * First 2 links with children are rendered as hero tiles (large image + label).
    * Remaining links render as flat rows.
  - Level 2 and 3: each panel slides in from the right with a "back" arrow header
    and "All <category>" CTA at the bottom that links to the parent's URL.
  - Tile images come from link.object.featured_image (auto for collections),
    with optional override via metafield `menu.image`.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

{%- liquid
  assign menu_links = section.settings.menu.links
  assign hero_links = empty
  assign list_links = empty

  if menu_links.size > 0
    assign hero_links = menu_links | slice: 0, 2
    if menu_links.size > 2
      assign hero_count = menu_links.size | minus: 2
      assign list_links = menu_links | slice: 2, hero_count
    endif
  endif

  assign announcement_section = sections['announcement-bar']
-%}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            {%- if hero_links.size > 0 -%}
              <div class="menu-drawer__hero">
                {%- for link in hero_links -%}
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-hero-{{ forloop.index }}">
                      <summary class="menu-drawer__tile" id="HeaderDrawer-{{ link.handle }}">
                        {% render 'menu-link-image', link: link %}
                        <span class="menu-drawer__tile-label">
                          {{ link.title | escape }}
                          <span class="svg-wrapper">{{- 'chevron-right.svg' | inline_asset_content -}}</span>
                        </span>
                      </summary>
                      {% render 'menu-drawer-panel', link: link %}
                    </details>
                  {%- else -%}
                    <a href="{{ link.url }}" class="menu-drawer__tile">
                      {% render 'menu-link-image', link: link %}
                      <span class="menu-drawer__tile-label">
                        {{ link.title | escape }}
                        <span class="svg-wrapper">{{- 'chevron-right.svg' | inline_asset_content -}}</span>
                      </span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if list_links.size > 0 -%}
              <hr class="menu-drawer__divider">

              <ul class="menu-drawer__menu has-submenu list-menu flex flex-col gap-7" role="list">
                {%- for link in list_links -%}
                  <li>
                    {%- if link.links != blank -%}
                      <details id="Details-menu-drawer-menu-item-{{ forloop.index | plus: hero_links.size }}">
                        <summary
                          id="HeaderDrawer-{{ link.handle }}"
                          class="menu-drawer__menu-item list-menu__item link link--text focus-inset p-0 text-lg leading-5 font-bold"
                        >
                          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                            {{ link.title | escape }}
                          </a>
                          <span class="svg-wrapper">{{- 'chevron-right.svg' | inline_asset_content -}}</span>
                        </summary>
                        {% render 'menu-drawer-panel', link: link %}
                      </details>
                    {%- else -%}
                      <a
                        id="HeaderDrawer-{{ link.handle }}"
                        href="{{ link.url }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset p-0 text-lg leading-5 font-bold"
                        {% if link.current %}aria-current="page"{% endif %}
                      >
                        {{ link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="my-[1.5rem] w-full flex flex-col *:text-gray-600 *:my-0.5 *:leading-6 *:text-md *:font-bold px-6">
              {% if announcement_section.settings.blog_link != blank %}
                <a class="text-base" href="{{ announcement_section.settings.blog_link }}">
                  {{- 'general.navigation.blog' | t | default: 'Blog' -}}
                </a>
              {% else %}
                <a class="text-base" href="{{ blog.url | default: '/blogs/news' }}">
                  {{- 'general.navigation.blog' | t | default: 'Blog' -}}
                </a>
              {% endif %}
              {% if announcement_section.settings.faq_link != blank %}
                <a class="text-base" href="{{ announcement_section.settings.faq_link }}">
                  {{- 'general.navigation.faq' | t | default: 'FAQ' -}}
                </a>
              {% else %}
                <a class="text-base" href="/pages/faq">{{ 'general.navigation.faq' | t | default: 'FAQ' }}</a>
              {% endif %}
            </div>
          </nav>

          <hr class="menu-drawer__divider">

          <div class="menu-drawer__utility-links my-5 px-6">
            <div class="flex flex-col w-full gap-y-3">
              {% if customer %}
                <a
                  href="{{ routes.account_url }}"
                  class="w-full button h-[var(--control-height-md)] leading-7 flex items-center justify-center"
                >
                  <span class="svg-wrapper size-5 mr-2">{{ 'icon-account.svg' | inline_asset_content }}</span>
                  {{ 'customer.account.title' | t | default: 'Customer Zone' }}
                </a>
                <a
                  href="{{ routes.account_logout_url }}"
                  class="w-full button h-[var(--control-height-md)] bg-background text-foreground leading-7 flex items-center justify-center"
                >
                  <span class="svg-wrapper size-5 mr-2">{{ 'icon-logout.svg' | inline_asset_content }}</span>
                  {{ 'customer.log_out' | t | default: 'Log out' }}
                </a>
              {% else %}
                <a
                  href="{{ routes.storefront_login_url }}"
                  class="w-full button h-[var(--control-height-md)] leading-7 flex items-center justify-center"
                >
                  {{ 'customer.login_page.sign_in' | t | default: 'Login' }}
                </a>
              {% endif %}
            </div>

            {%- liquid
              assign show_drawer_country = false
              assign show_drawer_language = false
              if settings.show_country_selector and localization.available_countries.size > 1
                assign show_drawer_country = true
              endif
              if settings.show_language_selector
                assign show_drawer_language = true
              endif
            -%}
            {%- if show_drawer_country or show_drawer_language -%}
              <div class="menu-drawer__localization header-localization menu-drawer__localization--mobile">
                {%- if show_drawer_country -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}

                {%- if show_drawer_language -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

{% stylesheet %}
  .menu-drawer__localization--mobile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(var(--color-base-foreground), 0.08);
  }

  .menu-drawer__localization--mobile localization-form,
  .menu-drawer__localization--mobile .localization-form,
  .menu-drawer__localization--mobile .disclosure {
    display: block;
    width: 100%;
    position: relative;
  }

  .menu-drawer__localization--mobile .localization-form__select {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: var(--touch-target-min);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-gray-500);
    border-radius: var(--radius-sm);
    font-size: 1rem;
    font-weight: 400;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer__localization--mobile .localization-form__select:active {
    transform: scale(0.98);
  }

  .menu-drawer__localization--mobile .localization-form__select .icon-caret {
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer__localization--mobile .localization-form__select[aria-expanded='true'] .icon-caret {
    transform: rotate(180deg);
  }

  /* Open the popup UPWARD from the trigger so it never gets clipped by
     the bottom of the drawer (the localization selectors live at the very
     end of the drawer). Constrain width to avoid horizontal overflow. */
  .menu-drawer__localization--mobile localization-form .disclosure__list-wrapper {
    position: absolute;
    top: auto;
    bottom: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    width: 100%;
    max-width: none;
    max-height: 50vh;
    transform: translateY(0);
    border-radius: 0.5rem;
    border: 1px solid rgba(var(--color-base-foreground), 0.1);
    background-color: rgb(var(--color-base-background));
    box-shadow:
      0 -1px 2px rgba(0, 0, 0, 0.04),
      0 -4px 12px rgba(0, 0, 0, 0.06),
      0 -16px 32px rgba(0, 0, 0, 0.08);
    z-index: 5;
    transform-origin: bottom center;
    animation: menuDrawerLocOpen 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Force any anchor-positioning logic from component-localization-form.css
     to also open upward (and stay scoped to the trigger). Fully opt out of
     position-anchor + position-try here — the drawer panel anchors itself
     to the trigger via plain absolute positioning, so we don't want the
     engine attempting an anchored layout that could collapse the panel
     when the trigger's anchor name fails to resolve. */
  @supports (anchor-name: --x) {
    .menu-drawer__localization--mobile localization-form .disclosure__list-wrapper {
      position: absolute;
      inset: auto;
      bottom: calc(100% + 0.5rem);
      top: auto;
      left: 0;
      right: 0;
      width: 100%;
      position-anchor: none;
      position-try-fallbacks: none;
    }
  }

  .menu-drawer__localization--mobile localization-form .disclosure__list {
    width: 100%;
    max-width: none;
    min-width: 0;
    max-height: calc(50vh - 0.5rem);
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }

  .menu-drawer__localization--mobile .disclosure__item .disclosure__link {
    min-height: var(--touch-target-min);
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.25rem;
    color: rgba(var(--color-base-foreground), 0.75);
    border-radius: 0;
    text-decoration: none;
  }

  .menu-drawer__localization--mobile .disclosure__item .disclosure__link:hover {
    background-color: rgba(var(--color-base-foreground), 0.04);
    color: rgb(var(--color-base-foreground));
  }

  /* Active language/country matches the bold/underline treatment used
     for the current menu item elsewhere in the drawer */
  .menu-drawer__localization--mobile .disclosure__item .disclosure__link[aria-current='true'] {
    font-weight: 700;
    color: rgb(var(--color-base-foreground));
  }

  /* The trigger button reflects the active state in the same way */
  .menu-drawer__localization--mobile .localization-form__select {
    font-weight: 600;
    color: rgb(var(--color-base-foreground));
  }

  @keyframes menuDrawerLocOpen {
    from {
      opacity: 0;
      transform: translateY(4px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-drawer__localization--mobile .disclosure__list-wrapper,
    .menu-drawer__localization--mobile .localization-form__select,
    .menu-drawer__localization--mobile .localization-form__select .icon-caret {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}
