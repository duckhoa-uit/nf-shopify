{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container p-10 px-4">
          <nav class="menu-drawer__navigation p-0">
            <ul class="menu-drawer__menu has-submenu list-menu flex flex-col gap-7" role="list">
              {%- for link in section.settings.menu.links -%}
                {%- liquid
                  assign link_has_current_descendant = false
                  if link.current
                    assign link_has_current_descendant = true
                  else
                    for childlink in link.links
                      if childlink.current
                        assign link_has_current_descendant = true
                        break
                      endif
                      for grandchildlink in childlink.links
                        if grandchildlink.current
                          assign link_has_current_descendant = true
                          break
                        endif
                      endfor
                      if link_has_current_descendant
                        break
                      endif
                    endfor
                  endif
                -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset p-0 text-lg leading-5 {% if link_has_current_descendant %}font-bold{% else %}font-medium{% endif %}"
                      >
                        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                          {{ link.title | escape }}
                        </a>
                        <span class="svg-wrapper">
                          {{- 'icon-plus.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-minus.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce mt-3"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset p-0{% if childlink.current %} menu-drawer__menu-item--active font-bold{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <div class="separator"></div>
                                  <div
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset p-0 text-lg font-bold leading-7 uppercase"
                                  >
                                    {{ childlink.title | escape }}
                                  </div>
                                  <div
                                    id="childlink-{{ childlink.handle | escape }}"
                                    class="menu-drawer__submenu has-submenu gradient motion-reduce visible"
                                  >
                                    <button
                                      class="menu-drawer__close-button link link--text focus-inset"
                                      aria-expanded="true"
                                    >
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      {{ childlink.title | escape }}
                                    </button>
                                    <ul
                                      class="menu-drawer__menu list-menu"
                                      role="list"
                                      tabindex="-1"
                                    >
                                      {%- for grandchildlink in childlink.links -%}
                                        <li class="mt-3">
                                          <a
                                            id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                            href="{{ grandchildlink.url }}"
                                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset p-0 text-lg leading-6 mt-2 text-[#3D3D3D] {% if grandchildlink.current %}menu-drawer__menu-item--active font-bold{% else %}font-medium{% endif %}"
                                            {% if grandchildlink.current %}
                                              aria-current="page"
                                            {% endif %}
                                          >
                                            {{ grandchildlink.title | escape }}
                                          </a>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </div>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset p-0 text-lg leading-5 {% if link.current %}font-bold{% else %}font-medium{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>

          <div class="my-[2.1875rem] w-full flex flex-col *:text-[#999] *:my-0.5 *:leading-7 *:text-base">
            {% assign announcement_bar_section = sections['announcement-bar'] %}
            {% if announcement_bar_section.settings.blog_link != blank %}
              <a href="{{ announcement_bar_section.settings.blog_link }}">
                {{- 'general.navigation.blog' | t | default: 'Blog' -}}
              </a>
            {% else %}
              <a href="{{ blog.url | default: '/blogs/news' }}">
                {{- 'general.navigation.blog' | t | default: 'Blog' -}}
              </a>
            {% endif %}
            {% if announcement_bar_section.settings.faq_link != blank %}
              <a href="{{ announcement_bar_section.settings.faq_link }}">
                {{- 'general.navigation.faq' | t | default: 'FAQ' -}}
              </a>
            {% else %}
              <a href="/pages/faq">{{ 'general.navigation.faq' | t | default: 'FAQ' }}</a>
            {% endif %}
          </div>

          <div class="menu-drawer__utility-links mb-5">
            <div class="flex flex-col w-full gap-y-5">
              {% if customer %}
                <a
                  href="{{ routes.account_url }}"
                  class="button h-[3.125rem] leading-7 flex items-center justify-center"
                >
                  <span class="svg-wrapper size-5 mr-2">{{ 'icon-account.svg' | inline_asset_content }}</span>
                  {{ 'customer.account.title' | t | default: 'Customer Zone' }}
                </a>
                <a
                  href="{{ routes.account_logout_url }}"
                  class="button h-[3.125rem] bg-background text-foreground leading-7 flex items-center justify-center"
                >
                  <span class="svg-wrapper size-5 mr-2">{{ 'icon-logout.svg' | inline_asset_content }}</span>
                  {{ 'customer.log_out' | t | default: 'Log out' }}
                </a>
              {% else %}
                <a
                  href="{{ routes.account_register_url }}"
                  data-auth-trigger="register"
                  rel="nofollow"
                  class="button h-[3.125rem] leading-7 flex items-center justify-center"
                >
                  <span class="button-text">{{ 'customer.register.title' | t | default: 'Register' }}</span>
                  <span class="button-spinner" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </span>
                </a>
                <a
                  href="{{ routes.account_login_url }}"
                  data-auth-trigger="login"
                  rel="nofollow"
                  class="button h-[3.125rem] bg-background text-foreground leading-7 flex items-center justify-center"
                >
                  <span class="button-text">{{ 'customer.login_page.sign_in' | t | default: 'Login' }}</span>
                  <span class="button-spinner" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </span>
                </a>
              {% endif %}
            </div>
            {% comment %}
              {%- if shop.customer_accounts_enabled -%}
                <a
                  href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                  class="menu-drawer__account link focus-inset h5 medium-hide large-up-hide"
                  rel="nofollow"
                >
                  {%- if section.settings.enable_customer_avatar -%}
                    <account-icon>
                      {%- if customer and customer.has_avatar? -%}
                        {{ customer | avatar }}
                      {%- else -%}
                        <span class="svg-wrapper">
                          {{- 'icon-account.svg' | inline_asset_content -}}
                        </span>
                      {%- endif -%}
                    </account-icon>
                  {%- else -%}
                    <span class="svg-wrapper">
                      {{- 'icon-account.svg' | inline_asset_content -}}
                    </span>
                  {%- endif -%}
                  {%- liquid
                    if customer
                      echo 'customer.account_fallback' | t
                    else
                      echo 'customer.log_in' | t
                    endif
                  -%}
                </a>
              {%- endif -%}
            {% endcomment %}

            {%- if localization.available_countries or localization.available_languages -%}
              <div class="menu-drawer__localization header-localization menu-drawer__localization--mobile">
                {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            {% comment %}
              <ul class="list list-social list-unstyled" role="list">
                {%- if settings.social_twitter_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-twitter.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-facebook.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_pinterest_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-pinterest.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-instagram.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-tiktok.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tumblr_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-tumblr.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_snapchat_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-snapchat.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-youtube.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_vimeo_link != blank -%}
                  <li class="list-social__item">
                    <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                      <span class="svg-wrapper">
                        {{- 'icon-vimeo.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {% endcomment %}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

{% stylesheet %}
  /* Mobile menu drawer — localization picker polish.
     Scoped to .menu-drawer__localization--mobile to avoid bleed into desktop. */
  .menu-drawer__localization--mobile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(var(--color-base-foreground), 0.08);
  }

  .menu-drawer__localization--mobile localization-form,
  .menu-drawer__localization--mobile .localization-form,
  .menu-drawer__localization--mobile .disclosure {
    display: block;
    width: 100%;
    position: relative;
  }

  /* Make the entire row tappable, not just label+chevron. */
  .menu-drawer__localization--mobile .localization-form__select {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
    padding: 10px 0;
    font-size: 1rem;
    font-weight: 500;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer__localization--mobile .localization-form__select:active {
    transform: scale(0.98);
  }

  .menu-drawer__localization--mobile .localization-form__select .icon-caret {
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer__localization--mobile .localization-form__select[aria-expanded='true'] .icon-caret {
    transform: rotate(180deg);
  }

  /* Drop the popup *down* from the trigger (default Dawn pops up, which collides
     with Login button above). Constrain width to avoid horizontal overflow. */
  .menu-drawer__localization--mobile localization-form .disclosure__list-wrapper {
    bottom: auto;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    width: 100%;
    max-width: none;
    max-height: 50vh;
    transform: translateY(0);
    border-radius: 8px;
    border: 1px solid rgba(var(--color-base-foreground), 0.1);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 4px 12px rgba(0, 0, 0, 0.06),
      0 16px 32px rgba(0, 0, 0, 0.08);
    z-index: 5;
    transform-origin: top center;
    animation: menuDrawerLocOpen 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .menu-drawer__localization--mobile localization-form .disclosure__list {
    width: 100%;
    max-width: none;
    min-width: 0;
    max-height: none;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }

  .menu-drawer__localization--mobile .disclosure__item .disclosure__link {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 10px 14px;
  }

  @keyframes menuDrawerLocOpen {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-drawer__localization--mobile .disclosure__list-wrapper,
    .menu-drawer__localization--mobile .localization-form__select,
    .menu-drawer__localization--mobile .localization-form__select .icon-caret {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}
