{% comment %}
  Renders cart notification

  Accepts:
  - color_scheme: {String} sets the color scheme of the notification (optional)
  - desktop_menu_type: {String} passes the desktop menu type which allows us to use the right css class (optional)

  Usage:
  {% render 'cart-notification' %}
{% endcomment %}

<cart-notification style="display: none;">
  <div class="layer_cart_overlay"></div>
  <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification focus-inset{% if color_scheme %} color-{{ color_scheme }} gradient{% endif %}"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      role="dialog"
      tabindex="-1"
      style="display: none;"
    >
      <div class="cart-notification__header" style="display: none;">
        <div class="cart-notification__success" style="display: none;">
          <div class="cart-notification__checkmark" style="display: none;">
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
          </div>
          <h2 class="cart-notification__heading" style="display: none;">
            {{ 'general.cart.item_added' | t }}
          </h2>
        </div>
        <button
          type="button"
          class="cart-notification__close modal__close-button"
          aria-label="{{ 'accessibility.close' | t }}"
          style="display: none;"
        >
          <span class="svg-wrapper" style="display: none;">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      <div id="cart-notification-product" class="cart-notification-product" style="display: none;"></div>
      <div class="cart-notification__divider" style="display: none;"></div>
      <div class="cart-notification__links" style="display: none;">
        <a
          href="{{ routes.cart_url }}"
          id="cart-notification-button"
          class="button button--primary button--full-width"
          style="display: none;"
        >
          View Cart
        </a>
        <button type="button" class="button button--secondary button--full-width continue-shopping" style="display: none;">
          {{ 'general.continue_shopping' | t }}
        </button>
      </div>
    </div>
  </div>
</cart-notification>
