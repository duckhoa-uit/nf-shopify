{% comment %}
  Size Fit Recommender Component
  
  Accepts:
  - product: {Object} product object
  
  Usage:
  {% render 'size-fit-recommender', product: product %}
{% endcomment %}

<div class="size-recommender-section">
  <!-- Header -->
  <div class="text-center mb-8">
    <h3 class="text-xl font-bold mb-2">Find Your Perfect Size</h3>
    <p class="text-gray-600">Enter your measurements to get a personalized size recommendation</p>
  </div>

  <!-- Measurement Input Form -->
  <div class="max-w-2xl mx-auto">
    <form id="size-recommender-form" class="space-y-6">
      <!-- Body Measurements -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="form-group">
          <label for="chest-input" class="block text-sm font-medium text-gray-700 mb-2">
            Chest <span class="text-red-500">*</span>
            <span class="unit-label text-gray-500">(cm)</span>
          </label>
          <input 
            type="number" 
            id="chest-input" 
            name="chest" 
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
            placeholder="86-140"
            min="60"
            max="200"
            required
          >
        </div>

        <div class="form-group">
          <label for="waist-input" class="block text-sm font-medium text-gray-700 mb-2">
            Waist <span class="text-red-500">*</span>
            <span class="unit-label text-gray-500">(cm)</span>
          </label>
          <input 
            type="number" 
            id="waist-input" 
            name="waist" 
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
            placeholder="60-140"
            min="50"
            max="180"
            required
          >
        </div>

        <div class="form-group">
          <label for="height-input" class="block text-sm font-medium text-gray-700 mb-2">
            Height <span class="unit-label text-gray-500">(cm)</span>
          </label>
          <input 
            type="number" 
            id="height-input" 
            name="height" 
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
            placeholder="150-210"
            min="140"
            max="220"
          >
        </div>

        <div class="form-group">
          <label for="weight-input" class="block text-sm font-medium text-gray-700 mb-2">
            Weight <span class="unit-label text-gray-500">(kg)</span>
          </label>
          <input 
            type="number" 
            id="weight-input" 
            name="weight" 
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
            placeholder="40-150"
            min="30"
            max="200"
          >
        </div>
      </div>

      <!-- Fit Preference -->
      <div class="form-group">
        <label class="block text-sm font-medium text-gray-700 mb-3">
          How do you prefer your clothes to fit?
        </label>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <label class="fit-preference-option cursor-pointer">
            <input type="radio" name="fit_preference" value="tight" class="sr-only">
            <div class="border-2 border-gray-200 rounded-lg p-4 text-center hover:border-red-300 transition-colors">
              <div class="font-medium text-gray-900">Tight Fit</div>
              <div class="text-sm text-gray-500 mt-1">Snug, form-fitting</div>
            </div>
          </label>
          <label class="fit-preference-option cursor-pointer">
            <input type="radio" name="fit_preference" value="regular" class="sr-only" checked>
            <div class="border-2 border-red-500 bg-red-50 rounded-lg p-4 text-center hover:border-red-300 transition-colors">
              <div class="font-medium text-gray-900">Regular Fit</div>
              <div class="text-sm text-gray-500 mt-1">Standard comfortable fit</div>
            </div>
          </label>
          <label class="fit-preference-option cursor-pointer">
            <input type="radio" name="fit_preference" value="loose" class="sr-only">
            <div class="border-2 border-gray-200 rounded-lg p-4 text-center hover:border-red-300 transition-colors">
              <div class="font-medium text-gray-900">Loose Fit</div>
              <div class="text-sm text-gray-500 mt-1">Relaxed, roomy fit</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="text-center">
        <button 
          type="submit" 
          class="bg-red-600 text-white px-8 py-3 rounded-md font-medium hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors"
        >
          Get Size Recommendation
        </button>
      </div>
    </form>

    <!-- Loading State -->
    <div id="recommender-loading" class="hidden text-center py-8">
      <div class="inline-flex items-center">
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Calculating your perfect size...
      </div>
    </div>

    <!-- Recommendation Results -->
    <div id="recommendation-results" class="hidden mt-8">
      <div class="bg-green-50 border border-green-200 rounded-lg p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-3 flex-1">
            <h4 class="text-lg font-medium text-green-900 mb-2">Your Recommended Size</h4>
            <div id="recommended-size" class="text-2xl font-bold text-green-900 mb-2"></div>
            <div id="confidence-score" class="text-sm text-green-700 mb-3"></div>
            <div id="recommendation-explanation" class="text-sm text-green-700"></div>
            
            <!-- Alternative Sizes -->
            <div id="alternative-sizes" class="mt-4 hidden">
              <h5 class="text-sm font-medium text-green-900 mb-2">Alternative sizes to consider:</h5>
              <div id="alternative-sizes-list" class="flex flex-wrap gap-2"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Error State -->
    <div id="recommendation-error" class="hidden mt-8">
      <div class="bg-red-50 border border-red-200 rounded-lg p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-3">
            <h4 class="text-lg font-medium text-red-900 mb-2">Unable to Calculate Size</h4>
            <p id="error-message" class="text-sm text-red-700"></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.fit-preference-option input:checked + div {
  border-color: #ef4444;
  background-color: #fef2f2;
}

.form-group input:focus {
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
}

#recommendation-results {
  animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>
