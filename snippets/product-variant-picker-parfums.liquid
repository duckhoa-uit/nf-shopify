{% comment %}
  Backward-compatible wrapper for perfume product-family navigation.

  Accepts:
  - product: {Object} Current product.
  - block: {Object} Variant picker block.

  Usage:
  {% render 'product-variant-picker-parfums', product: product, block: block %}
{% endcomment %}

{% render 'perfume-product-family-picker',
  product: product,
  instance_id: block.id,
  shopify_attributes: block.shopify_attributes
%}
