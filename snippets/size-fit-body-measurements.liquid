  <!-- How to Measure Section -->
  <div class="measurement-guide mb-10 mt-8">
    {% if is_shoes %}
      <h3 class="text-xl text-left mb-4 font-archivo-expanded">
        {{ 'size_guide.headings.footwear_measurement_guide' | t }}
      </h3>

      <div class="measurement-content flex flex-col md:flex-row items-center gap-8">
        <div class="measurement-instructions flex-1">
          <div class="rte">
            <ol>
              <li>{% render 'get-measurement-label', type: 'body', key: 'foot_length' %}</li>
            </ol>
            <p class="text-gray-600 mt-4">{{ 'size_guide.descriptions.hiking_shoes' | t }}</p>
          </div>
        </div>

        <div class="measurement-figure flex-1 text-center">
          {% if category == 'hiking_shoes_men' %}
            <img
              src="{{ 'hiking-shoe-sizing-man.png' | asset_url }}"
              alt="How to Measure Foot Length - Men"
              class="max-w-full h-auto"
            >
          {% elsif category == 'hiking_shoes_women' %}
            <img
              src="{{ 'hiking-shoe-sizing-woman.png' | asset_url }}"
              alt="How to Measure Foot Length - Women"
              class="max-w-full h-auto"
            >
          {% else %}
            <img
              src="{{ 'hiking-shoe-sizing-man.png' | asset_url }}"
              alt="How to Measure Foot Length"
              class="max-w-full h-auto"
            >
          {% endif %}
        </div>
      </div>

    {% else %}
      <h3 class="text-xl text-left mb-4 font-archivo-expanded">{{ 'size_guide.headings.measurement_guide' | t }}</h3>

