{% comment %}
  Size Fit Body Measurements Component

  Accepts:
  - measurements: {Object} body measurements data from metafields

  Usage:
  {% render 'size-fit-body-measurements', measurements: body_measurements %}
{% endcomment %}

{% assign measurements = measurements | default: blank %}

<div class="body-measurements-section">
  <!-- Table -->
  <div class="overflow-x-auto mb-8">
    <table class="w-full border-collapse">
      <thead>
        <tr class="bg-gray-100">
          <th class="p-3 border border-gray-300 text-left font-medium">Size</th>
          {% if measurements.sizes %}
            {% for size_data in measurements.sizes limit: 7 %}
              {% assign size = size_data[0] %}
              <th class="p-3 border border-gray-300 text-center font-medium">{{ size }}</th>
            {% endfor %}
          {% else %}
            <th class="p-3 border border-gray-300 text-center font-medium">S</th>
            <th class="p-3 border border-gray-300 text-center font-medium">M</th>
            <th class="p-3 border border-gray-300 text-center font-medium">L</th>
            <th class="p-3 border border-gray-300 text-center font-medium">XL</th>
            <th class="p-3 border border-gray-300 text-center font-medium">XXL</th>
            <th class="p-3 border border-gray-300 text-center font-medium">3XL</th>
            <th class="p-3 border border-gray-300 text-center font-medium">4XL</th>
          {% endif %}
        </tr>
      </thead>
      <tbody>
        <!-- EU Size Row -->
        <tr>
          <td class="p-3 border border-gray-300 font-medium">EU</td>
          {% if measurements.sizes %}
            {% for size_data in measurements.sizes limit: 7 %}
              {% assign size_info = size_data[1] %}
              <td class="p-3 border border-gray-300 text-center" data-measurement="eu" data-size="{{ size_data[0] }}">
                {% if size_info.eu_size %}
                  {{ size_info.eu_size }}
                {% else %}
                  -
                {% endif %}
              </td>
            {% endfor %}
          {% else %}
            <td class="p-3 border border-gray-300 text-center">44-46</td>
            <td class="p-3 border border-gray-300 text-center">48-50</td>
            <td class="p-3 border border-gray-300 text-center">52-54</td>
            <td class="p-3 border border-gray-300 text-center">56-58</td>
            <td class="p-3 border border-gray-300 text-center">60-62</td>
            <td class="p-3 border border-gray-300 text-center">64</td>
            <td class="p-3 border border-gray-300 text-center">66</td>
          {% endif %}
        </tr>

        <!-- Chest Row -->
        <tr>
          <td class="p-3 border border-gray-300 font-medium">CHEST</td>
          {% if measurements.sizes %}
            {% for size_data in measurements.sizes limit: 7 %}
              {% assign size_info = size_data[1] %}
              <td class="p-3 border border-gray-300 text-center" data-measurement="chest" data-size="{{ size_data[0] }}">
              {% if size_info.chest %}
                <span class="measurement-value" data-cm="{{ size_info.chest.min }}-{{ size_info.chest.max }}" data-in="{{ size_info.chest.min | divided_by: 2.54 | round: 1 }}-{{ size_info.chest.max | divided_by: 2.54 | round: 1 }}">
                  {{ size_info.chest.min }}-{{ size_info.chest.max }}
                </span>
              {% else %}
                -
              {% endif %}
            </td>
            {% endfor %}
          {% else %}
            <td class="p-3 border border-gray-300 text-center" data-measurement="chest">
              <span class="measurement-value" data-cm="86-94" data-in="33.9-37.0">86-94</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="chest">
              <span class="measurement-value" data-cm="94-102" data-in="37.0-40.2">94-102</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="chest">
              <span class="measurement-value" data-cm="102-110" data-in="40.2-43.3">102-110</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="chest">
              <span class="measurement-value" data-cm="110-116" data-in="43.3-45.7">110-116</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="chest">
              <span class="measurement-value" data-cm="116-128" data-in="45.7-50.4">116-128</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="chest">
              <span class="measurement-value" data-cm="126-132" data-in="49.6-52.0">126-132</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="chest">
              <span class="measurement-value" data-cm="132-140" data-in="52.0-55.1">132-140</span>
            </td>
          {% endif %}
        </tr>

        <!-- Waist Row -->
        <tr>
          <td class="p-3 border border-gray-300 font-medium">WAIST</td>
          {% if measurements.sizes %}
            {% for size_data in measurements.sizes limit: 7 %}
              {% assign size_info = size_data[1] %}
              <td class="p-3 border border-gray-300 text-center" data-measurement="waist" data-size="{{ size_data[0] }}">
                {% if size_info.waist %}
                  <span class="measurement-value" data-cm="{{ size_info.waist.min }}-{{ size_info.waist.max }}" data-in="{{ size_info.waist.min | divided_by: 2.54 | round: 1 }}-{{ size_info.waist.max | divided_by: 2.54 | round: 1 }}">
                    {{ size_info.waist.min }}-{{ size_info.waist.max }}
                  </span>
                {% else %}
                  -
                {% endif %}
              </td>
            {% endfor %}
          {% else %}
            <td class="p-3 border border-gray-300 text-center" data-measurement="waist">
              <span class="measurement-value" data-cm="72-80" data-in="28.3-31.5">72-80</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="waist">
              <span class="measurement-value" data-cm="80-88" data-in="31.5-34.6">80-88</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="waist">
              <span class="measurement-value" data-cm="88-96" data-in="34.6-37.8">88-96</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="waist">
              <span class="measurement-value" data-cm="96-104" data-in="37.8-40.9">96-104</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="waist">
              <span class="measurement-value" data-cm="104-112" data-in="40.9-44.1">104-112</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="waist">
              <span class="measurement-value" data-cm="112-120" data-in="44.1-47.2">112-120</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="waist">
              <span class="measurement-value" data-cm="120-128" data-in="47.2-50.4">120-128</span>
            </td>
          {% endif %}
        </tr>

        <!-- Hip Row -->
        <tr>
          <td class="p-3 border border-gray-300 font-medium">HIP</td>
          {% if measurements.sizes %}
            {% for size_data in measurements.sizes limit: 7 %}
              {% assign size_info = size_data[1] %}
              <td class="p-3 border border-gray-300 text-center" data-measurement="hip" data-size="{{ size_data[0] }}">
                {% if size_info.hip %}
                  <span class="measurement-value" data-cm="{{ size_info.hip.min }}-{{ size_info.hip.max }}" data-in="{{ size_info.hip.min | divided_by: 2.54 | round: 1 }}-{{ size_info.hip.max | divided_by: 2.54 | round: 1 }}">
                    {{ size_info.hip.min }}-{{ size_info.hip.max }}
                  </span>
                {% else %}
                  -
                {% endif %}
              </td>
            {% endfor %}
          {% else %}
            <td class="p-3 border border-gray-300 text-center" data-measurement="hip">
              <span class="measurement-value" data-cm="88-96" data-in="34.6-37.8">88-96</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="hip">
              <span class="measurement-value" data-cm="96-104" data-in="37.8-40.9">96-104</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="hip">
              <span class="measurement-value" data-cm="104-112" data-in="40.9-44.1">104-112</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="hip">
              <span class="measurement-value" data-cm="112-120" data-in="44.1-47.2">112-120</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="hip">
              <span class="measurement-value" data-cm="120-128" data-in="47.2-50.4">120-128</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="hip">
              <span class="measurement-value" data-cm="128-136" data-in="50.4-53.5">128-136</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="hip">
              <span class="measurement-value" data-cm="136-144" data-in="53.5-56.7">136-144</span>
            </td>
          {% endif %}
        </tr>

        <!-- Height Row -->
        <tr>
          <td class="p-3 border border-gray-300 font-medium">HEIGHT</td>
          {% if measurements.sizes %}
            {% for size_data in measurements.sizes limit: 7 %}
              {% assign size_info = size_data[1] %}
              <td class="p-3 border border-gray-300 text-center" data-measurement="height" data-size="{{ size_data[0] }}">
                {% if size_info.height %}
                  <span class="measurement-value" data-cm="{{ size_info.height.min }}-{{ size_info.height.max }}" data-in="{{ size_info.height.min | divided_by: 2.54 | round: 1 }}-{{ size_info.height.max | divided_by: 2.54 | round: 1 }}">
                    {{ size_info.height.min }}-{{ size_info.height.max }}
                  </span>
                {% else %}
                  -
                {% endif %}
              </td>
            {% endfor %}
          {% else %}
            <td class="p-3 border border-gray-300 text-center" data-measurement="height">
              <span class="measurement-value" data-cm="170-176" data-in="66.9-69.3">170-176</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="height">
              <span class="measurement-value" data-cm="176-182" data-in="69.3-71.7">176-182</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="height">
              <span class="measurement-value" data-cm="182-188" data-in="71.7-74.0">182-188</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="height">
              <span class="measurement-value" data-cm="188-194" data-in="74.0-76.4">188-194</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="height">
              <span class="measurement-value" data-cm="188-194" data-in="74.0-76.4">188-194</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="height">
              <span class="measurement-value" data-cm="188-194" data-in="74.0-76.4">188-194</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="height">
              <span class="measurement-value" data-cm="194-198" data-in="76.4-77.9">194-198</span>
            </td>
          {% endif %}
        </tr>

        <!-- Inseam Length Row -->
        <tr>
          <td class="p-3 border border-gray-300 font-medium">INSEAM LENGTH</td>
          {% if measurements.sizes %}
            {% for size_data in measurements.sizes limit: 7 %}
              {% assign size_info = size_data[1] %}
              <td class="p-3 border border-gray-300 text-center" data-measurement="inseam" data-size="{{ size_data[0] }}">
                {% if size_info.inseam_length %}
                  <span class="measurement-value" data-cm="{{ size_info.inseam_length.min }}-{{ size_info.inseam_length.max }}" data-in="{{ size_info.inseam_length.min | divided_by: 2.54 | round: 1 }}-{{ size_info.inseam_length.max | divided_by: 2.54 | round: 1 }}">
                    {{ size_info.inseam_length.min }}-{{ size_info.inseam_length.max }}
                  </span>
                {% else %}
                  -
                {% endif %}
              </td>
            {% endfor %}
          {% else %}
            <td class="p-3 border border-gray-300 text-center" data-measurement="inseam">
              <span class="measurement-value" data-cm="79-80" data-in="31.1-31.5">79-80</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="inseam">
              <span class="measurement-value" data-cm="81-82" data-in="31.9-32.3">81-82</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="inseam">
              <span class="measurement-value" data-cm="83-84" data-in="32.7-33.1">83-84</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="inseam">
              <span class="measurement-value" data-cm="85-86" data-in="33.5-33.9">85-86</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="inseam">
              <span class="measurement-value" data-cm="87-88" data-in="34.3-34.6">87-88</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="inseam">
              <span class="measurement-value" data-cm="89" data-in="35.0">89</span>
            </td>
            <td class="p-3 border border-gray-300 text-center" data-measurement="inseam">
              <span class="measurement-value" data-cm="89" data-in="35.0">89</span>
            </td>
          {% endif %}
        </tr>
      </tbody>
    </table>
  </div>

  <!-- How to Measure Section -->
  <div class="measurement-guide-section mt-8">
    <h3 class="text-lg font-bold mb-6">How to Measure your Body?</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div><strong>CHEST:</strong> Measure around the fullest part of your chest</div>
      <div><strong>WAIST:</strong> Measure around your natural waistline</div>
      <div><strong>HIP:</strong> Measure around the fullest part of your hips</div>
      <div><strong>HEIGHT:</strong> Measure from head to floor without shoes</div>
    </div>
  </div>
</div>
