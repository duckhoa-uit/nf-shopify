{% comment %}
  Account Settings tab content

  Accepts:
  - No specific parameters
{% endcomment %}

<div id="account-settings" class="tab-content" role="tabpanel">
  <h2 class="section-title">{{ 'customer.account.settings' | t }}</h2>

  <div class="form-section">
    <h3 class="form-section-title">{{ 'customer.account.account_settings' | t }}</h3>

    <div class="form-group">
      <p>{{ 'customer.account.settings_description' | t }}</p>
    </div>

    <div class="form-actions">
      <button type="button" class="btn btn-primary" id="DeleteAccountBtn">
        <span class="btn-text">{{ 'customer.account.delete_account' | t }}</span>
        <span class="btn-spinner" style="display: none;">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 818-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 714 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</div>
