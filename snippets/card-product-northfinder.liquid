{% comment %}
  Renders a product card in the Northfinder style

  Accepts:
  - card_product: {Object} Product Liquid object (required)
  - section_id: {String} The ID of the section that contains this card (required)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)

  Usage:
  {% render 'card-product-northfinder', card_product: product, section_id: section.id %}
{% endcomment %}

{%- if card_product and card_product != empty -%}
  <div class="card-wrapper h-full">
    <div class="flex flex-col h-full relative">
      <div class="flex items-center gap-2 mb-1.5 h-8">
        {%- if card_product.tags contains 'new' or card_product.tags contains 'new' -%}
          <div class="bg-background border border-[#CCCCCC] text-[#4D4D4D] font-medium px-2 py-1.5 rounded-3 text-sm uppercase">
            New
          </div>
        {%- endif -%}

        {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
          <div class="bg-accent text-background font-medium px-2 py-1.5 rounded-3 text-sm">
            {%- assign savings = card_product.compare_at_price
              | minus: card_product.price
              | times: 100
              | divided_by: card_product.compare_at_price
              | round
            -%}
            -{{ savings }}%
          </div>
        {%- endif -%}
      </div>

      {%- if card_product.featured_media -%}
        <div class="relative overflow-hidden mb-3">
          <a href="{{ card_product.url }}" class="card-product-northfinder__link">
            <img
              srcset="
                {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
              "
              src="{{ card_product.featured_media | image_url: width: 533 }}"
              sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
              alt="{{ card_product.featured_media.alt | escape }}"
              class="w-full h-auto object-cover aspect-square transition-transform duration-500 ease-in-out hover:scale-105"
              {% unless lazy_load == false %}
                loading="lazy"
              {% endunless %}
              width="{{ card_product.featured_media.width }}"
              height="{{ card_product.featured_media.height }}"
            >
          </a>

          <button
            type="button"
            class="absolute top-[0.625rem] right-[0.625rem] z-20 bg-[#F5F5F5] size-10 rounded-full flex items-center justify-center"
            aria-label="Add to wishlist"
          >
            <span class="svg-wrapper size-5">{{ 'icon-heart.svg' | inline_asset_content }}</span>
          </button>
        </div>

        {%- if card_product.has_only_default_variant == false or card_product.variants.size > 1 -%}
          <div class="grid mb-0 grid-cols-5 h-[3.75rem] w-fit gap-0.5">
            {%- for variant in card_product.variants limit: 6 -%}
              {%- if variant.featured_media -%}
                <a
                  href="{{ card_product.url }}?variant={{ variant.id }}"
                  class="size-[3.75rem] overflow-hidden bg-background flex items-center justify-center transition-colors"
                >
                  <img
                    src="{{ variant.featured_media | image_url: width: 50 }}"
                    alt="{{ variant.title }}"
                    width="60"
                    height="60"
                    loading="lazy"
                    class="size-[3.75rem] object-cover"
                  >
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="flex flex-col gap-1 pt-3">
        <a href="{{ card_product.url }}" class="card-product-northfinder__title-link">
          <h3 class="text-base font-semibold leading-[1.625rem] text-[#0F0F0F]">{{ card_product.title | escape }}</h3>
        </a>

        <div class="flex gap-2 items-center mt-1 text-sm font-semibold leading-7">
          {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
            <span class="line-through text-[#666666]">{{ card_product.compare_at_price | money }}</span>
            <span class="text-accent">{{ card_product.price | money }}</span>
          {%- else -%}
            <span class="text-foreground">{{ card_product.price | money }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper product-card-northfinder">
    <div class="card-product-northfinder relative">
      <div class="card-product-northfinder__media">
        {{ 'product-apparel-2' | placeholder_svg_tag: 'card-product-northfinder__image placeholder-svg' }}
      </div>
      <div class="card-product-northfinder__content">
        <h3 class="card-product-northfinder__title">{{ 'onboarding.product_title' | t }}</h3>
        <div class="card-product-northfinder__type">Product Type</div>
        <div class="card-product-northfinder__price">
          <span class="card-product-northfinder__price-regular">$29.99</span>
        </div>
        <div class="card-product-northfinder__availability">In Stock</div>
      </div>
    </div>
  </div>
{%- endif -%}
