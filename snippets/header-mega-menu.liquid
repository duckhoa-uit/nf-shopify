{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Add click event listeners to all mega menu summary elements
    document.querySelectorAll('.mega-menu summary').forEach(function (summary) {
      summary.addEventListener('click', function (event) {
        // Find the anchor tag inside the summary
        const anchor = this.querySelector('a');
        if (anchor && event.target === anchor) {
          // If the anchor was clicked directly, navigate to its href
          window.location.href = anchor.getAttribute('href');
          // Prevent the details from toggling
          event.preventDefault();
        }
      });
    });
  });
</script>
<nav class="header__inline-menu mt-0 px-0 h-full lg:flex lg:items-center lg:justify-center">
  <ul class="list-menu list-menu--inline h-full" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu h-full">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset group transition-colors p-3 text-[0.9375rem] h-full"
              >
                <a
                  href="{{ link.url | default: '#' }}"
                  class="{% if link.child_active %} header__active-menu-item{% endif %} group-hover:text-accent font-semibold text-foreground uppercase inline-block w-full h-full leading-7"
                >
                  {{- link.title | escape -}}
                </a>
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient global-settings-popup border-0 shadow-[0_20px_40px_#e2e2e2] overflow-hidden"
                tabindex="-1"
              >
                <ul
                  class="mega-menu__list page-width"
                  role="list"
                >
                  <li class="border-r border-[#E0DFDF]"></li>
                  {% if link.levels == 1 %}
                    <li>
                      {%- if link.links != blank -%}
                        <ul class="list-unstyled flex flex-col gap-y-3 items-start" role="list">
                          {%- for childlink in link.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ link.handle }}-{{ childlink.handle }}"
                                href="{{ childlink.url }}"
                                class="mega-menu__link link{% if childlink.current %} mega-menu__link--active{% endif %} text-lg leading-[1.25rem] p-0 hover:text-accent transition-colors text-[#3D3D3D] tracking-normal"
                                {% if childlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ childlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {% else %}
                    {%- for childlink in link.links -%}
                      <li class="flex flex-col gap-6 border-r border-[#E0DFDF] last:border-0">
                        {%- if childlink.links == blank and childlink.url != blank -%}
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            href="{{ childlink.url }}"
                            class="text-base font-bold leading-[1.3125rem] text-black hover:text-accent transition-colors"
                            {% if childlink.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ childlink.title | escape }}
                          </a>
                        {%- else -%}
                          <span
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            class="text-base font-bold leading-[1.3125rem] cursor-default text-black"
                            {% if childlink.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ childlink.title | escape }}
                          </span>
                        {%- endif -%}
                        {%- if childlink.links != blank -%}
                          <ul class="list-unstyled flex flex-col gap-y-3 items-start" role="list">
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a
                                  id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                  href="{{ grandchildlink.url }}"
                                  class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %} text-lg leading-[1.25rem] p-0 hover:text-accent transition-colors text-[#3D3D3D] tracking-normal"
                                  {% if grandchildlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  {% endif %}
                </ul>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset hover:text-accent transition-colors text-sm p-3 h-full"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              class="{% if link.current %} header__active-menu-item{% endif %} hover:text-accent transition-colors font-semibold text-foreground uppercase"
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
