{% comment %}
  Unified Button Component with Consistent Loading State

  Accepts:
  - text: {String} Button text (required)
  - type: {String} Button type (button, submit, reset) - default: button
  - class: {String} Additional CSS classes
  - variant: {String} Button variant (primary, secondary, tertiary, small) - default: primary
  - disabled: {Boolean} Whether button is disabled
  - id: {String} Button ID
  - name: {String} Button name attribute
  - value: {String} Button value attribute
  - data_attributes: {String} Additional data attributes
  - loading: {Boolean} Whether button needs loading state (default: true)
  - full_width: {Boolean} Whether button should be full width

  Usage:
  {% render 'unified-button',
    text: 'Add to Cart',
    type: 'submit',
    variant: 'primary',
    loading: true
  %}
{% endcomment %}

{%- liquid
  assign button_type = type | default: 'button'
  assign button_variant = variant | default: 'primary'
  assign button_classes = 'button'
  assign needs_loading = loading | default: true

  case button_variant
    when 'secondary'
      assign button_classes = button_classes | append: ' button--secondary'
    when 'tertiary'
      assign button_classes = button_classes | append: ' button--tertiary'
    when 'small'
      assign button_classes = button_classes | append: ' button--small'
  endcase

  if full_width
    assign button_classes = button_classes | append: ' button--full-width'
  endif

  if class
    assign button_classes = button_classes | append: ' ' | append: class
  endif
-%}

<button
  type="{{ button_type }}"
  class="{{ button_classes }}"
  {% if disabled %}disabled{% endif %}
  {% if id %}id="{{ id }}"{% endif %}
  {% if name %}name="{{ name }}"{% endif %}
  {% if value %}value="{{ value }}"{% endif %}
  {% if data_attributes %}{{ data_attributes }}{% endif %}
>
  <span class="button-text">{{ text }}</span>
  {%- if needs_loading -%}
    <span class="button-spinner" style="display: none;">
      {{- 'loading-spinner.svg' | inline_asset_content -}}
    </span>
  {%- endif -%}
</button>
