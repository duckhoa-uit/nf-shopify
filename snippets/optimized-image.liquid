{%- comment -%}
  Optimized Image Snippet for Performance

  Usage:
  {% render 'optimized-image',
     image: image_object,
     sizes: '(min-width: 750px) 50vw, 100vw',
     loading: 'lazy',
     class: 'custom-class',
     alt: 'Alt text' %}
{%- endcomment -%}

{%- liquid
  assign loading_strategy = loading | default: 'lazy'
  assign image_class = class | default: ''
  assign image_alt = alt | default: image.alt | escape
  assign image_sizes = sizes | default: '100vw'

  # Determine if this is above the fold (should be eager loaded)
  if loading_strategy == 'eager' or loading_strategy == 'auto'
    assign loading_attr = 'eager'
  else
    assign loading_attr = 'lazy'
  endif

  # Generate responsive widths
  assign widths = '375,550,750,1100,1500,1780,2000,3000,3840' | split: ','
-%}

{%- if image -%}
  <picture class="{{ image_class }}">
    {%- comment -%} WebP source for modern browsers {%- endcomment -%}
    <source
      type="image/webp"
      srcset="{%- for width in widths -%}{{ image | image_url: width: width, format: 'webp' }} {{ width }}w{%- unless forloop.last -%}, {%- endunless -%}{%- endfor -%}"
      sizes="{{ image_sizes }}"
    >

    {%- comment -%} Fallback for browsers that don't support WebP {%- endcomment -%}
    <img
      src="{{ image | image_url: width: 1100 }}"
      srcset="{%- for width in widths -%}{{ image | image_url: width: width }} {{ width }}w{%- unless forloop.last -%}, {%- endunless -%}{%- endfor -%}"
      sizes="{{ image_sizes }}"
      alt="{{ image_alt }}"
      loading="{{ loading_attr }}"
      decoding="async"
      width="{{ image.width }}"
      height="{{ image.height }}"
      class="{{ image_class }}"
      {%- if loading_attr == 'eager' -%}
        fetchpriority="high"
      {%- endif -%}
    >
  </picture>
{%- else -%}
  {%- comment -%} Placeholder when no image is provided {%- endcomment -%}
  <div
    class="placeholder-image {{ image_class }}"
    role="img"
    aria-label="{{ image_alt | default: 'Placeholder image' }}"
  >
    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
  </div>
{%- endif -%}
