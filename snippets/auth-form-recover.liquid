{% comment %}
  Password recovery form. Rendered inside auth-modal and as the /account/recover template.

  Accepts:
    none

  Usage:
    {% render 'auth-form-recover' %}
{% endcomment %}

<p class="auth-modal__lede">
  {{ 'customer.recover_password.subtext' | t }}
</p>

<div id="recover-messages" class="auth-modal__messages" aria-live="polite">
  {% if form.errors %}
    <div class="auth-modal__error">
      {{ form.errors | default_errors }}
    </div>
  {% elsif form.posted_successfully? %}
    <div class="auth-modal__success">
      {{ 'customer.recover_password.success' | t }}
    </div>
  {% endif %}
</div>

{% form 'recover_customer_password', return_to: routes.account_login_url, id: 'customer_recover_form', class: 'auth-modal__form' %}
  <div class="field">
    <input
      type="email"
      name="email"
      id="recover_email"
      required
      placeholder=" "
      autocomplete="email"
      {% if form.errors contains 'email' %}
        aria-invalid="true"
      {% endif %}
      value="{{ form.email }}"
    >
    <label for="recover_email">{{ 'customer.login_page.email' | t }}</label>
  </div>

  <button type="submit" class="button auth-modal__submit">
    {{ 'customer.recover_password.submit' | t }}
  </button>

  <p class="auth-modal__forgot auth-modal__forgot--center">
    <a
      href="{{ routes.account_login_url }}"
      class="auth-modal__link"
      data-auth-switch="login"
    >
      {{- 'customer.recover_password.cancel' | t -}}
    </a>
  </p>
{% endform %}
