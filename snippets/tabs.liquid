{% comment %}
  tabs.liquid - Reusable tabs component

  Usage:
  {% render 'tabs', tabs: tabs_array %}

  Where tabs_array is an array of objects with:
  - id: unique tab identifier
  - title: tab title text
  - content: tab content (liquid/html)
  - active: boolean (optional, first tab is active by default)

  Example:
  {% assign tabs_array = array %}

  {% capture login_content %}
    {% form 'customer_login' %}
      <!-- form fields -->
    {% endform %}
  {% endcapture %}

  {% capture register_content %}
    {% form 'create_customer' %}
      <!-- form fields -->
    {% endform %}
  {% endcapture %}

  {% assign login_tab = hash %}
  {% assign login_tab['id'] = 'login' %}
  {% assign login_tab['title'] = 'PRIHLÁSENIE' %}
  {% assign login_tab['content'] = login_content %}
  {% assign login_tab['active'] = true %}
  {% assign tabs_array = tabs_array | push: login_tab %}

  {% assign register_tab = hash %}
  {% assign register_tab['id'] = 'register' %}
  {% assign register_tab['title'] = 'REGISTRÁCIA' %}
  {% assign register_tab['content'] = register_content %}
  {% assign tabs_array = tabs_array | push: register_tab %}

  {% render 'tabs', tabs: tabs_array, tabs_id: 'account_tabs' %}
{% endcomment %}

{%- liquid
  # Set unique identifier for this tabs instance
  assign tabs_id = tabs_id | default: 'tabs_' | append: 'now' | date: '%s'

  # Find the active tab (first one by default)
  assign active_tab = null
  for tab in tabs
    if tab.active
      assign active_tab = tab.id
      break
    endif
  endfor

  if active_tab == null and tabs.size > 0
    assign active_tab = tabs[0].id
  endif
-%}

<div class="w-full max-w-md mx-auto p-6">
  {%- comment -%} Tabs Header {%- endcomment -%}
  <div class="flex mb-8" id="{{ tabs_id }}_header">
    {%- for tab in tabs -%}
      <button
        data-tab="{{ tab.id }}"
        data-tabs-group="{{ tabs_id }}"
        class="tabs-button flex-1 text-lg font-medium pb-2 border-b-2 transition-colors {% if tab.id == active_tab %}border-black text-black{% else %}border-transparent text-gray-500 hover:text-gray-700{% endif %}"
      >
        {{ tab.title }}
      </button>
    {%- endfor -%}
  </div>

  {%- comment -%} Tab Contents {%- endcomment -%}
  {%- for tab in tabs -%}
    <div
      id="{{ tabs_id }}_{{ tab.id }}"
      class="tabs-content {% if tab.id != active_tab %}hidden{% endif %}"
      data-tabs-group="{{ tabs_id }}"
    >
      {{ tab.content }}
    </div>
  {%- endfor -%}
</div>

{% unless tabs_js_loaded %}
  {%- comment -%} Load JS only once per page {%- endcomment -%}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function setupTabs() {
        const tabButtons = document.querySelectorAll('.tabs-button');

        tabButtons.forEach((button) => {
          button.addEventListener('click', function () {
            const tabId = this.getAttribute('data-tab');
            const tabsGroup = this.getAttribute('data-tabs-group');

            // Deactivate all tabs in this group
            document.querySelectorAll(`.tabs-button[data-tabs-group="${tabsGroup}"]`).forEach((tab) => {
              tab.classList.remove('border-black', 'text-black');
              tab.classList.add('border-transparent', 'text-gray-500');
            });

            // Activate clicked tab
            this.classList.add('border-black', 'text-black');
            this.classList.remove('border-transparent', 'text-gray-500');

            // Hide all content in this group
            document.querySelectorAll(`.tabs-content[data-tabs-group="${tabsGroup}"]`).forEach((content) => {
              content.classList.add('hidden');
            });

            // Show selected content
            document.getElementById(`${tabsGroup}_${tabId}`).classList.remove('hidden');
          });
        });
      }

      // Setup tabs on page load
      setupTabs();

      // Re-setup tabs after Shopify section loads/changes (for editor support)
      if (Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', setupTabs);
        document.addEventListener('shopify:section:select', setupTabs);
      }
    });
  </script>
  {% assign tabs_js_loaded = true %}
{% endunless %}
