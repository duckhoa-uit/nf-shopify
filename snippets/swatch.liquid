{% comment %}
  Renders a swatch.
  Accepts:
  - swatch: {SwatchDrop} the swatch drop
  - shape: {String} swatch shape. Accepts 'square', defaults to circle (optional)
  - thumbnail_url: {String} URL for the thumbnail image (optional)
  Usage:
   {% render 'swatch', swatch: swatch, shape: 'circle', thumbnail_url: thumbnail_url %}
{% endcomment %}

{%- liquid
  assign swatch_style = ''
  if swatch.image
    assign swatch_style = swatch_style | append: '--swatch-focal-point:' | append: swatch.image.presentation.focal_point | append: ';'
    assign swatch_style = swatch_style | append: '--swatch--background:' | append: 'url(' | append: swatch.image | image_url: width: 50 | append: ');'
  elsif swatch.color
    assign swatch_style = swatch_style | append: '--swatch--background:rgb(' | append: swatch.color.rgb | append: ');'
  endif
-%}

<span
  class="swatch{% if shape == 'square' %} swatch--square{% endif %}{% unless swatch and swatch.value %} swatch--unavailable{% endunless %}"
  style="{{ swatch_style }}"
>
  {%- if thumbnail_url != blank -%}
    <img src="{{ thumbnail_url }}" alt="" class="swatch-thumbnail" width="50" height="50" loading="lazy">
  {%- endif -%}
</span>
