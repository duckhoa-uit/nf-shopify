{% comment %}
  Renders a product card in the Northfinder style

  Accepts:
  - card_product: {Object} Product Liquid object (required)
  - section_id: {String} The ID of the section that contains this card (required)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)

  Usage:
  {% render 'card-product', card_product: product, section_id: section.id %}
{% endcomment %}

{%- if card_product and card_product != empty -%}
  <div class="card-wrapper h-full">
    <div class="flex flex-col h-full relative">
      <div class="flex items-center gap-2 mb-1.5 h-8">
        {%- if card_product.tags contains 'new' or card_product.tags contains 'new' -%}
          <div class="bg-background border border-[#CCCCCC] text-[#4D4D4D] font-medium px-2 py-1.5 rounded-3 text-sm uppercase">
            New
          </div>
        {%- endif -%}

        {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
          {%- assign savings = card_product.compare_at_price
            | minus: card_product.price
            | times: 100
            | divided_by: card_product.compare_at_price
            | round
          -%}
          <div class="bg-[#EC0009] text-white font-bold px-2 py-1 rounded-[2px] text-[15px] leading-[16px]">
            {%- if savings >= 15 -%}
              -{{ savings }}%
            {%- else -%}
              SALE
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if card_product.media.size > 0 -%}
        {%- comment -%} Find the first model image for the product {%- endcomment -%}
        {%- assign model_image = null -%}
        {%- assign main_image = null -%}
        {%- assign lowest_sequence = 999 -%}
        {%- assign found_model_image = false -%}

        {%- comment -%} First look for model images without sequence (just -M) {%- endcomment -%}
        {%- for media in card_product.media -%}
          {%- assign media_src = media.src | default: '' -%}
          {%- assign parsed_url = media_src | split: '/' | last -%}

          {%- comment -%} Find main image (with -H suffix) for hover effect {%- endcomment -%}
          {%- if parsed_url contains '-H' or parsed_url contains '-H.' -%}
            {%- assign main_image = media -%}
          {%- endif -%}

          {%- if parsed_url contains '-M' -%}
            {%- unless parsed_url contains '-M_' -%}
              {%- assign model_image = media -%}
              {%- assign found_model_image = true -%}
              {%- break -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} If no model image without sequence found, look for one with lowest sequence {%- endcomment -%}
        {%- unless found_model_image -%}
          {%- assign best_model_media = null -%}
          {%- for media in card_product.media -%}
            {%- assign media_src = media.src | default: '' -%}
            {%- assign parsed_url = media_src | split: '/' | last -%}
            {%- if parsed_url contains '-M_' -%}
              {%- assign sequence_part = parsed_url | split: '-M_' | last | split: '.' | first -%}
              {%- assign sequence_number = sequence_part | plus: 0 -%}

              {%- comment -%} Only update if this sequence is lower than current lowest {%- endcomment -%}
              {%- if sequence_number > 0 and sequence_number < lowest_sequence -%}
                {%- assign lowest_sequence = sequence_number -%}
                {%- assign best_model_media = media -%}
                {%- assign found_model_image = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Set the model image from the best model media found {%- endcomment -%}
          {%- if best_model_media -%}
            {%- assign model_image = best_model_media -%}
          {%- endif -%}
        {%- endunless -%}

        {%- comment -%} If still no model image found, try other image types in priority order {%- endcomment -%}
        {%- unless found_model_image -%}
          {%- comment -%} Define image type priority for fallback {%- endcomment -%}
          {%- assign image_types = 'H,B,BV,D' | split: ',' -%}

          {%- comment -%} Try each image type in priority order {%- endcomment -%}
          {%- for type in image_types -%}
            {%- if model_image == null -%}
              {%- for media in card_product.media -%}
                {%- assign media_src = media.src | default: '' -%}
                {%- assign parsed_url = media_src | split: '/' | last -%}

                {%- comment -%} Check if the image contains the current image type {%- endcomment -%}
                {%- assign type_code = '-' | append: type -%}
                {%- if parsed_url contains type_code -%}
                  {%- assign model_image = media -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        {%- comment -%} Fallback to featured_media if no model image found {%- endcomment -%}
        {%- unless model_image -%}
          {%- assign model_image = card_product.featured_media -%}
        {%- endunless -%}

        {%- comment -%} If no main image found, try to find alternative model images for hover effect {%- endcomment -%}
        {%- unless main_image -%}
          {%- comment -%} Look for model images with sequence numbers (-M_2, -M_3, etc.) {%- endcomment -%}
          {%- assign alternative_main_image = null -%}
          {%- assign lowest_sequence = 999 -%}

          {%- for media in card_product.media -%}
            {%- assign media_src = media.src | default: '' -%}
            {%- assign parsed_url = media_src | split: '/' | last -%}

            {%- comment -%} Look for model images with sequence that are different from current model image {%- endcomment -%}
            {%- if parsed_url contains '-M_' and media.id != model_image.id -%}
              {%- assign sequence_part = parsed_url | split: '-M_' | last | split: '.' | first -%}
              {%- assign sequence_number = sequence_part | plus: 0 -%}

              {%- comment -%} Find the lowest sequence number for consistent behavior {%- endcomment -%}
              {%- if sequence_number > 0 and sequence_number < lowest_sequence -%}
                {%- assign lowest_sequence = sequence_number -%}
                {%- assign alternative_main_image = media -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Use alternative model image if found, otherwise fallback to current model image {%- endcomment -%}
          {%- if alternative_main_image -%}
            {%- assign main_image = alternative_main_image -%}
          {%- else -%}
            {%- assign main_image = model_image -%}
          {%- endif -%}
        {%- endunless -%}

        {%- comment -%} Check if we found a real main image (different from model image) {%- endcomment -%}
        {%- assign has_real_main_image = false -%}
        {%- if main_image and main_image.id != model_image.id -%}
          {%- assign has_real_main_image = true -%}
        {%- endif -%}

        <div class="relative overflow-hidden mb-3">
          <a
            href="{{ card_product.url }}"
            class="card-product-northfinder__link"
            data-product-id="{{ card_product.id }}"
            data-main-image-src="{{ main_image | image_url: width: 400 }}"
            data-main-image-srcset="{%- if main_image.width >= 200 -%}{{ main_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if main_image.width >= 300 -%}{{ main_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if main_image.width >= 400 -%}{{ main_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if main_image.width >= 500 -%}{{ main_image | image_url: width: 500 }} 500w{%- endif -%}"
            data-has-real-main-image="{{ has_real_main_image }}"
          >
            <div
              id="main-image-{{ card_product.id }}"
              data-original-src="{{ model_image | image_url: width: 400 }}"
              data-original-srcset="{%- if model_image.width >= 200 -%}{{ model_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if model_image.width >= 300 -%}{{ model_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if model_image.width >= 400 -%}{{ model_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if model_image.width >= 500 -%}{{ model_image | image_url: width: 500 }} 500w{%- endif -%}"
            >
              <img
                src="{{ model_image | image_url: width: 400 }}"
                srcset="{%- if model_image.width >= 200 -%}{{ model_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if model_image.width >= 300 -%}{{ model_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if model_image.width >= 400 -%}{{ model_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if model_image.width >= 500 -%}{{ model_image | image_url: width: 500 }} 500w{%- endif -%}"
                sizes="(min-width: 990px) calc(33.33vw - 2rem), (min-width: 750px) calc(50vw - 1.5rem), calc(50vw - 1rem)"
                alt="{{ model_image.alt | escape }}"
                loading="lazy"
                decoding="async"
                width="{{ model_image.width }}"
                height="{{ model_image.height }}"
                class="w-full h-auto object-cover aspect-square transition-opacity duration-300 ease-in-out"
              >
            </div>
          </a>
        </div>

      {%- else -%}
        {%- comment -%} Product has no media - show placeholder with consistent dimensions {%- endcomment -%}
        <div class="relative overflow-hidden mb-3">
          <a
            href="{{ card_product.url }}"
            class="card-product-northfinder__link block"
            data-product-id="{{ card_product.id }}"
          >
            <div class="w-full aspect-square bg-gray-100 flex items-center justify-center">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'w-full h-full text-gray-400 max-w-[60%] max-h-[60%]' }}
            </div>
          </a>
        </div>
      {%- endif -%}

      {%- comment -%} Show variants regardless of whether product has media or not {%- endcomment -%}
      {%- if card_product.has_only_default_variant == false or card_product.variants.size > 1 -%}
        {%- comment -%} Group variants by color (option1) {%- endcomment -%}
        {%- assign unique_colors = '' -%}

        {%- for variant in card_product.variants -%}
          {%- assign color = variant.option1 -%}
          {%- unless unique_colors contains color -%}
            {%- assign unique_colors = unique_colors | append: ',' | append: color -%}
          {%- endunless -%}
        {%- endfor -%}

        {%- assign unique_colors = unique_colors | remove_first: ',' | split: ',' -%}

        {%- comment -%} Sort unique_colors by position from metafields.custom.color.value {%- endcomment -%}
        {%- if card_product.metafields.custom.color.value != blank -%}
          {%- assign color_positions = '' -%}

          {%- for color in unique_colors -%}
            {%- assign position = 999 -%}
            {%- assign color_downcase = color | downcase | strip -%}

            {%- for color_item in card_product.metafields.custom.color.value -%}
              {%- if color_item.name == color_downcase -%}
                {%- assign position = color_item.position -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- assign position_str = position | prepend: '00000' | slice: -5, 5 -%}
            {%- assign color_positions = color_positions
              | append: position_str
              | append: ':'
              | append: color
              | append: ','
            -%}
          {%- endfor -%}

          {%- assign sorted_positions = color_positions | split: ',' | sort -%}
          {%- assign sorted_colors = '' -%}

          {%- for position_color in sorted_positions -%}
            {%- if position_color != blank -%}
              {%- assign parts = position_color | split: ':' -%}
              {%- if parts.size > 1 -%}
                {%- assign sorted_colors = sorted_colors | append: ',' | append: parts[1] -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign unique_colors = sorted_colors | remove_first: ',' | split: ',' -%}
        {%- endif -%}

        {%- assign colors_count = unique_colors.size -%}
        {%- assign display_count = colors_count -%}
        {%- assign remaining_count = 0 -%}

        {%- if colors_count > 5 -%}
          {%- assign display_count = 4 -%}
          {%- assign remaining_count = colors_count | minus: display_count -%}
        {%- endif -%}

        <div class="grid mb-0 grid-cols-5 w-fit gap-0.5">
          {%- for color in unique_colors limit: display_count -%}
            {%- comment -%} Find first variant with this color {%- endcomment -%}
            {%- assign color_variant = null -%}
            {%- for variant in card_product.variants -%}
              {%- if variant.option1 == color -%}
                {%- assign color_variant = variant -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if color_variant -%}
              {%- assign variant_image = null -%}
              {%- assign color_value = color
                | downcase
                | strip
                | replace: ' ', '-'
                | replace: "'", ''
                | replace: '.', ''
                | replace: ',', ''
              -%}
              {%- assign reference_id = '' -%}

              {%- comment -%} Find the reference_id for this color from metafields {%- endcomment -%}
              {%- if card_product.metafields.custom.color.value != blank -%}
                {%- for color_item in card_product.metafields.custom.color.value -%}
                  {%- if color_item.name == color_value -%}
                    {%- assign reference_id = color_item.reference_id -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {%- comment -%} Try to find a model image for this color using reference_id (only if product has media) {%- endcomment -%}
              {%- if reference_id != '' and card_product.media.size > 0 -%}
                {%- assign lowest_sequence = 999 -%}
                {%- assign found_model_image = false -%}

                {%- comment -%} First look for model images without sequence (just -M) {%- endcomment -%}
                {%- for media in card_product.media -%}
                  {%- assign media_src = media.src | default: '' -%}
                  {%- assign parsed_url = media_src | split: '/' | last -%}

                  {%- if parsed_url contains reference_id -%}
                    {%- if parsed_url contains '-M' -%}
                      {%- unless parsed_url contains '-M_' -%}
                        {%- assign variant_image = media -%}
                        {%- assign found_model_image = true -%}
                        {%- break -%}
                      {%- endunless -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- comment -%} If no model image without sequence found, look for one with lowest sequence {%- endcomment -%}
                {%- unless found_model_image -%}
                  {%- assign best_variant_media = null -%}
                  {%- for media in card_product.media -%}
                    {%- assign media_src = media.src | default: '' -%}
                    {%- assign parsed_url = media_src | split: '/' | last -%}
                    {%- if parsed_url contains reference_id and parsed_url contains '-M_' -%}
                      {%- assign sequence_part = parsed_url | split: '-M_' | last | split: '.' | first -%}
                      {%- assign sequence_number = sequence_part | plus: 0 -%}

                      {%- comment -%} Only update if this sequence is lower than current lowest {%- endcomment -%}
                      {%- if sequence_number > 0 and sequence_number < lowest_sequence -%}
                        {%- assign lowest_sequence = sequence_number -%}
                        {%- assign best_variant_media = media -%}
                        {%- assign found_model_image = true -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- comment -%} Set the variant image from the best variant media found {%- endcomment -%}
                  {%- if best_variant_media -%}
                    {%- assign variant_image = best_variant_media -%}
                  {%- endif -%}
                {%- endunless -%}

                {%- comment -%} If still no model image found, try other image types in priority order {%- endcomment -%}
                {%- unless found_model_image -%}
                  {%- comment -%} Define image type priority for fallback {%- endcomment -%}
                  {%- assign image_types = 'H,B,BV,D' | split: ',' -%}

                  {%- comment -%} Try each image type in priority order {%- endcomment -%}
                  {%- for type in image_types -%}
                    {%- if variant_image == null -%}
                      {%- for media in card_product.media -%}
                        {%- assign media_src = media.src | default: '' -%}
                        {%- assign parsed_url = media_src | split: '/' | last -%}

                        {%- comment -%} Check if the image contains both the reference_id and the current image type {%- endcomment -%}
                        {%- assign type_code = '-' | append: type -%}
                        {%- if parsed_url contains reference_id and parsed_url contains type_code -%}
                          {%- assign variant_image = media -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endunless -%}
              {%- endif -%}

              {%- comment -%} Try to find matching image in variant.featured_image if no model image found and product has media {%- endcomment -%}
              {%- unless variant_image -%}
                {%- if color_variant.featured_image -%}
                  {%- assign variant_image = color_variant.featured_image -%}
                {%- elsif card_product.media.size > 0 -%}
                  {%- comment -%} Try to find matching image in product.media or product.images {%- endcomment -%}
                  {%- for media in card_product.media -%}
                    {%- assign media_src = media.src | default: '' -%}
                    {%- assign parsed_url = media_src | split: '/' | last -%}

                    {%- comment -%} Try to match by color name in the URL {%- endcomment -%}
                    {%- if parsed_url contains color_value -%}
                      {%- assign variant_image = media -%}
                      {%- break -%}
                    {%- endif -%}

                    {%- comment -%} Try to match by alt text {%- endcomment -%}
                    {%- if media.alt contains color or media.alt contains color_variant.title -%}
                      {%- assign variant_image = media -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- unless variant_image -%}
                    {%- for image in card_product.images -%}
                      {%- if image.alt contains color or image.alt contains color_variant.title -%}
                        {%- assign variant_image = image -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endunless -%}

                  {%- comment -%} Final fallback to featured_image (only if product has media) {%- endcomment -%}
                  {%- unless variant_image -%}
                    {%- assign variant_image = card_product.featured_media -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endunless -%}

              <a
                href="{{ card_product.url }}?variant={{ color_variant.id }}"
                class="size-9 xl:size-[3.75rem] overflow-hidden bg-background flex items-center justify-center transition-colors variant-swatch"
                data-variant-id="{{ color_variant.id }}"
                data-product-id="{{ card_product.id }}"
                {%- if variant_image -%}
                  data-variant-image="{{ variant_image | image_url: width: 120 }}"
                  data-variant-image-srcset="{%- if variant_image.width >= 200 -%}{{ variant_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if variant_image.width >= 300 -%}{{ variant_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if variant_image.width >= 400 -%}{{ variant_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if variant_image.width >= 500 -%}{{ variant_image | image_url: width: 500 }} 500w{%- endif -%}"
                {%- else -%}
                  data-variant-image="placeholder"
                  data-variant-image-srcset=""
                {%- endif -%}
                aria-label="Select {{ color_variant.title | escape }} variant"
              >
                {%- if variant_image -%}
                  <img
                    src="{{ variant_image | image_url: width: 120 }}"
                    srcset="{%- if variant_image.width >= 40 -%}{{ variant_image | image_url: width: 40 }} 40w,{%- endif -%}{%- if variant_image.width >= 60 -%}{{ variant_image | image_url: width: 60 }} 60w,{%- endif -%}{%- if variant_image.width >= 80 -%}{{ variant_image | image_url: width: 80 }} 80w,{%- endif -%}{%- if variant_image.width >= 100 -%}{{ variant_image | image_url: width: 100 }} 100w,{%- endif -%}{%- if variant_image.width >= 120 -%}{{ variant_image | image_url: width: 120 }} 120w,{%- endif -%}{{ variant_image | image_url: width: variant_image.width }} {{ variant_image.width }}w"
                    sizes="(min-width: 1280px) 60px, 36px"
                    alt="{{ color | escape }}"
                    loading="lazy"
                    decoding="async"
                    width="120"
                    height="120"
                    class="w-full h-full object-cover"
                  >
                {%- else -%}
                  {%- comment -%} Show placeholder when no variant image is available {%- endcomment -%}
                  <div class="variant-swatch-placeholder w-full h-full bg-gray-100 flex items-center justify-center">
                    {{
                      'product-apparel-2'
                      | placeholder_svg_tag: 'variant-swatch-placeholder-svg w-3/5 h-3/5 text-gray-400 opacity-70'
                    }}
                  </div>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}

          {%- if remaining_count > 0 -%}
            <a
              href="{{ card_product.url }}"
              class="size-9 xl:size-[3.75rem] rounded-full border border-[#E5E5E5] bg-white flex items-center justify-center text-center text-[#4D4D4D] font-medium"
            >
              +{{ remaining_count }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="flex flex-col gap-1 pt-3">
        <a href="{{ card_product.url }}" class="card-product-northfinder__title-link">
          <h3 class="text-base font-semibold leading-[1.625rem] text-[#0F0F0F]">{{ card_product.title | escape }}</h3>
        </a>

        <div class="flex gap-3 items-center mt-0.5">
          {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
            <span class="line-through text-[#666666] font-medium font-archivo-expanded text-base leading-6">
              {{- card_product.compare_at_price | money -}}
            </span>
            <span class="text-black font-medium font-archivo-expanded text-base leading-6">
              {{- card_product.price | money -}}
            </span>
          {%- else -%}
            <span class="text-black font-medium font-archivo-expanded text-base leading-6">
              {{- card_product.price | money -}}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper product-card-northfinder">
    <div class="card-product-northfinder relative">
      <div class="card-product-northfinder__media">
        {{ 'product-apparel-2' | placeholder_svg_tag: 'card-product-northfinder__image placeholder-svg' }}
      </div>
      <div class="card-product-northfinder__content">
        <h3 class="card-product-northfinder__title">{{ 'onboarding.product_title' | t }}</h3>
        <div class="card-product-northfinder__type">Product Type</div>
        <div class="flex gap-3 items-center mt-0.5">
          <span class="text-black font-medium font-archivo-expanded text-base leading-6">$29.99</span>
        </div>
        <div class="card-product-northfinder__availability">In Stock</div>
      </div>
    </div>
  </div>
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Image preloading and caching system
    const imageCache = new Map();
    const preloadQueue = new Set();
    let intersectionObserver;

    // Preload image function with caching
    function preloadImage(src, srcset = '') {
      if (imageCache.has(src) || preloadQueue.has(src)) {
        return imageCache.get(src) || Promise.resolve();
      }

      preloadQueue.add(src);

      const promise = new Promise((resolve, reject) => {
        const img = new Image();

        img.onload = () => {
          imageCache.set(src, img);
          preloadQueue.delete(src);
          resolve(img);
        };

        img.onerror = () => {
          preloadQueue.delete(src);
          reject(new Error(`Failed to load ${src}`));
        };

        // Set srcset first if available for responsive loading
        if (srcset) {
          img.srcset = srcset;
        }
        img.src = src;
      });

      imageCache.set(src, promise);
      return promise;
    }

    // Hover intent detection with delay
    function addHoverIntent(element, onIntent, delay = 150) {
      let hoverTimer;

      element.addEventListener('mouseenter', () => {
        hoverTimer = setTimeout(() => {
          onIntent();
        }, delay);
      });

      element.addEventListener('mouseleave', () => {
        if (hoverTimer) {
          clearTimeout(hoverTimer);
          hoverTimer = null;
        }
      });
    }

    // Setup Intersection Observer for viewport-based preloading
    if ('IntersectionObserver' in window) {
      intersectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const card = entry.target;
              const productId = card.dataset.productId;

              // Preload main hover image
              const mainImageSrc = card.dataset.mainImageSrc;
              const mainImageSrcset = card.dataset.mainImageSrcset;

              if (mainImageSrc) {
                preloadImage(mainImageSrc, mainImageSrcset).catch(() => {});
              }

              // Preload variant images
              const variantSwatches = document.querySelectorAll(`[data-product-id="${productId}"].variant-swatch`);
              variantSwatches.forEach((swatch) => {
                const variantImage = swatch.dataset.variantImage;
                const variantImageSrcset = swatch.dataset.variantImageSrcset;

                if (variantImage && variantImage !== 'placeholder') {
                  preloadImage(variantImage, variantImageSrcset).catch(() => {});
                }
              });

              // Stop observing this card after preloading
              intersectionObserver.unobserve(card);
            }
          });
        },
        {
          rootMargin: '50px', // Start preloading 50px before entering viewport
          threshold: 0.1,
        }
      );
    }

    // Find all product cards
    const productCards = document.querySelectorAll('.card-product-northfinder__link');

    // Add hover effect to product cards
    productCards.forEach((card, index) => {
      const productId = card.dataset.productId;

      if (!productId) {
        return;
      }

      // Start observing for viewport-based preloading
      if (intersectionObserver) {
        intersectionObserver.observe(card);
      }

      const mainImageContainer = document.getElementById(`main-image-${productId}`);

      if (!mainImageContainer) {
        return;
      }

      // Find img element (now using simple img tag instead of picture)
      const mainImage = mainImageContainer.querySelector('img');

      if (!mainImage) {
        return;
      }

      // Store original image data
      const originalSrc = mainImageContainer.dataset.originalSrc;
      const originalSrcset = mainImageContainer.dataset.originalSrcset;

      // Get main image data (with -H suffix) from data attributes
      const mainImageSrc = card.dataset.mainImageSrc;
      const mainImageSrcset = card.dataset.mainImageSrcset;

      // Check if this product has a real main image (different from model image)
      const hasRealMainImage = card.dataset.hasRealMainImage === 'true';

      // Add hover intent detection for preloading
      addHoverIntent(card, () => {
        // Preload main image on hover intent
        if (mainImageSrc && !imageCache.has(mainImageSrc)) {
          preloadImage(mainImageSrc, mainImageSrcset).catch(() => {});
        }
      });

      // Add hover event to show main image (only if has real main image)
      if (hasRealMainImage) {
        card.addEventListener('mouseenter', function () {
          if (mainImageSrc && mainImageSrc !== originalSrc) {
            // Check if we're already showing the target image to avoid unnecessary reloads
            const currentImageUrl = new URL(mainImage.src, window.location.origin);
            const targetImageUrl = new URL(mainImageSrc, window.location.origin);

            // Compare base URLs without query parameters to avoid flash
            const currentBase = currentImageUrl.pathname;
            const targetBase = targetImageUrl.pathname;

            if (currentBase !== targetBase) {
              // Update img element (simple approach)
              mainImage.src = mainImageSrc;
              if (mainImageSrcset) {
                mainImage.srcset = mainImageSrcset;
              }
            }
          }
        });

        card.addEventListener('mouseleave', function () {
          // Preload original image if not cached (for faster reset next time)
          if (!imageCache.has(originalSrc)) {
            preloadImage(originalSrc, originalSrcset).catch(() => {});
          }

          // Always reset to the original model image on mouseleave
          mainImage.src = originalSrc;
          mainImage.srcset = originalSrcset;
        });
      }
    });

    // Handle variant swatch hover
    const variantSwatches = document.querySelectorAll('.variant-swatch');

    variantSwatches.forEach((swatch, index) => {
      const productId = swatch.dataset.productId;
      const variantImage = swatch.dataset.variantImage;
      const variantImageSrcset = swatch.dataset.variantImageSrcset;
      const mainImageContainer = document.getElementById(`main-image-${productId}`);

      if (!mainImageContainer || !variantImage) {
        return;
      }

      // Find img element (now using simple img tag instead of picture)
      const mainImage = mainImageContainer.querySelector('img');
      if (!mainImage) {
        return;
      }

      // Store original image data
      const originalSrc = mainImageContainer.dataset.originalSrc;
      const originalSrcset = mainImageContainer.dataset.originalSrcset;

      // Add hover intent detection for variant preloading
      addHoverIntent(swatch, () => {
        if (variantImage && variantImage !== 'placeholder' && !imageCache.has(variantImage)) {
          preloadImage(variantImage, variantImageSrcset).catch(() => {});
        }
      });

      swatch.addEventListener('mouseenter', function () {
        // Check if variant has an actual image or is placeholder
        if (variantImage && variantImage !== 'placeholder') {
          // Check if we're already showing the target variant image to avoid unnecessary reloads
          const currentImageUrl = new URL(mainImage.src, window.location.origin);
          const targetImageUrl = new URL(variantImage, window.location.origin);

          // Compare base URLs without query parameters to avoid flash
          const currentBase = currentImageUrl.pathname;
          const targetBase = targetImageUrl.pathname;

          if (currentBase !== targetBase) {
            // Update img element (simple approach)
            mainImage.src = variantImage;
            mainImage.srcset = variantImageSrcset || '';
          }
        } else {
          // For placeholder variants, show a placeholder in main image
          const placeholderContainer = mainImage.closest('picture') || mainImage.parentElement;
          const existingPlaceholder = placeholderContainer.querySelector('.main-image-placeholder');

          if (!existingPlaceholder) {
            // Hide the main image and show placeholder
            mainImage.style.display = 'none';

            // Create placeholder element with proper SVG
            const placeholder = document.createElement('div');
            placeholder.className =
              'main-image-placeholder absolute inset-0 w-full h-full bg-gray-100 flex items-center justify-center';

            // Create SVG placeholder instead of using Liquid template
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('class', 'w-3/5 h-3/5 text-gray-400 opacity-70');
            svg.setAttribute('fill', 'currentColor');
            svg.setAttribute('viewBox', '0 0 20 20');
            svg.innerHTML =
              '<path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>';

            placeholder.appendChild(svg);
            placeholderContainer.appendChild(placeholder);
          }
        }
      });

      swatch.addEventListener('mouseleave', function () {
        // Remove any placeholder that might be showing
        const placeholderContainer = mainImage.closest('picture') || mainImage.parentElement;
        const existingPlaceholder = placeholderContainer.querySelector('.main-image-placeholder');

        if (existingPlaceholder) {
          existingPlaceholder.remove();
          mainImage.style.display = 'block';
        }

        // Restore original image
        mainImage.src = originalSrc;
        mainImage.srcset = originalSrcset || '';
      });
    });
  });

  // Function to parse image URL and determine if it's a model image
  function parseImageUrl(url) {
    // Initialize result with default values
    const result = {
      product: '',
      color: '',
      image_type: 'main',
      sequence: null,
    };

    // Extract filename from URL and remove file extension
    const filename = url.split('/').pop()?.split('?')[0] || '';
    const nameWithoutExt = filename.replace(/\.[^/.]+$/, '');

    // Return default values for malformed URLs or files without proper naming convention
    if (!nameWithoutExt.includes('-')) {
      return result;
    }

    // Check for model image type
    if (nameWithoutExt.includes('-M')) {
      result.image_type = 'model';

      // Check for sequence number
      if (nameWithoutExt.includes('-M_')) {
        const seqPart = nameWithoutExt.split('-M_')[1];
        if (seqPart) {
          const seqNum = parseInt(seqPart, 10);
          if (!isNaN(seqNum)) {
            result.sequence = seqNum;
          }
        }
      }
    }

    return result;
  }
</script>
