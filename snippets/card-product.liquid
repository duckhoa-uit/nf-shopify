{% comment %}
  Renders a product card in the Northfinder style
  
  OPTIMIZED VERSION - Single pass media indexing, efficient Liquid filters
  
  Accepts:
  - card_product: {Object} Product Liquid object (required)
  - section_id: {String} The ID of the section that contains this card (required)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)

  Usage:
  {% render 'card-product', card_product: product, section_id: section.id %}
{% endcomment %}

{%- if card_product and card_product != empty -%}
  <div class="card-wrapper h-full">
    <div class="flex flex-col h-full relative">
      <div class="relative">
        <div class="flex items-center gap-2 mb-1.5 h-8 overflow-x-auto scrollbar-hide tag-container"
             style="scrollbar-width: none; -ms-overflow-style: none;"
             onscroll="this.style.setProperty('--scroll-shadow-left', this.scrollLeft > 0 ? '1' : '0'); this.style.setProperty('--scroll-shadow-right', this.scrollLeft < this.scrollWidth - this.clientWidth ? '1' : '0')">
        {%- assign tag_count = 0 -%}

        {% render 'discount-badge', product: card_product %}

        <!-- Product tags from metafields (max 3) -->
        {%- if card_product.metafields.features.extra.value -%}
          {%- for extra_tag in card_product.metafields.features.extra.value -%}
            {%- if tag_count < 3 -%}
              <span class="text-medium text-[13px] leading-4 uppercase text-[#4d4d4d] border border-[#ccc] px-2 py-1 rounded-[2px] flex-shrink-0">
                {{- extra_tag.name -}}
              </span>
              {%- assign tag_count = tag_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        <!-- Promotion metafield -->
        {%- if card_product.metafields.features.promotion.value -%}
          {%- for promotion in card_product.metafields.features.promotion.value -%}
            {%- if tag_count < 3 -%}
              <span class="text-medium text-[13px] leading-4 uppercase text-[#4d4d4d] border border-[#ccc] px-2 py-1 rounded-[2px] flex-shrink-0">
                {{- promotion.name -}}
              </span>
              {%- assign tag_count = tag_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        </div>

        <!-- Shadow indicators for scrollable content -->
        <div class="absolute left-0 top-0 bottom-0 w-4 bg-gradient-to-r from-white to-transparent pointer-events-none opacity-0 transition-opacity duration-200 shadow-left"></div>
        <div class="absolute right-0 top-0 bottom-0 w-4 bg-gradient-to-l from-white to-transparent pointer-events-none opacity-100 transition-opacity duration-200 shadow-right"></div>
      </div>

      {%- if card_product.media.size > 0 -%}
        {%- liquid
          # ============================================================
          # OPTIMIZATION: Single pass media indexing
          # Instead of multiple loops over media, we do ONE pass to collect:
          # - model_image_simple: -M without sequence
          # - model_images_sequenced: -M_N with sequences (stored as string for sorting)
          # - main_image: -H suffix for hover
          # - fallback images by type: H, B, BV, D
          # ============================================================
          
          assign model_image = null
          assign main_image = null
          assign model_image_simple = null
          assign best_sequenced_model = null
          assign best_sequence_num = 999
          assign alt_sequenced_model = null
          assign alt_sequence_num = 999
          assign fallback_h = null
          assign fallback_b = null
          assign fallback_bv = null
          assign fallback_d = null
          
          for media in card_product.media
            assign media_src = media.src | default: ''
            assign parsed_url = media_src | split: '/' | last
            
            # Check for -H (hover image)
            if parsed_url contains '-H' or parsed_url contains '-H.'
              if main_image == null
                assign main_image = media
              endif
            endif
            
            # Check for model images
            if parsed_url contains '-M'
              if parsed_url contains '-M_'
                # Sequenced model image - extract sequence number
                assign seq_part = parsed_url | split: '-M_' | last | split: '.' | first
                assign seq_num = seq_part | plus: 0
                if seq_num > 0 and seq_num < best_sequence_num
                  # Track for primary model (lowest sequence)
                  assign best_sequence_num = seq_num
                  assign best_sequenced_model = media
                endif
              else
                # Simple model image (no sequence) - highest priority
                if model_image_simple == null
                  assign model_image_simple = media
                endif
              endif
            endif
            
            # Collect fallback images by type (first match only)
            if fallback_h == null and parsed_url contains '-H'
              assign fallback_h = media
            endif
            if fallback_b == null and parsed_url contains '-B'
              unless parsed_url contains '-BV'
                assign fallback_b = media
              endunless
            endif
            if fallback_bv == null and parsed_url contains '-BV'
              assign fallback_bv = media
            endif
            if fallback_d == null and parsed_url contains '-D'
              assign fallback_d = media
            endif
          endfor
          
          # Resolve model_image with priority: simple -M > sequenced -M_N > fallbacks > featured
          if model_image_simple
            assign model_image = model_image_simple
          elsif best_sequenced_model
            assign model_image = best_sequenced_model
          elsif fallback_h
            assign model_image = fallback_h
          elsif fallback_b
            assign model_image = fallback_b
          elsif fallback_bv
            assign model_image = fallback_bv
          elsif fallback_d
            assign model_image = fallback_d
          else
            assign model_image = card_product.featured_media
          endif
          
          # Find alternative model for hover if no -H image found
          unless main_image
            # Look for a different sequenced model image
            if best_sequenced_model and model_image_simple
              # If we used simple model, use sequenced as alternative
              assign main_image = best_sequenced_model
            else
              # Find next lowest sequence model image different from current
              for media in card_product.media
                assign media_src = media.src | default: ''
                assign parsed_url = media_src | split: '/' | last
                if parsed_url contains '-M_' and media.id != model_image.id
                  assign seq_part = parsed_url | split: '-M_' | last | split: '.' | first
                  assign seq_num = seq_part | plus: 0
                  if seq_num > 0 and seq_num < alt_sequence_num
                    assign alt_sequence_num = seq_num
                    assign alt_sequenced_model = media
                  endif
                endif
              endfor
              
              if alt_sequenced_model
                assign main_image = alt_sequenced_model
              else
                assign main_image = model_image
              endif
            endif
          endunless
          
          # Check if we have a real hover image
          assign has_real_main_image = false
          if main_image and main_image.id != model_image.id
            assign has_real_main_image = true
          endif
        -%}

        <div class="relative overflow-hidden mb-3">
          <a
            href="{{ card_product.url }}"
            class="card-product-northfinder__link"
            data-product-id="{{ card_product.id }}"
            data-section-id="{{ section_id }}"
            data-main-image-src="{{ main_image | image_url: width: 400 }}"
            data-main-image-srcset="{%- if main_image.width >= 200 -%}{{ main_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if main_image.width >= 300 -%}{{ main_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if main_image.width >= 400 -%}{{ main_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if main_image.width >= 500 -%}{{ main_image | image_url: width: 500 }} 500w{%- endif -%}"
            data-has-real-main-image="{{ has_real_main_image }}"
          >
            <div
              id="main-image-{{ section_id }}-{{ card_product.id }}"
              data-original-src="{{ model_image | image_url: width: 400 }}"
              data-original-srcset="{%- if model_image.width >= 200 -%}{{ model_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if model_image.width >= 300 -%}{{ model_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if model_image.width >= 400 -%}{{ model_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if model_image.width >= 500 -%}{{ model_image | image_url: width: 500 }} 500w{%- endif -%}"
            >
              <img
                src="{{ model_image | image_url: width: 400 }}"
                srcset="{%- if model_image.width >= 200 -%}{{ model_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if model_image.width >= 300 -%}{{ model_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if model_image.width >= 400 -%}{{ model_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if model_image.width >= 500 -%}{{ model_image | image_url: width: 500 }} 500w{%- endif -%}"
                sizes="(min-width: 990px) calc(33.33vw - 2rem), (min-width: 750px) calc(50vw - 1.5rem), calc(50vw - 1rem)"
                alt="{{ model_image.alt | escape }}"
                loading="lazy"
                decoding="async"
                width="{{ model_image.width }}"
                height="{{ model_image.height }}"
                class="w-full h-auto object-cover aspect-square transition-opacity duration-300 ease-in-out"
              >
            </div>
          </a>
        </div>

      {%- else -%}
        {%- comment -%} Product has no media - show placeholder with consistent dimensions {%- endcomment -%}
        <div class="relative overflow-hidden mb-3">
          <a
            href="{{ card_product.url }}"
            class="card-product-northfinder__link block"
            data-product-id="{{ card_product.id }}"
            data-section-id="{{ section_id }}"
          >
            <div class="w-full aspect-square bg-gray-100 flex items-center justify-center">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'w-full h-full text-gray-400 max-w-[60%] max-h-[60%]' }}
            </div>
          </a>
        </div>
      {%- endif -%}

      {%- comment -%} Show variants regardless of whether product has media or not {%- endcomment -%}
      {%- if card_product.has_only_default_variant == false or card_product.variants.size > 1 -%}
        {%- liquid
          # ============================================================
          # OPTIMIZATION: Efficient color extraction using Liquid filters
          # Replace nested variant loops with map/uniq/where filters
          # ============================================================
          
          # Get unique colors efficiently
          assign all_colors = card_product.variants | map: 'option1' | uniq
          
          # Get available variants and their colors
          assign available_variants = card_product.variants | where: 'available', true
          assign available_color_list = available_variants | map: 'option1' | uniq
          
          # Build available_colors string for compatibility with sorting logic
          assign available_colors = ''
          for color in available_color_list
            if available_colors == ''
              assign available_colors = color
            else
              assign available_colors = available_colors | append: ',' | append: color
            endif
          endfor
          assign available_colors = available_colors | split: ','
          
          # Fallback: if no colors have stock, show first color for visual consistency
          if available_colors.size == 0 and all_colors.size > 0
            assign available_colors = all_colors | slice: 0, 1
          endif
        -%}

        {%- comment -%} Sort available_colors by position from metafields.custom.color.value {%- endcomment -%}
        {%- if card_product.metafields.custom.color.value != blank and available_colors.size > 0 -%}
          {%- assign color_positions = '' -%}

          {%- for color in available_colors -%}
            {%- assign position = 999 -%}
            {%- assign color_downcase = color | downcase | strip -%}

            {%- for color_item in card_product.metafields.custom.color.value -%}
              {%- if color_item.name == color_downcase -%}
                {%- assign position = color_item.position -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- assign position_str = position | prepend: '00000' | slice: -5, 5 -%}
            {%- assign color_positions = color_positions
              | append: position_str
              | append: ':'
              | append: color
              | append: ','
            -%}
          {%- endfor -%}

          {%- assign sorted_positions = color_positions | split: ',' | sort -%}
          {%- assign sorted_colors = '' -%}

          {%- for position_color in sorted_positions -%}
            {%- if position_color != blank -%}
              {%- assign parts = position_color | split: ':' -%}
              {%- if parts.size > 1 -%}
                {%- assign sorted_colors = sorted_colors | append: ',' | append: parts[1] -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- assign available_colors = sorted_colors | remove_first: ',' | split: ',' -%}
        {%- endif -%}

        {%- assign colors_count = available_colors.size -%}
        {%- assign display_count = colors_count -%}
        {%- assign remaining_count = 0 -%}

        {%- if colors_count > 5 -%}
          {%- assign display_count = 4 -%}
          {%- assign remaining_count = colors_count | minus: display_count -%}
        {%- endif -%}

        <div class="grid mb-0 grid-cols-5 w-fit gap-0.5">
          {%- for color in available_colors limit: display_count -%}
            {%- liquid
              # ============================================================
              # OPTIMIZATION: Use where filter for variant lookup
              # ============================================================
              
              # Try available variant first, then any variant
              assign color_variants_available = card_product.variants | where: 'option1', color | where: 'available', true
              assign color_variant = color_variants_available | first
              
              if color_variant == null
                assign color_variants_any = card_product.variants | where: 'option1', color
                assign color_variant = color_variants_any | first
              endif
            -%}

            {%- if color_variant -%}
              {%- liquid
                assign variant_image = null
                assign color_value = color | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '.', '' | replace: ',', ''
                assign reference_id = ''
                
                # Find reference_id from metafields
                if card_product.metafields.custom.color.value != blank
                  for color_item in card_product.metafields.custom.color.value
                    if color_item.name == color_value
                      assign reference_id = color_item.reference_id
                      break
                    endif
                  endfor
                endif
                
                # Try to find variant image using reference_id
                if reference_id != '' and card_product.media.size > 0
                  assign found_variant_image = false
                  assign best_variant_seq = 999
                  
                  for media in card_product.media
                    assign media_src = media.src | default: ''
                    assign parsed_url = media_src | split: '/' | last
                    
                    if parsed_url contains reference_id
                      # Priority 1: -M without sequence
                      if parsed_url contains '-M'
                        unless parsed_url contains '-M_'
                          assign variant_image = media
                          assign found_variant_image = true
                          break
                        endunless
                      endif
                      
                      # Priority 2: -M_N with lowest sequence (collect during loop)
                      if parsed_url contains '-M_' and found_variant_image == false
                        assign seq_part = parsed_url | split: '-M_' | last | split: '.' | first
                        assign seq_num = seq_part | plus: 0
                        if seq_num > 0 and seq_num < best_variant_seq
                          assign best_variant_seq = seq_num
                          assign variant_image = media
                        endif
                      endif
                      
                      # Priority 3: Other image types (H, B, BV, D)
                      if variant_image == null
                        if parsed_url contains '-H' or parsed_url contains '-B' or parsed_url contains '-BV' or parsed_url contains '-D'
                          assign variant_image = media
                        endif
                      endif
                    endif
                  endfor
                endif
                
                # Fallback to variant.featured_image or product media matching
                unless variant_image
                  if color_variant.featured_image
                    assign variant_image = color_variant.featured_image
                  elsif card_product.media.size > 0
                    # Try to find by color name in URL or alt text
                    for media in card_product.media
                      assign media_src = media.src | default: ''
                      assign parsed_url = media_src | split: '/' | last
                      
                      if parsed_url contains color_value
                        assign variant_image = media
                        break
                      endif
                      
                      if media.alt contains color or media.alt contains color_variant.title
                        assign variant_image = media
                        break
                      endif
                    endfor
                    
                    # Try product.images as last resort
                    unless variant_image
                      for image in card_product.images
                        if image.alt contains color or image.alt contains color_variant.title
                          assign variant_image = image
                          break
                        endif
                      endfor
                    endunless
                    
                    # Final fallback to featured_media
                    unless variant_image
                      assign variant_image = card_product.featured_media
                    endunless
                  endif
                endunless
              -%}

              <a
                href="{{ card_product.url }}?variant={{ color_variant.id }}"
                class="size-9 xl:size-[3.75rem] overflow-hidden bg-background flex items-center justify-center transition-colors variant-swatch border-b-2 border-transparent hover:border-accent"
                data-variant-id="{{ color_variant.id }}"
                data-product-id="{{ card_product.id }}"
                data-section-id="{{ section_id }}"
                {%- if variant_image -%}
                  data-variant-image="{{ variant_image | image_url: width: 120 }}"
                  data-variant-image-srcset="{%- if variant_image.width >= 200 -%}{{ variant_image | image_url: width: 200 }} 200w,{%- endif -%}{%- if variant_image.width >= 300 -%}{{ variant_image | image_url: width: 300 }} 300w,{%- endif -%}{%- if variant_image.width >= 400 -%}{{ variant_image | image_url: width: 400 }} 400w,{%- endif -%}{%- if variant_image.width >= 500 -%}{{ variant_image | image_url: width: 500 }} 500w{%- endif -%}"
                {%- else -%}
                  data-variant-image="placeholder"
                  data-variant-image-srcset=""
                {%- endif -%}
                aria-label="Select {{ color_variant.title | escape }} variant"
              >
                {%- if variant_image -%}
                  <img
                    src="{{ variant_image | image_url: width: 120 }}"
                    srcset="{%- if variant_image.width >= 40 -%}{{ variant_image | image_url: width: 40 }} 40w,{%- endif -%}{%- if variant_image.width >= 60 -%}{{ variant_image | image_url: width: 60 }} 60w,{%- endif -%}{%- if variant_image.width >= 80 -%}{{ variant_image | image_url: width: 80 }} 80w,{%- endif -%}{%- if variant_image.width >= 100 -%}{{ variant_image | image_url: width: 100 }} 100w,{%- endif -%}{%- if variant_image.width >= 120 -%}{{ variant_image | image_url: width: 120 }} 120w,{%- endif -%}{{ variant_image | image_url: width: variant_image.width }} {{ variant_image.width }}w"
                    sizes="(min-width: 1280px) 60px, 36px"
                    alt="{{ color | escape }}"
                    loading="lazy"
                    decoding="async"
                    width="120"
                    height="120"
                    class="w-full h-full object-cover"
                  >
                {%- else -%}
                  {%- comment -%} Show placeholder when no variant image is available {%- endcomment -%}
                  <div class="variant-swatch-placeholder w-full h-full bg-gray-100 flex items-center justify-center">
                    {{
                      'product-apparel-2'
                      | placeholder_svg_tag: 'variant-swatch-placeholder-svg w-3/5 h-3/5 text-gray-400 opacity-70'
                    }}
                  </div>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}

          {%- if remaining_count > 0 -%}
            <a
              href="{{ card_product.url }}"
              class="size-9 xl:size-[3.75rem] rounded-full border border-[#E5E5E5] bg-white flex items-center justify-center text-center text-[#4D4D4D] font-medium"
            >
              +{{ remaining_count }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="flex flex-col gap-1 pt-3">
        <a href="{{ card_product.url }}" class="card-product-northfinder__title-link">
          <h3 class="text-base font-semibold leading-[1.625rem] text-[#0F0F0F]">{{ card_product.title | escape }}</h3>
        </a>

        <div class="flex gap-3 items-center mt-0.5">
          {%- if card_product.compare_at_price > card_product.price and card_product.available -%}
            <span class="line-through text-[#666666] font-medium font-archivo-expanded text-base leading-6">
              {{- card_product.compare_at_price | money -}}
            </span>
            <span class="text-black font-medium font-archivo-expanded text-base leading-6">
              {{- card_product.price | money -}}
            </span>
          {%- else -%}
            <span class="text-black font-medium font-archivo-expanded text-base leading-6">
              {{- card_product.price | money -}}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper h-full">
    <div class="flex flex-col h-full relative">
      {%- comment -%} Empty tags container to match the spacing {%- endcomment -%}
      <div class="relative">
        <div class="flex items-center gap-2 mb-1.5 h-8 overflow-x-auto scrollbar-hide tag-container">
          <span class="text-medium text-[13px] leading-4 uppercase text-[#4d4d4d] border border-[#ccc] px-2 py-1 rounded-[2px] flex-shrink-0">
            {{ 'onboarding.product_tag' | t | default: 'Sample Tag' }}
          </span>
        </div>
      </div>

      {%- comment -%} Placeholder image with same structure as product media {%- endcomment -%}
      <div class="relative overflow-hidden mb-3">
        <a href="#" class="card-product-northfinder__link block">
          <div class="w-full aspect-square bg-gray-100 flex items-center justify-center">
            {{ 'product-apparel-2' | placeholder_svg_tag: 'w-full h-full text-gray-400 max-w-[60%] max-h-[60%]' }}
          </div>
        </a>
      </div>

      {%- comment -%} Placeholder variant swatches {%- endcomment -%}
      <div class="flex flex-wrap gap-1 py-3 border-t border-[#E5E5E5]">
        <div class="size-9 xl:size-[3.75rem] overflow-hidden bg-gray-100 flex items-center justify-center border-b-2 border-transparent">
          {{ 'product-apparel-2' | placeholder_svg_tag: 'w-3/5 h-3/5 text-gray-400 opacity-70' }}
        </div>
        <div class="size-9 xl:size-[3.75rem] overflow-hidden bg-gray-100 flex items-center justify-center border-b-2 border-transparent">
          {{ 'product-apparel-2' | placeholder_svg_tag: 'w-3/5 h-3/5 text-gray-400 opacity-70' }}
        </div>
        <div class="size-9 xl:size-[3.75rem] overflow-hidden bg-gray-100 flex items-center justify-center border-b-2 border-transparent">
          {{ 'product-apparel-2' | placeholder_svg_tag: 'w-3/5 h-3/5 text-gray-400 opacity-70' }}
        </div>
      </div>

      {%- comment -%} Placeholder title and price {%- endcomment -%}
      <div class="flex flex-col gap-1 pt-3">
        <a href="#" class="card-product-northfinder__title-link">
          <h3 class="text-base font-semibold leading-[1.625rem] text-[#0F0F0F]">{{ 'onboarding.product_title' | t }}</h3>
        </a>

        <div class="flex gap-3 items-center mt-0.5">
          <span class="text-black font-medium font-archivo-expanded text-base leading-6">$29.99</span>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% comment %} ============================================================
  Styles - Scoped to this component
============================================================ {% endcomment %}
{% stylesheet %}
  /* Hide scrollbar for tag container while maintaining scroll functionality */
  .scrollbar-hide {
    -webkit-overflow-scrolling: touch;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  /* Ensure tags don't wrap and maintain minimum width */
  .scrollbar-hide .text-medium {
    white-space: nowrap;
    flex-shrink: 0;
    min-width: fit-content;
  }

  /* Smooth scrolling behavior */
  @media (prefers-reduced-motion: no-preference) {
    .scrollbar-hide {
      scroll-behavior: smooth;
    }
  }

  /* Shadow indicators for scrollable content */
  .tag-container[style*="--scroll-shadow-left: 1"] ~ .shadow-left {
    opacity: 1 !important;
  }

  .tag-container[style*="--scroll-shadow-right: 0"] ~ .shadow-right {
    opacity: 0 !important;
  }

  /* Initial state - show right shadow only if content overflows */
  .tag-container {
    position: relative;
  }
{% endstylesheet %}

{% comment %} ============================================================
  JavaScript - Scoped and optimized with passive listeners
============================================================ {% endcomment %}
{% javascript %}
  // Initialize shadow visibility for tag containers - uses event delegation
  (function() {
    function updateShadows(container) {
      const parent = container.parentElement;
      const leftShadow = parent.querySelector('.shadow-left');
      const rightShadow = parent.querySelector('.shadow-right');
      
      if (!leftShadow || !rightShadow) return;
      
      const isScrollable = container.scrollWidth > container.clientWidth;
      const isAtStart = container.scrollLeft <= 0;
      const isAtEnd = container.scrollLeft >= container.scrollWidth - container.clientWidth - 1;

      if (!isScrollable) {
        leftShadow.style.opacity = '0';
        rightShadow.style.opacity = '0';
      } else {
        leftShadow.style.opacity = isAtStart ? '0' : '1';
        rightShadow.style.opacity = isAtEnd ? '0' : '1';
      }
    }
    
    // Use Intersection Observer for lazy initialization
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          const container = entry.target;
          updateShadows(container);
          
          // Add scroll listener with passive flag for performance
          container.addEventListener('scroll', function() {
            updateShadows(container);
          }, { passive: true });
          
          observer.unobserve(container);
        }
      });
    }, { rootMargin: '50px' });
    
    // Observe all tag containers
    document.querySelectorAll('.tag-container').forEach(function(container) {
      observer.observe(container);
    });
    
    // Debounced resize handler
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        document.querySelectorAll('.tag-container').forEach(updateShadows);
      }, 100);
    }, { passive: true });
  })();
