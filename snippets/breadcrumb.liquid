<div class="breadcrumb-container page-width">
  <nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
    <ol class="breadcrumb__list">
      <li class="breadcrumb__back-button">
        <a href="javascript:history.back()" aria-label="Go back" class="breadcrumb__link text-[#0F0F0F] flex items-center gap-2">
          <span class="svg-wrapper size-3 rotate-180">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          <span>Back</span>
        </a>
        <span class="breadcrumb__divider">|</span>
      </li>

      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="{{ routes.root_url }}">Home</a>
        <span class="breadcrumb__divider" aria-hidden="true">›</span>
      </li>

      {% if template contains 'product' %}
        {% if product.collections.first %}
          {% assign current_collection = product.collections.first %}

          {% if current_collection.metafields.custom.parent_collection %}
            {% assign parent_collection = collections[current_collection.metafields.custom.parent_collection] %}

            {% if parent_collection %}
              <li class="breadcrumb__item">
                <a class="breadcrumb__link" href="{{ parent_collection.url }}">
                  {{ parent_collection.metafields.custom.display_name | default: parent_collection.title }}
                </a>
                <span class="breadcrumb__divider" aria-hidden="true">›</span>
              </li>
            {% endif %}
          {% endif %}

          <li class="breadcrumb__item">
            <a class="breadcrumb__link" href="{{ current_collection.url }}">
              {{ current_collection.metafields.custom.display_name | default: current_collection.title }}
            </a>
            <span class="breadcrumb__divider" aria-hidden="true">›</span>
          </li>
        {% endif %}

        <li class="breadcrumb__item breadcrumb__item--current">
          <span class="breadcrumb__text" aria-current="page">{{ product.title }}</span>
        </li>
      {% elsif template contains 'collection' %}
        {% if collection.metafields.custom.parent_collection %}
          {% assign parent_collection = collections[collection.metafields.custom.parent_collection] %}

          {% if parent_collection %}
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ parent_collection.url }}">
                {{ parent_collection.metafields.custom.display_name | default: parent_collection.title }}
              </a>
              <span class="breadcrumb__divider" aria-hidden="true">›</span>
            </li>
          {% endif %}
        {% endif %}

        <li class="breadcrumb__item breadcrumb__item--current">
          <span class="breadcrumb__text" aria-current="page">
            {{ collection.metafields.custom.display_name | default: collection.title }}
          </span>
        </li>
      {% elsif template contains 'page' %}
        <li class="breadcrumb__item breadcrumb__item--current">
          <span class="breadcrumb__text" aria-current="page">{{ page.title }}</span>
        </li>
      {% elsif template contains 'blog' %}
        <li class="breadcrumb__item breadcrumb__item--current">
          <span class="breadcrumb__text" aria-current="page">{{ blog.title }}</span>
        </li>
      {% elsif template contains 'article' %}
        <li class="breadcrumb__item">
          <a class="breadcrumb__link" href="{{ blog.url }}">{{ blog.title }}</a>
          <span class="breadcrumb__divider" aria-hidden="true">›</span>
        </li>
        <li class="breadcrumb__item breadcrumb__item--current">
          <span class="breadcrumb__text" aria-current="page">{{ article.title }}</span>
        </li>
      {% else %}
        <li class="breadcrumb__item breadcrumb__item--current">
          <span class="breadcrumb__text" aria-current="page">{{ page_title }}</span>
        </li>
      {% endif %}
    </ol>
  </nav>
</div>

<style>
  .breadcrumb-container {
    margin-bottom: 1.5rem;
    padding-top: 1rem;
  }

  .breadcrumb {
    font-size: 0.75rem;
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
  }

  .breadcrumb__back-button {
    display: flex;
    align-items: center;
  }

  .breadcrumb__back-button svg {
    /* margin-right: 0.5rem; */
  }

  .breadcrumb__divider {
    color: var(--color-foreground-30);
    margin: 0 1rem;
  }

  .breadcrumb__link {
    color: #666;
    text-decoration: underline;
  }

  .breadcrumb__link:hover {
    color: #000;
    text-decoration: none;
  }

  .breadcrumb__divider {
    margin: 0 0.5rem;
    color: #999;
  }

  .breadcrumb__item--current .breadcrumb__text {
  }
</style>
