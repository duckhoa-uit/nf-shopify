{% comment %}
  Renders social sharing buttons as red circular icons.
  Accepts:
  - share_link: {String} url to be shared.
  - title: {String} title to be shared.

  Usage:
  {% render 'social-sharing-buttons',
    share_link: share_url,
    title: article.title
  %}
{% endcomment %}

<div class="social-sharing-buttons">
  {% assign encoded_title = title | url_encode %}
  {% assign encoded_url = share_link | url_encode %}

  <a
    href="https://www.facebook.com/sharer.php?u={{ encoded_url }}"
    target="_blank"
    rel="noopener"
    aria-label="Share on Facebook"
    class="social-sharing-button social-sharing-button--facebook"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
    </svg>
  </a>

  <a
    href="https://twitter.com/intent/tweet?text={{ encoded_title }}&url={{ encoded_url }}"
    target="_blank"
    rel="noopener"
    aria-label="Share on Twitter"
    class="social-sharing-button social-sharing-button--twitter"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
    </svg>
  </a>

  <a
    href="https://wa.me/?text={{ encoded_title }}%20{{ encoded_url }}"
    target="_blank"
    rel="noopener"
    aria-label="Share on WhatsApp"
    class="social-sharing-button social-sharing-button--whatsapp"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
  </a>

  <a
    href="mailto:?subject={{ encoded_title }}&body={{ encoded_url }}"
    aria-label="Share by Email"
    class="social-sharing-button social-sharing-button--email"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22,6 12,13 2,6"></polyline>
    </svg>
  </a>
</div>

<style>
  /* Base container styles */
  .article-template__social-sharing {
    position: static; /* Ensures it doesn't take up space */
    height: 0; /* No height */
    margin: 0; /* No margin */
    padding: 0; /* No padding */
  }

  .social-sharing-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
  }

  .social-sharing-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #ec0009;
    color: white;
    transition: background-color 0.3s ease;
    text-decoration: none;
  }

  .social-sharing-button:hover {
    background-color: #c70007;
  }

  .social-sharing-button svg {
    width: 18px;
    height: 18px;
    stroke-width: 2px;
  }

  /* Desktop styles (min-width: 750px) */
  @media screen and (min-width: 750px) {
    .social-sharing-buttons {
      position: absolute;
      left: max(20px, calc((100vw - var(--page-width)) / 4));
      bottom: -50vw;
      z-index: 5;
    }
  }

  /* Large desktop adjustment */
  @media screen and (min-width: 990px) {
    .social-sharing-buttons {
      left: max(20px, calc((100vw - var(--page-width)) / 4));
    }
  }

  /* Mobile styles (max-width: 749px) */
  @media screen and (max-width: 749px) {
    .social-sharing-buttons {
      display: none; /* Hide completely on mobile */
    }
  }
</style>
