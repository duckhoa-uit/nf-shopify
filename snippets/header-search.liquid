{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

<div
  class="search-modal__content pl-0 pr-5 hidden lg:flex"
  tabindex="-1"
>
  {%- if settings.predictive_search_enabled -%}
    <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
      <form action="javascript:void(0)" method="get" role="search" class="search search-modal__form">
        <div class="relative flex xl:min-w-[300px]">
          <input
            class="w-full px-3 py-2 text-base leading-5 bg-[#F0F0F0] rounded-3 border-none focus-visible:outline-none focus-visible:shadow-none"
            id="{{ input_id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.search' | t }}"
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <div class="absolute right-3 top-0 h-full flex flex-row items-center gap-4">
            <button
              type="reset"
              class="cursor-pointer flex items-center justify-center {% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper size-3">
                {{- 'icon-reset.svg' | inline_asset_content -}}
              </span>
            </button>
            <button
              type="button"
              class="cursor-pointer flex flex-col items-center justify-center"
              aria-label="{{ 'general.search.search' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-search.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        </div>
        {%- if settings.predictive_search_enabled -%}
          <div
            class="predictive-search predictive-search--header w-[600px]"
            tabindex="-1"
            data-predictive-search
            style="display: none;"
          >
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>

          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>
    </predictive-search>
  {%- endif -%}
</div>
