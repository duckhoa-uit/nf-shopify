                      class="measurement-value"
                      data-cm="{{ size_measurements.bottom_girth_relaxed }}"
                      data-in="{{ size_measurements.bottom_girth_relaxed | divided_by: 2.54 | round: 1 }}"
                    >
                      {{ size_measurements.bottom_girth_relaxed }}
