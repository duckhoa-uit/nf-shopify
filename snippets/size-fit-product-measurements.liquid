{% comment %}
  Size Fit Product Measurements Component

  Accepts:
  - measurements: {Object} product measurements data from metafields
  - product: {Object} product object

  Usage:
  {% render 'size-fit-product-measurements', measurements: measurements, product: product %}
{% endcomment %}

{% assign measurements = measurements | default: blank %}

{% comment %} Create sorted size array for JavaScript sorting {% endcomment %}
{% assign size_order = 'XXS,XS,S,M,L,XL,XXL,2XL,3XL,4XL,5XL' | split: ',' %}

{% comment %}
  Comprehensive measurement definition map with localization
  Format: field_name|alpha_label|translation_key
{% endcomment %}
{% assign measurement_definitions_raw = 'waist_girth|A,waist_girth_relaxed|A1,waist_girth_stretched|A2,outside_length_end_waist|B,chest_girth_half|B,outside_length_top_waist|B1,hip_girth|C,bottom_girth_half|C,bottom_girth_relaxed|C1,bottom_girth_stretched_half|C2,shoulder_point_to_point|D,front_rise_end_waist|D,shoulder_sleeve_length|E,back_rise_end_waist|E,inside_length|F,center_back_length|F,thigh_half_crotch|G,sleeve_length|G,front_rise_top_waist|H,back_rise_top_waist|I,bottom_legs_half|J,waist_girth_half|K' | split: ',' %}

{% assign measurement_definitions = '' %}
{% for definition in measurement_definitions_raw %}
  {% assign parts = definition | split: '|' %}
  {% assign field_name = parts[0] %}
  {% assign alpha_label = parts[1] %}

  {% assign product_measurements = shop.metafields.size_guide.product_measurements.value %}
  {% assign display_name = product_measurements[field_name] %}

  {% unless display_name %}
    {% assign fallback_key = 'size_guide.product_measurements.' | append: field_name %}
    {% assign display_name = fallback_key | t %}
  {% endunless %}

  {% assign localized_definition = field_name | append: '|' | append: alpha_label | append: '|' | append: display_name %}
  {% if forloop.first %}
    {% assign measurement_definitions = localized_definition %}
  {% else %}
    {% assign measurement_definitions = measurement_definitions | append: ',' | append: localized_definition %}
  {% endif %}
{% endfor %}

{% assign measurement_definitions = measurement_definitions | split: ',' %}

{% assign measurement_map = blank %}
{% assign measurement_map_array = '' %}
{% for definition in measurement_definitions %}
  {% assign parts = definition | split: '|' %}
  {% assign field_name = parts[0] %}
  {% assign alpha_label = parts[1] %}
  {% assign display_name = parts[2] %}
  {% assign measurement_map_array = measurement_map_array
    | append: field_name
    | append: ':'
    | append: alpha_label
    | append: ':'
    | append: display_name
    | append: ','
  %}
{% endfor %}

<div class="product-measurements-section">
  <!-- Description -->
  <div class="mb-6 text-center">
    <p class="text-gray-600">{{ 'size_guide.size_fit.product_measurements.description' | t }}</p>
    <p class="text-sm text-gray-500">{{ 'size_guide.size_fit.product_measurements.usage_note' | t }}</p>
  </div>

  <!-- Product Measurements Table -->
  {% if measurements %}
    <div class="size-fit-table__wrapper mb-8">
      <table class="size-fit-table__table size_table_product">
        <tbody>
          <!-- Size Header Row -->
          <tr class="size-fit-table__header-row">
            {% for size_data in measurements %}
              {% assign size_name = size_data[0] %}
              <th class="size-fit-table__header-cell">{{ size_name }}</th>
            {% endfor %}
          </tr>

          {% comment %} Calculate number of sizes for colspan {% endcomment %}
          {% assign size_count = measurements.size | default: 3 %}

          {% comment %}
            Dynamic measurement rendering based on data availability
            1. Check which measurements have data across any size
            2. Sort by alpha label alphabetically
            3. Render only measurements with data
          {% endcomment %}

          {% comment %} First pass: collect available measurements {% endcomment %}
          {% assign available_measurements = '' %}
          {% for definition in measurement_definitions %}
            {% assign parts = definition | split: '|' %}
            {% assign field_name = parts[0] %}
            {% assign alpha_label = parts[1] %}
            {% assign display_name = parts[2] %}

            {% comment %} Check if this measurement has data in any size {% endcomment %}
            {% assign has_data = false %}
            {% for size_data in measurements %}
              {% assign size_measurements = size_data[1].measurements %}
              {% assign field_value = size_measurements[field_name] %}
              {% if field_value and field_value != blank and field_value != 0 %}
                {% assign has_data = true %}
                {% break %}
              {% endif %}
            {% endfor %}

            {% if has_data %}
              {% assign available_measurements = available_measurements
                | append: alpha_label
                | append: '|'
                | append: field_name
                | append: '|'
                | append: display_name
                | append: ','
              %}
            {% endif %}
          {% endfor %}

          {% comment %} Convert to array and sort by alpha label {% endcomment %}
          {% assign available_measurements_array = available_measurements | split: ',' %}
          {% assign sorted_measurements = available_measurements_array | sort %}

          {% comment %} Render measurements in alphabetical order {% endcomment %}
          {% for measurement_info in sorted_measurements %}
            {% if measurement_info != blank %}
              {% assign measurement_parts = measurement_info | split: '|' %}
              {% assign alpha_label = measurement_parts[0] %}
              {% assign field_name = measurement_parts[1] %}
              {% assign display_name = measurement_parts[2] %}

              <!-- {{ alpha_label }}: {{ display_name }} -->
              <tr class="size-fit-table__data-row">
                <td
                  colspan="{{ size_count }}"
                  class="size-fit-table__data-cell size-fit-table__sticky-cell type_name text-center"
                >
                  <span
                    ><span class="alpha">{{ alpha_label }}</span> {{ display_name }} (cm)</span
                  >
                </td>
              </tr>
              <tr class="size-fit-table__data-row">
                {% for size_data in measurements %}
                  {% assign size_measurements = size_data[1].measurements %}
                  <td class="size-fit-table__data-cell">
                    {% assign field_value = size_measurements[field_name] %}
                    {% if field_value and field_value != blank and field_value != 0 %}
                      <span
                        class="measurement-value"
                        data-cm="{{ field_value }}"
                        data-in="{{ field_value | divided_by: 2.54 | round: 1 }}"
                      >
                        {{ field_value }}
                      </span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="text-center py-8">
      <p class="text-gray-500">{{ 'size_guide.size_fit.no_product_measurements' | t }}</p>
    </div>
  {% endif %}

