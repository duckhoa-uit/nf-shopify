{% comment %}
  Size Fit Product Measurements Component

  Accepts:
  - measurements: {Object} product measurements data from metafields
  - product: {Object} product object

  Usage:
  {% render 'size-fit-product-measurements', measurements: measurements, product: product %}
{% endcomment %}

{% assign measurements = measurements | default: blank %}
{% comment %} Get product category from product metafields {% endcomment %}
{% assign product_category = 'fleece sweaters' %}

{% comment %} Try different ways to access the array {% endcomment %}
{% assign kind_value = product.metafields.features.kind.value %}
{% if kind_value %}
  {% for item in kind_value %}
    {% assign product_category = item.name %}
    {% break %}
  {% endfor %}
{% endif %}

{% comment %} Create sorted size array for JavaScript sorting {% endcomment %}
{% assign size_order = 'XXS,XS,S,M,L,XL,XXL,2XL,3XL,4XL,5XL' | split: ',' %}

<div class="product-measurements-section">
  <!-- Description -->
  <div class="mb-6 text-center">
    <p class="text-gray-600">Approximate dimensions measured on the products</p>
    <p class="text-sm text-gray-500">(use to compare with your clothes in the wardrobe)</p>
  </div>

  <!-- Product Measurements Table -->
  {% if measurements %}
    <div class="size-fit-table__wrapper mb-8">
      <table class="size-fit-table__table size_table_product">
        <tbody>
          <!-- Size Header Row -->
          <tr class="size-fit-table__header-row">
            {% for size_data in measurements %}
              {% assign size_name = size_data[0] %}
              <th class="size-fit-table__header-cell">{{ size_name }}</th>
            {% endfor %}
          </tr>

          {% comment %} Calculate number of sizes for colspan {% endcomment %}
          {% assign size_count = measurements.size | default: 3 %}

          {% if product_category == 'fleece sweaters' %}
            <!-- Fleece Sweaters Measurements -->

            <!-- B: 1/2 Chest Girth -->
            <tr class="size-fit-table__data-row">
              <td colspan="{{ size_count }}" class="size-fit-table__data-cell size-fit-table__sticky-cell type_name text-center">
                <span><span class="alpha">B</span> 1/2 chest girth (cm)</span>
              </td>
            </tr>
            <tr class="size-fit-table__data-row">
              {% for size_data in measurements %}
                {% assign size_measurements = size_data[1].measurements %}
                <td class="size-fit-table__data-cell">
                  {% if size_measurements.chest_girth_half %}
                    <span
                      class="measurement-value"
                      data-cm="{{ size_measurements.chest_girth_half }}"
                      data-in="{{ size_measurements.chest_girth_half | divided_by: 2.54 | round: 1 }}"
                    >
                      {{ size_measurements.chest_girth_half }}
                    </span>
                  {% else %}
                    -
                  {% endif %}
                </td>
              {% endfor %}
            </tr>

            <!-- C1: 1/2 Bottom Girth - Relaxed -->
            <tr class="size-fit-table__data-row">
              <td colspan="{{ size_count }}" class="size-fit-table__data-cell size-fit-table__sticky-cell type_name text-center">
                <span><span class="alpha">C1</span> 1/2 bottom girth - relaxed (cm)</span>
              </td>
            </tr>
            <tr class="size-fit-table__data-row">
              {% for size_data in measurements %}
                {% assign size_measurements = size_data[1].measurements %}
                <td class="size-fit-table__data-cell">
                  {% if size_measurements.bottom_girth_relaxed %}
