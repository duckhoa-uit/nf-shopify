{% comment %}
  Size Fit Product Measurements Component

  Accepts:
  - measurements: {Object} product measurements data from metafields
  - product: {Object} product object

  Usage:
  {% render 'size-fit-product-measurements', measurements: measurements, product: product %}
{% endcomment %}

{% assign measurements = measurements | default: blank %}

{% comment %} Create sorted size array for JavaScript sorting {% endcomment %}
{% assign size_order = 'XXS,XS,S,M,L,XL,XXL,2XL,3XL,4XL,5XL' | split: ',' %}

{% comment %}
  Comprehensive measurement definition map
  Format: field_name|alpha_label|display_name
{% endcomment %}
{% assign measurement_definitions = 'waist_girth|A|Waist girth,waist_girth_relaxed|A1|Waist girth - relaxed,waist_girth_stretched|A2|Waist girth - stretched,outside_length_end_waist|B|Out side length from the end waist,chest_girth_half|B|1/2 chest girth,outside_length_top_waist|B1|Out side length from the top waist,hip_girth|C|Hip girth,bottom_girth_half|C|1/2 bottom girth,bottom_girth_relaxed|C1|1/2 bottom girth - relaxed,bottom_girth_stretched_half|C2|1/2 bottom girth - stretched,shoulder_point_to_point|D|Shoulder point to point,front_rise_end_waist|D|Front rise length from the end waist,shoulder_sleeve_length|E|Shoulder & sleeve length,back_rise_end_waist|E|Back rise length - fr the end waist,inside_length|F|Inside length,center_back_length|F|Center back length,thigh_half_crotch|G|1/2 thigh - at crotch,sleeve_length|G|Sleeve length,front_rise_top_waist|H|Front rise length - fr the top waist,back_rise_top_waist|I|Back rise length - fr the top waist,bottom_legs_half|J|1/2 bottom legs,waist_girth_half|K|1/2 waist girth'
  | split: ','
%}

{% comment %} Create measurement map for easy lookup {% endcomment %}
{% assign measurement_map = blank %}
{% assign measurement_map_array = '' %}
{% for definition in measurement_definitions %}
  {% assign parts = definition | split: '|' %}
  {% assign field_name = parts[0] %}
  {% assign alpha_label = parts[1] %}
  {% assign display_name = parts[2] %}
  {% assign measurement_map_array = measurement_map_array
    | append: field_name
    | append: ':'
    | append: alpha_label
    | append: ':'
    | append: display_name
    | append: ','
  %}
{% endfor %}

<div class="product-measurements-section">
  <!-- Description -->
  <div class="mb-6 text-center">
    <p class="text-gray-600">Approximate dimensions measured on the products</p>
    <p class="text-sm text-gray-500">(use to compare with your clothes in the wardrobe)</p>
  </div>

  <!-- Product Measurements Table -->
  {% if measurements %}
    <div class="size-fit-table__wrapper mb-8">
      <table class="size-fit-table__table size_table_product">
        <tbody>
          <!-- Size Header Row -->
          <tr class="size-fit-table__header-row">
            {% for size_data in measurements %}
              {% assign size_name = size_data[0] %}
              <th class="size-fit-table__header-cell">{{ size_name }}</th>
            {% endfor %}
          </tr>

          {% comment %} Calculate number of sizes for colspan {% endcomment %}
          {% assign size_count = measurements.size | default: 3 %}

          {% comment %}
            Dynamic measurement rendering based on data availability
            1. Check which measurements have data across any size
            2. Sort by alpha label alphabetically
            3. Render only measurements with data
          {% endcomment %}

          {% comment %} First pass: collect available measurements {% endcomment %}
          {% assign available_measurements = '' %}
          {% for definition in measurement_definitions %}
            {% assign parts = definition | split: '|' %}
            {% assign field_name = parts[0] %}
            {% assign alpha_label = parts[1] %}
            {% assign display_name = parts[2] %}

            {% comment %} Check if this measurement has data in any size {% endcomment %}
            {% assign has_data = false %}
            {% for size_data in measurements %}
              {% assign size_measurements = size_data[1].measurements %}
              {% assign field_value = size_measurements[field_name] %}
              {% if field_value and field_value != blank and field_value != 0 %}
                {% assign has_data = true %}
                {% break %}
              {% endif %}
            {% endfor %}

            {% if has_data %}
              {% assign available_measurements = available_measurements
                | append: alpha_label
                | append: '|'
                | append: field_name
                | append: '|'
                | append: display_name
                | append: ','
              %}
            {% endif %}
          {% endfor %}

          {% comment %} Convert to array and sort by alpha label {% endcomment %}
          {% assign available_measurements_array = available_measurements | split: ',' %}
          {% assign sorted_measurements = available_measurements_array | sort %}

          {% comment %} Render measurements in alphabetical order {% endcomment %}
          {% for measurement_info in sorted_measurements %}
            {% if measurement_info != blank %}
              {% assign measurement_parts = measurement_info | split: '|' %}
              {% assign alpha_label = measurement_parts[0] %}
              {% assign field_name = measurement_parts[1] %}
              {% assign display_name = measurement_parts[2] %}

              <!-- {{ alpha_label }}: {{ display_name }} -->
              <tr class="size-fit-table__data-row">
                <td
                  colspan="{{ size_count }}"
                  class="size-fit-table__data-cell size-fit-table__sticky-cell type_name text-center"
                >
                  <span
                    ><span class="alpha">{{ alpha_label }}</span> {{ display_name }} (cm)</span
                  >
                </td>
              </tr>
              <tr class="size-fit-table__data-row">
                {% for size_data in measurements %}
                  {% assign size_measurements = size_data[1].measurements %}
                  <td class="size-fit-table__data-cell">
                    {% assign field_value = size_measurements[field_name] %}
                    {% if field_value and field_value != blank and field_value != 0 %}
                      <span
                        class="measurement-value"
                        data-cm="{{ field_value }}"
                        data-in="{{ field_value | divided_by: 2.54 | round: 1 }}"
                      >
                        {{ field_value }}
                      </span>
                    {% else %}
                      -
                    {% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="text-center py-8">
      <p class="text-gray-500">No product measurements available for this item.</p>
    </div>
  {% endif %}

  <!-- Product Measurement Guide -->
  <div class="mt-8">
    <h3 class="text-lg font-bold mb-4">How to measure the product?</h3>
    <div class="text-sm text-gray-600">
      <p>
        These measurements are taken directly from the garment and can be used to compare with your existing clothes.
      </p>
    </div>
  </div>
</div>

<style>
  .size_table_product .type_name {
    font-weight: 500;
    background-color: #f8f9fa;
  }

  .size_table_product .alpha {
    display: inline-block;
    width: 20px;
    height: 20px;
    background-color: #000;
    color: #fff;
    border-radius: 50%;
    text-align: center;
    line-height: 20px;
    font-size: 12px;
    font-weight: bold;
    margin-right: 8px;
  }

  .size_table_product th {
    background-color: #f1f5f9;
    font-weight: 600;
  }

  .size_table_product td,
  .size_table_product th {
    padding: 12px;
    border: 1px solid #e2e8f0;
    text-align: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Sort size columns in measurement table
    const sizeTable = document.querySelector('.size_table_product');
    if (!sizeTable) return;

    const sizeOrder = {{ size_order | json }};
    const headerRow = sizeTable.querySelector('tr:first-child');
    const measurementRows = sizeTable.querySelectorAll('tr:not(:first-child)');

    if (!headerRow) return;

    // Get header cells (size names)
    const headerCells = Array.from(headerRow.querySelectorAll('th'));
    if (headerCells.length === 0) return;

    // Create array of column data with original index
    const columns = headerCells.map((cell, index) => ({
      size: cell.textContent.trim(),
      index: index,
      headerCell: cell
    }));

    // Sort columns by size order
    columns.sort((a, b) => {
      const aIndex = sizeOrder.indexOf(a.size);
      const bIndex = sizeOrder.indexOf(b.size);

      // If size not found in order, put it at the end
      if (aIndex === -1 && bIndex === -1) return 0;
      if (aIndex === -1) return 1;
      if (bIndex === -1) return -1;

      return aIndex - bIndex;
    });

    // Reorder header cells
    const sortedHeaderCells = columns.map(col => col.headerCell);
    headerRow.innerHTML = '';
    sortedHeaderCells.forEach(cell => headerRow.appendChild(cell));

    // Reorder measurement cells in each row
    measurementRows.forEach(row => {
      const cells = Array.from(row.querySelectorAll('td'));
      if (cells.length === 0) return;

      // Skip rows that are measurement type headers (have colspan)
      if (cells.length === 1 && cells[0].hasAttribute('colspan')) return;

      const sortedCells = columns.map(col => cells[col.index]).filter(cell => cell);
      row.innerHTML = '';
      sortedCells.forEach(cell => row.appendChild(cell));
    });
  });
</script>
