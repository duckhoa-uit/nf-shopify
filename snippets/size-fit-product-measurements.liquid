                  {% if size_measurements.thigh_half_crotch %}
                    <span
                      class="measurement-value"
                      data-cm="{{ size_measurements.thigh_half_crotch }}"
                      data-in="{{ size_measurements.thigh_half_crotch | divided_by: 2.54 | round: 1 }}"
                    >
                      {{ size_measurements.thigh_half_crotch }}
                    </span>
                  {% else %}
                    -
                  {% endif %}
                </td>
              {% endfor %}
            </tr>

            <!-- J: 1/2 Bottom Legs -->
            <tr class="size-fit-table__data-row">
              <td colspan="{{ size_count }}" class="size-fit-table__data-cell size-fit-table__sticky-cell type_name text-center">
                <span><span class="alpha">J</span> 1/2 bottom legs (cm)</span>
              </td>
            </tr>
            <tr class="size-fit-table__data-row">
              {% for size_data in measurements %}
                {% assign size_measurements = size_data[1].measurements %}
                <td class="size-fit-table__data-cell">
                  {% if size_measurements.bottom_legs_half %}
                    <span
                      class="measurement-value"
                      data-cm="{{ size_measurements.bottom_legs_half }}"
                      data-in="{{ size_measurements.bottom_legs_half | divided_by: 2.54 | round: 1 }}"
                    >
                      {{ size_measurements.bottom_legs_half }}
                    </span>
                  {% else %}
                    -
                  {% endif %}
                </td>
              {% endfor %}
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="text-center py-8">
      <p class="text-gray-500">No product measurements available for this item.</p>
    </div>
  {% endif %}

  <!-- Product Measurement Guide -->
  <div class="mt-8">
    <h3 class="text-lg font-bold mb-4">How to measure the product?</h3>
    <div class="text-sm text-gray-600">
      <p>
        These measurements are taken directly from the garment and can be used to compare with your existing clothes.
      </p>
    </div>
  </div>
</div>

<style>
  .size_table_product .type_name {
    font-weight: 500;
    background-color: #f8f9fa;
  }

  .size_table_product .alpha {
    display: inline-block;
    width: 20px;
    height: 20px;
    background-color: #000;
    color: #fff;
    border-radius: 50%;
    text-align: center;
    line-height: 20px;
    font-size: 12px;
    font-weight: bold;
    margin-right: 8px;
  }

  .size_table_product th {
    background-color: #f1f5f9;
    font-weight: 600;
  }

  .size_table_product td,
  .size_table_product th {
    padding: 12px;
    border: 1px solid #e2e8f0;
    text-align: center;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Sort size columns in measurement table
  const sizeTable = document.querySelector('.size_table_product');
  if (!sizeTable) return;

  const sizeOrder = {{ size_order | json }};
  const headerRow = sizeTable.querySelector('tr:first-child');
  const measurementRows = sizeTable.querySelectorAll('tr:not(:first-child)');

  if (!headerRow) return;

  // Get header cells (size names)
  const headerCells = Array.from(headerRow.querySelectorAll('th'));
  if (headerCells.length === 0) return;

  // Create array of column data with original index
  const columns = headerCells.map((cell, index) => ({
    size: cell.textContent.trim(),
    index: index,
    headerCell: cell
  }));

  // Sort columns by size order
  columns.sort((a, b) => {
    const aIndex = sizeOrder.indexOf(a.size);
    const bIndex = sizeOrder.indexOf(b.size);

    // If size not found in order, put it at the end
    if (aIndex === -1 && bIndex === -1) return 0;
    if (aIndex === -1) return 1;
    if (bIndex === -1) return -1;

    return aIndex - bIndex;
  });

  // Reorder header cells
  const sortedHeaderCells = columns.map(col => col.headerCell);
  headerRow.innerHTML = '';
  sortedHeaderCells.forEach(cell => headerRow.appendChild(cell));

  // Reorder measurement cells in each row
  measurementRows.forEach(row => {
    const cells = Array.from(row.querySelectorAll('td'));
    if (cells.length === 0) return;

    // Skip rows that are measurement type headers (have colspan)
    if (cells.length === 1 && cells[0].hasAttribute('colspan')) return;

    const sortedCells = columns.map(col => cells[col.index]).filter(cell => cell);
    row.innerHTML = '';
    sortedCells.forEach(cell => row.appendChild(cell));
  });
});
</script>
