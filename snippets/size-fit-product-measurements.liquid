    border-radius: 50%;
    text-align: center;
    line-height: 20px;
    font-size: 12px;
    font-weight: bold;
    margin-right: 8px;
  }

  .size_table_product th {
    background-color: #f1f5f9;
    font-weight: 600;
  }

  .size_table_product td,
  .size_table_product th {
    padding: 12px;
    border: 1px solid #e2e8f0;
    text-align: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Sort size columns in measurement table
    const sizeTable = document.querySelector('.size_table_product');
    if (!sizeTable) return;

    const sizeOrder = {{ size_order | json }};
    const headerRow = sizeTable.querySelector('tr:first-child');
    const measurementRows = sizeTable.querySelectorAll('tr:not(:first-child)');

    if (!headerRow) return;

    // Get header cells (size names)
    const headerCells = Array.from(headerRow.querySelectorAll('th'));
    if (headerCells.length === 0) return;

    // Create array of column data with original index
    const columns = headerCells.map((cell, index) => ({
      size: cell.textContent.trim(),
      index: index,
      headerCell: cell
    }));

    // Sort columns by size order
    columns.sort((a, b) => {
      const aIndex = sizeOrder.indexOf(a.size);
      const bIndex = sizeOrder.indexOf(b.size);

      // If size not found in order, put it at the end
      if (aIndex === -1 && bIndex === -1) return 0;
      if (aIndex === -1) return 1;
      if (bIndex === -1) return -1;

      return aIndex - bIndex;
    });

    // Reorder header cells
    const sortedHeaderCells = columns.map(col => col.headerCell);
    headerRow.innerHTML = '';
    sortedHeaderCells.forEach(cell => headerRow.appendChild(cell));

    // Reorder measurement cells in each row
    measurementRows.forEach(row => {
      const cells = Array.from(row.querySelectorAll('td'));
      if (cells.length === 0) return;

      // Skip rows that are measurement type headers (have colspan)
      if (cells.length === 1 && cells[0].hasAttribute('colspan')) return;

      const sortedCells = columns.map(col => cells[col.index]).filter(cell => cell);
      row.innerHTML = '';
      sortedCells.forEach(cell => row.appendChild(cell));
    });
  });
</script>
