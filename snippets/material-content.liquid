{%- liquid
  assign show_title_above_media_on_mobile = show_title_above_media_on_mobile | default: false
-%}

<div class="single-material{% if show_title_above_media_on_mobile %} title-above-media-mobile{% endif %}">
  {%- if show_title_above_media_on_mobile and block.settings.title != blank -%}
    <h3 class="material-title material-title-mobile text-sm mb-2">{{ block.settings.title }}</h3>
  {%- endif -%}

  {%- if block.settings.video_url != blank -%}
    <div class="material-video-container aspect-video">
      {%- assign video_id = block.settings.video_url | split: '/' | last -%}
      {%- if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' -%}
        {%- # Extract YouTube ID -%}
        {%- if block.settings.video_url contains 'v=' -%}
          {%- assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first -%}
        {%- elsif block.settings.video_url contains 'youtu.be/' -%}
          {%- assign video_id = block.settings.video_url | split: 'youtu.be/' | last -%}
        {%- endif -%}
        <div class="material-video youtube-video">
          <iframe
            src="https://www.youtube.com/embed/{{ video_id }}?rel=0&showinfo=0&controls=1"
            frameborder="0"
            allowfullscreen
            loading="lazy"
            title="{{ block.settings.title | escape }}"
            class="w-full h-full">
          </iframe>
        </div>
      {%- elsif block.settings.video_url contains 'vimeo.com' -%}
        {%- # Extract Vimeo ID -%}
        {%- assign video_id = block.settings.video_url | split: '/' | last -%}
        <div class="material-video vimeo-video">
          <iframe
            src="https://player.vimeo.com/video/{{ video_id }}?title=0&byline=0&portrait=0"
            frameborder="0"
            allowfullscreen
            loading="lazy"
            title="{{ block.settings.title | escape }}"
            class="w-full h-full">
          </iframe>
        </div>
      {%- else -%}
        <div class="material-video generic-video">
          <video
            controls
            class="w-full h-full"
            preload="metadata"
            poster="{{ block.settings.image | image_url: width: 1100 }}"
          >
            <source src="{{ block.settings.video_url }}" type="video/mp4"><!-- Direct URL used for MP4 videos -->
            {{ 'video.no_support' | t }}
          </video>
        </div>
      {%- endif -%}
    </div>
  {%- elsif block.settings.image != blank -%}
    <div class="material-image-container">
      <img
        srcset="
          {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
          {%- if block.settings.image.width >= 550 -%}{{ block.settings.image | image_url: width: 550 }} 550w,{%- endif -%}
          {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
          {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
          {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
        "
        src="{{ block.settings.image | image_url: width: 1100 }}"
        sizes="(min-width: 750px) 50vw, 100vw"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="material-image aspect-video"
      >
    </div>
  {%- else -%}
    <div class="material-image-container bg-foreground/10 flex items-center justify-center aspect-video">
      {{ 'image' | placeholder_svg_tag: 'w-full h-full text-foreground/50' }}
    </div>
  {%- endif -%}

  <div class="material-content">
    {%- if block.settings.title != blank -%}
      <h3 class="material-title {% if show_title_above_media_on_mobile %}material-title-desktop{% endif %} text-sm lg:text-2xl mb-2 lg:mb-6">{{ block.settings.title }}</h3>
    {%- endif -%}


    {%- if block.settings.description != blank -%}
      <div class="material-description [&_p]:m-0 leading-5 text-sm lg:leading-6 lg:text-base">{{ block.settings.description }}</div>
    {%- endif -%}

    {%- if block.settings.button_url != blank -%}
      <a href="{{ block.settings.button_url | default: '#' }}" class="material-button mt-4 lg:mt-6 leading-4">
        {{ 'blogs.article.read_more' | t }}
      </a>
    {%- endif -%}
  </div>
</div>
