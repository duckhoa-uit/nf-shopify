{%- liquid
  assign show_title_above_media_on_mobile = show_title_above_media_on_mobile | default: false

  assign linked_article = block.settings.article

  # Image: manual override → article image
  assign resolved_image = block.settings.image
  if resolved_image == blank and linked_article != blank
    assign resolved_image = linked_article.image
  endif

  # Title: manual override → article title
  assign resolved_title = block.settings.title
  if resolved_title == blank and linked_article != blank
    assign resolved_title = linked_article.title
  endif

  # Description: manual override → article excerpt → truncated content
  assign resolved_description = block.settings.description
  if resolved_description == blank and linked_article != blank
    if linked_article.excerpt != blank
      assign resolved_description = linked_article.excerpt
    elsif linked_article.content != blank
      assign resolved_description = linked_article.content | strip_html | truncatewords: 30
    endif
  endif

  # Button URL: manual override → article URL (already locale-aware via Shopify)
  assign resolved_button_url = block.settings.button_url
  if resolved_button_url == blank and linked_article != blank
    assign resolved_button_url = linked_article.url
  endif
-%}

<div class="single-material{% if show_title_above_media_on_mobile %} title-above-media-mobile{% endif %}">
  {%- if show_title_above_media_on_mobile and resolved_title != blank -%}
    <h3 class="material-title material-title-mobile text-sm mb-2">{{ resolved_title }}</h3>
  {%- endif -%}

  {%- if block.settings.video_url != blank -%}
    <div class="material-video-container aspect-video">
      {%- assign video_id = block.settings.video_url | split: '/' | last -%}
      {%- if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' -%}
        {%- # Extract YouTube ID -%}
        {%- if block.settings.video_url contains 'v=' -%}
          {%- assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first -%}
        {%- elsif block.settings.video_url contains 'youtu.be/' -%}
          {%- assign video_id = block.settings.video_url | split: 'youtu.be/' | last -%}
        {%- endif -%}
        <div class="material-video youtube-video">
          <iframe
            src="https://www.youtube.com/embed/{{ video_id }}?rel=0&showinfo=0&controls=1"
            frameborder="0"
            allowfullscreen
            loading="lazy"
            title="{{ resolved_title | escape }}"
            class="w-full h-full">
          </iframe>
        </div>
      {%- elsif block.settings.video_url contains 'vimeo.com' -%}
        {%- # Extract Vimeo ID -%}
        {%- assign video_id = block.settings.video_url | split: '/' | last -%}
        <div class="material-video vimeo-video">
          <iframe
            src="https://player.vimeo.com/video/{{ video_id }}?title=0&byline=0&portrait=0"
            frameborder="0"
            allowfullscreen
            loading="lazy"
            title="{{ resolved_title | escape }}"
            class="w-full h-full">
          </iframe>
        </div>
      {%- else -%}
        <div class="material-video generic-video">
          <video
            controls
            class="w-full h-full"
            preload="metadata"
            poster="{{ resolved_image | image_url: width: 1100 }}"
          >
            <source src="{{ block.settings.video_url }}" type="video/mp4"><!-- Direct URL used for MP4 videos -->
            {{ 'video.no_support' | t }}
          </video>
        </div>
      {%- endif -%}
    </div>
  {%- elsif resolved_image != blank -%}
    <div class="material-image-container">
      <img
        srcset="
          {%- if resolved_image.width >= 375 -%}{{ resolved_image | image_url: width: 375 }} 375w,{%- endif -%}
          {%- if resolved_image.width >= 550 -%}{{ resolved_image | image_url: width: 550 }} 550w,{%- endif -%}
          {%- if resolved_image.width >= 750 -%}{{ resolved_image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if resolved_image.width >= 1100 -%}{{ resolved_image | image_url: width: 1100 }} 1100w,{%- endif -%}
          {%- if resolved_image.width >= 1500 -%}{{ resolved_image | image_url: width: 1500 }} 1500w,{%- endif -%}
          {{ resolved_image | image_url }} {{ resolved_image.width }}w
        "
        src="{{ resolved_image | image_url: width: 1100 }}"
        sizes="(min-width: 750px) 50vw, 100vw"
        alt="{{ resolved_image.alt | escape }}"
        loading="lazy"
        width="{{ resolved_image.width }}"
        height="{{ resolved_image.height }}"
        class="material-image aspect-video"
      >
    </div>
  {%- else -%}
    <div class="material-image-container bg-foreground/10 flex items-center justify-center aspect-video">
      {{ 'image' | placeholder_svg_tag: 'w-full h-full text-foreground/50' }}
    </div>
  {%- endif -%}

  <div class="material-content">
    {%- if resolved_title != blank -%}
      <h3 class="material-title {% if show_title_above_media_on_mobile %}material-title-desktop{% endif %} text-sm lg:text-2xl mb-2 lg:mb-6">{{ resolved_title }}</h3>
    {%- endif -%}


    {%- if resolved_description != blank -%}
      <div class="material-description [&_p]:m-0 leading-5 text-sm lg:leading-6 lg:text-base">{{ resolved_description }}</div>
    {%- endif -%}

    {%- if resolved_button_url != blank -%}
      <a href="{{ resolved_button_url }}" class="button button--primary font-semibold text-sm uppercase mt-4 lg:mt-6 leading-4">
        {{ 'blogs.article.read_more' | t }}
      </a>
    {%- endif -%}
  </div>
</div>
