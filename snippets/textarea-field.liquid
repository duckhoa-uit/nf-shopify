{% comment %}
  Reusable textarea field component

  Accepts:
  - id: Textarea ID
  - name: Textarea name
  - value: Textarea value
  - label: Label text
  - placeholder: Placeholder text (default: " ")
  - required: Whether the field is required (default: false)
  - readonly: Whether the field is readonly (default: false)
  - rows: Number of rows (default: 10)
  - class: Additional CSS classes
{% endcomment %}

{%- assign placeholder = placeholder | default: ' ' -%}
{%- assign required = required | default: false -%}
{%- assign readonly = readonly | default: false -%}
{%- assign rows = rows | default: 10 -%}

<div class="field{% if class %} {{ class }}{% endif %}">
  <textarea
    id="{{ id }}"
    name="{{ name }}"
    class="text-area field__input"
    rows="{{ rows }}"
    placeholder="{{ placeholder }}"
    {% if required %}
      required
    {% endif %}
    {% if readonly %}
      readonly
    {% endif %}
  >{{ value | default: '' }}</textarea>
  <label class="field__label" for="{{ id }}">
    {% if label contains 'customer.' or label contains 'general.' or label contains 'templates.' %}
      {{ label | t }}
    {% else %}
      {{ label }}
    {% endif %}
    {% if required %}
      <span aria-hidden="true">*</span>
    {% endif %}
  </label>
</div>
