{% comment %}
  Get variant color image based on color name

  Accepts:
  - product: {Object} product object
  - color_value: {String} color value to find image for
  - width: {Number} width of the image (default: 100)
  - height: {Number} height of the image (default: 100)
  - crop: {String} crop mode (default: 'center')
  - image_type: {String} optional image type to filter by (M, H, B, BV, D)

  Usage:
  {% render 'get-variant-color-image',
    product: product,
    color_value: color_value,
    width: 100,
    height: 100,
    crop: 'center',
    image_type: 'M'
  %}
{% endcomment %}

{% assign width = width | default: 100 %}
{% assign height = height | default: 100 %}
{% assign crop = crop | default: 'center' %}
{% assign image_type = image_type | default: '' %}

{% comment %} Use the product-color-utils to get the image URL {% endcomment %}
{% capture image_url %}{% render 'product-color-utils',
  with: 'get_color_image',
  product: product,
  color_value: color_value,
  image_type: image_type,
  width: width,
  height: height,
  crop: crop
%}{% endcapture %}
{% assign image_url = image_url | strip %}

{% comment %} Output the image_url variable directly to make it accessible to the parent template {% endcomment %}
{%- if image_url != blank -%}{{ image_url }}{%- endif -%}
