{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign sorted_indices = ''

  # Option detection based on swatches and standard size patterns
  assign is_color_option = false
  assign is_size_option = false

  # Check if this option has swatches - indicates it's a color option
  assign swatch_count = option.values | map: 'swatch' | compact | size

  if swatch_count > 0
    assign is_color_option = true
  endif

  # Check if option name indicates it's a size option (multi-language support)
  assign option_name_lower = option.name | downcase
  assign size_keywords = 'size,größe,taille,talla,taglia,størrelse,storlek,veličina,размер,veľkosť,尺寸,rozmiar,tamanho,koko,maat,サイズ,사이즈' | split: ','
  for size_keyword in size_keywords
    if option_name_lower contains size_keyword
      assign is_size_option = true
      break
    endif
  endfor

  # Check if option values match standard size patterns
  # Standard sizes to detect: XXS, XS, S, M, L, XL, XXL, 2XL, 3XL, 4XL, 5XL, 6XL
  assign standard_sizes_pattern = 'XXS,XS,S,M,L,XL,XXL,2XL,3XL,4XL,5XL,6XL' | split: ','
  assign size_match_count = 0

  for value in option.values
    # Get string representation of value (works with both object and string)
    capture value_str
      echo value
    endcapture
    assign value_upcase = value_str | upcase | strip
    for standard_size in standard_sizes_pattern
      if value_upcase == standard_size
        assign size_match_count = size_match_count | plus: 1
        break
      endif
    endfor
  endfor

  # If at least 2 values match standard sizes, treat as size option
  if size_match_count >= 2
    assign is_size_option = true
  endif

  # Fallback: if position 1 and not detected as size, treat as color
  if option.position == 1 and is_size_option == false
    assign is_color_option = true
  endif

  # NEW: Stock-based filtering for color options
  assign available_color_values = ''
  assign available_colors_array = ''
  assign fallback_color_value = null
  assign fallback_color_name = ''
  assign fallback_render_mode = false

  # Determine fallback color to display if all variants are unavailable
  assign selected_color_name = option.selected_value

  if selected_color_name
    assign fallback_color_value = option.values | where: 'name', selected_color_name | first
  endif

  if fallback_color_value == null
    assign fallback_color_value = option.values.first
  endif

  if fallback_color_value
    assign fallback_color_name = fallback_color_value.name | default: fallback_color_value
  endif

  if is_color_option
    # Filter color options to only show those with available stock
    # Must check at variant level to exclude variants with inventory_management: null
    # (These show available=true but have no actual tracked stock)
    for value in option.values
      assign value_name = value.name | default: value
      assign has_truly_available_variant = false
      
      # Check each variant to see if any has real stock (inventory_management != null)
      for variant in product.variants
        case option.position
          when 1
            assign variant_option_value = variant.option1
          when 2
            assign variant_option_value = variant.option2
          when 3
            assign variant_option_value = variant.option3
        endcase
        
        if variant_option_value == value_name and variant.available and variant.inventory_management != blank
          assign has_truly_available_variant = true
          break
        endif
      endfor
      
      if has_truly_available_variant
        if available_color_values == ''
          assign available_color_values = value
        else
          assign available_color_values = available_color_values | append: ',' | append: value
        endif
      endif
    endfor

    # Convert to array for iteration
    if available_color_values != ''
      assign available_colors_array = available_color_values | split: ','
    endif

    if available_colors_array == '' and fallback_color_name != ''
      assign fallback_render_mode = true
      assign available_colors_array = fallback_color_name | split: '|||'
    endif
  endif

  # Only do sorting for Color and Size options
  if is_color_option and product.metafields.custom.color.value != blank
    assign metafield_colors = product.metafields.custom.color.value

    # Build position data for each value with index
    for index in (0..option.values.size)
      if option.values[index] != blank
        assign value = option.values[index]
        assign value_downcase = value | downcase
        assign position = 999

        # Find matching metafield position
        for metafield_color in metafield_colors
          if value_downcase == metafield_color.name
            assign position = metafield_color.position
            break
          endif
        endfor

        # Format for sorting
        assign position_str = position | prepend: '00000' | slice: -5, 5
        assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
      endif
    endfor

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  elsif is_size_option
    # Standard size order fallback (common clothing sizes)
    assign standard_size_order = 'XXS,XS,S,M,L,XL,XXL,2XL,3XL,4XL,5XL,6XL' | split: ','

    if product.metafields.custom.size.value != blank
      assign metafield_sizes = product.metafields.custom.size.value
      
      # Check if metafield has valid position data (not all zeros)
      assign has_valid_positions = false
      for metafield_size in metafield_sizes
        if metafield_size.position > 0
          assign has_valid_positions = true
          break
        endif
      endfor

      if has_valid_positions
        # Build position data for each value with index using metafield
        for index in (0..option.values.size)
          if option.values[index] != blank
            assign value = option.values[index]
            capture value_str
              echo value
            endcapture
            assign value_str = value_str | strip
            assign position = 999

            # Find matching metafield position
            for metafield_size in metafield_sizes
              assign metafield_size_str = metafield_size.value | strip
              assign metafield_pos = metafield_size.position
              if value_str == metafield_size_str
                assign position = metafield_pos
                break
              endif
            endfor

            # Format for sorting
            assign position_str = position | prepend: '00000' | slice: -5, 5
            assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
          endif
        endfor
      else
        # Metafield exists but has no valid positions - use standard size order
        for index in (0..option.values.size)
          if option.values[index] != blank
            assign value = option.values[index]
            capture value_str
              echo value
            endcapture
            assign value_upcase = value_str | upcase | strip
            assign position = 999

            # Find position in standard size order
            for standard_size in standard_size_order
              if value_upcase == standard_size
                assign position = forloop.index0
                break
              endif
            endfor

            # Format for sorting
            assign position_str = position | prepend: '00000' | slice: -5, 5
            assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
          endif
        endfor
      endif
    else
      # Fallback: Use standard size order when metafield is not available
      for index in (0..option.values.size)
        if option.values[index] != blank
          assign value = option.values[index]
          # Get string representation of value (works with both object and string)
          capture value_str
            echo value
          endcapture
          assign value_upcase = value_str | upcase | strip
          assign position = 999

          # Find position in standard size order
          for standard_size in standard_size_order
            if value_upcase == standard_size
              assign position = forloop.index0
              break
            endif
          endfor

          # Format for sorting
          assign position_str = position | prepend: '00000' | slice: -5, 5
          assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
        endif
      endfor
    endif

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  endif
-%}

{% comment %}
  Render options in sorted order if available, otherwise use original order
{% endcomment %}

{%- if sorted_indices.size > 0 -%}
  {%- for position_index in sorted_indices -%}
    {%- if position_index != blank -%}
      {%- assign parts = position_index | split: '_' -%}
      {%- if parts.size > 1 -%}
        {%- assign index = parts[1] | plus: 0 -%}
        {%- assign value = option.values[index] -%}

        {%- liquid
          # Common properties for both options
          assign option_disabled = true
          if value.available
            assign option_disabled = false
          endif

          # Create input ID and names
          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
          assign input_name = option.name | append: '-' | append: option.position

          # Set up dataset properties
          assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
          assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

          # Note: Swatch properties handled in swatch-input component
        -%}

        {%- if is_size_option -%}
          <div class="attribute_radio" data-size-option="{{ value | escape }}">
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ input_name | escape }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if value.selected %}
                checked
              {% endif %}
              {% if option_disabled %}
                class="disabled" disabled
              {% endif %}
              {{ input_dataset }}
              data-size-value="{{ value | escape }}"
            >
            <label for="{{ input_id }}">
              {{ value }}
              {% if option_disabled %}
                <span class="visually-hidden label-unavailable">
                  {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
                </span>
              {% endif %}
            </label>
          </div>
        {%- elsif is_color_option -%}
          {%- comment -%} Skip color rendering in sorted section - will be handled separately {%- endcomment -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- for value in option.values -%}
    {%- liquid
      # Common properties for both options
      assign option_disabled = true
      if value.available
        assign option_disabled = false
      endif

      # Create input ID and names
      assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
      assign input_name = option.name | append: '-' | append: option.position

      # Set up dataset properties
      assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
      assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

      # Note: Swatch properties handled in swatch-input component
    -%}

    {%- if is_size_option -%}
      <div class="attribute_radio" data-size-option="{{ value | escape }}">
        <input
          type="radio"
          id="{{ input_id }}"
          name="{{ input_name | escape }}"
          value="{{ value | escape }}"
          form="{{ product_form_id }}"
          {% if value.selected %}
            checked
          {% endif %}
          {% if option_disabled %}
            class="disabled" disabled
          {% endif %}
          {{ input_dataset }}
          data-size-value="{{ value | escape }}"
        >
        <label for="{{ input_id }}">
          {{ value }}
          {% if option_disabled %}
            <span class="visually-hidden label-unavailable">
              {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
            </span>
          {% endif %}
        </label>
      </div>
    {%- elsif is_color_option -%}
      {%- comment -%} Skip color rendering in unsorted section - will be handled separately {%- endcomment -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% comment %}
  NEW: Stock-based color filtering implementation
  Render color options separately with availability filtering
{% endcomment %}
{%- if is_color_option -%}
  {%- if available_colors_array != '' and available_colors_array.size > 0 -%}
    {%- comment -%} Render available colors or fallback color {%- endcomment -%}
    {%- for color_name in available_colors_array -%}
      {%- assign color_name_normalized = color_name | strip -%}
      {%- assign value = option.values | where: 'name', color_name_normalized | first -%}
      {%- if value == blank and fallback_render_mode and color_name_normalized == fallback_color_name -%}
        {%- assign value = fallback_color_value -%}
      {%- endif -%}

      {%- if value -%}
        {%- liquid
          assign is_fallback_color = false
          if fallback_render_mode and color_name_normalized == fallback_color_name
            assign is_fallback_color = true
          endif

          assign option_disabled = false
          assign data_available_state = 'false'
          if value.available
            assign data_available_state = 'true'
          endif

          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
          assign input_name = option.name | append: '-' | append: option.position

          assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
          assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

          assign color_value = value | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '.', '' | replace: ',', ''
        -%}

        {%- capture help_text -%}
          <span class="visually-hidden">{{ value | escape }}</span>
        {%- endcapture -%}

        {%- if show_thumbnails -%}
          {% comment %} Generate thumbnail URL {% endcomment %}
          {% capture thumbnail_url %}{% render 'get-variant-color-image',
            product: product,
            color_value: color_value,
            width: 80,
            height: 80,
            crop: 'center',
            image_type: 'M'
          %}{% endcapture %}

          {%- liquid
            assign thumbnail_url = thumbnail_url | strip
          -%}

          <div class="color-option-with-thumbnail" data-color-name="{{ value }}" data-available="{{ data_available_state }}">
            {%
              render 'swatch-input',
              id: input_id,
              name: input_name,
              value: value | escape,
              swatch: value.swatch,
              product_form_id: product_form_id,
              checked: value.selected,
              shape: block.settings.swatch_shape,
              help_text: help_text,
              additional_props: input_dataset,
              thumbnail_url: thumbnail_url
            %}
          </div>
        {%- else -%}
          {%
            render 'swatch-input',
            id: input_id,
            name: input_name,
            value: value | escape,
            swatch: value.swatch,
            product_form_id: product_form_id,
            checked: value.selected,
            shape: block.settings.swatch_shape,
            help_text: help_text,
            additional_props: input_dataset
          %}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

  {%- endif -%}
{%- endif -%}
