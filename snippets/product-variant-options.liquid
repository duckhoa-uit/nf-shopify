{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign sorted_indices = ''

  # Position-based option detection for internationalization
  # Color is typically position 1, Size is typically position 2
  assign is_color_option = false
  assign is_size_option = false

  # Check if this is a color option FIRST (higher priority)
  assign swatch_count = option.values | map: 'swatch' | compact | size

  if option.position == 1
    assign is_color_option = true
  endif

  if swatch_count > 0
    assign is_color_option = true
  endif

  # Only check for size option if it's NOT already identified as color
  unless is_color_option
    if option.position == 2
      assign is_size_option = true
    endif
  endunless

  # NEW: Stock-based filtering for color options
  assign available_color_values = ''
  assign available_colors_array = ''

  if is_color_option
    # Filter color options to only show those with available stock
    for value in option.values
      if value.available
        if available_color_values == ''
          assign available_color_values = value
        else
          assign available_color_values = available_color_values | append: ',' | append: value
        endif
      endif
    endfor

    # Convert to array for iteration
    if available_color_values != ''
      assign available_colors_array = available_color_values | split: ','
    endif
  endif

  # Only do sorting for Color and Size options
  if is_color_option and product.metafields.custom.color.value != blank
    assign metafield_colors = product.metafields.custom.color.value

    # Build position data for each value with index
    for index in (0..option.values.size)
      if option.values[index] != blank
        assign value = option.values[index]
        assign value_downcase = value | downcase
        assign position = 999

        # Find matching metafield position
        for metafield_color in metafield_colors
          if value_downcase == metafield_color.name
            assign position = metafield_color.position
            break
          endif
        endfor

        # Format for sorting
        assign position_str = position | prepend: '00000' | slice: -5, 5
        assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
      endif
    endfor

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  elsif is_size_option and product.metafields.custom.size.value != blank
    assign metafield_sizes = product.metafields.custom.size.value

    # Build position data for each value with index
    for index in (0..option.values.size)
      if option.values[index] != blank
        assign value = option.values[index]
        assign position = 999

        # Find matching metafield position
        for metafield_size in metafield_sizes
          if value == metafield_size.value
            assign position = metafield_size.position
            break
          endif
        endfor

        # Format for sorting
        assign position_str = position | prepend: '00000' | slice: -5, 5
        assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
      endif
    endfor

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  endif
-%}

{% comment %}
  Render options in sorted order if available, otherwise use original order
{% endcomment %}

{%- if sorted_indices.size > 0 -%}
  {%- for position_index in sorted_indices -%}
    {%- if position_index != blank -%}
      {%- assign parts = position_index | split: '_' -%}
      {%- if parts.size > 1 -%}
        {%- assign index = parts[1] | plus: 0 -%}
        {%- assign value = option.values[index] -%}

        {%- liquid
          # Common properties for both options
          assign option_disabled = true
          if value.available
            assign option_disabled = false
          endif

          # Create input ID and names
          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
          assign input_name = option.name | append: '-' | append: option.position

          # Set up dataset properties
          assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
          assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

          # Note: Swatch properties handled in swatch-input component
        -%}

        {%- if is_size_option -%}
          <div class="attribute_radio">
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ input_name | escape }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if value.selected %}
                checked
              {% endif %}
              {% if option_disabled %}
                class="disabled" disabled
              {% endif %}
              {{ input_dataset }}
            >
            <label for="{{ input_id }}">
              {{ value }}
              {% if option_disabled %}
                <span class="visually-hidden label-unavailable">
                  {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
                </span>
              {% endif %}
            </label>
          </div>
        {%- elsif is_color_option -%}
          {%- comment -%} Skip color rendering in sorted section - will be handled separately {%- endcomment -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- for value in option.values -%}
    {%- liquid
      # Common properties for both options
      assign option_disabled = true
      if value.available
        assign option_disabled = false
      endif

      # Create input ID and names
      assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
      assign input_name = option.name | append: '-' | append: option.position

      # Set up dataset properties
      assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
      assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

      # Note: Swatch properties handled in swatch-input component
    -%}

    {%- if is_size_option -%}
      <div class="attribute_radio">
        <input
          type="radio"
          id="{{ input_id }}"
          name="{{ input_name | escape }}"
          value="{{ value | escape }}"
          form="{{ product_form_id }}"
          {% if value.selected %}
            checked
          {% endif %}
          {% if option_disabled %}
            class="disabled" disabled
          {% endif %}
          {{ input_dataset }}
        >
        <label for="{{ input_id }}">
          {{ value }}
          {% if option_disabled %}
            <span class="visually-hidden label-unavailable">
              {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
            </span>
          {% endif %}
        </label>
      </div>
    {%- elsif is_color_option -%}
      {%- comment -%} Skip color rendering in unsorted section - will be handled separately {%- endcomment -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% comment %}
  NEW: Stock-based color filtering implementation
  Render color options separately with availability filtering
{% endcomment %}
{%- if is_color_option -%}
  {%- if available_colors_array.size > 0 -%}
    {%- comment -%} Render available colors only {%- endcomment -%}
    {%- for color_name in available_colors_array -%}
      {%- assign value = option.values | where: 'name', color_name | first -%}
      {%- if value -%}
        {%- liquid
          # Since we pre-filtered, all colors here are available
          assign option_disabled = false

          # Create input ID and names
          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
          assign input_name = option.name | append: '-' | append: option.position

          # Set up dataset properties
          assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
          assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

          # Color value processing for thumbnail
          assign color_value = value | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '.', '' | replace: ',', ''
        -%}

        {%- capture help_text -%}
          <span class="visually-hidden">{{ value | escape }}</span>
        {%- endcapture -%}

        {%- if show_thumbnails -%}
          {% comment %} Generate thumbnail URL {% endcomment %}
          {% capture thumbnail_url %}{% render 'get-variant-color-image',
            product: product,
            color_value: color_value,
            width: 80,
            height: 80,
            crop: 'center',
            image_type: 'M'
          %}{% endcapture %}

          {%- liquid
            assign thumbnail_url = thumbnail_url | strip
          -%}

          <div class="color-option-with-thumbnail" data-color-name="{{ value }}" data-available="true">
            {%
              render 'swatch-input',
              id: input_id,
              name: input_name,
              value: value | escape,
              swatch: value.swatch,
              product_form_id: product_form_id,
              checked: value.selected,
              visually_disabled: false,
              shape: block.settings.swatch_shape,
              help_text: help_text,
              additional_props: input_dataset,
              thumbnail_url: thumbnail_url
            %}
          </div>
        {%- else -%}
          {%
            render 'swatch-input',
            id: input_id,
            name: input_name,
            value: value | escape,
            swatch: value.swatch,
            product_form_id: product_form_id,
            checked: value.selected,
            visually_disabled: false,
            shape: block.settings.swatch_shape,
            help_text: help_text,
            additional_props: input_dataset
          %}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- comment -%} No colors available - show message {%- endcomment -%}
    <div class="color-options-unavailable">
      <div class="no-stock-message bg-gray-50 border border-gray-200 rounded-lg p-4 text-center">
        <svg class="w-8 h-8 mx-auto mb-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2 2v-5m16 0h-2M4 13h2m0 0V9a2 2 0 012-2h2m0 0V6a2 2 0 012-2h2.09M9 9h6m6 0a2 2 0 012 2v1M9 9V6a2 2 0 012-2h2.09"></path>
        </svg>
        <p class="text-sm font-medium text-gray-900 mb-1">
          All colors currently out of stock
        </p>
        <p class="text-xs text-gray-500">
          Check back later for availability
        </p>
      </div>
    </div>
  {%- endif -%}


{%- endif -%}
