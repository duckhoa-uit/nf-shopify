{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign sorted_indices = ''

  # Only do sorting for Color and Size options
  if option.name == 'Color' and product.metafields.custom.color.value != blank
    assign metafield_colors = product.metafields.custom.color.value

    # Build position data for each value with index
    for index in (0..option.values.size)
      if option.values[index] != blank
        assign value = option.values[index]
        assign value_downcase = value | downcase
        assign position = 999

        # Find matching metafield position
        for metafield_color in metafield_colors
          if value_downcase == metafield_color.name
            assign position = metafield_color.position
            break
          endif
        endfor

        # Format for sorting
        assign position_str = position | prepend: '00000' | slice: -5, 5
        assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
      endif
    endfor

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  elsif option.name == 'Size' and product.metafields.custom.size.value != blank
    assign metafield_sizes = product.metafields.custom.size.value

    # Build position data for each value with index
    for index in (0..option.values.size)
      if option.values[index] != blank
        assign value = option.values[index]
        assign position = 999

        # Find matching metafield position
        for metafield_size in metafield_sizes
          if value == metafield_size.value
            assign position = metafield_size.position
            break
          endif
        endfor

        # Format for sorting
        assign position_str = position | prepend: '00000' | slice: -5, 5
        assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
      endif
    endfor

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  endif
-%}

{% comment %}
  Render options in sorted order if available, otherwise use original order
{% endcomment %}

{%- if sorted_indices.size > 0 -%}
  {%- for position_index in sorted_indices -%}
    {%- if position_index != blank -%}
      {%- assign parts = position_index | split: '_' -%}
      {%- if parts.size > 1 -%}
        {%- assign index = parts[1] | plus: 0 -%}
        {%- assign value = option.values[index] -%}

        {%- liquid
          # Common properties for both options
          assign option_disabled = true
          if value.available
            assign option_disabled = false
          endif

          # Create input ID and names
          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
          assign input_name = option.name | append: '-' | append: option.position

          # Set up dataset properties
          assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
          assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

          # Set up any swatch properties for color options
          assign swatch_value = null
          assign swatch_focal_point = null
          if value.swatch.image
            assign image_url = value.swatch.image | image_url: width: 50
            assign swatch_value = 'url(' | append: image_url | append: ')'
            assign swatch_focal_point = value.swatch.image.presentation.focal_point
          elsif value.swatch.color
            assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
          endif
        -%}

        {%- if option.name == 'Size' -%}
          <div class="attribute_radio">
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ input_name | escape }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if value.selected %}
                checked
              {% endif %}
              {% if option_disabled %}
                class="disabled" disabled
              {% endif %}
              {{ input_dataset }}
            >
            <label for="{{ input_id }}">
              {{ value }}
              {% if option_disabled %}
                <span class="visually-hidden label-unavailable">
                  {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
                </span>
              {% endif %}
            </label>
          </div>
        {%- elsif option.name == 'Color' -%}
          {%- capture help_text -%}
            <span class="visually-hidden">{{ value | escape }}</span>
            {% if option_disabled %}
              <span class="visually-hidden label-unavailable">
                {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
              </span>
            {% endif %}
          {%- endcapture -%}

          {%- if show_thumbnails -%}
            {%- liquid
              assign color_value = value | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '.', '' | replace: ',', ''

              # Use our improved get-variant-color-image snippet to find the image
            -%}
            {% capture thumbnail_url %}{% render 'get-variant-color-image',
              product: product,
              color_value: color_value,
              width: 80,
              height: 80,
              crop: 'center'
            %}{% endcapture %}
            {%- liquid
              # Clean up any whitespace in the captured URL
              assign thumbnail_url = thumbnail_url | strip
            -%}

            <div class="color-option-with-thumbnail" data-color-name="{{ value }}">
              {%
                render 'swatch-input',
                id: input_id,
                name: input_name,
                value: value | escape,
                swatch: value.swatch,
                product_form_id: product_form_id,
                checked: value.selected,
                visually_disabled: option_disabled,
                shape: block.settings.swatch_shape,
                help_text: help_text,
                additional_props: input_dataset,
                thumbnail_url: thumbnail_url
              %}
            </div>
          {%- else -%}
            {%
              render 'swatch-input',
              id: input_id,
              name: input_name,
              value: value | escape,
              swatch: value.swatch,
              product_form_id: product_form_id,
              checked: value.selected,
              visually_disabled: option_disabled,
              shape: block.settings.swatch_shape,
              help_text: help_text,
              additional_props: input_dataset
            %}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- for value in option.values -%}
    {%- liquid
      # Common properties for both options
      assign option_disabled = true
      if value.available
        assign option_disabled = false
      endif

      # Create input ID and names
      assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
      assign input_name = option.name | append: '-' | append: option.position

      # Set up dataset properties
      assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
      assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

      # Set up any swatch properties for color options
      assign swatch_value = null
      assign swatch_focal_point = null
      if value.swatch.image
        assign image_url = value.swatch.image | image_url: width: 50
        assign swatch_value = 'url(' | append: image_url | append: ')'
        assign swatch_focal_point = value.swatch.image.presentation.focal_point
      elsif value.swatch.color
        assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
      endif
    -%}

    {%- if option.name == 'Size' -%}
      <div class="attribute_radio">
        <input
          type="radio"
          id="{{ input_id }}"
          name="{{ input_name | escape }}"
          value="{{ value | escape }}"
          form="{{ product_form_id }}"
          {% if value.selected %}
            checked
          {% endif %}
          {% if option_disabled %}
            class="disabled" disabled
          {% endif %}
          {{ input_dataset }}
        >
        <label for="{{ input_id }}">
          {{ value }}
          {% if option_disabled %}
            <span class="visually-hidden label-unavailable">
              {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
            </span>
          {% endif %}
        </label>
      </div>
    {%- elsif option.name == 'Color' -%}
      {%- capture help_text -%}
        <span class="visually-hidden">{{ value | escape }}</span>
        {% if option_disabled %}
          <span class="visually-hidden label-unavailable">
            {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
          </span>
        {% endif %}
      {%- endcapture -%}

      {%- if show_thumbnails -%}
        {%- liquid
          assign color_value = value | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '.', '' | replace: ',', ''

          # Use our improved get-variant-color-image snippet to find the image
        -%}
        {% capture thumbnail_url %}{% render 'get-variant-color-image',
          product: product,
          color_value: color_value,
          width: 80,
          height: 80,
          crop: 'center'
        %}{% endcapture %}
        {%- liquid
          # Clean up any whitespace in the captured URL
          assign thumbnail_url = thumbnail_url | strip
        -%}

        <div class="color-option-with-thumbnail" data-color-name="{{ value }}">
          {%
            render 'swatch-input',
            id: input_id,
            name: input_name,
            value: value | escape,
            swatch: value.swatch,
            product_form_id: product_form_id,
            checked: value.selected,
            visually_disabled: option_disabled,
            shape: block.settings.swatch_shape,
            help_text: help_text,
            additional_props: input_dataset,
            thumbnail_url: thumbnail_url
          %}
        </div>
      {%- else -%}
        {%
          render 'swatch-input',
          id: input_id,
          name: input_name,
          value: value | escape,
          swatch: value.swatch,
          product_form_id: product_form_id,
          checked: value.selected,
          visually_disabled: option_disabled,
          shape: block.settings.swatch_shape,
          help_text: help_text,
          additional_props: input_dataset
        %}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
