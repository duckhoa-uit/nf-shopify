{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign sorted_indices = ''

  # Only do sorting for Color and Size options
  if option.name == 'Color' and product.metafields.custom.color.value != blank
    assign metafield_colors = product.metafields.custom.color.value

    # Build position data for each value with index
    for index in (0..option.values.size)
      if option.values[index] != blank
        assign value = option.values[index]
        assign value_downcase = value | downcase
        assign position = 999

        # Find matching metafield position
        for metafield_color in metafield_colors
          if value_downcase == metafield_color.name
            assign position = metafield_color.position
            break
          endif
        endfor

        # Format for sorting
        assign position_str = position | prepend: '00000' | slice: -5, 5
        assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
      endif
    endfor

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  elsif option.name == 'Size' and product.metafields.custom.size.value != blank
    assign metafield_sizes = product.metafields.custom.size.value

    # Build position data for each value with index
    for index in (0..option.values.size)
      if option.values[index] != blank
        assign value = option.values[index]
        assign position = 999

        # Find matching metafield position
        for metafield_size in metafield_sizes
          if value == metafield_size.value
            assign position = metafield_size.position
            break
          endif
        endfor

        # Format for sorting
        assign position_str = position | prepend: '00000' | slice: -5, 5
        assign sorted_indices = sorted_indices | append: position_str | append: '_' | append: index | append: ','
      endif
    endfor

    # Sort indices by position
    assign sorted_indices = sorted_indices | split: ',' | sort
  endif
-%}

{% comment %}
  Render options in sorted order if available, otherwise use original order
{% endcomment %}

{%- if sorted_indices.size > 0 -%}
  {%- for position_index in sorted_indices -%}
    {%- if position_index != blank -%}
      {%- assign parts = position_index | split: '_' -%}
      {%- if parts.size > 1 -%}
        {%- assign index = parts[1] | plus: 0 -%}
        {%- assign value = option.values[index] -%}

        {%- liquid
          # Common properties for both options
          assign option_disabled = true
          if value.available
            assign option_disabled = false
          endif

          # Create input ID and names
          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
          assign input_name = option.name | append: '-' | append: option.position

          # Set up dataset properties
          assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
          assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

          # Set up any swatch properties for color options
          assign swatch_value = null
          assign swatch_focal_point = null
          if value.swatch.image
            assign image_url = value.swatch.image | image_url: width: 50
            assign swatch_value = 'url(' | append: image_url | append: ')'
            assign swatch_focal_point = value.swatch.image.presentation.focal_point
          elsif value.swatch.color
            assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
          endif
        -%}

        {%- if option.name == 'Size' -%}
          <div class="attribute_radio">
            <input
              type="radio"
              id="{{ input_id }}"
              name="{{ input_name | escape }}"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if value.selected %}checked{% endif %}
              {% if option_disabled %}class="disabled" disabled{% endif %}
              {{ input_dataset }}
            >
            <label for="{{ input_id }}">
              {{ value }}
              {% if option_disabled %}
                <span class="visually-hidden label-unavailable">
                  {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
                </span>
              {% endif %}
            </label>
          </div>
        {%- elsif option.name == 'Color' -%}
          {%- capture help_text -%}
            <span class="visually-hidden">{{ value | escape }}</span>
            {% if option_disabled %}
              <span class="visually-hidden label-unavailable">
                {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
              </span>
            {% endif %}
          {%- endcapture -%}

          {%- if show_thumbnails -%}
            {%- liquid
              assign thumbnail_url = ''
              assign color_value = value | downcase | strip | replace: ' ', '-' | replace: "'", "" | replace: ".", "" | replace: ",", ""
              assign reference_id = ''

              # Find the reference_id for this color from metafields
              if product.metafields.custom.color.value != blank
                for color_item in product.metafields.custom.color.value
                  if color_item.name == color_value
                    assign reference_id = color_item.reference_id
                    break
                  endif
                endfor
              endif

              # Try to find a model image for this color from product media
              if reference_id != ''
                assign lowest_sequence = 999
                assign found_model_image = false

                # First look for model images without sequence (just -M)
                for media in product.media
                  assign media_src = media.src | default: ''
                  assign parsed_url = media_src | split: '/' | last

                  if parsed_url contains reference_id
                    if parsed_url contains '-M'
                      unless parsed_url contains '-M_'
                        assign thumbnail_url = media.preview_image | image_url: width: 80
                        assign found_model_image = true
                        break
                      endunless
                    endif
                  endif
                endfor

                # If no model image without sequence found, look for one with lowest sequence
                unless found_model_image
                  for media in product.media
                    assign media_src = media.src | default: ''
                    assign parsed_url = media_src | split: '/' | last
                    if parsed_url contains reference_id and parsed_url contains '-M_'
                      assign sequence_part = parsed_url | split: '-M_' | last | split: '.' | first
                      assign sequence_number = sequence_part | plus: 0

                      if sequence_number < lowest_sequence
                        assign lowest_sequence = sequence_number
                        assign thumbnail_url = media.preview_image | image_url: width: 80
                        assign found_model_image = true
                      endif
                    endif
                  endfor
                endunless

                # If still no model image found, try other image types in priority order
                unless found_model_image
                  # Define image type priority for fallback
                  assign image_types = 'H,B,BV,D' | split: ','

                  # Try each image type in priority order
                  for type in image_types
                    if thumbnail_url == ''
                      for media in product.media
                        assign media_src = media.src | default: ''
                        assign parsed_url = media_src | split: '/' | last

                        # Check if the image contains both the reference_id and the current image type
                        assign type_code = '-' | append: type
                        if parsed_url contains reference_id and parsed_url contains type_code
                          assign thumbnail_url = media.preview_image | image_url: width: 80
                          break
                        endif
                      endfor
                    endif
                  endfor
                endunless
              endif

              # Fallback to the old method if no image found with reference_id
              if thumbnail_url == ''
                for media in product.media
                  assign media_src = media.src | default: ''
                  assign parsed_url = media_src | split: '/' | last

                  # Try to match by color name in the URL
                  if parsed_url contains color_value
                    assign thumbnail_url = media.preview_image | image_url: width: 80
                    break
                  endif
                endfor
              endif
            -%}

            <div class="color-option-with-thumbnail" data-color-name="{{ value }}">
              {%
                render 'swatch-input',
                id: input_id,
                name: input_name,
                value: value | escape,
                swatch: value.swatch,
                product_form_id: product_form_id,
                checked: value.selected,
                visually_disabled: option_disabled,
                shape: block.settings.swatch_shape,
                help_text: help_text,
                additional_props: input_dataset,
                thumbnail_url: thumbnail_url
              %}
            </div>
          {%- else -%}
            {%
              render 'swatch-input',
              id: input_id,
              name: input_name,
              value: value | escape,
              swatch: value.swatch,
              product_form_id: product_form_id,
              checked: value.selected,
              visually_disabled: option_disabled,
              shape: block.settings.swatch_shape,
              help_text: help_text,
              additional_props: input_dataset
            %}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- for value in option.values -%}
    {%- liquid
      # Common properties for both options
      assign option_disabled = true
      if value.available
        assign option_disabled = false
      endif

      # Create input ID and names
      assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
      assign input_name = option.name | append: '-' | append: option.position

      # Set up dataset properties
      assign input_dataset = 'data-product-url="' | append: value.product_url | append: '" '
      assign input_dataset = input_dataset | append: 'data-option-value-id="' | append: value.id | append: '"'

      # Set up any swatch properties for color options
      assign swatch_value = null
      assign swatch_focal_point = null
      if value.swatch.image
        assign image_url = value.swatch.image | image_url: width: 50
        assign swatch_value = 'url(' | append: image_url | append: ')'
        assign swatch_focal_point = value.swatch.image.presentation.focal_point
      elsif value.swatch.color
        assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
      endif
    -%}

    {%- if option.name == 'Size' -%}
      <div class="attribute_radio">
        <input
          type="radio"
          id="{{ input_id }}"
          name="{{ input_name | escape }}"
          value="{{ value | escape }}"
          form="{{ product_form_id }}"
          {% if value.selected %}checked{% endif %}
          {% if option_disabled %}class="disabled" disabled{% endif %}
          {{ input_dataset }}
        >
        <label for="{{ input_id }}">
          {{ value }}
          {% if option_disabled %}
            <span class="visually-hidden label-unavailable">
              {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
            </span>
          {% endif %}
        </label>
      </div>
    {%- elsif option.name == 'Color' -%}
      {%- capture help_text -%}
        <span class="visually-hidden">{{ value | escape }}</span>
        {% if option_disabled %}
          <span class="visually-hidden label-unavailable">
            {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
          </span>
        {% endif %}
      {%- endcapture -%}

      {%- if show_thumbnails -%}
        {%- liquid
          assign thumbnail_url = ''
          assign color_value = value | downcase | strip | replace: ' ', '-' | replace: "'", "" | replace: ".", "" | replace: ",", ""
          assign reference_id = ''

          # Find the reference_id for this color from metafields
          if product.metafields.custom.color.value != blank
            for color_item in product.metafields.custom.color.value
              if color_item.name == color_value
                assign reference_id = color_item.reference_id
                break
              endif
            endfor
          endif

          # Try to find a model image for this color from product media
          if reference_id != ''
            assign lowest_sequence = 999
            assign found_model_image = false

            # First look for model images without sequence (just -M)
            for media in product.media
              assign media_src = media.src | default: ''
              assign parsed_url = media_src | split: '/' | last

              if parsed_url contains reference_id
                if parsed_url contains '-M'
                  unless parsed_url contains '-M_'
                    assign thumbnail_url = media.preview_image | image_url: width: 80
                    assign found_model_image = true
                    break
                  endunless
                endif
              endif
            endfor

            # If no model image without sequence found, look for one with lowest sequence
            unless found_model_image
              for media in product.media
                assign media_src = media.src | default: ''
                assign parsed_url = media_src | split: '/' | last
                if parsed_url contains reference_id and parsed_url contains '-M_'
                  assign sequence_part = parsed_url | split: '-M_' | last | split: '.' | first
                  assign sequence_number = sequence_part | plus: 0

                  if sequence_number < lowest_sequence
                    assign lowest_sequence = sequence_number
                    assign thumbnail_url = media.preview_image | image_url: width: 80
                    assign found_model_image = true
                  endif
                endif
              endfor
            endunless

            # If still no model image found, try other image types in priority order
            unless found_model_image
              # Define image type priority for fallback
              assign image_types = 'H,B,BV,D' | split: ','

              # Try each image type in priority order
              for type in image_types
                if thumbnail_url == ''
                  for media in product.media
                    assign media_src = media.src | default: ''
                    assign parsed_url = media_src | split: '/' | last

                    # Check if the image contains both the reference_id and the current image type
                    assign type_code = '-' | append: type
                    if parsed_url contains reference_id and parsed_url contains type_code
                      assign thumbnail_url = media.preview_image | image_url: width: 80
                      break
                    endif
                  endfor
                endif
              endfor
            endunless
          endif

          # Fallback to the old method if no image found with reference_id
          if thumbnail_url == ''
            for media in product.media
              assign media_src = media.src | default: ''
              assign parsed_url = media_src | split: '/' | last

              # Try to match by color name in the URL
              if parsed_url contains color_value
                assign thumbnail_url = media.preview_image | image_url: width: 80
                break
              endif
            endfor
          endif
        -%}

        <div class="color-option-with-thumbnail" data-color-name="{{ value }}">
          {%
            render 'swatch-input',
            id: input_id,
            name: input_name,
            value: value | escape,
            swatch: value.swatch,
            product_form_id: product_form_id,
            checked: value.selected,
            visually_disabled: option_disabled,
            shape: block.settings.swatch_shape,
            help_text: help_text,
            additional_props: input_dataset,
            thumbnail_url: thumbnail_url
          %}
        </div>
      {%- else -%}
        {%
          render 'swatch-input',
          id: input_id,
          name: input_name,
          value: value | escape,
          swatch: value.swatch,
          product_form_id: product_form_id,
          checked: value.selected,
          visually_disabled: option_disabled,
          shape: block.settings.swatch_shape,
          help_text: help_text,
          additional_props: input_dataset
        %}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
