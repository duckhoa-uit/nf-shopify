{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{% comment %}
  Renders a product thumbnail with media or rich text content
  Accepts:
  - media: {Object} Product Media object
  - position: {Number} (optional) The position of the media in the grid
  - loop: {Boolean} (optional) Enable video looping
  - modal_id: {String} (optional) The product modal that will be updated when the thumbnail is clicked
  - xr_button: {Boolean} (optional) Renders the "View in your space" button for shopify XR
  - media_width: {Float} (optional) The width percentage that the media takes up
  - lazy_load: {Boolean} (optional) Image loading lazy. Default: true
  - lightbox: {Boolean} (optional) Whether to enable lightbox functionality

  Usage:
  {% render 'product-thumbnail', media: media, position: position %}
{% endcomment %}

{%- liquid
  assign media_aspect_ratio = media.aspect_ratio
  assign ratio = media_aspect_ratio | default: 1

  if media_aspect_ratio == blank or media_aspect_ratio < 0.5 or media_aspect_ratio > 2
    assign ratio = 1
  endif
-%}

{%- capture sizes -%}(min-width: 1200px) 605px, (min-width: 990px) 500px, (min-width: 750px) 425px, calc(100vw - 30px){%- endcapture -%}

<div
  class="media relative w-full h-0"
  style="--ratio: {{ ratio }}; --preview-ratio: {{ ratio }}; padding-bottom: {{ 100 | divided_by: ratio }}%;"
  {% if modal_id != blank %}
    data-media-id="{{ modal_id }}-{{ media.id }}"
  {% endif %}
>
  <div class="absolute inset-0 w-full h-full">
    {% if media.media_type == 'video' or media.media_type == 'external_video' %}
      <deferred-media
        class="deferred-media no-js-hidden"
        data-media-id="{{ media.id }}"
        {% if loop %}
          data-loop="true"
        {% endif %}
      >
        <button
          id="Deferred-Poster-Modal-{{ media.id }}"
          class="deferred-media__poster"
          type="button"
          aria-label="{{ 'products.product.load_video' | t: position: position | escape }}"
          aria-haspopup="dialog"
          data-media-id="{{ modal_id }}-{{ media.id }}"
        >
          <span class="deferred-media__poster-button motion-reduce">
            <span class="svg-wrapper">{{ 'icon-play.svg' | inline_asset_content }}</span>
          </span>

          {%- if media.alt != blank -%}
            {{
              media.preview_image
              | image_url: width: 1200
              | image_tag:
                class: 'motion-reduce h-full w-full object-cover',
                loading: 'lazy',
                sizes: sizes,
                widths: '218, 436, 770, 900, 1100, 1500, 2200, 3000',
                alt: media.alt
              | escape
            }}
          {%- else -%}
            {{
              media.preview_image
              | image_url: width: 1200
              | image_tag:
                class: 'motion-reduce h-full w-full object-cover',
                loading: 'lazy',
                sizes: sizes,
                widths: '218, 436, 770, 900, 1100, 1500, 2200, 3000'
              | escape
            }}
          {%- endif -%}
        </button>
        <template>
          {% case media.media_type %}
            {% when 'video' %}
              <video
                playsinline
                controls
                autoplay
                class="h-full w-full"
                aria-labelledby="Deferred-Poster-Modal-{{ media.id }}"
              >
                <source src="{{ media | file_url }}" type="video/mp4">
              </video>
            {% when 'external_video' %}
              {% if media.host == 'youtube' %}
                <iframe
                  src="https://www.youtube.com/embed/{{ media.external_id }}?enablejsapi=1&autoplay=1&wmode=opaque"
                  allowfullscreen
                  allowtransparency
                  role="img"
                  aria-labelledby="Deferred-Poster-Modal-{{ media.id }}"
                  height="100%"
                  width="100%"
                  class="h-full w-full"
                ></iframe>
              {% else %}
                <iframe
                  src="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1"
                  allowfullscreen
                  allowtransparency
                  role="img"
                  aria-labelledby="Deferred-Poster-Modal-{{ media.id }}"
                  height="100%"
                  width="100%"
                  class="h-full w-full"
                ></iframe>
              {% endif %}
          {% endcase %}
        </template>
      </deferred-media>

    {% elsif media.media_type == 'model' %}
      <product-model
        class="deferred-media no-js-hidden"
        data-media-id="{{ media.id }}"
        data-shopify-xr
        data-shopify-model3d-id="{{ media.id }}"
        data-shopify-title="{{ product.title | escape }}"
        data-shopify-xr-hidden
      >
        {% if xr_button %}
          <button
            class="button button--full-width button button--secondary"
            type="button"
            aria-expanded="false"
            aria-label="{{ 'products.product.xr_button_label' | t }}"
            data-shopify-xr-launcher
          >
            <span class="svg-wrapper">{{ 'icon-3d-model' | inline_asset_content }}</span>
            {{ 'products.product.xr_button' | t }}
          </button>
        {% endif %}
        <div
          id="ProductModal3DContainer-{{ product.id }}"
          class="product-model"
          data-shopify-xr-container
          aria-label="{{ product.title | escape }}"
        >
          <div class="product-model__wrapper" data-shopify-xr-container-inner></div>
        </div>
        <template>
          {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, data-model-id: media.id }}
        </template>
      </product-model>

    {% else %}
      {%- assign alt_text = media.alt | default: product.title -%}
      {%- if media.media_type == 'image' and alt_text != blank -%}
        {% if media_width != blank %}
          <style>
            @media screen and (min-width: 750px) {
              #ProductMedia-{{ media.id }} {
                width: {{ media_width | times: 100 }}%;
              }
            }
          </style>
        {% endif %}

        {% if lightbox %}
          {{
            media
            | image_url: width: 1500
            | image_tag: loading: lazy_load
            | default: 'lazy',
              class: 'media-item w-full h-full object-cover product-lightbox-img',
              sizes: sizes,
              widths: '218, 436, 770, 900, 1100, 1500, 2200, 3000',
              alt: alt_text,
              id: 'ProductMedia-'
            | append: media.id, data-fancybox: 'product-gallery', data-src: media
            | image_url: width: 2000
          }}
        {% else %}
          {{
            media
            | image_url: width: 1500
            | image_tag: loading: lazy_load
            | default: 'lazy',
              class: 'media-item w-full h-full object-cover',
              sizes: sizes,
              widths: '218, 436, 770, 900, 1100, 1500, 2200, 3000',
              alt: alt_text,
              id: 'ProductMedia-'
            | append: media.id
          }}
        {% endif %}

      {%- else -%}
        {{ media | media_tag }}
      {%- endif -%}
    {% endif %}
  </div>
</div>
