{% comment %}
  Determines if a product option is a color option.

  Locale-independent — relies on Shopify "Linked Metafields" feature
  (option values linked to `custom.color` metaobjects) plus swatch presence
  rather than translated option names.

  Accepts:
  - option: {Object} Product option object (required)
  - product: {Object} Product object (optional, recommended)
      Used to cross-reference option values against the `custom.color`
      metaobject list for robust detection.

  Returns (via echo):
  - 'true' if the option is a color option
  - 'false' otherwise

  Detection priority:
  1. Any option value has a `swatch` → color
  2. `product.metafields.custom.color` exists AND any option value name
     matches one of its metaobject `name` entries → color
  3. Fallback: position 1 AND not detected as size → color
     (size detection is delegated to `is-size-option`)

  Usage:
  {%- capture is_color -%}
    {%- render 'is-color-option', option: option, product: product -%}
  {%- endcapture -%}
  {%- if is_color == 'true' -%}
    ...color-specific logic...
  {%- endif -%}
{% endcomment %}

{%- liquid
  assign is_color = false

  # Priority 1: Swatches present → color option
  assign swatch_count = option.values | map: 'swatch' | compact | size
  if swatch_count > 0
    assign is_color = true
  endif

  # Priority 2: Cross-reference with linked metafield (custom.color metaobjects)
  if is_color == false and product.metafields.custom.color.value != blank
    assign color_metaobjects = product.metafields.custom.color.value
    for value in option.values
      assign value_lower = value | downcase | strip
      for color_meta in color_metaobjects
        assign color_name = color_meta.name | downcase | strip
        if value_lower == color_name
          assign is_color = true
          break
        endif
      endfor
      if is_color
        break
      endif
    endfor
  endif

  # Priority 3: Fallback — first option is color when not detected as size
  if is_color == false and option.position == 1
    capture is_size
      render 'is-size-option', option: option, product: product
    endcapture
    assign is_size = is_size | strip
    if is_size != 'true'
      assign is_color = true
    endif
  endif

  echo is_color
-%}
