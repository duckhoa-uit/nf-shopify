{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}

{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    class="mt-3"
    {{ block.shopify_attributes }}
  >
    {%- liquid
      # Position-based option sorting for internationalization
      # Color is typically position 1, Size is typically position 2
      assign sorted_options = ''
      assign color_option = null
      assign size_option = null

      # First, identify Color and Size options by position and common patterns
      for option in product.options_with_values
        assign is_color_option = false
        assign is_size_option = false

        # Check if this is a color option (position 1 or has color-related values)
        if option.position == 1
          assign is_color_option = true
        endif

        # Additional check: if option has swatch values, it's likely a color option
        assign swatch_count = option.values | map: 'swatch' | compact | size
        if swatch_count > 0
          assign is_color_option = true
        endif

        # Check if this is a size option (position 2 or has size-related patterns)
        if option.position == 2
          assign is_size_option = true
        endif

        # Store the identified options
        if is_color_option
          assign color_option = option
        elsif is_size_option
          assign size_option = option
        endif
      endfor

      # Build sorted options list: Color first, then Size, then others
      if color_option
        assign sorted_options = sorted_options | append: color_option.name | append: ','
      endif

      if size_option
        assign sorted_options = sorted_options | append: size_option.name | append: ','
      endif

      # Add remaining options
      for option in product.options_with_values
        assign is_already_added = false
        if color_option and option.position == color_option.position
          assign is_already_added = true
        endif
        if size_option and option.position == size_option.position
          assign is_already_added = true
        endif

        unless is_already_added
          assign sorted_options = sorted_options | append: option.name | append: ','
        endunless
      endfor

      assign sorted_options = sorted_options | split: ','
    -%}

    {%- for option_name in sorted_options -%}
      {%- assign option = product.options_with_values | where: 'name', option_name | first -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      {%- liquid
        # Determine option type based on position and characteristics
        assign is_size_option = false
        assign is_color_option = false

        # Check if this is a color option FIRST (higher priority)
        assign swatch_count_check = option.values | map: 'swatch' | compact | size

        # Primary detection: Position 1 (most reliable for color)
        if option.position == 1
          assign is_color_option = true
        endif

        # Secondary detection: Has swatch values
        if swatch_count_check > 0
          assign is_color_option = true
        endif

        # Additional detection: Common color-related option names (fallback)
        assign option_name_lower = option.name | downcase

        if option_name_lower contains 'color'
          assign is_color_option = true
        endif

        if option_name_lower contains 'colour'
          assign is_color_option = true
        endif

        if option_name_lower contains 'farbe'
          assign is_color_option = true
        endif

        if option_name_lower contains 'couleur'
          assign is_color_option = true
        endif

        # Only check for size option if it's NOT already identified as color
        unless is_color_option
          if option.position == 2
            assign is_size_option = true
          endif

          # Additional check for size metafields only if not color
          if product.metafields.size_fit.measurements.value or product.metafields.size_fit.body_measurements.value
            assign is_size_option = true
          endif
        endunless
      -%}

      {%- if is_size_option -%}
        {%- comment -%} Check product kind to hide size-fit-button for scarfs {%- endcomment -%}
        {%- assign is_scarfs = false -%}
        {%- if product.metafields.features.kind.value -%}
          {%- for kind_item in product.metafields.features.kind.value -%}
            {%- assign kind_system_handle = kind_item.system.handle -%}
            {%- if kind_system_handle == 'scarfs' -%}
              {%- assign is_scarfs = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        <fieldset class="js product-form__input product-form__input--pill product-form__input--pill-size" data-option-type="size" data-option-position="{{ option.position }}">
          <div class="flex items-center justify-between mb-2">
            <legend class="form__label m-0">{{ option.name }}</legend>
            {%- unless is_scarfs -%}
              <button
                type="button"
                class="size-fit-button flex items-center text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors"
                data-size-fit-modal
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
                {{ 'products.product.size_guide_fit_recommender' | t }}
              </button>
            {%- endunless -%}
          </div>
          <div class="grid grid-cols-5 gap-5">
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type
            %}
          </div>
        </fieldset>
      {%- elsif is_color_option -%}
        <fieldset class="js product-form__input product-form__input--swatch product-form__input--pill-color" data-option-type="color" data-option-position="{{ option.position }}">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          <div class="grid grid-cols-5 gap-0.5 w-full" data-color-thumbnails>
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type,
              show_thumbnails: true
            %}
          </div>
        </fieldset>
      {%- elsif picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">{{ option.name }}</legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>

    <script type="application/json" data-product-variants>
      {{ product.variants | json }}
    </script>
  </variant-selects>
{%- endunless -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // No additional JavaScript needed
    // The size chart button functionality will be handled by a Shopify app
  });
</script>
