{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}

{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    class="mt-3"
    {{ block.shopify_attributes }}
  >
    {%- liquid
      # Set up form ID for inputs
      assign product_form_id = 'product-form-' | append: section.id

      # Identify Color and Size options using centralized, locale-independent
      # detection (is-color-option / is-size-option). Size takes priority over
      # color when both somehow match (defensive — same option shouldn't be both).
      assign sorted_options = ''
      assign color_option = null
      assign size_option = null

      for option in product.options_with_values
        # --- Inline size detection (locale-independent) ---
        # Priority 1: linked metafield (custom.size) cross-ref
        # Priority 2: ≥2 numeric values
        # Priority 3: ≥2 standard letter sizes
        assign is_size_opt = false
        if product.metafields.custom.size.value != blank
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_norm = v_str | strip
            for sm in product.metafields.custom.size.value
              assign sm_norm = sm.value | strip
              if v_norm == sm_norm
                assign is_size_opt = true
                break
              endif
            endfor
            if is_size_opt
              break
            endif
          endfor
        endif
        if is_size_opt == false
          assign numeric_count = 0
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_norm = v_str | strip | replace: ',', '.'
            assign digits = v_norm | replace: '.', '' | replace: '0', '' | replace: '1', '' | replace: '2', '' | replace: '3', '' | replace: '4', '' | replace: '5', '' | replace: '6', '' | replace: '7', '' | replace: '8', '' | replace: '9', ''
            if digits == '' and v_norm != ''
              assign numeric_count = numeric_count | plus: 1
            endif
          endfor
          if numeric_count >= 2
            assign is_size_opt = true
          endif
        endif
        if is_size_opt == false
          assign letter_sizes = 'XXS,XS,S,M,L,XL,XXL,2XL,3XL,4XL,5XL,6XL' | split: ','
          assign letter_count = 0
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_up = v_str | upcase | strip
            for ls in letter_sizes
              if v_up == ls
                assign letter_count = letter_count | plus: 1
                break
              endif
            endfor
          endfor
          if letter_count >= 2
            assign is_size_opt = true
          endif
        endif

        # --- Inline color detection (locale-independent) ---
        # Priority 1: any option value has a `swatch` attribute set
        # Priority 2: linked metafield (custom.color) cross-ref
        # Priority 3: first option position fallback (when not size)
        assign is_color_opt = false
        assign swatch_for_color = option.values | map: 'swatch' | compact | size
        if swatch_for_color > 0
          assign is_color_opt = true
        endif
        if is_color_opt == false and product.metafields.custom.color.value != blank
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_norm = v_str | strip | downcase
            for cm in product.metafields.custom.color.value
              assign cm_norm = cm.value | strip | downcase
              if v_norm == cm_norm
                assign is_color_opt = true
                break
              endif
            endfor
            if is_color_opt
              break
            endif
          endfor
        endif
        if is_color_opt == false and option.position == 1 and is_size_opt == false
          assign is_color_opt = true
        endif

        # Size takes priority if both somehow match
        if is_size_opt
          assign size_option = option
        elsif is_color_opt
          assign color_option = option
        endif
      endfor

      # Build sorted options list: Color first, then Size, then others
      if color_option
        assign sorted_options = sorted_options | append: color_option.name | append: ','
      endif

      if size_option
        assign sorted_options = sorted_options | append: size_option.name | append: ','
      endif

      # Add remaining options
      for option in product.options_with_values
        assign is_already_added = false
        if color_option and option.position == color_option.position
          assign is_already_added = true
        endif
        if size_option and option.position == size_option.position
          assign is_already_added = true
        endif

        unless is_already_added
          assign sorted_options = sorted_options | append: option.name | append: ','
        endunless
      endfor

      assign sorted_options = sorted_options | split: ','
    -%}

    {%- for option_name in sorted_options -%}
      {%- assign option = product.options_with_values | where: 'name', option_name | first -%}

      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      {%- liquid
        # Locale-independent option type detection (inline; avoids render-scope issues).
        # Size takes priority over color when both somehow match.
        assign is_size_option = false
        if product.metafields.custom.size.value != blank
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_norm = v_str | strip
            for sm in product.metafields.custom.size.value
              assign sm_norm = sm.value | strip
              if v_norm == sm_norm
                assign is_size_option = true
                break
              endif
            endfor
            if is_size_option
              break
            endif
          endfor
        endif
        if is_size_option == false
          assign numeric_count = 0
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_norm = v_str | strip | replace: ',', '.'
            assign digits = v_norm | replace: '.', '' | replace: '0', '' | replace: '1', '' | replace: '2', '' | replace: '3', '' | replace: '4', '' | replace: '5', '' | replace: '6', '' | replace: '7', '' | replace: '8', '' | replace: '9', ''
            if digits == '' and v_norm != ''
              assign numeric_count = numeric_count | plus: 1
            endif
          endfor
          if numeric_count >= 2
            assign is_size_option = true
          endif
        endif
        if is_size_option == false
          assign letter_sizes = 'XXS,XS,S,M,L,XL,XXL,2XL,3XL,4XL,5XL,6XL' | split: ','
          assign letter_count = 0
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_up = v_str | upcase | strip
            for ls in letter_sizes
              if v_up == ls
                assign letter_count = letter_count | plus: 1
                break
              endif
            endfor
          endfor
          if letter_count >= 2
            assign is_size_option = true
          endif
        endif

        assign is_color_option = false
        assign swatch_for_color = option.values | map: 'swatch' | compact | size
        if swatch_for_color > 0
          assign is_color_option = true
        endif
        if is_color_option == false and product.metafields.custom.color.value != blank
          for v in option.values
            capture v_str
              echo v
            endcapture
            assign v_norm = v_str | strip | downcase
            for cm in product.metafields.custom.color.value
              assign cm_norm = cm.value | strip | downcase
              if v_norm == cm_norm
                assign is_color_option = true
                break
              endif
            endfor
            if is_color_option
              break
            endif
          endfor
        endif
        if is_color_option == false and option.position == 1 and is_size_option == false
          assign is_color_option = true
        endif

        # Size takes priority over color
        if is_size_option
          assign is_color_option = false
        endif
      -%}

      {%- if is_size_option -%}
        {%- comment -%} Check if this is a single-size product {%- endcomment -%}
        {%- assign is_single_size_product = false -%}
        {%- assign single_size_value = null -%}
        {%- assign single_size_input_id = null -%}

        {%- if option.values.size == 1 -%}
          {%- assign is_single_size_product = true -%}
          {%- assign single_size_value = option.values.first -%}
          {%- assign single_size_input_id = section.id | append: '-' | append: option.position | append: '-single-size' -%}
        {%- endif -%}

        {%- comment -%} Check product kind to hide size-fit-button for scarfs {%- endcomment -%}
        {%- assign is_scarfs = false -%}
        {%- if product.metafields.features.kind.value -%}
          {%- for kind_item in product.metafields.features.kind.value -%}
            {%- assign kind_system_handle = kind_item.system.handle -%}
            {%- if kind_system_handle == 'scarfs' -%}
              {%- assign is_scarfs = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if is_single_size_product -%}
          {%- comment -%} Single size product: render hidden input instead of fieldset {%- endcomment -%}
          <input
            type="hidden"
            id="{{ single_size_input_id }}"
            name="options[{{ option.name | escape }}]"
            value="{{ single_size_value | escape }}"
            form="{{ product_form_id }}"
            data-single-size-input
            data-option-type="size"
            data-option-position="{{ option.position }}"
            data-size-value="{{ single_size_value | escape }}"
            checked
          >
          {%- comment -%} Optional: Add a visually hidden label for accessibility {%- endcomment -%}
          <span class="visually-hidden" aria-live="polite">
            {{ option.name }}: {{ single_size_value }}
          </span>
        {%- else -%}
          {%- comment -%} Multiple sizes: render normal fieldset {%- endcomment -%}
          <fieldset class="js product-form__input product-form__input--pill product-form__input--pill-size" data-option-type="size" data-option-position="{{ option.position }}">
            <div class="flex items-center justify-between mb-2">
              <legend class="form__label m-0">{{ option.name }}</legend>
              {%- unless is_scarfs -%}
                <button
                  type="button"
                  class="size-fit-button flex items-center text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors"
                  data-size-fit-modal
                >
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  </svg>
                  {{ 'products.product.size_guide_fit_recommender' | t }}
                </button>
              {%- endunless -%}
            </div>
            <div class="grid grid-cols-5 gap-5">
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </div>
          </fieldset>
        {%- endif -%}
      {%- elsif is_color_option -%}
        <fieldset class="js product-form__input product-form__input--swatch product-form__input--pill-color" data-option-type="color" data-option-position="{{ option.position }}">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          <div class="grid grid-cols-5 gap-0.5 w-full" data-color-thumbnails>
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type,
              show_thumbnails: true
            %}
          </div>
        </fieldset>
      {%- elsif picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">{{ option.name }}</legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>

    <script type="application/json" data-product-variants>
      {{ product.variants | json }}
    </script>
  </variant-selects>
{%- endunless -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // No additional JavaScript needed
    // The size chart button functionality will be handled by a Shopify app
  });
</script>
