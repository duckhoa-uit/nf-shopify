{%- comment -%}
  materials-tabs.liquid - Tabs component for materials section

  Usage:
  {% render 'materials-tabs', blocks: section.blocks, tabs_id: section.id %}

  Where blocks are the section blocks of type 'material'
{%- endcomment -%}

{%- liquid
  # Set unique identifier for this tabs instance
  assign tabs_id = tabs_id | default: 'tabs_' | append: 'now' | date: '%s'

  # Find the active tab (first one by default)
  assign active_tab_index = 1
-%}

<div class="w-full mx-auto">
  {%- comment -%} Tabs Header {%- endcomment -%}
  <div
    class="overflow-x-auto overflow-y-hidden scrollbar-hide mb-6 w-full border-b border-[#e0dfdf]"
    id="{{ tabs_id }}_header"
  >
    <div class="flex whitespace-nowrap">
      {%- for block in blocks -%}
        {%- if block.type == 'material' -%}
          {%- assign tab_index = forloop.index -%}
          <button
            id="{{ tabs_id }}_tab_{{ tab_index }}"
            data-tab="{{ tab_index }}"
            data-tabs-group="{{ tabs_id }}"
            class="tabs-button font-semmibold leading-5 pb-4 mr-9 whitespace-nowrap {% if tab_index == active_tab_index %}text-accent border-foreground{% else %}text-foreground{% endif %}"
          >
            {{ block.settings.material_name }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Tab Contents {%- endcomment -%}
  {%- for block in blocks -%}
    {%- if block.type == 'material' -%}
      {%- assign tab_index = forloop.index -%}
      <div
        id="{{ tabs_id }}_{{ tab_index }}"
        class="tabs-content w-full {% if tab_index != active_tab_index %}hidden{% endif %}"
        data-tabs-group="{{ tabs_id }}"
      >
        {% render 'material-content', block: block %}
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function setupMaterialsTabs() {
      const tabsGroup = '{{ tabs_id }}';
      const tabButtons = document.querySelectorAll(`.tabs-button[data-tabs-group="${tabsGroup}"]`);

      tabButtons.forEach((button) => {
        button.addEventListener('click', function () {
          const tabId = this.getAttribute('data-tab');

          // Deactivate all tabs in this group
          document.querySelectorAll(`.tabs-button[data-tabs-group="${tabsGroup}"]`).forEach((tab) => {
            tab.classList.remove('text-accent', 'border-foreground');
            tab.classList.add('text-gray-500');
          });

          // Activate clicked tab
          this.classList.add('text-accent', 'border-foreground');
          this.classList.remove('text-gray-500');

          // Scroll tab into view if it's not fully visible
          const tabsContainer = document.getElementById(`${tabsGroup}_header`);
          if (tabsContainer) {
            const tabRect = this.getBoundingClientRect();
            const containerRect = tabsContainer.getBoundingClientRect();

            // Check if tab is not fully visible
            if (tabRect.left < containerRect.left || tabRect.right > containerRect.right) {
              // Scroll the tab into view with some padding
              this.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          }

          // Fade out all content in this group
          document.querySelectorAll(`.tabs-content[data-tabs-group="${tabsGroup}"]`).forEach((content) => {
            if (!content.classList.contains('hidden')) {
              content.classList.add('fade-out');
              setTimeout(() => {
                content.classList.add('hidden');
                content.classList.remove('fade-out');

                // Fade in the selected content
                const selectedContent = document.getElementById(`${tabsGroup}_${tabId}`);
                selectedContent.classList.remove('hidden');
                selectedContent.classList.add('fade-in');
                setTimeout(() => {
                  selectedContent.classList.remove('fade-in');
                }, 150);
              }, 150);
            }
          });

          // If all tabs are already hidden, just show the selected one with fade in
          const visibleTabs = document.querySelectorAll(`.tabs-content[data-tabs-group="${tabsGroup}"]:not(.hidden)`);
          if (visibleTabs.length === 0) {
            const selectedContent = document.getElementById(`${tabsGroup}_${tabId}`);
            selectedContent.classList.remove('hidden');
            selectedContent.classList.add('fade-in');
            setTimeout(() => {
              selectedContent.classList.remove('fade-in');
            }, 150);
          }
        });
      });
    }

    // Setup tabs on page load
    setupMaterialsTabs();

    // Scroll active tab into view on page load
    setTimeout(() => {
      const tabsGroup = '{{ tabs_id }}';
      const activeTab = document.querySelector(`.tabs-button[data-tabs-group="${tabsGroup}"].text-accent`);
      if (activeTab) {
        const tabsContainer = document.getElementById(`${tabsGroup}_header`);
        if (tabsContainer) {
          const tabRect = activeTab.getBoundingClientRect();
          const containerRect = tabsContainer.getBoundingClientRect();

          // Check if tab is not fully visible
          if (tabRect.left < containerRect.left || tabRect.right > containerRect.right) {
            // Scroll the tab into view with some padding
            activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        }
      }
    }, 100);

    // Re-setup tabs after Shopify section loads/changes (for editor support)
    if (typeof Shopify !== 'undefined' && Shopify.designMode) {
      document.addEventListener('shopify:section:load', setupMaterialsTabs);
      document.addEventListener('shopify:section:select', setupMaterialsTabs);
    }
  });
</script>
