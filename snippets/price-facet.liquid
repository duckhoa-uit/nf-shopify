{%- liquid
  assign fallback_max = price_filter_range_max | default: settings.price_filter_max | default: 500
-%}

<!-- Sale Filter URL State Synchronization -->
<script>
  function syncSaleFilterCheckbox() {
    const checkbox = document.getElementById('discount-filter-checkbox');
    if (checkbox) {
      // Check URL parameters using JavaScript
      const urlParams = new URLSearchParams(window.location.search);
      const saleFilterActive = urlParams.get('filter.p.m.custom.sale_off') === 'true';

      // Sync checkbox state with URL
      if (saleFilterActive && !checkbox.checked) {
        checkbox.checked = true;
      } else if (!saleFilterActive && checkbox.checked) {
        checkbox.checked = false;
      }
    }
  }

  // Sync on DOM load
  document.addEventListener('DOMContentLoaded', syncSaleFilterCheckbox);

  // Sync on URL changes (for AJAX updates)
  window.addEventListener('popstate', syncSaleFilterCheckbox);

  // Sync on facet updates (Shopify theme events)
  document.addEventListener('facet:updated', syncSaleFilterCheckbox);

  // Additional sync after a short delay (for AJAX content replacement)
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(syncSaleFilterCheckbox, 100);
    setTimeout(syncSaleFilterCheckbox, 500);
  });
</script>
<div
  class="price-filter-container"
  data-min-value="{% if filter.min_value.value != blank %}{{ filter.min_value.value | money_without_currency }}{% else %}0{% endif %}"
  data-max-value="{% if filter.max_value.value != blank %}{{ filter.max_value.value | money_without_currency }}{% elsif filter.range_max %}{{ filter.range_max | money_without_currency }}{% else %}{{ fallback_max | money_without_currency }}{% endif %}"
>
  <div class="price-inputs-container">
    <div class="field price-field">
      <input
        class="field__input price-input"
        name="{{ filter.min_value.param_name }}"
        id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
        value="{% if filter.min_value.value != blank %}{{ filter.min_value.value | money_without_currency }}{% else %}0{% endif %}"
        type="text"
        inputmode="decimal"
        placeholder="0.00"
        data-pattern="\d| |,|\."
        data-min="0"
        data-max="{% if filter.range_max %}{{ filter.range_max | money_without_currency }}{% else %}{{ fallback_max | money_without_currency }}{% endif %}"
      >
      <span class="price-currency">{{ cart.currency.symbol }}</span>
    </div>

    <div class="field price-field">
      <input
        class="field__input price-input"
        name="{{ filter.max_value.param_name }}"
        id="{{ id_prefix }}{{ filter.label | escape }}-LTE"
        value="{% if filter.max_value.value != blank %}{{ filter.max_value.value | money_without_currency }}{% elsif filter.range_max %}{{ filter.range_max | money_without_currency }}{% else %}{{ fallback_max | money_without_currency }}{% endif %}"
        type="text"
        inputmode="decimal"
        placeholder="{% if filter.range_max %}{{ filter.range_max | money_without_currency }}{% else %}{{ fallback_max | money_without_currency }}{% endif %}"
        data-pattern="\d| |,|\."
        data-min="0"
        data-max="{% if filter.range_max %}{{ filter.range_max | money_without_currency }}{% else %}{{ fallback_max | money_without_currency }}{% endif %}"
      >
      <span class="price-currency">{{ cart.currency.symbol }}</span>
    </div>
  </div>

  <div class="price-slider-container">
    <div class="price-slider">
      <div class="price-slider-track"></div>
      <div class="price-slider-range"></div>
      <div class="price-slider-thumb price-slider-thumb-min"></div>
      <div class="price-slider-thumb price-slider-thumb-max"></div>
    </div>
  </div>

  <div class="discount-filter">
    <label for="discount-filter-checkbox" class="discount-filter-label flex items-center w-full gap-2 justify-between">
      <span class="discount-filter-text text-[#000] text-xs md:text-sm font-medium uppercase leading-[1.3125rem] text-left">
        {{- 'products.facets.show_only_discounted' | t -}}
      </span>
      <input
        type="checkbox"
        id="discount-filter-checkbox"
        class="discount-filter-checkbox"
        name="filter.p.m.custom.sale_off"
        value="true"
      >
    </label>
  </div>
</div>
