<div class="price-filter-container">
  <div class="price-inputs-container">
    <div class="field price-field">
      <input
        class="field__input price-input"
        name="{{ filter.min_value.param_name }}"
        id="{{ id_prefix }}{{ filter.label | escape }}-GTE"
        value="{{ filter.min_value.value | default: 0 | money_without_currency }}"
        type="text"
        inputmode="decimal"
        placeholder="0.00"
        data-pattern="\d| |,|\."
        data-min="0"
        data-max="{{ filter.range_max | money_without_currency }}"
      >
      <span class="price-currency">{{ cart.currency.symbol }}</span>
    </div>

    <div class="field price-field">
      <input
        class="field__input price-input"
        name="{{ filter.max_value.param_name }}"
        id="{{ id_prefix }}{{ filter.label | escape }}-LTE"
        value="{{ filter.max_value.value | default: filter.range_max | money_without_currency }}"
        type="text"
        inputmode="decimal"
        placeholder="{{ filter.range_max | money_without_currency }}"
        data-pattern="\d| |,|\."
        data-min="0"
        data-max="{{ filter.range_max | money_without_currency }}"
      >
      <span class="price-currency">{{ cart.currency.symbol }}</span>
    </div>
  </div>

  <div class="price-slider-container">
    <div class="price-slider">
      <div class="price-slider-track"></div>
      <div class="price-slider-range"></div>
      <div class="price-slider-thumb price-slider-thumb-min"></div>
      <div class="price-slider-thumb price-slider-thumb-max"></div>
    </div>
  </div>

  <div class="discount-filter">
    <label for="discount-filter-checkbox" class="discount-filter-label flex items-center w-full gap-2 justify-between">
      <span class="discount-filter-text text-[#000] text-sm font-medium uppercase leading-[1.3125rem] text-left"
        >Show only discounted products</span
      >
      <input
        type="checkbox"
        id="discount-filter-checkbox"
        class="discount-filter-checkbox"
        name="filter.p.tag"
        value="Sale"
      >
    </label>
  </div>
</div>
