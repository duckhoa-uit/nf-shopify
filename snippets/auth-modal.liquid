<div id="auth-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <!-- Modal Backdrop -->
  <div class="absolute top-0 left-0 right-0 h-full bg-[#0f0f0f] opacity-40"></div>

  <!-- Modal Panel -->
  <div class="flex min-h-full items-center justify-center p-0 md:p-4 ">
    <div class="relative w-full md:max-w-md bg-background md:rounded-3">
      <!-- Close Button -->
      <button type="button" class="close absolute right-8 top-8 text-secondary-foreground hover:text-foreground size-4">
        <span class="size-4">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      <!-- Login Form -->
      <div id="customer-login-form" class="p-8 hidden customer">
        <div class="flex items-center mb-3">
          <h3 class="text-base font-bold uppercase">
            {{ 'customer.login_page.title' | t | default: 'Northfinder Account' }}
          </h3>
        </div>

        <div class="block mb-8">
          <div class="border-b border-[#E0DFDF]">
            <nav class="-mb-px flex gap-x-6 uppercase" aria-label="Tabs">
              <a
                class="whitespace-nowrap border-b-2 border-[#0F0F0F] px-1 py-4 text-sm font-medium leading-4 text-foreground no-underline tab-link"
                data-tab="login"
              >
                {{- 'customer.login_page.sign_in' | t | default: 'Login' -}}
              </a>
              <a
                class="whitespace-nowrap border-b-2 border-transparent px-1 py-4 text-sm font-medium leading-4 text-foreground no-underline tab-link"
                data-tab="register"
              >
                {{- 'customer.register.title' | t | default: 'Register' -}}
              </a>
            </nav>
          </div>
        </div>

        <div id="login-messages" class="auth-messages mt-4">
          {% if form.errors %}
            <div class="p-4 mb-4 rounded-3 bg-red-50 text-red-800">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        </div>

        {% form 'customer_login', return_to: request.path, id: 'customer_login_form' %}
          <div class="flex flex-col">
            <div>
              <div class="relative mb-3 field">
                <input
                  type="email"
                  name="customer[email]"
                  id="customer_email"
                  required
                  placeholder=" "
                  autocomplete="email"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="email-error"
                  {% endif %}
                >
                <label
                  for="customer_email"
                >
                  E-mail
                </label>
              </div>
            </div>

            <div>
              <div class="relative mb-4 field">
                <input
                  type="password"
                  name="customer[password]"
                  id="customer_password"
                  required
                  placeholder=" "
                  autocomplete="current-password"
                  {% if form.errors contains 'password' %}
                    aria-invalid="true"
                    aria-describedby="password-error"
                  {% endif %}
                >
                <label
                  for="customer_password"
                >
                  Password
                </label>
              </div>
            </div>

            <button
              type="submit"
              class="button w-full uppercase text-sm px-9 py-3 mb-3"
            >
              {{ 'customer.login_page.sign_in' | t | default: 'Sign In' }}
            </button>

            <div class="oxi-social-login"></div>

            <div class="text-sm text-[#3D3D3D] mt-6 leading-5 text-left">
              {{
                'customer.login_page.forgot_password_message'
                | t
                | default: 'If you have lost your password, continue to the page'
              }}
              <a
                href="javascript:void(0)"
                title="Recover your forgotten password"
                rel="nofollow"
                class="text-accent underline forgot-password-link"
              >
                {{- 'customer.login_page.forgot_password' | t | default: 'Forgotten password' -}}
              </a>
            </div>
          </div>
        {% endform %}
      </div>

      <!-- Register Form -->
      <div id="customer-register-form" class="p-8 hidden customer">
        <div class="flex items-center mb-3">
          <h3 class="text-base font-bold uppercase">
            {{ 'customer.login_page.title' | t | default: 'Northfinder Account' }}
          </h3>
        </div>

        <div class="block">
          <div class="border-b border-[#E0DFDF]">
            <nav class="-mb-px flex gap-x-6 uppercase" aria-label="Tabs">
              <a
                class="whitespace-nowrap border-b-2 border-transparent px-1 py-4 text-sm font-medium leading-4 text-foreground no-underline tab-link"
                data-tab="login"
              >
                {{- 'customer.login_page.sign_in' | t | default: 'Login' -}}
              </a>
              <a
                class="whitespace-nowrap border-b-2 border-[#0F0F0F] px-1 py-4 text-sm font-medium leading-4 text-foreground no-underline tab-link"
                data-tab="register"
              >
                {{- 'customer.register.title' | t | default: 'Registration' -}}
              </a>
            </nav>
          </div>
        </div>

        <div id="register-messages" class="auth-messages mt-4">
          {% if form.errors %}
            <div class="p-4 mb-4 rounded-3 bg-red-50 text-red-800">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        </div>

        {% form 'create_customer', return_to: routes.account_url, id: 'customer_register_form' %}
          <div class="flex flex-col gap-y-3 mb-3">
            <div>
              <div class="relative field">
                <input
                  type="text"
                  name="customer[first_name]"
                  id="first_name"
                  placeholder=" "
                  autocomplete="given-name"
                  {% if form.errors contains 'first_name' %}
                    aria-invalid="true"
                    aria-describedby="first-name-error"
                  {% endif %}
                  value="{{ form.first_name }}"
                >
                <label
                  for="first_name"
                >
                  {{ 'customer.register.first_name' | t | default: 'Name' }}
                </label>
              </div>
            </div>

            <div>
              <div class="relative field">
                <input
                  type="text"
                  name="customer[last_name]"
                  id="last_name"
                  placeholder=" "
                  autocomplete="family-name"
                  {% if form.errors contains 'last_name' %}
                    aria-invalid="true"
                    aria-describedby="last-name-error"
                  {% endif %}
                  value="{{ form.last_name }}"
                >
                <label
                  for="last_name"
                >
                  {{ 'customer.register.last_name' | t | default: 'Surname' }}
                </label>
              </div>
            </div>

            <div>
              <div class="relative field">
                <input
                  type="email"
                  name="customer[email]"
                  id="email"
                  required
                  placeholder=" "
                  autocomplete="email"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="email-error"
                  {% endif %}
                  value="{{ form.email }}"
                >
                <label
                  for="email"
                >
                  {{ 'customer.login_page.email' | t | default: 'E-mail' }}
                </label>
              </div>
            </div>

            <div>
              <div class="relative field">
                <input
                  type="password"
                  name="customer[password]"
                  id="password"
                  required
                  minlength="8"
                  title="{{ 'customer.register.password_requirements' | t | default: 'Password must be at least 8 characters and include at least one uppercase letter, one lowercase letter, one number, and one special character' }}"
                  placeholder=" "
                  autocomplete="new-password"
                  {% if form.errors contains 'password' %}
                    aria-invalid="true"
                    aria-describedby="password-error"
                  {% endif %}
                >
                <label
                  for="password"
                >
                  {{ 'customer.login_page.password' | t | default: 'Password' }}
                </label>
              </div>
              <div class="password-requirements flex flex-col items-start text-xs mt-1 text-[#666666]">
                <div>
                  {{
                    'customer.register.password_requirements'
                    | t
                    | default: 'Password must meet the following requirements:'
                  }}
                </div>
                <ul class="mt-1 ml-4 list-disc">
                  <li class="requirement-length">At least 8 characters</li>
                  <li class="requirement-lowercase">At least one lowercase letter</li>
                  <li class="requirement-uppercase">At least one uppercase letter</li>
                  <li class="requirement-number">At least one number</li>
                  <li class="requirement-special">At least one special character</li>
                </ul>
              </div>
            </div>

            <div class="w-full">
              {%
                render 'checkbox-field',
                id: 'newsletter',
                name: 'customer[accepts_marketing]',
                value: '1',
                label: 'customer.register.accepts_marketing' | t | default: 'In the future, I would like to receive information by email about current trends, offers and NORTHFINDER discounts. The subscription can be canceled free of charge at any time.',
                class: 'flex items-start',
                input_class: 'flex size-[1.125rem] items-center justify-center mr-2 cursor-pointer p-2 relative',
                label_class: 'mt-0 text-foreground text-sm leading-6 text-left flex-1'
              %}
            </div>

            <button
              type="submit"
              class="w-full button"
            >
              {{ 'customer.register.submit' | t | default: 'Register' }}
            </button>
          </div>
        {% endform %}
      </div>

      <!-- Reset Password Form -->
      <div id="customer-recover-form" class="p-8 hidden customer">
        <div class="flex items-center mb-3">
          <h3 class="text-base font-bold uppercase">
            {{ 'customer.recover_password.title' | t | default: 'Forgot your password?' }}
          </h3>
        </div>

        <p class="text-base text-black mb-6 leading-6">
          {{
            'customer.recover_password.subtext'
            | t
            | default: 'Enter your email address and we will send you a link to reset your password'
          }}
        </p>

        <div id="recover-messages" class="auth-messages mt-4">
          {% if form.errors %}
            <div class="p-4 mb-4 rounded-3 bg-red-50 text-red-800">
              {{ form.errors | default_errors }}
            </div>
          {% elsif form.posted_successfully? %}
            <div class="p-4 mb-4 rounded-3 bg-green-50 text-green-800">
              {{
                'customer.recover_password.success'
                | t
                | default: "We've sent you an email with a link to update your password."
              }}
            </div>
          {% endif %}
        </div>

        {% form 'recover_customer_password', return_to: routes.account_login_url, id: 'customer_recover_form' %}
          <div class="flex flex-col">
            <div>
              <div class="relative mb-6 field">
                <input
                  type="email"
                  name="email"
                  id="recover_email"
                  required
                  placeholder=" "
                  class="w-full border border-[#B8B8B8] rounded-3 px-4 py-3 bg-white"
                  autocomplete="email"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="recover-email-error"
                  {% endif %}
                  value="{{ form.email }}"
                >
                <label
                  for="recover_email"
                  class="text-[#666666]"
                >
                  {{ 'customer.login_page.email' | t | default: 'E-mail' }}
                </label>
              </div>
            </div>

            <button
              type="submit"
              class="button w-full uppercase text-sm py-3 px-9 bg-black text-white font-semibold text-center rounded-3 mb-6"
            >
              {{ 'customer.recover_password.submit' | t | default: 'Reset Password' }}
            </button>

            <div class="text-center">
              <a
                href="javascript:void(0)"
                class="text-black font-medium text-sm recovery-cancel"
              >
                {{- 'customer.recover_password.cancel' | t | default: 'Back to login' -}}
              </a>
            </div>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Check if we're on an auth page
    const currentPath = window.location.pathname;
    const isAuthPage = currentPath.includes('/account/login') ||
                       currentPath.includes('/account/register') ||
                       currentPath === '/account';
    // Password validation functions
    function validatePassword(password) {
      const minLength = password.length >= 8;
      const hasLowercase = /[a-z]/.test(password);
      const hasUppercase = /[A-Z]/.test(password);
      const hasNumber = /\d/.test(password);
      const hasSpecial = /[!@#$%^&*()_+\-=\[\]{};':\"\\|,.<>\/?]/.test(password);

      return {
        minLength,
        hasLowercase,
        hasUppercase,
        hasNumber,
        hasSpecial,
        isValid: minLength && hasLowercase && hasUppercase && hasNumber && hasSpecial
      };
    }

    // Setup password validation UI
    const passwordInputs = document.querySelectorAll('input[type="password"][name="customer[password]"]');

    passwordInputs.forEach(function(input, index) {
      // Add input event listener
      input.addEventListener('input', function() {
        const validation = validatePassword(this.value);

        // Find the form containing this input
        const form = this.closest('form');

        // Look for the password-requirements div in the form
        const requirementsEl = form ? form.querySelector('.password-requirements') : document.querySelector('.password-requirements');

        if (requirementsEl) {
          // Update individual requirement indicators
          const lengthEl = requirementsEl.querySelector('.requirement-length');
          const lowercaseEl = requirementsEl.querySelector('.requirement-lowercase');
          const uppercaseEl = requirementsEl.querySelector('.requirement-uppercase');
          const numberEl = requirementsEl.querySelector('.requirement-number');
          const specialEl = requirementsEl.querySelector('.requirement-special');

          // Update classes based on validation
          updateRequirementClass(lengthEl, validation.minLength);
          updateRequirementClass(lowercaseEl, validation.hasLowercase);
          updateRequirementClass(uppercaseEl, validation.hasUppercase);
          updateRequirementClass(numberEl, validation.hasNumber);
          updateRequirementClass(specialEl, validation.hasSpecial);

          // Update overall validation state
          if (validation.isValid) {
            this.setCustomValidity('');
          } else if (this.value.length > 0) {
            this.setCustomValidity('Password must meet all requirements');
          } else {
            this.setCustomValidity('');
          }
        }
      });

      // Also add a keyup event listener as a backup
      input.addEventListener('keyup', function() {
        // Trigger the input event handler
        const event = new Event('input', { bubbles: true });
        this.dispatchEvent(event);
      });
    });

    // Helper function to update requirement class
    function updateRequirementClass(element, isValid) {
      if (!element) {
        return;
      }

      try {
        if (isValid) {
          element.classList.add('requirement-success');
          element.classList.remove('requirement-error');
          element.classList.remove('text-[#666666]');
        } else {
          element.classList.add('requirement-error');
          element.classList.remove('requirement-success');
          element.classList.remove('text-[#666666]');
        }

        // Force a repaint to ensure the changes take effect
        void element.offsetWidth;
      } catch (error) {
        // Silent error handling
      }
    }

    // Check if we need to reload the page after login
    if (localStorage.getItem('auth_reload_needed') === 'true') {
      // Clear the flag
      localStorage.removeItem('auth_reload_needed');

      // Check if the user is logged in
      {% if customer %}
        // User is logged in, reload the page to update the UI
        window.location.reload();
      {% endif %}
    }

    const modal = document.getElementById('auth-modal');
    const loginForm = document.getElementById('customer-login-form');
    const registerForm = document.getElementById('customer-register-form');
    const recoverForm = document.getElementById('customer-recover-form');
    const closeButton = modal.querySelector('.close');
    const loginTabs = modal.querySelectorAll('.tab-link');
    const forgotPasswordLink = loginForm.querySelector('.forgot-password-link');
    const recoverCancelLink = recoverForm.querySelector('.recovery-cancel');

    // Close modal
    closeButton.addEventListener('click', function() {
      modal.classList.add('hidden');
    });

    // Switch between login and register
    loginTabs.forEach(function(tab) {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        const tabType = this.getAttribute('data-tab');

        // Update active tab
        loginTabs.forEach(t => {
          t.classList.toggle('border-[#0F0F0F]', t === this);
          t.classList.toggle('border-transparent', t !== this);
        });

        // Show appropriate form
        if (tabType === 'login') {
          loginForm.classList.remove('hidden');
          registerForm.classList.add('hidden');
          recoverForm.classList.add('hidden');
        } else if (tabType === 'register') {
          loginForm.classList.add('hidden');
          registerForm.classList.remove('hidden');
          recoverForm.classList.add('hidden');
        }
      });
    });

    // Forgot password link
    forgotPasswordLink.addEventListener('click', function(e) {
      e.preventDefault();
      loginForm.classList.add('hidden');
      registerForm.classList.add('hidden');
      recoverForm.classList.remove('hidden');
    });

    // Recovery cancel link
    recoverCancelLink.addEventListener('click', function(e) {
      e.preventDefault();
      loginForm.classList.remove('hidden');
      registerForm.classList.add('hidden');
      recoverForm.classList.add('hidden');

      // Ensure login tab is active
      loginTabs.forEach(function(tab) {
        const isLoginTab = tab.getAttribute('data-tab') === 'login';
        tab.classList.toggle('border-[#0F0F0F]', isLoginTab);
        tab.classList.toggle('border-transparent', !isLoginTab);
      });
    });

    // Function to check if we're already on a login or register page
    function isOnAuthPage() {
      const currentPath = window.location.pathname;

      // Check if we're on login, register, or account pages
      return (
        currentPath.includes('/account/login') ||
        currentPath.includes('/account/register') ||
        currentPath === '/account'
      );
    }

    // Function to show auth modal
    function showAuthModal(formType = 'login') {
      // Don't show the modal if we're already on a login or register page
      if (isOnAuthPage()) {
        // If we're on an auth page, redirect to the appropriate page instead
        if (formType === 'login' && !window.location.pathname.includes('/account/login')) {
          window.location.href = '/account/login';
        } else if (formType === 'register' && !window.location.pathname.includes('/account/register')) {
          window.location.href = '/account/register';
        }

        return;
      }

      modal.classList.remove('hidden');

      // Hide all forms first
      loginForm.classList.add('hidden');
      registerForm.classList.add('hidden');
      recoverForm.classList.add('hidden');

      // Show requested form
      if (formType === 'login') {
        loginForm.classList.remove('hidden');
        // Ensure login tab is active
        loginTabs.forEach(function(tab) {
          const isLoginTab = tab.getAttribute('data-tab') === 'login';
          tab.classList.toggle('border-[#0F0F0F]', isLoginTab);
          tab.classList.toggle('border-transparent', !isLoginTab);
        });
      } else if (formType === 'register') {
        registerForm.classList.remove('hidden');
        // Ensure register tab is active
        loginTabs.forEach(function(tab) {
          const isRegisterTab = tab.getAttribute('data-tab') === 'register';
          tab.classList.toggle('border-[#0F0F0F]', isRegisterTab);
          tab.classList.toggle('border-transparent', !isRegisterTab);
        });
      } else if (formType === 'recover') {
        recoverForm.classList.remove('hidden');
      }
    }

    // Handle account and wishlist icon clicks
    const accountIcon = document.querySelector('.header__icon--account');
    const wishlistIcon = document.querySelector('.header__icon .icon-wishlist');

    if (accountIcon) {
      accountIcon.addEventListener('click', function(e) {
        // Check if user is not logged in and not already on an auth page
        {% if customer == null %}
          // Only prevent default and show modal if we're not already on an auth page
          if (!isOnAuthPage()) {
            e.preventDefault();
            showAuthModal('login');
          }
        {% endif %}
        // If logged in, default link behavior will take them to account page
      });
    }

    if (wishlistIcon) {
      const wishlistParent = wishlistIcon.closest('a');
      if (wishlistParent) {
        wishlistParent.addEventListener('click', function(e) {
          // Check if user is not logged in and not already on an auth page
          {% if customer == null %}
            // Only prevent default and show modal if we're not already on an auth page
            if (!isOnAuthPage()) {
              e.preventDefault();
              showAuthModal('login');
            }
          {% endif %}
          // If logged in, default link behavior will proceed
        });
      }
    }

    // Also handle wishlist buttons on product cards
    document.querySelectorAll('.wishlist-button').forEach(function(button) {
      button.addEventListener('click', function(e) {
        // Check if user is not logged in and not already on an auth page
        {% if customer == null %}
          // Only prevent default and show modal if we're not already on an auth page
          if (!isOnAuthPage()) {
            e.preventDefault();
            showAuthModal('login');
          }
        {% endif %}
        // If logged in, handle wishlist functionality (to be implemented)
      });
    });

    // Initialize any auth trigger buttons
    document.querySelectorAll('[data-auth-trigger]').forEach(function(button) {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const formType = e.currentTarget.getAttribute('data-auth-trigger');

        // Check if we're already on an auth page
        if (isOnAuthPage()) {
          console.log('Already on auth page, redirecting instead of showing modal');

          // Redirect to the appropriate page based on the form type
          if (formType === 'login' && !window.location.pathname.includes('/account/login')) {
            window.location.href = '/account/login';
          } else if (formType === 'register' && !window.location.pathname.includes('/account/register')) {
            window.location.href = '/account/register';
          }

          return;
        }

        // If not on an auth page, show the modal
        showAuthModal(formType);
      });
    });

    // Close modal when clicking outside
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Get all the forms
    const customerLoginForm = document.getElementById('customer_login_form');
    const customerRegisterForm = document.getElementById('customer_register_form');
    const customerRecoverForm = document.getElementById('customer_recover_form');

    // Handle form submissions
    if (customerLoginForm) {
      customerLoginForm.addEventListener('submit', function(e) {
        // We're not preventing default here, letting the form submit normally

        // Store a flag in localStorage to indicate we should reload after login
        localStorage.setItem('auth_reload_needed', 'true');

        // Let the form submit normally
        // The browser will follow the redirect to the login page and then back to the return_to URL
        // When the page loads, we'll check for the flag and reload if needed
      });
    }

    // Handle register form submission
    if (customerRegisterForm) {
      // Disable the native form validation
      customerRegisterForm.setAttribute('novalidate', 'novalidate');

      // First, completely disable the form's native submit behavior
      customerRegisterForm.onsubmit = function() {
        return false;
      };

      customerRegisterForm.addEventListener('submit', function(e) {
        console.log('Register form submit event triggered');

        // Always prevent the default submission first - multiple ways for redundancy
        if (e.preventDefault) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
        e.returnValue = false;
        console.log('Default form submission prevented');

        // Validate password before submission
        const passwordInput = this.querySelector('input[type="password"][name="customer[password]"]');
        console.log('Password input found in form:', !!passwordInput);

        if (passwordInput) {
          console.log('Password value:', passwordInput.value);

          // Validate the password
          const validation = validatePassword(passwordInput.value);
          console.log('Password validation result on submit:', validation);

          if (!validation.isValid) {
            console.log('Password validation failed on submit');

            // Get the password-requirements div directly from the form
            const requirementsEl = this.querySelector('.password-requirements');
            console.log('Requirements element found on submit:', !!requirementsEl);

            if (requirementsEl) {
              // Update individual requirement indicators
              const lengthEl = requirementsEl.querySelector('.requirement-length');
              const lowercaseEl = requirementsEl.querySelector('.requirement-lowercase');
              const uppercaseEl = requirementsEl.querySelector('.requirement-uppercase');
              const numberEl = requirementsEl.querySelector('.requirement-number');
              const specialEl = requirementsEl.querySelector('.requirement-special');

              console.log('Submit requirement elements found:', {
                length: !!lengthEl,
                lowercase: !!lowercaseEl,
                uppercase: !!uppercaseEl,
                number: !!numberEl,
                special: !!specialEl
              });

              // Update classes based on validation
              updateRequirementClass(lengthEl, validation.minLength);
              updateRequirementClass(lowercaseEl, validation.hasLowercase);
              updateRequirementClass(uppercaseEl, validation.hasUppercase);
              updateRequirementClass(numberEl, validation.hasNumber);
              updateRequirementClass(specialEl, validation.hasSpecial);
            }

            // Show error message
            passwordInput.setCustomValidity('Password must meet all requirements');
            passwordInput.reportValidity();
            passwordInput.focus();
            console.log('Form submission stopped due to invalid password');
            return false; // Stop here and don't submit
          } else {
            // Clear any previous validation message
            passwordInput.setCustomValidity('');
            console.log('Password validation passed on submit');
          }
        }

        console.log('Proceeding with form submission');
        // Store a flag in localStorage to indicate we should reload after registration
        localStorage.setItem('auth_reload_needed', 'true');

        // If we get here, validation passed, so submit the form programmatically
        // Use setTimeout to ensure this happens after all other handlers
        setTimeout(function() {
          console.log('Submitting register form programmatically');
          try {
            // Create a new submit event that bypasses our validation
            const submitEvent = new Event('submit-validated', { bubbles: true, cancelable: false });
            customerRegisterForm.dispatchEvent(submitEvent);

            // Submit the form directly
            customerRegisterForm.submit();
            console.log('Form submitted successfully');
          } catch (error) {
            console.error('Error submitting form:', error);

            // Fallback method - create a hidden submit button and click it
            const submitButton = document.createElement('button');
            submitButton.type = 'submit';
            submitButton.style.display = 'none';
            customerRegisterForm.appendChild(submitButton);
            submitButton.click();
            customerRegisterForm.removeChild(submitButton);
          }
        }, 10);

        return false;
      }, true); // true for capture phase
    }
  });
</script>
