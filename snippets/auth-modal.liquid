{% comment %}
  Authentication modal — Login / Register / Recover password.

  Built as a Dawn-style Web Component (<auth-modal>) wrapping the native <dialog> element.
  - Native <dialog> provides focus trap, top-layer rendering, ESC handling, and inert background.
  - The component is declarative: any element with [data-auth-trigger="login|register|recover"]
    will open the modal on click. Unauthenticated users clicking [data-auth-required] elements
    (account icon, wishlist) will also be intercepted via auth-modal.js event delegation.

  Usage:
    {% render 'auth-modal' %}
{% endcomment %}

{%- if customer == nil -%}
  <auth-modal
    id="AuthModal"
    data-heading-login="{{ 'customer.login_page.sign_in' | t }}"
    data-heading-register="{{ 'customer.register.title' | t }}"
    data-heading-recover="{{ 'customer.recover_password.title' | t }}"
  >
    <dialog
      class="auth-modal"
      aria-labelledby="AuthModal-heading"
    >
      <button
        type="button"
        class="auth-modal__close"
        aria-label="{{ 'accessibility.close' | t }}"
        data-auth-close
      >
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      <div class="auth-modal__inner" tabindex="-1">
        <h2 id="AuthModal-heading" class="auth-modal__heading">
          {{- 'customer.login_page.sign_in' | t -}}
        </h2>

        <div role="tablist" class="auth-modal__tablist" aria-label="{{ 'customer.login_page.title' | t }}">
          <button
            type="button"
            role="tab"
            id="AuthModal-tab-login"
            aria-selected="true"
            aria-controls="AuthModal-panel-login"
            tabindex="0"
            class="auth-modal__tab"
            data-tab="login"
          >
            {{- 'customer.login_page.sign_in' | t -}}
          </button>
          <button
            type="button"
            role="tab"
            id="AuthModal-tab-register"
            aria-selected="false"
            aria-controls="AuthModal-panel-register"
            tabindex="-1"
            class="auth-modal__tab"
            data-tab="register"
          >
            {{- 'customer.register.title' | t -}}
          </button>
        </div>

        <div
          id="AuthModal-panel-login"
          role="tabpanel"
          aria-labelledby="AuthModal-tab-login"
          class="auth-modal__panel customer"
          data-panel="login"
        >
          {% render 'auth-form-login' %}
        </div>

        <div
          id="AuthModal-panel-register"
          role="tabpanel"
          aria-labelledby="AuthModal-tab-register"
          class="auth-modal__panel customer"
          data-panel="register"
          hidden
        >
          {% render 'auth-form-register' %}
        </div>

        <div
          id="AuthModal-panel-recover"
          role="tabpanel"
          aria-labelledby="AuthModal-tab-login"
          class="auth-modal__panel customer"
          data-panel="recover"
          hidden
        >
          {% render 'auth-form-recover' %}
        </div>
      </div>
    </dialog>
  </auth-modal>
{%- endif -%}
