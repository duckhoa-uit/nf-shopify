{%- assign required = required | default: false -%}
{%- assign readonly = readonly | default: false -%}

{% comment %}
  Format the phone number to display without leading zero
  This is needed when the page reloads after form submission
{% endcomment %}
{%- assign formatted_value = value | default: '' -%}
{%- if formatted_value != '' -%}
  {%- assign first_char = formatted_value | slice: 0, 1 -%}
  {%- if first_char == '+' -%}
    {%- comment -%}Already in international format, will be handled by JS{%- endcomment -%}
  {%- elsif first_char == '0' -%}
    {%- assign formatted_value = formatted_value | slice: 1, formatted_value.size -%}
  {%- endif -%}
{%- endif -%}

<div class="phone-field-wrapper{% if class %} {{ class }}{% endif %}">
  <label class="form-label mb-0" for="{{ id }}">
    {% if label contains 'customer.' or label contains 'general.' %}
      {{ label | t }}
    {% else %}
      {{ label }}
    {% endif %}
  </label>
  <div class="phone-field">
    <input
      type="tel"
      id="{{ id }}"
      name="{{ name }}_display"
      class="field__input phone-input"
      value="{{ formatted_value }}"
      placeholder="Phone number"
      {% if required %}
        required
        aria-required="true"
      {% endif %}
      {% if readonly %}
        readonly
      {% endif %}
      data-intl-tel-input
      data-shop-country="{{ shop.country }}"
      {% if error_id %}
        data-error-for="{{ error_id }}"
      {% endif %}
    >
    <input
      type="hidden"
      id="{{ id }}_international"
      name="{{ name }}"
      value="{{ value | default: '' }}"
      class="phone-international-format"
      {% if required %}
        required
      {% endif %}
    >

  </div>

  {% comment %}
    Create a hidden element with all countries from Shopify
    This will be used by JavaScript to populate the country dropdown
  {% endcomment %}
  <select class="hidden" aria-hidden="true" id="{{ id }}_countries" style="display: none;">
    {% for country in all_country_option_tags %}
      {% assign country_option = country | split: '"' %}
      {% assign country_code = country_option[1] | downcase %}
      {% assign country_name = country_option[2] | remove: '>' | remove: '</' | remove: 'option' | strip %}
      <option value="{{ country_code }}" data-name="{{ country_name }}">{{ country_name }}</option>
    {% endfor %}
  </select>
</div>

{% comment %} Load intl-tel-input JavaScript inline {% endcomment %}
<script id="intl-tel-input-js-{{ id }}">
  // Only load JavaScript once per page
  if (!window.intlTelInputLoaded) {
    window.intlTelInputLoaded = true;

    // Load intl-tel-input library from CDN
    const intlTelInputScript = document.createElement('script');
    intlTelInputScript.src = '{{ "intl-tel-input.min.js" | asset_url }}';
    intlTelInputScript.onload = function() {
      // Load utils script
      const utilsScript = document.createElement('script');
      utilsScript.src = '{{ "intl-tel-input-utils.js" | asset_url }}';
      utilsScript.onload = function() {
        // Initialize phone validation after both scripts are loaded
        initializePhoneField{{ id | replace: '-', '_' | replace: '[', '_' | replace: ']', '_' }}();
      };
      document.head.appendChild(utilsScript);
    };
    document.head.appendChild(intlTelInputScript);
  } else {
    // Scripts already loaded, initialize immediately
    setTimeout(function() {
      initializePhoneField{{ id | replace: '-', '_' | replace: '[', '_' | replace: ']', '_' }}();
    }, 100);
  }

  // Initialize phone field function
  function initializePhoneField{{ id | replace: '-', '_' | replace: '[', '_' | replace: ']', '_' }}() {
    if (!window.intlTelInput) {
      console.error('intlTelInput library not loaded');
      return;
    }

    const input = document.getElementById('{{ id }}');
    if (!input) {
      console.error('Phone input not found: {{ id }}');
      return;
    }

    // Skip if already initialized
    if (input.classList.contains('iti-initialized')) {
      return;
    }

    // Set up theme strings for validation
    if (!window.theme) window.theme = {};
    if (!window.theme.strings) window.theme.strings = {};
    window.theme.strings.phone_validation = {
      invalid: {{ 'phone_validation.invalid' | t | default: 'Invalid phone number' | json }},
      invalid_country_code: {{ 'phone_validation.invalid_country_code' | t | default: 'Invalid country code' | json }},
      too_short: {{ 'phone_validation.too_short' | t | default: 'Phone number is too short' | json }},
      too_long: {{ 'phone_validation.too_long' | t | default: 'Phone number is too long' | json }},
      local_only: {{ 'phone_validation.local_only' | t | default: 'Please enter an international format' | json }}
    };
    window.theme.strings.phone_required = {{ 'phone_validation.required' | t | default: 'Please enter a phone number' | json }};
    window.theme.assets = {
      utilsScript: '{{ "intl-tel-input-utils.js" | asset_url }}'
    };

    // Get shop country and preferred countries
    const shopCountry = input.getAttribute('data-shop-country') || 'DE';
    const preferredCountries = ['de', 'at', 'ch', 'us', 'gb'];

    // Initialize intl-tel-input
    const iti = window.intlTelInput(input, {
      utilsScript: window.theme.assets.utilsScript,
      preferredCountries: preferredCountries,
      initialCountry: shopCountry.toLowerCase(),
      autoPlaceholder: 'aggressive',
      separateDialCode: true,
      formatOnDisplay: false,
      allowDropdown: !input.readOnly && !input.disabled,
      customContainer: "phone-field-container",
      customPlaceholder: function(selectedCountryPlaceholder, selectedCountryData) {
        return "Phone number";
      }
    });

    input.classList.add('iti-initialized');

    // Find or create hidden input
    let hiddenInput = document.getElementById('{{ id }}_international');
    if (!hiddenInput) {
      hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = input.name.replace('_display', '');
      hiddenInput.id = '{{ id }}_international';
      hiddenInput.className = 'phone-international-format';
      input.after(hiddenInput);

      if (input.name.indexOf('_display') === -1) {
        input.name = input.name + '_display';
      }
    }

    // Update hidden input on change
    function updateHiddenInput() {
      const internationalNumber = iti.getNumber();
      if (hiddenInput) {
        hiddenInput.value = internationalNumber;
      }
    }

    // Event listeners
    input.addEventListener('input', function() {
      updateHiddenInput();
      // Clear validation message as user types
      input.setCustomValidity('');
    });
    input.addEventListener('countrychange', updateHiddenInput);

    // Initial update
    updateHiddenInput();

    // Validation function using setCustomValidity
    function validatePhoneInput() {
      if (input.value.trim() === '') {
        if (input.hasAttribute('required')) {
          input.setCustomValidity(window.theme.strings.phone_required);
          return false;
        }
        input.setCustomValidity('');
        return true;
      }

      const isValid = iti.isValidNumber();
      if (!isValid) {
        const errorCode = iti.getValidationError();
        let message = window.theme.strings.phone_validation.invalid;

        switch (errorCode) {
          case window.intlTelInputUtils.validationError.INVALID_COUNTRY_CODE:
            message = window.theme.strings.phone_validation.invalid_country_code;
            break;
          case window.intlTelInputUtils.validationError.TOO_SHORT:
            message = window.theme.strings.phone_validation.too_short;
            break;
          case window.intlTelInputUtils.validationError.TOO_LONG:
            message = window.theme.strings.phone_validation.too_long;
            break;
        }

        input.setCustomValidity(message);
        return false;
      }

      input.setCustomValidity('');
      return true;
    }



    // Form submission validation
    const form = input.closest('form');
    if (form && !form.hasAttribute('data-phone-handler-initialized-{{ id }}')) {
      form.setAttribute('data-phone-handler-initialized-{{ id }}', 'true');

      form.addEventListener('submit', function(e) {
        if (!validatePhoneInput()) {
          e.preventDefault();
          e.stopPropagation();
          input.focus();
          return false;
        }
      });
    }

    // Real-time validation with debounce
    let validationTimeout;
    input.addEventListener('input', function() {
      clearTimeout(validationTimeout);
      if (input.value.length >= 3) {
        validationTimeout = setTimeout(validatePhoneInput, 500);
      } else {
        input.setCustomValidity('');
      }
    });
  }
</script>
