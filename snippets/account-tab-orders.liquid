{% comment %}
  Orders tab content

  Accepts:
  - customer: The customer object
{% endcomment %}

<div
  id="orders"
  class="tab-content"
  role="tabpanel"
  data-reorder-error="{{ 'customer.orders.reorder_error' | t }}"
>
  <h2 class="section-title">{{ 'customer.orders.title' | t }}</h2>
  {% paginate customer.orders by 5 %}
    {%- if customer.orders.size > 0 -%}
      <div class="order-header-labels">
        <div>{{ 'customer.orders.order_number' | t }}</div>
        <div>{{ 'customer.orders.date' | t }}</div>
        <div>{{ 'customer.orders.quantity' | t }}</div>
        <div>{{ 'customer.orders.status' | t }}</div>
        <div class="text-right">{{ 'customer.orders.total' | t }}</div>
      </div>

      <div class="orders-list">
        {%- for order in customer.orders -%}
          <div class="order-item" data-order-id="{{ order.id }}">
            <div class="order-header" data-order-id="{{ order.id }}">
              <div class="order-number">
                <a
                  href="{{ order.customer_url }}"
                  aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                >
                  {{ order.name }}
                </a>
              </div>
              <div class="order-date">{{ order.created_at | date: '%d.%m.%Y' }}</div>
              <div class="order-quantity">{{ order.line_items.size }}</div>
              <div>
                {% comment %} Priority order: cancelled > refunded > partially_refunded > delivered > shipped > processing > pending {% endcomment %}
                {% if order.cancelled %}
                  <div class="order-status cancelled">{{ 'customer.orders.cancelled' | t }}</div>
                {% elsif order.financial_status == 'refunded' %}
                  <div class="order-status refunded">{{ 'customer.orders.refunded' | t }}</div>
                {% elsif order.financial_status == 'partially_refunded' %}
                  <div class="order-status partially-refunded">{{ 'customer.orders.partially_refunded' | t }}</div>
                {% elsif order.fulfillment_status_label == 'Fulfilled' %}
                  <div class="order-status delivered">{{ 'customer.orders.delivered' | t }}</div>
                {% elsif order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial' %}
                  <div class="order-status shipped">{{ 'customer.orders.shipped' | t }}</div>
                {% elsif order.financial_status == 'paid' and order.fulfillment_status == 'unfulfilled' %}
                  <div class="order-status processing">{{ 'customer.orders.processing' | t }}</div>
                {% elsif order.financial_status == 'pending' or order.financial_status == 'unpaid' %}
                  <div class="order-status pending">{{ 'customer.orders.pending_payment' | t }}</div>
                {% else %}
                  <div class="order-status processing">{{ order.fulfillment_status_label }}</div>
                {% endif %}
              </div>
              <div class="order-total">{{ order.total_price | money }}</div>
            </div>

            <!-- Mobile order header -->
            <div class="order-header-mobile">
              <div class="order-header-mobile-row">
                <div class="order-header-mobile-label font-normal">{{ 'customer.orders.order_number' | t }}:</div>
                <div class="order-header-mobile-value font-bold">{{ order.name }}</div>

                <div class="order-header-mobile-status">
                  {% comment %} Priority order: cancelled > refunded > partially_refunded > delivered > shipped > processing > pending {% endcomment %}
                  {% if order.cancelled %}
                    <div class="order-status cancelled">{{ 'customer.orders.cancelled' | t }}</div>
                  {% elsif order.financial_status == 'refunded' %}
                    <div class="order-status refunded">{{ 'customer.orders.refunded' | t }}</div>
                  {% elsif order.financial_status == 'partially_refunded' %}
                    <div class="order-status partially-refunded">{{ 'customer.orders.partially_refunded' | t }}</div>
                  {% elsif order.fulfillment_status_label == 'Fulfilled' %}
                    <div class="order-status delivered">{{ 'customer.orders.delivered' | t }}</div>
                  {% elsif order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial' %}
                    <div class="order-status shipped">{{ 'customer.orders.shipped' | t }}</div>
                  {% elsif order.financial_status == 'paid' and order.fulfillment_status == 'unfulfilled' %}
                    <div class="order-status processing">{{ 'customer.orders.processing' | t }}</div>
                  {% elsif order.financial_status == 'pending' or order.financial_status == 'unpaid' %}
                    <div class="order-status pending">{{ 'customer.orders.pending_payment' | t }}</div>
                  {% else %}
                    <div class="order-status processing">{{ order.fulfillment_status_label }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
            <div class="order-header-mobile">
              <div class="order-header-mobile-row">
                <div class="order-header-mobile-label">{{ 'customer.orders.date' | t }}:</div>
                <div class="order-header-mobile-value">{{ order.created_at | date: '%d.%m.%Y' }}</div>
              </div>
              <div class="order-header-mobile-row mt-2">
                <div class="order-header-mobile-label">{{ 'customer.orders.quantity' | t }}:</div>
                <div class="order-header-mobile-value">{{ order.line_items.size }}</div>
              </div>
              <div class="order-header-mobile-row mt-2">
                <div class="order-header-mobile-label">{{ 'customer.orders.total' | t }}:</div>
                <div class="order-header-mobile-value">{{ order.total_price | money }}</div>
              </div>
            </div>

            <div class="order-content">
              <div class="order-products">
                {% for line_item in order.line_items %}
                  <div class="order-product">
                    <div class="product-left">
                      <div class="product-image">
                        {% comment %} Extract color value using direct variant option properties {% endcomment %}
                        {% assign color_value = null %}
                        {% capture order_color_pos %}{% render 'get-color-option-position', product: line_item.product %}{% endcapture %}
                        {% assign order_color_pos = order_color_pos | strip | plus: 0 %}
                        {% if order_color_pos == 1 %}
                          {% assign color_value = line_item.variant.option1 %}
                        {% elsif order_color_pos == 2 %}
                          {% assign color_value = line_item.variant.option2 %}
                        {% elsif order_color_pos == 3 %}
                          {% assign color_value = line_item.variant.option3 %}
                        {% endif %}

                        {% comment %} Try to get color-specific image {% endcomment %}
                        {% if color_value != blank %}
                          {% capture variant_image_url %}{% render 'get-variant-color-image',
                            product: line_item.product,
                            color_value: color_value,
                            variant: line_item.variant,
                            width: 100,
                            height: 100,
                            crop: 'center',
                            image_type: 'M'
                          %}{% endcapture %}
                          {% assign variant_image_url = variant_image_url | strip %}
                        {% endif %}

                        {% if variant_image_url != blank %}
                          <img
                            src="{{ variant_image_url }}"
                            alt="{{ line_item.title | escape }}"
                            width="100"
                            height="100"
                            loading="lazy"
                          >
                        {% elsif line_item.image %}
                          <img
                            src="{{ line_item.image | image_url: width: 100, height: 100, crop: 'center' }}"
                            alt="{{ line_item.title | escape }}"
                            width="100"
                            height="100"
                            loading="lazy"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {% endif %}

                        {% if line_item.original_price > line_item.final_price %}
                          {% assign discount_percentage = line_item.original_price
                            | minus: line_item.final_price
                            | times: 100
                            | divided_by: line_item.original_price
                          %}
                          <div class="sale-badge">-{{ discount_percentage }}%</div>
                        {% endif %}
                      </div>
                    </div>

                    <div class="product-info">
                      {% comment %} Use product.title directly - Shopify's native localization handles language switching {% endcomment %}
                      <h4 class="text-sm leading-5">
                        <a href="{{ line_item.product.url }}" class="hover:underline text-current">
                          {{ line_item.product.title | escape }}
                        </a>
                      </h4>

                      <div class="product-meta">
                        {% comment %} Detect size and color positions using locale-independent centralized snippets {% endcomment %}
                        {% assign display_size_pos = 0 %}
                        {% assign display_color_pos = order_color_pos %}
                        {% for option in line_item.product.options_with_values %}
                          {% capture is_opt_color %}{% render 'is-color-option', option: option, product: line_item.product %}{% endcapture %}
                          {% assign is_opt_color = is_opt_color | strip %}
                          {% if is_opt_color == 'true' %}
                            {% assign display_color_pos = option.position %}
                          {% else %}
                            {% capture is_opt_size %}{% render 'is-size-option', option: option, product: line_item.product %}{% endcapture %}
                            {% assign is_opt_size = is_opt_size | strip %}
                            {% if is_opt_size == 'true' %}
                              {% assign display_size_pos = option.position %}
                            {% endif %}
                          {% endif %}
                        {% endfor %}

                        {% comment %} Get translated option values directly from variant object {% endcomment %}
                        {% assign display_size_value = nil %}
                        {% assign display_color_value = nil %}
                        {% if display_size_pos == 1 %}
                          {% assign display_size_value = line_item.variant.option1 %}
                        {% elsif display_size_pos == 2 %}
                          {% assign display_size_value = line_item.variant.option2 %}
                        {% elsif display_size_pos == 3 %}
                          {% assign display_size_value = line_item.variant.option3 %}
                        {% endif %}
                        {% if display_color_pos == 1 %}
                          {% assign display_color_value = line_item.variant.option1 %}
                        {% elsif display_color_pos == 2 %}
                          {% assign display_color_value = line_item.variant.option2 %}
                        {% elsif display_color_pos == 3 %}
                          {% assign display_color_value = line_item.variant.option3 %}
                        {% endif %}

                        {% comment %} Display size if available {% endcomment %}
                        <div class="product-meta-item">
                          <span class="meta-label">{{ 'customer.orders.size' | t }}:</span>
                          <span class="meta-value">
                            {{ display_size_value | default: 'N/A' }}
                          </span>
                        </div>

                        {% comment %} Display color if available {% endcomment %}
                        <div class="product-meta-item">
                          <span class="meta-label">{{ 'customer.orders.color' | t }}:</span>
                          <span class="meta-value">
                            {{ display_color_value | default: 'N/A' }}
                          </span>
                        </div>

                        <div class="product-meta-item">
                          <span class="meta-label">{{ 'customer.orders.quantity' | t }}:</span>
                          <span class="meta-value">{{ line_item.quantity }}</span>
                        </div>
                        <div class="product-meta-item">
                          <span class="meta-value md:hidden">
                            {% if line_item.original_price > line_item.final_price %}
                              <s>{{ line_item.original_price | money }}</s>
                              <span>{{ line_item.final_price | money }}</span>
                            {% else %}
                              <span>{{ line_item.original_price | money }}</span>
                            {% endif %}
                          </span>
                        </div>
                      </div>
                    </div>

                    <div></div>
                    <div></div>

                    <div class="product-price">
                      {% if line_item.original_price > line_item.final_price %}
                        <s>{{ line_item.original_price | money }}</s>
                        <span>{{ line_item.final_price | money }}</span>
                      {% else %}
                        <span>{{ line_item.original_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}

                <div class="order-toggle-container hidden md:block">
                  <div class="order-toggle" data-order-toggle>
                    {{ 'customer.orders.detail' | t }}
                    <span class="icon svg-wrapper rotate-90">
                      {{ 'icon-chevron.svg' | inline_asset_content }}
                    </span>
                  </div>
                </div>
                <div class="order-toggle-container h-12 md:hidden">
                  <div class="order-toggle top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-8" data-order-toggle>
                    {{ 'customer.orders.detail' | t }}
                    <span class="icon svg-wrapper rotate-90">
                      {{ 'icon-chevron.svg' | inline_asset_content }}
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <div class="order-details">
              <div class="order-details-grid">
                <!-- Column 1: Addresses -->
                <div class="order-details-column order-addresses-column">
                  <div class="order-addresses">
                    <div class="order-address">
                      <h3>{{ 'customer.orders.billing_address' | t }}</h3>
                      {% if order.billing_address %}
                        <ul class="address-list">
                          {% if order.billing_address.first_name != blank or order.billing_address.last_name != blank %}
                            <li>{{ order.billing_address.first_name }} {{ order.billing_address.last_name }}</li>
                          {% endif %}
                          {% if order.billing_address.company != blank %}
                            <li>{{ order.billing_address.company }}</li>
                          {% endif %}
                          {% if order.email != blank %}
                            <li>{{ order.email }}</li>
                          {% endif %}
                          {% if order.billing_address.phone != blank %}
                            <li>{{ order.billing_address.phone }}</li>
                          {% endif %}
                          {% if order.billing_address.address1 != blank %}
                            <li>{{ order.billing_address.address1 }}</li>
                          {% endif %}
                          {% if order.billing_address.address2 != blank %}
                            <li>{{ order.billing_address.address2 }}</li>
                          {% endif %}
                          {% if order.billing_address.city != blank %}
                            <li>{{ order.billing_address.city }}</li>
                          {% endif %}
                          {% if order.billing_address.zip != blank %}
                            <li>{{ order.billing_address.zip }}</li>
                          {% endif %}
                          {% if order.billing_address.country != blank %}
                            <li>{{ order.billing_address.country }}</li>
                          {% endif %}
                        </ul>
                      {% else %}
                        <p>{{ 'customer.orders.no_billing_address' | t }}</p>
                      {% endif %}
                    </div>

                    <div class="order-address">
                      <h3>{{ 'customer.orders.shipping_address' | t }}</h3>
                      {% if order.shipping_address %}
                        <ul class="address-list">
                          {% if order.shipping_address.first_name != blank or order.shipping_address.last_name != blank %}
                            <li>{{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}</li>
                          {% endif %}
                          {% if order.shipping_address.company != blank %}
                            <li>{{ order.shipping_address.company }}</li>
                          {% endif %}
                          {% if order.email != blank %}
                            <li>{{ order.email }}</li>
                          {% endif %}
                          {% if order.shipping_address.phone != blank %}
                            <li>{{ order.shipping_address.phone }}</li>
                          {% endif %}
                          {% if order.shipping_address.address1 != blank %}
                            <li>{{ order.shipping_address.address1 }}</li>
                          {% endif %}
                          {% if order.shipping_address.address2 != blank %}
                            <li>{{ order.shipping_address.address2 }}</li>
                          {% endif %}
                          {% if order.shipping_address.city != blank %}
                            <li>{{ order.shipping_address.city }}</li>
                          {% endif %}
                          {% if order.shipping_address.zip != blank %}
                            <li>{{ order.shipping_address.zip }}</li>
                          {% endif %}
                          {% if order.shipping_address.country != blank %}
                            <li>{{ order.shipping_address.country }}</li>
                          {% endif %}
                        </ul>
                      {% else %}
                        <p>{{ 'customer.orders.no_shipping_address' | t }}</p>
                      {% endif %}
                    </div>
                  </div>
                </div>

                <!-- Column 3: Pricing -->
                <div class="order-details-column order-pricing-column">
                  <h3>{{ 'customer.orders.price_details' | t }}</h3>
                  <div class="order-pricing">
                    {% assign original_price = order.subtotal_price | plus: order.total_discounts %}
                    <div class="price-item">
                      <span class="price-label">{{ 'customer.orders.original_price' | t }}</span>
                      <span class="price-value">{{ original_price | money }}</span>
                    </div>

                    {% if order.discount_applications.size > 0 %}
                      {% comment %} Group discounts by target_type {% endcomment %}
                      {% assign line_item_discount_total = 0 %}
                      {% assign shipping_discount_total = 0 %}
                      {% assign line_item_discount_percentage = 0 %}
                      {% assign shipping_discount_percentage = 0 %}

                      {% for discount_application in order.discount_applications %}
                        {% if discount_application.target_type == 'line_item' %}
                          {% assign line_item_discount_total = line_item_discount_total | plus: discount_application.total_allocated_amount %}
                          {% if discount_application.value_type == 'percentage' and line_item_discount_percentage == 0 %}
                            {% assign line_item_discount_percentage = discount_application.value %}
                          {% endif %}
                        {% elsif discount_application.target_type == 'shipping_line' %}
                          {% assign shipping_discount_total = shipping_discount_total | plus: discount_application.total_allocated_amount %}
                          {% if discount_application.value_type == 'percentage' and shipping_discount_percentage == 0 %}
                            {% assign shipping_discount_percentage = discount_application.value %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}

                      {% comment %} Display line item discounts {% endcomment %}
                      {% if line_item_discount_total > 0 %}
                        <div class="price-item discount-row">
                          <span class="price-label">{{ 'customer.orders.product_discount' | t }}</span>
                          <div class="price-value-with-badge">
                            <span class="price-value discount">-{{ line_item_discount_total | money }}</span>
                            {% comment %} {% if line_item_discount_percentage > 0 %}
                              <span class="discount-badge">-{{ line_item_discount_percentage }}%</span>
                            {% endif %} {% endcomment %}
                          </div>
                        </div>
                      {% endif %}

                      {% comment %} Display shipping discounts {% endcomment %}
                      {% if shipping_discount_total > 0 %}
                        <div class="price-item discount-row">
                          <span class="price-label">{{ 'customer.orders.shipping_discount' | t }}</span>
                          <div class="price-value-with-badge">
                            <span class="price-value discount">-{{ shipping_discount_total | money }}</span>
                            {% if shipping_discount_percentage > 0 %}
                              <span class="discount-badge">-{{ shipping_discount_percentage }}%</span>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}
                    {% elsif order.total_discounts > 0 %}
                      {% assign discount_percentage = order.total_discounts
                        | times: 100
                        | divided_by: original_price
                        | round
                      %}
                      <div class="price-item discount-row">
                        <span class="price-label">{{ 'customer.orders.discount' | t }}</span>
                        <div class="price-value-with-badge">
                          <span class="price-value discount">-{{ order.total_discounts | money }}</span>
                          <span class="discount-badge">-{{ discount_percentage }}%</span>
                        </div>
                      </div>
                    {% endif %}

                    <div class="price-item">
                      <span class="price-label">{{ 'customer.orders.purchase_price' | t }}</span>
                      <span class="price-value">{{ order.total_price | money }}</span>
                    </div>

                    {% assign shipping_price = order.shipping_price %}
                    {% if shipping_price > 0 %}
                      <div class="price-item">
                        <span class="price-label">{{ 'customer.orders.shipping' | t }}</span>
                        <span class="price-value">{{ shipping_price | money }}</span>
                      </div>
                    {% endif %}

                    <div class="price-item">
                      <span class="price-label">{{ 'customer.orders.including_vat' | t }}</span>
                      <span class="price-value">{{ order.tax_price | money }}</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="order-actions">
                {% if order.financial_status == 'paid' %}
                  <a
                    href="https://{{ shop.permanent_domain }}/apps/pdf-vify/pdf-preview/invoice?shop_domain={{ shop.permanent_domain }}&order_id={{ order.id }}&locale={{ request.locale.iso_code }}"
                    class="order-action-btn btn-invoice"
                    target="_blank"
                  >
                    <span class="btn-icon">
                      {{ 'icon-download.svg' | inline_asset_content }}
                    </span>
                    <span class="btn-text">{{ 'customer.orders.download_invoice' | t }}</span>
                  </a>
                {% endif %}

                <button
                  type="button"
                  class="order-action-btn btn-reorder"
                  data-variants="{% for item in order.line_items %}{{ item.variant_id }}:{{ item.quantity }}{% unless forloop.last %},{% endunless %}{% endfor %}"
                >
                  <span class="btn-text">{{ 'customer.orders.reorder' | t }}</span>
                  <span class="btn-spinner">
                    {{- 'loading-spinner.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>

              <div class="relative md:hidden flex justify-center items-center mb-4">
                <div class="order-toggle static" data-order-toggle>
                  <svg width="22" height="10" viewBox="0 0 22 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 9L11 1L21 9" stroke="#EC0009" stroke-linecap="round"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      {%- if paginate.parts.size > 0 -%}
        <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
          <ul role="list">
            {%- if paginate.previous -%}
              <li>
                <a href="{{ paginate.previous.url }}#orders" aria-label="{{ 'general.pagination.previous' | t }}">
                  <span class="svg-wrapper">
                    {{ 'chevron-left.svg' | inline_asset_content }}
                  </span>
                </a>
              </li>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}#orders" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                    {{- part.title -}}
                  </a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span
                      aria-current="page"
                      aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                    >
                      {{- part.title -}}
                    </span>
                  {%- else -%}
                    <span>{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- if paginate.next -%}
              <li>
                <a href="{{ paginate.next.url }}#orders" aria-label="{{ 'general.pagination.next' | t }}">
                  <span class="svg-wrapper">
                    {{ 'chevron-right.svg' | inline_asset_content }}
                  </span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endif -%}
  {% endpaginate %}
</div>
