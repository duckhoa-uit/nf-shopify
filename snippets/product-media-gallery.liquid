  /* Hide navigation buttons on tablet and mobile */
  @media screen and (max-width: 990px) {
    .f-button.is-prev,
    .f-button.is-next {
      display: none;
    }
  }

  .f-button.is-prev:hover,
  .f-button.is-next:hover {
    opacity: 0.9;
  }

  .f-button.is-prev::before,
  .f-button.is-next::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 24px;
    stroke: #0f0f0f;
    stroke-width: 2px;
    stroke-linecap: round;
