{%- if template.name == 'product' -%}
  <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js" defer></script>
{%- endif -%}

{%- liquid
  # Get currently selected or first available variant
  assign first_variant = product.selected_or_first_available_variant

  # Detect color option using language-agnostic swatch/position detection
  assign color_option_name = ''
  assign color_option_index = -1
  assign temp_index = 0
  for option in product.options_with_values
    capture is_color
      render 'is-color-option', option: option
    endcapture
    if is_color == 'true'
      assign color_option_name = option.name
      assign color_option_index = temp_index
      break
    endif
    assign temp_index = temp_index | plus: 1
  endfor

  assign active_color = blank
  if color_option_name != ''
    assign active_color = first_variant.option_values | where: 'name', color_option_name | first
  endif

  # Try different approaches to get color
  if active_color == blank
    # Try options directly
    assign color_position = -1
    assign option_index = 0
    for option in product.options_with_values
      # Position-based color detection for internationalization
      # Color is typically position 1 or has swatch values
      assign swatch_count = option.values | map: 'swatch' | compact | size
      assign is_color_option = false

      if option.position == 1
        assign is_color_option = true
      endif

      if swatch_count > 0
        assign is_color_option = true
      endif

      if is_color_option
        assign color_position = option_index
        break
      endif
      assign option_index = option_index | plus: 1
    endfor

    if color_position >= 0
      assign active_color_value = first_variant.options[color_position] | downcase | strip | replace: ' ', '-'
    endif
  else
    assign active_color_value = active_color.value | downcase | strip | replace: ' ', '-'
  endif

  # If still blank, try selected options
  if active_color_value == blank
    assign selected_options = first_variant.selected_options
    for option in selected_options
      # Position-based color detection for internationalization
      # Check if this is a color option (position 1 or has swatch values)
      assign is_color_option = false
      if option.name
        # Find the corresponding option in product.options_with_values to check position
        for product_option in product.options_with_values
          if product_option.name == option.name
            assign swatch_count = product_option.values | map: 'swatch' | compact | size

            if product_option.position == 1
              assign is_color_option = true
            endif

            if swatch_count > 0
              assign is_color_option = true
            endif
            break
          endif
        endfor
      endif

      if is_color_option
        assign active_color_value = option.value | downcase | strip | replace: ' ', '-'
        break
      endif
    endfor
  endif

  # If still blank, fallback to first variant title
  if active_color_value == blank
    assign active_color_value = first_variant.title | downcase | split: '/' | first | strip | replace: ' ', '-'
  endif

  # Clean up the color value - remove special characters and clean up
  assign active_color_value = active_color_value | replace: "'", '' | replace: '.', '' | replace: ',', ''

  # Remove trailing dash if present
  if active_color_value contains '-'
    assign last_char = active_color_value | slice: -1, 1
    if last_char == '-'
      assign active_color_value = active_color_value | slice: 0, -1
    endif
  endif

  # ---------------------------------------------------------------------------
  # Locale-safe color matching: build option_value -> reference_id map.
  #
  # Variant option values may arrive in either form depending on whether the
  # product uses Shopify's "linked metafield" option feature:
  #   - Untranslated handle key  e.g. "black", "tyrkis"
  #   - Localized metaobject name e.g. "črna" (sl), "noir" (fr)
  #
  # Image filenames always embed `reference_id`, so we resolve any of those
  # variants to a reference_id and pass that to the gallery. We register both
  # the metaobject's untranslated `system.handle` (with trailing -<digits>
  # suffix stripped) AND the (possibly localized) `name` field for the
  # current storefront locale.
  # ---------------------------------------------------------------------------
  assign active_color_reference_id = ''
  assign color_value_to_ref_json = '{'
  assign first_pair = true

  if product.metafields.custom.color.value != blank
    for color_item in product.metafields.custom.color.value
      assign ref_id = color_item.reference_id | default: ''
      if ref_id == ''
        continue
      endif

      assign raw_handle = color_item.system.handle | default: ''
      assign normalized_handle = ''

      if raw_handle != ''
        # Strip trailing -<digits> suffix that Shopify auto-appends to handles
        # (e.g. `tyrkis-1`, `espresso-bronze-2` -> `tyrkis`, `espresso-bronze`).
        assign handle_parts = raw_handle | split: '-'
        assign last_part = handle_parts | last
        assign last_as_int_str = last_part | plus: 0 | append: ''
        if last_as_int_str == last_part
          assign handle_parts_size = handle_parts.size | minus: 1
          assign idx = 0
          for piece in handle_parts
            if idx < handle_parts_size
              if normalized_handle == ''
                assign normalized_handle = piece
              else
                assign normalized_handle = normalized_handle | append: '-' | append: piece
              endif
            endif
            assign idx = idx | plus: 1
          endfor
        else
          assign normalized_handle = raw_handle
        endif
      endif

      # Localized name field (e.g. "tyrkis" in en, "turkizna" in sl).
      assign localized_name = color_item.name | default: ''
      assign normalized_localized_name = localized_name | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '.', '' | replace: ',', '' | replace: '/', '-'

      # Register both keys (when present and distinct) so JS can resolve
      # whichever form `variant.option1` has at runtime.
      if normalized_handle != ''
        unless first_pair
          assign color_value_to_ref_json = color_value_to_ref_json | append: ','
        endunless
        assign first_pair = false
        assign color_value_to_ref_json = color_value_to_ref_json | append: '"' | append: normalized_handle | append: '":' | append: ref_id

        if active_color_reference_id == '' and normalized_handle == active_color_value
          assign active_color_reference_id = ref_id | append: ''
        endif
      endif

      if normalized_localized_name != '' and normalized_localized_name != normalized_handle
        unless first_pair
          assign color_value_to_ref_json = color_value_to_ref_json | append: ','
        endunless
        assign first_pair = false
        assign color_value_to_ref_json = color_value_to_ref_json | append: '"' | append: normalized_localized_name | append: '":' | append: ref_id

        if active_color_reference_id == '' and normalized_localized_name == active_color_value
          assign active_color_reference_id = ref_id | append: ''
        endif
      endif
    endfor
  endif

  assign color_value_to_ref_json = color_value_to_ref_json | append: '}'

  # Use reference_id when available; fall back to color value otherwise.
  if active_color_reference_id != ''
    assign active_color_data_attr = active_color_reference_id
  else
    assign active_color_data_attr = active_color_value
  endif

  # Keep the server-rendered candidate stable through hydration. The runtime
  # receives this ID and uses it as the initial item in the same sequence.
  assign initial_media = first_variant.featured_media | default: product.featured_media | default: product.media.first
  assign initial_image = initial_media.preview_image | default: initial_media
  assign initial_media_id = initial_media.id | default: ''
  assign initial_media_ratio = initial_image.aspect_ratio | default: 1

  # Initialize media string with all media URLs
  assign all_media = ''
  for media in product.media
    assign all_media = all_media | append: media.src | append: ','
  endfor

  # Clean up media string
  assign all_media = all_media | strip

  assign media_count = product.media.size
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif

  # Variables removed as they were unused in the template
-%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
  data-desktop-layout="{{ section.settings.gallery_layout }}"
  data-active-color="{{ active_color_data_attr }}"
  data-section-id="{{ section.id }}"
  data-initial-media-id="{{ initial_media_id }}"
  class="relative"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  <div class="swiper product-swiper md:hidden" data-gallery-mobile>
    <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
      {{ 'accessibility.skip_to_product_info' | t }}
    </a>
    <div
      id="Slider-Gallery-{{ section.id }}"
      data-gallery-slider
      class="swiper-wrapper product__media-list contains-media"
      role="list"
      data-media-count="{{ product.media.size }}"
      data-media-urls="{{ all_media | escape }}"
      data-active-color="{{ active_color_data_attr }}"
      aria-live="polite"
    >
      {%- if initial_image != blank -%}
        <div
          class="swiper-slide product__media-item is-active"
          data-gallery-item
          data-gallery-media-id="{{ initial_media_id }}"
          data-media-id="{{ initial_media_id }}"
          data-media-type="{{ initial_media.media_type | default: 'image' }}"
        >
          <div
            class="product__media media relative h-0 w-full"
            style="--ratio: {{ initial_media_ratio }}; --preview-ratio: {{ initial_media_ratio }}; aspect-ratio: {{ initial_media_ratio }};"
          >
            <div class="absolute inset-0 h-full w-full">
              <img
                src="{{ initial_image | image_url: width: 800 }}"
                srcset="
                  {{ initial_image | image_url: width: 360 }} 360w,
                  {{ initial_image | image_url: width: 540 }} 540w,
                  {{ initial_image | image_url: width: 720 }} 720w,
                  {{ initial_image | image_url: width: 900 }} 900w,
                  {{ initial_image | image_url: width: 1080 }} 1080w,
                  {{ initial_image | image_url: width: 1296 }} 1296w,
                  {{ initial_image | image_url: width: 1512 }} 1512w,
                  {{ initial_image | image_url: width: 1800 }} 1800w
                "
                sizes="(min-width: 990px) 66vw, 100vw"
                alt="{{ initial_image.alt | default: product.title | escape }}"
                width="{{ initial_image.width | default: 800 }}"
                height="{{ initial_image.height | default: 800 }}"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="media-item product-lightbox-img h-full w-full object-cover"
              >
            </div>
          </div>
        </div>
      {%- else -%}
        {%- comment -%} Fallback placeholder for mobile when no media and JS fails {%- endcomment -%}
        <div class="swiper-slide product__media-item is-active" data-gallery-item data-gallery-media-id="placeholder">
          <div
            class="product__media media relative h-0 w-full"
            style="--ratio: 1.0; --preview-ratio: 1.0; padding-bottom: 100%;"
          >
            <div class="absolute inset-0 flex h-full w-full items-center justify-center bg-gray-100">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'w-full h-full text-gray-400 max-w-[60%] max-h-[60%]' }}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
    <div class="swiper-pagination"></div>
  </div>

  <div id="desktop-gallery" data-gallery-grid class="relative hidden grid-cols-2 gap-4 md:grid">
    {%- if initial_image != blank -%}
      <div
        class="swiper-slide product__media-item is-active"
        data-gallery-item
        data-gallery-media-id="{{ initial_media_id }}"
        data-media-id="{{ initial_media_id }}"
        data-media-type="{{ initial_media.media_type | default: 'image' }}"
      >
        <div
          class="product__media media relative h-0 w-full"
          style="--ratio: {{ initial_media_ratio }}; --preview-ratio: {{ initial_media_ratio }}; aspect-ratio: {{ initial_media_ratio }};"
        >
          <div class="absolute inset-0 h-full w-full">
            <img
              src="{{ initial_image | image_url: width: 800 }}"
              srcset="
                {{ initial_image | image_url: width: 360 }} 360w,
                {{ initial_image | image_url: width: 540 }} 540w,
                {{ initial_image | image_url: width: 720 }} 720w,
                {{ initial_image | image_url: width: 900 }} 900w,
                {{ initial_image | image_url: width: 1080 }} 1080w,
                {{ initial_image | image_url: width: 1296 }} 1296w,
                {{ initial_image | image_url: width: 1512 }} 1512w,
                {{ initial_image | image_url: width: 1800 }} 1800w
              "
              sizes="(min-width: 990px) 66vw, 100vw"
              alt="{{ initial_image.alt | default: product.title | escape }}"
              width="{{ initial_image.width | default: 800 }}"
              height="{{ initial_image.height | default: 800 }}"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="media-item product-lightbox-img h-full w-full object-cover"
            >
          </div>
        </div>
      </div>
    {%- else -%}
      <div
        class="swiper-slide product__media-item is-active"
        data-gallery-item
        data-gallery-media-id="placeholder"
        data-media-id="placeholder"
        data-media-type="placeholder"
      >
        <div
          class="product__media media relative h-0 w-full"
          style="--ratio: 1; --preview-ratio: 1; aspect-ratio: 1; padding-bottom: 100%;"
        >
          <div class="absolute inset-0 flex h-full w-full items-center justify-center bg-gray-100">
            {{ 'product-apparel-2' | placeholder_svg_tag: 'h-full w-full max-h-[60%] max-w-[60%] text-gray-400' }}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <!-- See More/Less Button -->
  <div id="gallery-toggle-container" data-gallery-toggle-container class="hidden justify-end md:flex">
    <button id="gallery-toggle-btn" data-gallery-toggle>{{ 'sections.main_product.more_images' | t }}</button>
  </div>

  <script type="application/json" data-gallery-media>
    {{ product.media | json }}
  </script>
  <script type="application/json" data-gallery-colors>
    {% if product.metafields.custom.color.value %}{{ product.metafields.custom.color.value | json }}{% else %}null{% endif %}
  </script>
  <script type="application/json" data-gallery-options>
    {
      "colorOptionIndex": {{ color_option_index }},
      "colorValueToReferenceId": {{ color_value_to_ref_json }},
      "productTitle": {{ product.title | json }},
      "moreImagesText": {{ 'sections.main_product.more_images' | t | json }},
      "lessImagesText": {{ 'sections.main_product.less_images' | t | json }}
    }
  </script>
</media-gallery>
