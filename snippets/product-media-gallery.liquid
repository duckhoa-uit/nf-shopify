<script type="module">
  import {
    parseImageUrl,
    sortImagesByDisplayRules,
    getNormalizedColorKey,
    mapReferenceIdToColorInUrl,
    filterMediaByColor,
  } from "{{ 'product-utils.module.js' | asset_url }}";
  window.parseImageUrl = parseImageUrl;
  window.sortImagesByDisplayRules = sortImagesByDisplayRules;
  window.getNormalizedColorKey = getNormalizedColorKey;
  window.mapReferenceIdToColorInUrl = mapReferenceIdToColorInUrl;
  window.filterMediaByColor = filterMediaByColor;
</script>

{%- liquid
  # Get currently selected or first available variant
  assign first_variant = product.selected_or_first_available_variant

  # Detect color option using language-agnostic swatch/position detection
  assign color_option_name = ''
  assign color_option_index = -1
  assign temp_index = 0
  for option in product.options_with_values
    capture is_color
      render 'is-color-option', option: option
    endcapture
    if is_color == 'true'
      assign color_option_name = option.name
      assign color_option_index = temp_index
      break
    endif
    assign temp_index = temp_index | plus: 1
  endfor

  assign active_color = blank
  if color_option_name != ''
    assign active_color = first_variant.option_values | where: 'name', color_option_name | first
  endif

  # Try different approaches to get color
  if active_color == blank
    # Try options directly
    assign color_position = -1
    assign option_index = 0
    for option in product.options_with_values
      # Position-based color detection for internationalization
      # Color is typically position 1 or has swatch values
      assign swatch_count = option.values | map: 'swatch' | compact | size
      assign is_color_option = false

      if option.position == 1
        assign is_color_option = true
      endif

      if swatch_count > 0
        assign is_color_option = true
      endif

      if is_color_option
        assign color_position = option_index
        break
      endif
      assign option_index = option_index | plus: 1
    endfor

    if color_position >= 0
      assign active_color_value = first_variant.options[color_position] | downcase | strip | replace: ' ', '-'
    endif
  else
    assign active_color_value = active_color.value | downcase | strip | replace: ' ', '-'
  endif

  # If still blank, try selected options
  if active_color_value == blank
    assign selected_options = first_variant.selected_options
    for option in selected_options
      # Position-based color detection for internationalization
      # Check if this is a color option (position 1 or has swatch values)
      assign is_color_option = false
      if option.name
        # Find the corresponding option in product.options_with_values to check position
        for product_option in product.options_with_values
          if product_option.name == option.name
            assign swatch_count = product_option.values | map: 'swatch' | compact | size

            if product_option.position == 1
              assign is_color_option = true
            endif

            if swatch_count > 0
              assign is_color_option = true
            endif
            break
          endif
        endfor
      endif

      if is_color_option
        assign active_color_value = option.value | downcase | strip | replace: ' ', '-'
        break
      endif
    endfor
  endif

  # If still blank, fallback to first variant title
  if active_color_value == blank
    assign active_color_value = first_variant.title | downcase | split: '/' | first | strip | replace: ' ', '-'
  endif

  # Clean up the color value - remove special characters and clean up
  assign active_color_value = active_color_value | replace: "'", '' | replace: '.', '' | replace: ',', ''

  # Remove trailing dash if present
  if active_color_value contains '-'
    assign last_char = active_color_value | slice: -1, 1
    if last_char == '-'
      assign active_color_value = active_color_value | slice: 0, -1
    endif
  endif

  # ---------------------------------------------------------------------------
  # Locale-safe color matching: build option_value -> reference_id map.
  #
  # Variant option values may arrive in either form depending on whether the
  # product uses Shopify's "linked metafield" option feature:
  #   - Untranslated handle key  e.g. "black", "tyrkis"
  #   - Localized metaobject name e.g. "črna" (sl), "noir" (fr)
  #
  # Image filenames always embed `reference_id`, so we resolve any of those
  # variants to a reference_id and pass that to the gallery. We register both
  # the metaobject's untranslated `system.handle` (with trailing -<digits>
  # suffix stripped) AND the (possibly localized) `name` field for the
  # current storefront locale.
  # ---------------------------------------------------------------------------
  assign active_color_reference_id = ''
  assign color_value_to_ref_json = '{'
  assign first_pair = true

  if product.metafields.custom.color.value != blank
    for color_item in product.metafields.custom.color.value
      assign ref_id = color_item.reference_id | default: ''
      if ref_id == ''
        continue
      endif

      assign raw_handle = color_item.system.handle | default: ''
      assign normalized_handle = ''

      if raw_handle != ''
        # Strip trailing -<digits> suffix that Shopify auto-appends to handles
        # (e.g. `tyrkis-1`, `espresso-bronze-2` -> `tyrkis`, `espresso-bronze`).
        assign handle_parts = raw_handle | split: '-'
        assign last_part = handle_parts | last
        assign last_as_int_str = last_part | plus: 0 | append: ''
        if last_as_int_str == last_part
          assign handle_parts_size = handle_parts.size | minus: 1
          assign idx = 0
          for piece in handle_parts
            if idx < handle_parts_size
              if normalized_handle == ''
                assign normalized_handle = piece
              else
                assign normalized_handle = normalized_handle | append: '-' | append: piece
              endif
            endif
            assign idx = idx | plus: 1
          endfor
        else
          assign normalized_handle = raw_handle
        endif
      endif

      # Localized name field (e.g. "tyrkis" in en, "turkizna" in sl).
      assign localized_name = color_item.name | default: ''
      assign normalized_localized_name = localized_name | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '.', '' | replace: ',', '' | replace: '/', '-'

      # Register both keys (when present and distinct) so JS can resolve
      # whichever form `variant.option1` has at runtime.
      if normalized_handle != ''
        unless first_pair
          assign color_value_to_ref_json = color_value_to_ref_json | append: ','
        endunless
        assign first_pair = false
        assign color_value_to_ref_json = color_value_to_ref_json | append: '"' | append: normalized_handle | append: '":' | append: ref_id

        if active_color_reference_id == '' and normalized_handle == active_color_value
          assign active_color_reference_id = ref_id | append: ''
        endif
      endif

      if normalized_localized_name != '' and normalized_localized_name != normalized_handle
        unless first_pair
          assign color_value_to_ref_json = color_value_to_ref_json | append: ','
        endunless
        assign first_pair = false
        assign color_value_to_ref_json = color_value_to_ref_json | append: '"' | append: normalized_localized_name | append: '":' | append: ref_id

        if active_color_reference_id == '' and normalized_localized_name == active_color_value
          assign active_color_reference_id = ref_id | append: ''
        endif
      endif
    endfor
  endif

  assign color_value_to_ref_json = color_value_to_ref_json | append: '}'

  # Use reference_id when available; fall back to color value otherwise.
  if active_color_reference_id != ''
    assign active_color_data_attr = active_color_reference_id
  else
    assign active_color_data_attr = active_color_value
  endif

  # Initialize media string with all media URLs
  assign all_media = ''
  for media in product.media
    assign all_media = all_media | append: media.src | append: ','
  endfor

  # Clean up media string
  assign all_media = all_media | strip

  assign media_count = product.media.size
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif

  # Variables removed as they were unused in the template
-%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
  data-desktop-layout="{{ section.settings.gallery_layout }}"
  data-active-color="{{ active_color_data_attr }}"
  class="relative"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  <div class="swiper product-swiper md:hidden loading-media">
    <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
      {{ 'accessibility.skip_to_product_info' | t }}
    </a>
    <div
      id="Slider-Gallery-{{ section.id }}"
      class="swiper-wrapper product__media-list contains-media"
      role="list"
      data-media-count="{{ product.media.size }}"
      data-media-urls="{{ all_media | escape }}"
      data-active-color="{{ active_color_data_attr }}"
      aria-live="polite"
    >
      {%- if product.media.size == 0 -%}
        {%- comment -%} Fallback placeholder for mobile when no media and JS fails {%- endcomment -%}
        <div class="swiper-slide product__media-item is-active scroll-trigger animate--fade-in">
          <div
            class="product__media media relative w-full h-0"
            style="--ratio: 1.0; --preview-ratio: 1.0; padding-bottom: 100%;"
          >
            <div class="absolute inset-0 w-full h-full bg-gray-100 flex items-center justify-center">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'w-full h-full text-gray-400 max-w-[60%] max-h-[60%]' }}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
    <div class="swiper-pagination"></div>
  </div>

  <div id="desktop-gallery" class="hidden md:grid grid-cols-2 gap-4 loading-media relative">
    {%- comment -%} Desktop gallery content will be rendered entirely by JavaScript {%- endcomment -%}
    {%- comment -%} This eliminates server-side vs client-side sorting conflicts {%- endcomment -%}
    <div id="desktop-gallery-loading" class="col-span-2 flex items-center justify-center py-8">
      <div class="text-center">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900 mb-2"></div>
        <p class="text-sm text-gray-600">Loading gallery...</p>
      </div>
    </div>
  </div>

  <!-- See More/Less Button -->
  <div id="gallery-toggle-container" class="hidden md:flex justify-end">
    <button id="gallery-toggle-btn">{{ 'sections.main_product.more_images' | t }}</button>
  </div>

  <script>
    // Use GALLERY_CONFIG from product-media-gallery-init.js or define fallback
    const GALLERY_CONFIG = window.GALLERY_CONFIG || {
      visibleCount: 6,
      debounceMs: 300,
      videoRetryDelays: [100, 300, 800],
      mobileBreakpoint: 768,
      tabletBreakpoint: 990,
      minColorPartLength: 3,
      swiperAutoplayInterval: 3000,
      initRetryDelay: 50,
      initMaxRetryDelay: 100
    };

    // Translation variables
    const moreImagesText = {{ 'sections.main_product.more_images' | t | json }};
    const lessImagesText = {{ 'sections.main_product.less_images' | t | json }};

    // Language-agnostic color option index (0-based, -1 if not found)
    const colorOptionIndex = {{ color_option_index }};

    // Locale-safe map of un-localized option values -> reference_id
    // Built server-side from metaobject system.handle so it never depends on
    // the storefront language. Used by handleColorChange to keep filtering
    // consistent across all locales (e.g. /sl/, /de/, /en/).
    const colorOptionValueToReferenceId = {{ color_value_to_ref_json }};

    function resolveActiveColor(rawValue) {
      if (rawValue === null || rawValue === undefined || rawValue === '') return '';

      // Already a reference_id (numeric)? Pass through.
      const asNumber = parseInt(rawValue, 10);
      if (!isNaN(asNumber) && asNumber.toString() === rawValue.toString().trim()) {
        return asNumber.toString();
      }

      // Normalize the option value to match handle format (lowercase, dashes).
      const normalized = rawValue.toString()
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/'/g, '')
        .replace(/\./g, '')
        .replace(/,/g, '')
        .replace(/\/+/g, '-')
        .replace(/-+$/g, '');

      const refId = colorOptionValueToReferenceId[normalized];
      if (refId !== undefined && refId !== null) return refId.toString();

      return normalized;
    }

    // Function to create media item element
    function createMediaItem(url, index) {
      const allMedia = {{ product.media | json }};
      let mediaObject = null;

      // Find matching media object by comparing filenames
      const urlFilename = url.split('/').pop().split('?')[0].toLowerCase();

      for (const media of allMedia) {
        // For video media type, compare with preview image
        let mediaSrc, mediaFilename;
        if (media.media_type === 'video') {
          mediaSrc = media.preview_image.src;
        } else {
          mediaSrc = media.src;
        }

        mediaFilename = mediaSrc.split('/').pop().split('?')[0].toLowerCase();

        // Check for exact filename match only (prevent cross-matching like M_1 with M_12)
        if (urlFilename === mediaFilename) {
          mediaObject = media;
          break;
        }
      }

      // Create container div
      const div = document.createElement('div');
      div.className = `swiper-slide product__media-item${index === 0 ? ' is-active' : ''} scroll-trigger animate--fade-in`;

      // Set attributes based on whether we found a media object or not
      const mediaId = mediaObject ? mediaObject.id : `generated-${index}`;
      div.id = `Slide-{{ section.id }}-${mediaId}`;
      div.setAttribute('data-media-id', `{{ section.id }}-${mediaId}`);

      // Store media object reference for lightbox
      if (mediaObject) {
        div.setAttribute('data-media-object', JSON.stringify({
          id: mediaObject.id,
          position: mediaObject.position || index,
          media_type: mediaObject.media_type || 'image'
        }));
      }

      if (mediaObject && mediaObject.media_type !== 'image') {
        div.classList.add('product__media-item--full');
      }

      // Create media wrapper
      const wrapper = document.createElement('div');
      wrapper.className = 'product__media media relative w-full h-0';
      wrapper.style.cssText = '--ratio: 1.0; --preview-ratio: 1.0; padding-bottom: 100%;';

      // Create image container
      const imageContainer = document.createElement('div');
      imageContainer.className = 'absolute inset-0 w-full h-full';

      // Handle different media types
      if (mediaObject && mediaObject.media_type === 'video') {
        // Create a container for the video
        const videoContainer = document.createElement('div');
        videoContainer.className = 'video-container relative w-full h-full';

        // Create the video element
        const video = document.createElement('video');
        video.className = 'w-full h-full object-cover';
        video.playsInline = true;
        video.muted = true;
        video.loop = true;
        video.autoplay = true;
        video.controls = false; // Hide controls completely
        video.setAttribute('playsinline', '');
        video.setAttribute('muted', '');
        video.setAttribute('loop', '');
        video.setAttribute('autoplay', '');
        video.setAttribute('disablePictureInPicture', '');
        video.setAttribute('controlslist', 'nodownload nofullscreen noremoteplayback');
        video.setAttribute('webkit-playsinline', '');
        video.disablePictureInPicture = true;

        // Add poster (preview image)
        if (mediaObject.preview_image) {
          video.poster = mediaObject.preview_image.src;
        }

        // Add video sources
        if (mediaObject.sources) {
          mediaObject.sources.forEach(source => {
            const sourceElement = document.createElement('source');
            sourceElement.src = source.url;
            sourceElement.type = source.mime_type;
            video.appendChild(sourceElement);
          });
        }

        // Fallback image in case video doesn't load
        const img = document.createElement('img');
        img.src = mediaObject.preview_image.src;
        img.alt = mediaObject.alt || mediaObject.preview_image.alt || 'Product video preview';
        img.className = 'absolute inset-0 w-full h-full object-cover';
        img.style.display = 'none'; // Hide by default

        // If video fails to load, show the image
        video.addEventListener('error', () => {
          video.style.display = 'none';
          img.style.display = 'block';
        });

        // Assemble the elements
        videoContainer.appendChild(video);
        videoContainer.appendChild(img);
        imageContainer.appendChild(videoContainer);

        // Add click handler to prevent lightbox from opening when clicking on video
        videoContainer.addEventListener('click', function(e) {
          e.stopPropagation(); // Prevent event from bubbling up to container
        });
      } else {
        // Check if this is a placeholder
        if (url === 'placeholder' || url.includes('placeholder_svg_tag') || (!mediaObject && url.includes('placeholder'))) {
          // Create placeholder container
          const placeholderDiv = document.createElement('div');
          placeholderDiv.className = 'w-full h-full bg-gray-100 flex items-center justify-center';

          // Create SVG placeholder
          const svgContainer = document.createElement('div');
          svgContainer.className = 'w-full h-full text-gray-400 max-w-[60%] max-h-[60%] flex items-center justify-center';
          svgContainer.innerHTML = `{{ 'product-apparel-2' | placeholder_svg_tag: '' }}`;

          placeholderDiv.appendChild(svgContainer);
          imageContainer.appendChild(placeholderDiv);
        } else {
          // For images, create a standard image element
          const img = document.createElement('img');
          img.src = mediaObject ? mediaObject.src : url;
          img.alt = mediaObject ? (mediaObject.alt || 'Product image') : 'Product image';
          img.id = `ProductMedia-{{ section.id }}-${mediaId}`;
          img.className = 'media-item w-full h-full object-cover product-lightbox-img';
          img.setAttribute('loading', index === 0 ? 'eager' : 'lazy');

          // Add click handler for lightbox
          img.addEventListener('click', function(e) {
            e.preventDefault();
            // Pass the index in the filtered and sorted images
            openProductLightbox(index);
          });

          if (mediaObject) {
            img.width = mediaObject.width;
            img.height = mediaObject.height;
          }

          // Assemble the elements
          imageContainer.appendChild(img);
        }
      }

      wrapper.appendChild(imageContainer);
      div.appendChild(wrapper);

      return div;
    }

    // Wrap in a function to ensure proper execution
    function initProductGallery() {
      // DOM elements
      const gallery = document.querySelector('#MediaGallery-{{ section.id }}');
      const sliderWrapper = document.querySelector('#Slider-Gallery-{{ section.id }}');
      const grid = document.querySelector('#desktop-gallery');
      const mobileGallery = document.querySelector('.product-swiper');
      const loadingIndicator = document.querySelector('#desktop-gallery-loading');

      // Check if elements exist and parseImageUrl is available
      if (!gallery || !sliderWrapper || !grid || !mobileGallery) {
        setTimeout(initProductGallery, 100);
        return;
      }

      // Ensure parseImageUrl is available
      if (typeof window.parseImageUrl !== 'function') {
        setTimeout(initProductGallery, 50);
        return;
      }

      // Get color mappings from product metafields if available
      const colorMappings = {% if product.metafields.custom.color.value %}{{ product.metafields.custom.color.value | json }}{% else %}null{% endif %};

      // Hide galleries until content is ready
      mobileGallery.classList.remove('loaded');
      grid.classList.remove('loaded');

      // Get the initial active color
      const activeColor = gallery.dataset.activeColor;

      // Create global reference for slidesToCreate
      window.slidesToCreate = [];

      // Debounce timer for color changes to prevent race conditions
      let processMediaTimeout = null;

      // Debounced version of processMedia to prevent race conditions on rapid color changes
      function debouncedProcessMedia() {
        // Clear any pending processMedia call
        if (processMediaTimeout) {
          clearTimeout(processMediaTimeout);
        }

        // Schedule a new processMedia call after debounce delay
        processMediaTimeout = setTimeout(() => {
          processMediaInternal();
          processMediaTimeout = null;
        }, GALLERY_CONFIG.debounceMs);
      }

      // Process and filter media based on active color
      function processMedia() {
        debouncedProcessMedia();
      }

      // Internal implementation of processMedia
      function processMediaInternal() {
        if (!window.parseImageUrl || !window.filterMediaByColor) {
          setTimeout(processMedia, GALLERY_CONFIG.initRetryDelay);
          return;
        }

        // Get all media objects
        const allMedia = {{ product.media | json }};

        // Extract URLs, handling videos specially
        const allMediaUrls = allMedia.map(media => {
          // For videos, use the preview image URL instead of trying to parse the video URL
          if (media.media_type === 'video' && media.preview_image) {
            return media.preview_image.src;
          }
          return media.src;
        });

        // Use the shared filterMediaByColor utility
        let urlsToUse = window.filterMediaByColor(allMediaUrls, gallery.dataset.activeColor, colorMappings);

        // Get all product media to ensure we include videos regardless of color filtering
        const productMedia = {{ product.media | json }};
        const videoMedia = productMedia.filter(media => media.media_type === 'video');

        // Enhanced video handling for both normal filtering and fallback scenarios
        if (videoMedia.length > 0 && urlsToUse.length > 0) {
          // Create video preview image URLs for comparison
          const videoPreviewUrls = videoMedia.map(video =>
            video.preview_image ? video.preview_image.src : null
          ).filter(url => url !== null);

          // Check if any video preview URLs are already in our filtered list
          const hasVideoInFiltered = videoPreviewUrls.some(videoUrl =>
            urlsToUse.includes(videoUrl)
          );

          // If videos are not already in the filtered list, add them
          if (!hasVideoInFiltered) {
            // Add video preview images to the filtered URLs
            urlsToUse = [...urlsToUse, ...videoPreviewUrls];
          }
        }

        // Sort and update gallery, passing color mappings to the sort function
        // The function now returns objects with url and hidden properties
        let sortedImages = window.sortImagesByDisplayRules(urlsToUse, colorMappings);

        // Custom logic to move videos to the 2nd position
        if (videoMedia.length > 0) {
          // Create a new array to hold the reordered images
          const reorderedImages = [];

          // Find video items in the sorted list
          const videoItems = [];
          const nonVideoItems = [];

          sortedImages.forEach(item => {
            // Check if this item is a video by matching its URL with video preview images
            const isVideo = videoMedia.some(video => {
              // For videos, compare with preview image URL
              return video.preview_image &&
                     (item.url === video.preview_image.src ||
                      item.url.includes(video.preview_image.src.split('?')[0]));
            });

            if (isVideo) {
              videoItems.push(item);
            } else {
              nonVideoItems.push(item);
            }
          });

          // If we have both video and non-video items
          if (videoItems.length > 0 && nonVideoItems.length > 0) {
            // Create a new array to hold the reordered images
            let reorderedImages = [];

            // Add the first item (usually the main product image)
            reorderedImages.push(nonVideoItems[0]);

            // Add video items at position 2
            reorderedImages.push(...videoItems);

            // Add the rest of the non-video items, skipping the first one we already added
            reorderedImages.push(...nonVideoItems.slice(1));

            // Replace the sorted images with our reordered list
            sortedImages = reorderedImages;
          }
        }

        // Ensure all items have the hidden property set based on their index
        // This applies to all cases: with videos, without videos, etc.
        // Items up to visibleCount are visible (hidden: false), rest are hidden (hidden: true)
        sortedImages.forEach((item, index) => {
          if (index < GALLERY_CONFIG.visibleCount) {
            item.hidden = false;
          } else {
            item.hidden = true;
          }
        });

        updateGallery(sortedImages);
      } // End of processMediaInternal

      // Update gallery with the given URLs or image objects
      function updateGallery(images) {
        // Clear existing content
        sliderWrapper.innerHTML = '';
        grid.innerHTML = '';

        // Hide loading indicator
        if (loadingIndicator) {
          loadingIndicator.style.display = 'none';
        }

        // Get all media for reference (needed to check for videos)
        const allMedia = {{ product.media | json }};

        // Ensure we have at least some images to display
        if (images.length === 0) {
          if (allMedia.length > 0) {
            // Get all media URLs for sorting
            const allMediaUrls = allMedia.map(media => {
              // For videos, use the preview image URL
              return media.media_type === 'video' && media.preview_image ?
                media.preview_image.src : media.src;
            });

            // Sort all media according to display rules and take first 2
            const colorMappings = {% if product.metafields.custom.color.value %}{{ product.metafields.custom.color.value | json }}{% else %}null{% endif %};
            const sortedFallbackImages = window.sortImagesByDisplayRules(allMediaUrls, colorMappings);
            const fallbackUrls = sortedFallbackImages.slice(0, 2);


            // Convert back to the expected format with media metadata
            images = fallbackUrls.map((item, index) => {
              const url = typeof item === 'string' ? item : item.url;

              // Find the corresponding media object
              const mediaObject = allMedia.find(media => {
                const mediaSrc = media.media_type === 'video' && media.preview_image ?
                  media.preview_image.src : media.src;
                return mediaSrc === url;
              });

              return {
                url: url,
                mediaId: mediaObject ? mediaObject.id : `fallback-${index}`,
                mediaType: mediaObject ? mediaObject.media_type : 'image',
                hidden: false
              };
            });


          } else {
            // Product has no media at all - create placeholder
            images = [{
              url: 'placeholder',
              mediaId: 'placeholder',
              mediaType: 'placeholder',
              hidden: false
            }];

            // Show placeholder in desktop gallery at 1st grid position
            const placeholderDiv = document.createElement('div');
            placeholderDiv.className = 'product__media-item scroll-trigger animate--fade-in';
            placeholderDiv.innerHTML = `
              <div class="product__media media relative w-full h-0" style="--ratio: 1.0; --preview-ratio: 1.0; padding-bottom: 100%;">
                <div class="absolute inset-0 w-full h-full bg-gray-100 flex items-center justify-center">
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'w-full h-full text-gray-400 max-w-[60%] max-h-[60%]' }}
                </div>
              </div>
            `;
            grid.appendChild(placeholderDiv);

            // Show galleries immediately since we have placeholder
            requestAnimationFrame(() => {
              mobileGallery.classList.add('loaded');
              grid.classList.add('loaded');
            });

            return; // Exit early for placeholder case
          }
        }

        // Normalize the images array to ensure all items have url and hidden properties
        const normalizedImages = images.map(item => {
          if (typeof item === 'string') {
            // Handle legacy format (just URL strings)
            return { url: item, hidden: false };
          }
          return item; // Already in the correct format
        });

        // Create at least 2 slides for proper pagination
        window.slidesToCreate = normalizedImages.length === 1 ?
          [normalizedImages[0], normalizedImages[0]] : normalizedImages;

        // Create all items but only show first 6
        window.isGalleryExpanded = window.isGalleryExpanded || false;
        const toggleBtn = document.getElementById('gallery-toggle-btn');
        const toggleContainer = document.getElementById('gallery-toggle-container');

        // Set button text based on current expanded state
        if (toggleBtn) {
          toggleBtn.textContent = window.isGalleryExpanded ? lessImagesText : moreImagesText;
        }

        if (window.slidesToCreate.length > 0) {
          window.slidesToCreate.forEach((imageObj, index) => {
            const mediaItem = createMediaItem(imageObj.url, index);
            if (mediaItem) {
              // Add to mobile slider - all images are visible in the slider
              // Clone the media item for mobile slider
              const mobileMediaItem = mediaItem.cloneNode(true);

              // Ensure video autoplay attributes are preserved in cloned element
              const clonedVideo = mobileMediaItem.querySelector('video');
              if (clonedVideo) {
                clonedVideo.setAttribute('autoplay', '');
                clonedVideo.autoplay = true;
              }

              sliderWrapper.appendChild(mobileMediaItem);

              // Add to desktop grid with visibility control
              if (index === 0 || imageObj.url !== window.slidesToCreate[0].url) {
                // Apply hidden class based on the hidden property from sorting
                if (imageObj.hidden && !window.isGalleryExpanded) {
                  mediaItem.classList.add('hidden');
                }

                // Mark expandable items for toggle functionality
                if (imageObj.hidden) {
                  mediaItem.classList.add('expandable-item');
                }

                grid.appendChild(mediaItem);
              }
            }
          });

          // Only show toggle button if we have hidden images (more than the visible count)
          const hiddenItemsCount = window.slidesToCreate.filter(item => item.hidden).length;

          if (hiddenItemsCount > 0) {
            toggleContainer.classList.remove('hidden');

            // Replace button with clone to remove any existing event listeners
            const newBtn = toggleBtn.cloneNode(true);
            toggleBtn.parentNode.replaceChild(newBtn, toggleBtn);

            // Set up toggle button functionality
            newBtn.addEventListener('click', function() {
              window.isGalleryExpanded = !window.isGalleryExpanded;
              const expandableItems = grid.querySelectorAll('.expandable-item');

              expandableItems.forEach(item => {
                if (window.isGalleryExpanded) {
                  item.classList.remove('hidden');
                } else {
                  item.classList.add('hidden');
                }
              });

              // Update button text
              newBtn.textContent = window.isGalleryExpanded ? lessImagesText : moreImagesText;
            });
          } else {
            toggleContainer.classList.add('hidden');
          }
        }

        // Ensure pagination container exists
        let paginationContainer = document.querySelector('.product-swiper .swiper-pagination');
        if (!paginationContainer) {
          paginationContainer = document.createElement('div');
          paginationContainer.className = 'swiper-pagination';
          paginationContainer.style.display = 'flex';
          mobileGallery.appendChild(paginationContainer);
        }

        // Initialize Swiper
        initSwiper();

        // Add event listeners to mobile gallery images
        document.querySelectorAll('.product-swiper .swiper-slide img').forEach((img, index) => {
          img.addEventListener('click', function(e) {
            e.preventDefault();
            // Use the index in the filtered and sorted images
            openProductLightbox(index);
          });
          img.style.cursor = 'pointer';
        });

        // Show galleries
        requestAnimationFrame(() => {
          mobileGallery.classList.add('loaded');
          grid.classList.add('loaded');

          // Ensure videos autoplay after gallery update
          // This is necessary because browser autoplay policies may prevent autoplay
          // after DOM manipulation during color changes
          const allVideos = document.querySelectorAll('.product__media video');

          allVideos.forEach((video, index) => {
            // Set autoplay attributes if not already set
            if (!video.hasAttribute('autoplay')) {
              video.setAttribute('autoplay', '');
              video.autoplay = true;
            }

            // Function to attempt playing the video
            const attemptPlay = () => {
              const playPromise = video.play();
              if (playPromise !== undefined) {
                playPromise
                  .then(() => {
                    // Video playing successfully
                  })
                  .catch(error => {
                    // Autoplay was prevented, which is expected in some cases
                    // The video will still have the autoplay attribute for when user interacts
                  });
              }
            };

            // Wait for video to be ready before playing
            if (video.readyState >= 2) {
              // Video is ready to play
              attemptPlay();
            } else {
              // Video is not ready yet, wait for canplay event
              const onCanPlay = () => {
                attemptPlay();
                video.removeEventListener('canplay', onCanPlay);
              };

              video.addEventListener('canplay', onCanPlay);

              // Timeout fallback in case canplay never fires
              setTimeout(() => {
                attemptPlay();
                video.removeEventListener('canplay', onCanPlay);
              }, 2000);
            }
          });

          // Show toggle button container if needed
          if (toggleContainer && window.slidesToCreate.length > GALLERY_CONFIG.visibleCount) {
            toggleContainer.classList.add('visible');
            // Only show on medium screens and up (desktop)
            if (window.innerWidth < GALLERY_CONFIG.mobileBreakpoint) {
              toggleContainer.classList.add('hidden');
              toggleContainer.classList.remove('visible');
            }
          }

          // Additional autoplay trigger with retry mechanism
          // This handles cases where pauseAllMedia() or other code pauses videos

          // Helper function to safely play a video
          const safePlay = (video, index, retryNum) => {
            if (video.readyState >= 2) {
              const playPromise = video.play();
              if (playPromise !== undefined) {
                playPromise.catch(error => {
                  // Autoplay prevented, expected in some cases
                });
              }
            }
          };

          // Retry autoplay after a short delay (in case pauseAllMedia is called)
          setTimeout(() => {
            const retryVideos = document.querySelectorAll('.product__media video');
            retryVideos.forEach((video, index) => {
              if (video.paused && video.hasAttribute('autoplay')) {
                safePlay(video, index, 1);
              }
            });
          }, 100);

          // Second retry after longer delay
          setTimeout(() => {
            const retryVideos = document.querySelectorAll('.product__media video');
            retryVideos.forEach((video, index) => {
              if (video.paused && video.hasAttribute('autoplay')) {
                safePlay(video, index, 2);
              }
            });
          }, 300);

          // Third retry after even longer delay (for slow connections)
          setTimeout(() => {
            const retryVideos = document.querySelectorAll('.product__media video');
            retryVideos.forEach((video, index) => {
              if (video.paused && video.hasAttribute('autoplay')) {
                safePlay(video, index, 3);
              }
            });
          }, 800);
        });
      }

      // Initialize Swiper separately to ensure it only runs when ready
      function initSwiper() {
        // Only initialize if Swiper is loaded and DOM is ready
        if (typeof Swiper !== 'undefined') {
          // Destroy previous instance if it exists
          if (window.productSwiper) {
            window.productSwiper.destroy();
          }

          // Create new Swiper instance
          window.productSwiper = new Swiper('.product-swiper', {
            slidesPerView: 1,
            spaceBetween: 0,
            pagination: {
              el: '.swiper-pagination',
              type: 'bullets',
              clickable: true,
              renderBullet: function (index, className) {
                return '<span class="' + className + '"></span>';
              },
              // Force pagination visibility even with one slide
              dynamicBullets: false,
              dynamicMainBullets: 1
            },
            // Show pagination even for a single slide
            watchOverflow: false,
            on: {
              init: function () {
                // Force pagination container to be visible
                const pagination = document.querySelector('.swiper-pagination');
                if (pagination) {
                  pagination.style.display = 'flex';
                  // Remove lock class if it exists
                  pagination.classList.remove('swiper-pagination-lock');
                }
              },
              slideChange: function() {
                // Also ensure pagination stays visible after slide change
                const pagination = document.querySelector('.swiper-pagination');
                if (pagination) {
                  pagination.style.display = 'flex';
                  pagination.classList.remove('swiper-pagination-lock');
                }
              }
            }
          });
        } else {
          // If Swiper isn't loaded yet, wait for it
          document.querySelector('script[src*="swiper-bundle.min.js"]')?.addEventListener('load', function() {
            initSwiper();
          });
        }
      }

      // Handle color change
      function handleColorChange(newColor) {
        if (newColor === null || newColor === undefined || newColor === '') return;

        // Resolve the option value (which may be a localized name, an
        // untranslated handle, or a numeric reference_id) to a reference_id
        // whenever possible. This keeps gallery filtering correct on every
        // storefront locale because reference_ids match image filenames
        // exactly while localized color names do not.
        const colorForMatching = resolveActiveColor(newColor);

        // If the active color isn't the same as before, update the gallery
        if (colorForMatching !== gallery.dataset.activeColor) {
          gallery.dataset.activeColor = colorForMatching;

          // Preserve the expanded state when color changes
          // Don't reset window.isGalleryExpanded - keep the user's preference
          const toggleBtn = document.getElementById('gallery-toggle-btn');
          if (toggleBtn) {
            // Update button text based on current expanded state
            toggleBtn.textContent = window.isGalleryExpanded ? lessImagesText : moreImagesText;
          }

          // Hide toggle container until new content loads
          const toggleContainer = document.getElementById('gallery-toggle-container');
          if (toggleContainer) {
            toggleContainer.classList.remove('visible');
          }

          processMedia();
        }
      }

      // Set up event listeners
      function setupEventListeners() {
        // Listen for radio button changes (use data-option-type for language-agnostic detection)
        document.querySelectorAll('[data-option-type="color"] input[type="radio"]')
          .forEach(radio => {
            radio.addEventListener('change', e => {
              const newColor = e.target.value;
              handleColorChange(newColor);
            });
          });

        // Listen for variant select changes
        document.querySelectorAll('[data-option-type="color"] select')
          .forEach(select => {
            select.addEventListener('change', e => {
              const newColor = e.target.value;
              handleColorChange(newColor);
            });
          });

        // Listen for Shopify's variant change event
        document.addEventListener('variant:changed', function(event) {
          if (event.detail.variant) {
            // Extract color from variant using pre-computed index
            const colorPosition = colorOptionIndex;

            let newColor = '';
            if (colorPosition >= 0 && event.detail.variant.options) {
              newColor = event.detail.variant.options[colorPosition];
            } else if (event.detail.variant.title) {
              newColor = event.detail.variant.title.split('/')[0].trim();
            }

            if (newColor) {
              handleColorChange(newColor);
            }
          }
        });

        // Listen for URL changes for variant updates
        let currentUrl = window.location.href;
        setInterval(() => {
          if (currentUrl !== window.location.href) {
            currentUrl = window.location.href;
            const variantId = new URLSearchParams(window.location.search).get('variant');

            if (variantId) {
              const variants = {{ product.variants | json }};
              const variant = variants.find(v => v.id.toString() === variantId);

              if (variant) {
                // Extract color from variant using pre-computed index
                const colorPosition = colorOptionIndex;

                let color = colorPosition >= 0 && variant.options ? variant.options[colorPosition] : '';
                if (!color && variant.title) {
                  color = variant.title.split('/')[0].trim();
                }

                if (color) {
                  handleColorChange(color);
                }
              }
            }
          }
        }, 300);
      }

      // Start processing media and set up listeners
      processMedia();
      setupEventListeners();

      // Add resize event listener to hide button on mobile
      window.addEventListener('resize', function() {
        const toggleContainer = document.getElementById('gallery-toggle-container');
        if (toggleContainer) {
          if (window.innerWidth < GALLERY_CONFIG.mobileBreakpoint) {
            toggleContainer.classList.add('hidden');
            toggleContainer.classList.remove('visible');
          } else if (window.slidesToCreate && window.slidesToCreate.length > GALLERY_CONFIG.visibleCount) {
            toggleContainer.classList.remove('hidden');
            toggleContainer.classList.add('visible');
          }
        }
      });

      // Directly hook into Shopify's variant change mechanism
      const originalOnVariantChange = window.onVariantChange;
      window.onVariantChange = function(variant) {
        if (variant) {
          // Extract color from variant using pre-computed index
          const colorPosition = colorOptionIndex;

          let newColor = '';
          if (colorPosition >= 0 && variant.options) {
            newColor = variant.options[colorPosition];
          } else if (variant.title) {
            newColor = variant.title.split('/')[0].trim();
          }

          if (newColor) {
            handleColorChange(newColor);
          }
        }

        // Call the original handler if it exists
        if (typeof originalOnVariantChange === 'function') {
          originalOnVariantChange(variant);
        }
      };
    }

    // Function to open the lightbox with filtered and sorted images
    function openProductLightbox(startIndex) {
      // Get the gallery element
      const gallery = document.querySelector('#MediaGallery-{{ section.id }}');
      if (!gallery) {
        return;
      }

      // Get all media and color mappings
      const allMedia = {{ product.media | json }};
      const colorMappings = {% if product.metafields.custom.color.value %}{{ product.metafields.custom.color.value | json }}{% else %}null{% endif %};
      const activeColor = gallery.dataset.activeColor;

      // Ensure Fancybox is loaded
      if (!allMedia || !window.Fancybox) {
        return;
      }

      try {
        // Close any existing Fancybox instances to prevent duplication
        if (typeof Fancybox.close === 'function') {
          Fancybox.close();
        }

        // Get all media URLs - use original src values without transformation
        const allMediaUrls = allMedia.map(media => media.src);

        // Filter URLs by active color - using the same logic as the main gallery
        let urlsToUse = allMediaUrls;
        let exactMatches = [];
        let partialMatches = [];

        if (activeColor && colorMappings) {
          // First try to get normalized color key - this converts reference_id to color name if needed
          const normalizedColorKey = window.getNormalizedColorKey(activeColor, colorMappings);

          // Check each URL for matches using the active color
          allMediaUrls.forEach(url => {
            // Use parseImageUrl with colorMappings to properly handle reference_ids
            const parsed = window.parseImageUrl(url, colorMappings);
            const parsedColor = parsed.color.toLowerCase().trim();
            const activeColorNormalized = normalizedColorKey.toLowerCase().trim();

            // Collect exact and partial matches
            if (parsedColor === activeColorNormalized) {
              exactMatches.push(url);
            } else if (parsedColor.includes(activeColorNormalized) || activeColorNormalized.includes(parsedColor)) {
              partialMatches.push(url);
            }

            // If we didn't find a match but we have reference_id and colorMappings, try direct reference_id matching
            if (exactMatches.length === 0 && partialMatches.length === 0 && parsed.reference_id && colorMappings) {
              // Check if the active color is actually a reference_id
              const activeRefId = parseInt(activeColor, 10);

              if (!isNaN(activeRefId) && parsed.reference_id === activeRefId) {
                exactMatches.push(url);
              }
            }
          });

          // Prioritize exact matches, fall back to partial matches
          if (exactMatches.length > 0) {
            urlsToUse = exactMatches;
          } else if (partialMatches.length > 0) {
            urlsToUse = partialMatches;
          }

          // If no matches found, try more flexible matching (just try parts of the color name)
          if (urlsToUse.length === 0 && normalizedColorKey.includes('-')) {
            const colorParts = normalizedColorKey.split('-');

            for (const part of colorParts) {
              if (part.length < 3) {
                continue; // Skip very short parts
              }

              const flexibleMatches = allMediaUrls.filter(url => {
                const parsed = window.parseImageUrl(url, colorMappings);
                const isMatch = parsed.color.toLowerCase().includes(part.toLowerCase());
                return isMatch;
              });

              if (flexibleMatches.length > 0) {
                urlsToUse = flexibleMatches;
                break;
              }
            }
          }
        }

        // For lightbox, we don't need to include videos
        // This is different from the gallery grid where we want videos to be included

        // Get the current images from the gallery instead of sorting again
        // This ensures the Fancybox shows images in the exact same order as the gallery
        // including our custom ordering with videos at position 2
        const galleryImages = [];

        // Get all visible images from the desktop gallery
        const desktopGallery = document.querySelector('#desktop-gallery');
        if (desktopGallery) {
          const imageElements = desktopGallery.querySelectorAll('img.product-lightbox-img');
          imageElements.forEach(img => {
            // Try to get the media ID from the parent element
            const mediaItem = img.closest('.product__media-item');
            let mediaId = null;
            let mediaType = 'image';

            if (mediaItem) {
              // Extract media ID from data-media-id attribute
              const mediaIdAttr = mediaItem.getAttribute('data-media-id');
              if (mediaIdAttr) {
                // Format is "section-id-media-id", so we extract just the media ID
                const parts = mediaIdAttr.split('-');
                if (parts.length > 1) {
                  mediaId = parts[parts.length - 1];
                }
              }

              // If we couldn't get it from data-media-id, try data-media-object
              if (!mediaId) {
                try {
                  const mediaObjectStr = mediaItem.getAttribute('data-media-object');
                  if (mediaObjectStr) {
                    const mediaObject = JSON.parse(mediaObjectStr);
                    mediaId = mediaObject.id;
                    mediaType = mediaObject.media_type || 'image';
                  }
                } catch (e) {
                  // Error parsing media object data
                }
              }
            }

            // Skip videos for lightbox
            if (mediaType === 'video') {
              return;
            }

            galleryImages.push({
              url: img.src,
              mediaId: mediaId,
              hidden: mediaItem ? mediaItem.classList.contains('hidden') : false
            });
          });
        }

        // If desktop gallery is not available, try mobile gallery
        if (galleryImages.length === 0) {
          const mobileGallery = document.querySelector('.product-swiper');
          if (mobileGallery) {
            const imageElements = mobileGallery.querySelectorAll('.swiper-slide img');
            imageElements.forEach(img => {
              // Try to get the media ID from the parent element
              const mediaItem = img.closest('.product__media-item');
              let mediaId = null;
              let mediaType = 'image';

              if (mediaItem) {
                // Extract media ID from data-media-id attribute
                const mediaIdAttr = mediaItem.getAttribute('data-media-id');
                if (mediaIdAttr) {
                  // Format is "section-id-media-id", so we extract just the media ID
                  const parts = mediaIdAttr.split('-');
                  if (parts.length > 1) {
                    mediaId = parts[parts.length - 1];
                  }
                }

                // If we couldn't get it from data-media-id, try data-media-object
                if (!mediaId) {
                  try {
                    const mediaObjectStr = mediaItem.getAttribute('data-media-object');
                    if (mediaObjectStr) {
                      const mediaObject = JSON.parse(mediaObjectStr);
                      mediaId = mediaObject.id;
                      mediaType = mediaObject.media_type || 'image';
                    }
                  } catch (e) {
                    // Error parsing media object data
                  }
                }
              }

              // Skip videos for lightbox
              if (mediaType === 'video') {
                return;
              }

              galleryImages.push({
                url: img.src,
                mediaId: mediaId,
                hidden: false // Mobile gallery doesn't have hidden images
              });
            });
          }
        }

        // If we couldn't get images from the gallery, fall back to sorting
        const sortedImages = galleryImages.length > 0 ?
          galleryImages :
          window.sortImagesByDisplayRules(urlsToUse, colorMappings);

        // Create array of items for Fancybox from the sorted images
        // Use all images, not just visible ones, but filter out videos
        const items = sortedImages.map((img, idx) => {
          // Try to find the corresponding media object to determine media type
          const mediaItem = document.querySelector(`[data-media-id="${gallery.id}-${img.mediaId}"]`);
          let mediaObject = null;

          if (mediaItem) {
            try {
              const mediaObjectStr = mediaItem.getAttribute('data-media-object');
              if (mediaObjectStr) {
                mediaObject = JSON.parse(mediaObjectStr);
              }
            } catch (e) {
              // Error parsing media object data
            }
          }

          // If we couldn't get the media object from DOM, try to find it in allMedia
          if (!mediaObject) {
            for (const media of allMedia) {
              // Skip videos entirely for lightbox
              if (media.media_type === 'video') continue;

              if (media.src === img.url) {
                mediaObject = {
                  id: media.id,
                  media_type: 'image', // Force image type for lightbox
                  position: media.position
                };
                break;
              }
            }
          }

          // For lightbox, always use image type
          return {
            src: img.url,
            type: 'image',
            caption: '' // We don't have alt text for the sorted images
          };
        }).filter(item => item !== null);

        // Make sure we're using the correct startIndex
        // If no startIndex is provided, default to 0
        const adjustedStartIndex = (startIndex !== undefined && startIndex !== null)
          ? Math.min(Math.max(0, startIndex), items.length - 1)
          : 0;

        // Open Fancybox with a configuration for v5
        Fancybox.show(items, {
          startIndex: Math.min(adjustedStartIndex, items.length - 1),
          dragToClose: false,
          closeButton: false,
          Toolbar: false,
          Thumbs: {
            type: "classic"
          },
          Carousel: {
            transition: "fade",
            friction: 0
          },
          Images: {
            zoom: false,
            click: null
          },
          Caption: false,
          on: {
            ready: (fancybox) => {
              // Create custom toolbar
              const container = document.querySelector('.fancybox__container');
              if (!container) return;

              // Position navigation buttons relative to content
              const positionNavButtons = () => {
                // Get the content element and navigation buttons
                const content = document.querySelector('.fancybox__content');
                const prevButton = document.querySelector('.f-button.is-prev');
                const nextButton = document.querySelector('.f-button.is-next');

                if (content && prevButton && nextButton) {
                  // Get content width
                  const contentWidth = content.offsetWidth;
                  const contentRect = content.getBoundingClientRect();

                  // Calculate button positions based on screen size
                  let gap;
                  if (window.innerWidth <= 767) {
                    // Mobile: 20px gap
                    gap = 20;
                  } else if (window.innerWidth <= 990) {
                    // Tablet: 40px gap
                    gap = 40;
                  } else {
                    // Desktop: 60px gap
                    gap = 60;
                  }

                  // Set button positions directly
                  prevButton.style.position = 'absolute';
                  nextButton.style.position = 'absolute';
                  prevButton.style.top = '50%';
                  nextButton.style.top = '50%';
                  prevButton.style.transform = 'translateY(-50%)';
                  nextButton.style.transform = 'translateY(-50%)';

                  // Position buttons relative to content
                  prevButton.style.left = `${contentRect.left - gap}px`;
                  nextButton.style.right = `${window.innerWidth - contentRect.right - gap}px`;

                  // Hide buttons on mobile/tablet
                  if (window.innerWidth <= 990) {
                    prevButton.style.display = 'none';
                    nextButton.style.display = 'none';
                  } else {
                    prevButton.style.display = 'block';
                    nextButton.style.display = 'block';
                  }
                }
              };

              // Position buttons initially and on resize
              // Wait for Fancybox to fully initialize
              setTimeout(positionNavButtons, 100);
              window.addEventListener('resize', positionNavButtons);

              // Also position buttons when Fancybox changes slides
              fancybox.on('change', positionNavButtons);

              // Clean up event listener on close
              fancybox.on('destroy', () => {
                window.removeEventListener('resize', positionNavButtons);
              });

              // Create toolbar container
              const toolbar = document.createElement('div');
              toolbar.className = 'custom-fancybox-toolbar';

              // Share button
              const shareBtn = document.createElement('button');
              shareBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"></path></svg>`;
              shareBtn.title = 'Share';
              shareBtn.addEventListener('click', () => {
                if (navigator.share) {
                  navigator.share({
                    title: document.title,
                    url: window.location.href
                  }).catch(() => {
                    // Share failed
                  });
                } else {
                  // Fallback for browsers that don't support Web Share API
                  const url = window.location.href;
                  navigator.clipboard.writeText(url).then(() => {
                    alert('Link copied to clipboard!');
                  }).catch(() => {
                    // Clipboard copy failed
                  });
                }
              });

              // Autoplay button
              const autoplayBtn = document.createElement('button');
              autoplayBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"></path></svg>`; // Play icon
              autoplayBtn.title = 'Auto Play';
              let autoplayInterval;
              autoplayBtn.addEventListener('click', () => {
                if (autoplayInterval) {
                  // Stop autoplay and show play icon
                  clearInterval(autoplayInterval);
                  autoplayInterval = null;
                  autoplayBtn.classList.remove('active');
                  autoplayBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"></path></svg>`; // Play icon
                  autoplayBtn.title = 'Auto Play';
                } else {
                  // Start autoplay and show pause icon
                  autoplayBtn.classList.add('active');
                  autoplayBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M6,19H10V5H6V19M14,5V19H18V5H14Z"></path></svg>`; // Pause icon
                  autoplayBtn.title = 'Pause';
                  autoplayInterval = setInterval(() => {
                    fancybox.next();
                  }, 3000);
                }
              });

              // Fullscreen button
              const fullscreenBtn = document.createElement('button');
              fullscreenBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z"></path></svg>`;
              fullscreenBtn.title = 'Fullscreen';
              fullscreenBtn.addEventListener('click', () => {
                if (!document.fullscreenElement) {
                  container.requestFullscreen().catch(() => {
                    // Fullscreen request failed
                  });
                  fullscreenBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M14,14H19V16H16V19H14V14M5,14H10V19H8V16H5V14M8,5H10V10H5V8H8V5M19,8V10H14V5H16V8H19Z"></path></svg>`;
                } else {
                  document.exitFullscreen();
                  fullscreenBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z"></path></svg>`;
                }
              });

              // Toggle footer button
              const footerBtn = document.createElement('button');
              footerBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M4,5H20V7H4V5M4,9H20V11H4V9M4,13H20V15H4V13M4,17H20V19H4V17Z"></path></svg>`;
              footerBtn.title = 'Toggle Footer';
              let footerVisible = true;

              footerBtn.addEventListener('click', () => {
                const footer = container.querySelector('.fancybox__footer');
                if (!footer) return;

                footerVisible = !footerVisible;

                if (footerVisible) {
                  // Show footer using CSS transitions
                  footer.classList.remove('is-hidden');
                  footerBtn.classList.add('active');
                } else {
                  // Hide footer using CSS transitions
                  footer.classList.add('is-hidden');
                  footerBtn.classList.remove('active');
                }
              });

              // Close button
              const closeBtn = document.createElement('button');
              closeBtn.innerHTML = `<svg viewBox="0 0 24 24"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"></path></svg>`;
              closeBtn.title = 'Close';
              closeBtn.addEventListener('click', () => {
                Fancybox.close();
              });

              // Add all buttons to toolbar
              toolbar.appendChild(shareBtn);
              toolbar.appendChild(autoplayBtn);
              toolbar.appendChild(fullscreenBtn);
              toolbar.appendChild(footerBtn);
              toolbar.appendChild(closeBtn);

              // Add toolbar to container
              container.appendChild(toolbar);

              // Clean up on close
              fancybox.on('destroy', () => {
                if (autoplayInterval) {
                  clearInterval(autoplayInterval);
                }
              });
            }
          }

        });
      } catch (error) {
        // Error opening lightbox
      }
    }

    // Run initialization when DOM and product-utils.js are ready
    function waitForDependencies() {
      if (document.readyState === 'loading' || typeof window.parseImageUrl !== 'function') {
        setTimeout(waitForDependencies, 50);
      } else {
        initProductGallery();
      }
    }

    waitForDependencies();
  </script>
