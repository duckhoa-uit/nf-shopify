{% comment %}
  Renders a product media gallery. Should be used with 'media-gallery.js'
  Also see 'product-media-modal'

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant
  - limit: {Number} (optional) When passed, limits the number of media items to render

  Usage:
  {% render 'product-media-gallery' %}
{% endcomment %}

{{ 'pagination-dots.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'product-utils.js' | asset_url }}" defer></script>

{%- liquid
  if section.settings.hide_variants and variant_images.size == product.media.size
    assign single_media_visible = true
  endif

  if limit == 1
    assign single_media_visible = true
  endif

  # Get currently selected or first available variant
  assign first_variant = product.selected_or_first_available_variant
  assign active_color = first_variant.option_values | where: "name", "Color" | first

  if active_color == blank
    assign active_color = first_variant.option_values | where: "name", "Colour" | first
  endif

  # Try different approaches to get color
  if active_color == blank
    # Try options directly
    assign color_position = -1
    assign option_index = 0
    for option in product.options_with_values
      if option.name == 'Color' or option.name == 'Colour'
        assign color_position = option_index
        break
      endif
      assign option_index = option_index | plus: 1
    endfor

    if color_position >= 0
      assign active_color_value = first_variant.options[color_position] | downcase | replace: ' ', '-'
    endif
  else
    assign active_color_value = active_color.value | downcase | replace: ' ', '-'
  endif

  # If still blank, try selected options
  if active_color_value == blank
    assign selected_options = first_variant.selected_options
    for option in selected_options
      if option.name == 'Color' or option.name == 'Colour'
        assign active_color_value = option.value | downcase | replace: ' ', '-'
        break
      endif
    endfor
  endif

  # If still blank, fallback to first variant title
  if active_color_value == blank
    assign active_color_value = first_variant.title | downcase | split: '/' | first | replace: ' ', '-'
  endif

  # Clean up the color value
  if active_color_value contains '/'
    assign active_color_value = active_color_value | split: '/' | first
  endif
  # Remove trailing dash if present
  if active_color_value contains '-'
    assign active_color_value = active_color_value | replace: '-', ' ' | strip | replace: ' ', '-'
  endif

  # Initialize media string with all media URLs
  assign all_media = ''
  for media in product.media
    assign all_media = all_media | append: media.src | append: ','
  endfor

  # Clean up media string
  assign all_media = all_media | strip

  assign media_count = product.media.size
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif

  if media_count == 1 or single_media_visible
    assign single_media_visible_mobile = true
  endif

  if media_count == 0 or single_media_visible_mobile or section.settings.mobile_thumbnails == 'show' or section.settings.mobile_thumbnails == 'columns' and media_count < 3
    assign hide_mobile_slider = true
  endif

  assign media_width = 0.65
-%}

<style>
  .loading-media {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .loading-media.loaded {
    opacity: 1;
  }
</style>

<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  {% if section.settings.enable_sticky_info %}
    class="product__column-sticky"
  {% endif %}
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
  data-desktop-layout="{{ section.settings.gallery_layout }}"
  data-active-color="{{ active_color_value }}"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  <div class="swiper product-swiper md:hidden loading-media">
    <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
      {{ 'accessibility.skip_to_product_info' | t }}
    </a>
    <div
      id="Slider-Gallery-{{ section.id }}"
      class="swiper-wrapper product__media-list contains-media"
      role="list"
      data-media-count="{{ product.media.size }}"
      data-media-urls="{{ all_media | escape }}"
      data-active-color="{{ active_color_value }}"
      aria-live="polite"
    ></div>
    <div class="swiper-pagination"></div>
  </div>

  <div id="desktop-gallery" class="hidden md:grid grid-cols-2 gap-4 loading-media">
    {%- for media in product.media -%}
      <div
        id="Grid-{{ section.id }}-{{ media.id }}"
        class="product__media-item{% if forloop.first %} is-active{% endif %}{% if media.media_type != 'image' %} product__media-item--full{% endif %} scroll-trigger animate--fade-in"
        data-media-id="{{ section.id }}-{{ media.id }}"
      >
        {% render 'product-thumbnail',
          media: media,
          position: forloop.index,
          loop: section.settings.enable_video_looping,
          modal_id: section.id,
          xr_button: true,
          media_width: media_width,
          lazy_load: forloop.index > 1
        %}
      </div>
    {%- endfor -%}
  </div>

  <script>
    // Function to create media item element
    function createMediaItem(url, index) {
      const allMedia = {{ product.media | json }};

      // Convert URL to match media object URL format
      const mediaObject = allMedia.find(media => {
        const urlParts = url.split('/');
        const mediaParts = media.src.split('/');
        const urlFilename = urlParts[urlParts.length - 1].split('?')[0];
        const mediaFilename = mediaParts[mediaParts.length - 1].split('?')[0];

        const urlBase = urlFilename.split('.')[0];
        const mediaBase = mediaFilename.split('.')[0];

        return urlBase === mediaBase;
      });

      if (!mediaObject) {
        // Create a fallback media item if no match is found
        const div = document.createElement('div');
        div.id = `Slide-{{ section.id }}-${index}`;
        div.className = `swiper-slide product__media-item${index === 0 ? ' is-active' : ''} scroll-trigger animate--fade-in`;
        div.setAttribute('data-media-id', `{{ section.id }}-${index}`);

        const wrapper = document.createElement('div');
        wrapper.className = 'product__media media relative w-full h-0';
        wrapper.style.cssText = '--ratio: 1.0; --preview-ratio: 1.0; padding-bottom: 100%;';

        const imageContainer = document.createElement('div');
        imageContainer.className = 'absolute inset-0 w-full h-full';

        const img = document.createElement('img');
        img.src = url.startsWith('//') ? `https:${url}` : url;
        img.alt = '';
        img.id = `ProductMedia-{{ section.id }}-${index}`;
        img.className = 'media-item w-full h-full object-cover';
        img.setAttribute('loading', index === 0 ? 'eager' : 'lazy');

        imageContainer.appendChild(img);
        wrapper.appendChild(imageContainer);
        div.appendChild(wrapper);
        return div;
      }

      const div = document.createElement('div');
      div.id = `Slide-{{ section.id }}-${mediaObject.id}`;
      div.className = `swiper-slide product__media-item${index === 0 ? ' is-active' : ''}${mediaObject.media_type !== 'image' ? ' product__media-item--full' : ''} scroll-trigger animate--fade-in`;
      div.setAttribute('data-media-id', `{{ section.id }}-${mediaObject.id}`);

      const wrapper = document.createElement('div');
      wrapper.className = 'product__media media relative w-full h-0';
      wrapper.style.cssText = '--ratio: 1.0; --preview-ratio: 1.0; padding-bottom: 100%;';

      const imageContainer = document.createElement('div');
      imageContainer.className = 'absolute inset-0 w-full h-full';

      const img = document.createElement('img');
      const imgSrc = mediaObject.src.startsWith('//') ? `https:${mediaObject.src}` : mediaObject.src;
      img.src = imgSrc;
      img.alt = mediaObject.alt || '';
      img.id = `ProductMedia-{{ section.id }}-${mediaObject.id}`;
      img.className = 'media-item w-full h-full object-cover';
      img.setAttribute('loading', index === 0 ? 'eager' : 'lazy');
      img.width = mediaObject.width;
      img.height = mediaObject.height;

      imageContainer.appendChild(img);
      wrapper.appendChild(imageContainer);
      div.appendChild(wrapper);
      return div;
    }

    document.addEventListener('DOMContentLoaded', function () {
      console.log('DOMContentLoaded fired');

      // Initial setup
      const gallery = document.querySelector('#MediaGallery-{{ section.id }}');
      const sliderWrapper = document.querySelector('#Slider-Gallery-{{ section.id }}');
      const grid = document.querySelector('#desktop-gallery');
      const mobileGallery = document.querySelector('.product-swiper');

      // Hide galleries until content is ready
      mobileGallery.classList.remove('loaded');
      grid.classList.remove('loaded');

      // Get initial media URLs from data attribute
      let initialMediaUrls = sliderWrapper.dataset.mediaUrls
        .split(',')
        .filter(url => url && url.trim() !== '')
        .map(url => {
          // Remove any "files/" prefix if present
          url = url.replace(/\/files\//, '/');
          // Ensure proper URL formatting
          if (url.startsWith('//')) return `https:${url}`;
          if (!url.startsWith('http')) return `https:${url.startsWith('//') ? '' : '//'}${url}`;
          return url;
        });

      // Get the initial active color
      const activeColor = gallery.dataset.activeColor;
      console.log('Initial active color:', activeColor);

      // Wait for product-utils.js to load before filtering
      function waitForProductUtils() {
        if (window.parseImageUrl) {
          // Filter URLs by active color using parseImageUrl
          if (activeColor && initialMediaUrls.length > 0) {
            console.log('Filtering URLs for color:', activeColor);
            const filteredUrls = initialMediaUrls.filter(url => {
              const parsed = window.parseImageUrl(url);
              console.log('Parsed URL:', url, 'Color:', parsed.color);
              return parsed.color.toLowerCase() === activeColor.toLowerCase();
            });

            console.log('Filtered URLs:', filteredUrls);

            // Only use filtered URLs if we found matches
            if (filteredUrls.length > 0) {
              initialMediaUrls = filteredUrls;
            }
          }

          // If no URLs found, fallback to all media
          if (initialMediaUrls.length === 0) {
            initialMediaUrls = {{ product.media | json }}.map(media => {
              let url = media.src.replace(/\/files\//, '/');
              if (url.startsWith('//')) return `https:${url}`;
              if (!url.startsWith('http')) return `https:${url.startsWith('//') ? '' : '//'}${url}`;
              return url;
            });
          }

          console.log('Initial media URLs after filtering:', initialMediaUrls);

          const sortedInitialUrls = window.sortImagesByDisplayRules(initialMediaUrls);
          console.log('Sorted initial URLs:', sortedInitialUrls);

          updateGalleryContent(sortedInitialUrls);
        } else {
          // If product-utils.js hasn't loaded yet, wait and try again
          setTimeout(waitForProductUtils, 50);
        }
      }

      // Function to update gallery content
      function updateGalleryContent(urls) {
        // Clear existing content
        sliderWrapper.innerHTML = '';
        grid.innerHTML = '';

        // Populate mobile slider and desktop grid
        if (urls.length > 0) {
          urls.forEach((url, index) => {
            const mediaItem = createMediaItem(url, index);
            if (mediaItem) {
              sliderWrapper.appendChild(mediaItem.cloneNode(true));
              grid.appendChild(mediaItem);
            }
          });
        }

        // Initialize Swiper
        if (typeof Swiper !== 'undefined') {
          if (window.productSwiper) {
            window.productSwiper.destroy();
          }
          initSwiper();
        }

        // Show galleries after content is ready
        requestAnimationFrame(() => {
          mobileGallery.classList.add('loaded');
          grid.classList.add('loaded');
        });
      }

      // Start waiting for product-utils.js
      waitForProductUtils();

      // Directly monitor variant selectors
      const radioButtons = document.querySelectorAll('input[type="radio"][name^="Color"], input[type="radio"][name^="Colour"]');
      console.log('Found color radio buttons:', radioButtons.length);

      radioButtons.forEach(radio => {
        radio.addEventListener('change', function(e) {
          console.group('Color Radio Change');
          console.log('Radio changed:', e.target.value);
          const newColor = e.target.value.toLowerCase().replace(/\s+/g, '-').replace(/-+$/, '');

          // Update the gallery
          updateGalleryByColor(newColor);
          console.groupEnd();
        });
      });

      // Also listen for URL changes which indicate variant changes
      let currentUrl = window.location.href;
      setInterval(() => {
        if (currentUrl !== window.location.href) {
          console.group('URL Change Detected');
          console.log('Old URL:', currentUrl);
          console.log('New URL:', window.location.href);
          currentUrl = window.location.href;

          // Extract variant from URL
          const urlParams = new URLSearchParams(window.location.search);
          const variantId = urlParams.get('variant');

          if (variantId) {
            console.log('Variant ID from URL:', variantId);
            // Find the variant
            const variants = {{ product.variants | json }};
            const variant = variants.find(v => v.id.toString() === variantId);

            if (variant) {
              console.log('Found variant from URL:', variant);
              handleVariantChange(variant);
            }
          }
          console.groupEnd();
        }
      }, 300);

      // Function to update gallery by color
      function updateGalleryByColor(newColor) {
        console.group('Updating Gallery by Color');
        console.log('New color:', newColor);

        const currentColor = gallery.dataset.activeColor;
        console.log('Current color:', currentColor);

        if (newColor !== currentColor) {
          console.log('Color changed, updating gallery');
          gallery.dataset.activeColor = newColor;

          // Get all media URLs
          const allMediaUrls = {{ product.media | json }}.map(media => {
            let url = media.src.replace(/\/files\//, '/');
            if (url.startsWith('//')) return `https:${url}`;
            if (!url.startsWith('http')) return `https:${url.startsWith('//') ? '' : '//'}${url}`;
            return url;
          });

          console.log('All media URLs:', allMediaUrls);

          // Filter media by color
          const filteredUrls = allMediaUrls.filter(url => {
            const parsed = window.parseImageUrl(url);
            console.log('Parsing URL:', url, 'Found color:', parsed.color);
            return parsed.color.toLowerCase() === newColor.toLowerCase();
          });

          console.log('Filtered URLs:', filteredUrls);

          // If no filtered URLs found, use all URLs
          const urlsToUse = filteredUrls.length > 0 ? filteredUrls : allMediaUrls;
          console.log('URLs to use:', urlsToUse);

          // Sort filtered URLs
          const sortedUrls = window.sortImagesByDisplayRules(urlsToUse);
          console.log('Sorted URLs:', sortedUrls);

          // Update gallery content
          updateGalleryContent(sortedUrls);
        }

        console.groupEnd();
      }

      // Function to handle variant changes
      function handleVariantChange(variant) {
        console.group('Handling Variant Change');
        console.log('Variant:', variant);

        // Get color from variant
        let newColor = '';
        const colorPosition = {{ product.options_with_values | json }}.findIndex(option =>
          option.name.toLowerCase() === 'color' || option.name.toLowerCase() === 'colour'
        );

        if (colorPosition >= 0 && variant.options) {
          newColor = variant.options[colorPosition];
        }

        if (!newColor && variant.title) {
          newColor = variant.title.split('/')[0].trim();
        }

        if (newColor) {
          newColor = newColor.toLowerCase().replace(/\s+/g, '-').replace(/-+$/, '');
          console.log('New color:', newColor);

          const currentColor = gallery.dataset.activeColor;
          console.log('Current color:', currentColor);

          if (newColor !== currentColor) {
            console.log('Updating gallery color');
            gallery.dataset.activeColor = newColor;

            // Get all media URLs
            const allMediaUrls = {{ product.media | json }}.map(media => {
              let url = media.src.replace(/\/files\//, '/');
              if (url.startsWith('//')) return `https:${url}`;
              if (!url.startsWith('http')) return `https:${url.startsWith('//') ? '' : '//'}${url}`;
              return url;
            });

            console.log('All media URLs:', allMediaUrls);

            // Filter media by color
            const filteredUrls = allMediaUrls.filter(url => {
              const parsed = window.parseImageUrl(url);
              console.log('Parsing URL:', url, 'Found color:', parsed.color);
              return parsed.color.toLowerCase() === newColor.toLowerCase();
            });

            console.log('Filtered URLs:', filteredUrls);

            // If no filtered URLs found, use all URLs
            const urlsToUse = filteredUrls.length > 0 ? filteredUrls : allMediaUrls;
            console.log('URLs to use:', urlsToUse);

            // Sort filtered URLs
            const sortedUrls = window.sortImagesByDisplayRules(urlsToUse);
            console.log('Sorted URLs:', sortedUrls);

            // Update gallery content
            updateGalleryContent(sortedUrls);
          }
        }

        console.groupEnd();
      }
    });

    // Function to initialize Swiper
    function initSwiper() {
      window.productSwiper = new Swiper('.product-swiper', {
        slidesPerView: 1,
        spaceBetween: 0,
        pagination: {
          el: '.swiper-pagination',
          type: 'bullets',
          clickable: true
        }
      });
    }
  </script>

  {% comment %} {%- liquid
    assign is_not_limited_to_single_item = false
    if limit == null or limit > 1
      assign is_not_limited_to_single_item = true
    endif
  -%}
  {%- if is_not_limited_to_single_item
    and media_count > 1
    and section.settings.gallery_layout contains 'thumbnail'
    or section.settings.mobile_thumbnails == 'show'
  -%}
    <slider-component
      id="GalleryThumbnails-{{ section.id }}"
      class="thumbnail-slider slider-mobile-gutter quick-add-hidden{% unless section.settings.gallery_layout contains 'thumbnail' %} medium-hide large-up-hide{% endunless %}{% if section.settings.mobile_thumbnails != 'show' %} small-hide{% endif %}{% if media_count <= 3 %} thumbnail-slider--no-slide{% endif %}"
    >
      <button
        type="button"
        class="slider-button slider-button--prev{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
        aria-controls="GalleryThumbnails-{{ section.id }}"
        data-step="3"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <ul
        id="Slider-Thumbnails-{{ section.id }}"
        class="thumbnail-list list-unstyled slider slider--mobile{% if section.settings.gallery_layout == 'thumbnail_slider' %} slider--tablet-up{% endif %}"
        data-media-urls="{{ filtered_media | escape }}"
      >
        {%- for media in filtered_media_objects -%}
            <li
              id="Slide-Thumbnails-{{ section.id }}-{{ forloop.index }}"
            class="thumbnail-list__item slider__slide{% if section.settings.hide_variants and variant_images contains media %} thumbnail-list_item--variant{% endif %}"
              data-target="{{ section.id }}-{{ media.id }}"
            data-media-position="{{ forloop.index }}"
            >
              {%- if media.media_type == 'model' -%}
                <span class="thumbnail__badge" aria-hidden="true">
                  <span class="svg-wrapper">
                    {{- 'icon-3d-model.svg' | inline_asset_content -}}
                  </span>
                </span>
              {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                <span class="thumbnail__badge" aria-hidden="true">
                  <span class="svg-wrapper">
                    {{- 'icon-play.svg' | inline_asset_content -}}
                  </span>
                </span>
              {%- endif -%}
              {%- capture thumbnail_id -%}
                Thumbnail-{{ section.id }}-{{ forloop.index }}
              {%- endcapture -%}
              <button
                class="thumbnail global-media-settings global-media-settings--no-shadow"
              aria-label="{%- if media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: forloop.index }}{%- elsif media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: forloop.index }}{%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: forloop.index }}{%- endif -%}"
              {% if forloop.first %}aria-current="true"{% endif %}
                aria-controls="GalleryViewer-{{ section.id }}"
                aria-describedby="{{ thumbnail_id }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 416
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '54, 74, 104, 162, 208, 324, 416',
                    id: thumbnail_id,
                    alt: media.alt
                  | escape
                }}
              </button>
            </li>
        {%- endfor -%}
      </ul>
      <button
        type="button"
        class="slider-button slider-button--next{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
        aria-controls="GalleryThumbnails-{{ section.id }}"
        data-step="3"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const thumbnailList = document.querySelector('#Slider-Thumbnails-{{ section.id }}');

          // Get and sort media URLs
          const mediaUrls = thumbnailList.dataset.mediaUrls.split(',').filter(url => url);
          const sortedUrls = window.sortImagesByDisplayRules(mediaUrls);

          // Reorder thumbnails based on sorted URLs
          const items = Array.from(thumbnailList.children);
          const sortedItems = [];

          sortedUrls.forEach(url => {
            const item = items.find(item => {
              const img = item.querySelector('img');
              return img && (img.src === url || img.srcset.includes(url));
            });
            if (item) sortedItems.push(item);
          });

          // Clear and re-append in sorted order
          while (thumbnailList.firstChild) {
            thumbnailList.removeChild(thumbnailList.firstChild);
          }
          sortedItems.forEach((item, index) => {
            // Update position attributes
            item.dataset.mediaPosition = index + 1;
            item.id = `Slide-Thumbnails-{{ section.id }}-${index + 1}`;
            thumbnailList.appendChild(item);
          });
        });
      </script>
    </slider-component>
  {%- endif -%} {% endcomment %}
</media-gallery>
