    box-shadow: 0px 4px 10px 0px rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
  }
  #gallery-toggle-container {
    opacity: 0;
    transition: opacity 0.3s ease;
    position: absolute;
    z-index: 2;
    right: 1rem;
    bottom: 1rem;
  }
