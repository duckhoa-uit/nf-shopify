  .f-button.is-next::before {
    transform: translate(-50%, -50%);
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='24' viewBox='0 0 16 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 24L10 12L2 0' stroke='%230F0F0F' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: center;
  }

  .f-button.is-prev::before {
    transform: translate(-50%, -50%);
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='24' viewBox='0 0 16 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M14 24L6 12L14 0' stroke='%230F0F0F' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: center;
  }

  /* Custom toolbar for Fancybox */
  .custom-fancybox-toolbar {
    position: absolute;
    top: 6px;
    right: 6px;
    display: flex;
    gap: 10px;
    z-index: 40;
    background-color: rgba(128, 128, 128, 0.7);
    border-radius: 4px;
    padding: 8px 12px;
  }

  .custom-fancybox-toolbar button {
    width: 24px;
    height: 24px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .custom-fancybox-toolbar button:hover {
    opacity: 1;
  }

  .custom-fancybox-toolbar button svg {
    width: 20px;
    height: 20px;
    fill: white;
  }

  .custom-fancybox-toolbar button.active {
    opacity: 1;
  }

  /* Hide default close button and caption */
  .f-button.is-close {
    display: none !important;
  }

  /* Hide Fancybox caption */
  .fancybox__caption {
    display: none !important;
  }

  /* Footer transition for smooth show/hide */
  .fancybox__footer {
    transition: transform 0.3s ease, opacity 0.3s ease, margin-bottom 0.3s ease;
    transform-origin: bottom;
  }

  .fancybox__footer.is-hidden {
    transform: scaleY(0);
    opacity: 0;
    margin-bottom: -100px;
    pointer-events: none;
  }

  /* Custom thumbnail sizes */
  .f-thumbs__slide {
    width: 60px !important;
    height: 60px !important;
    border: none !important; /* Remove default border */
    position: relative; /* For positioning the bottom border */
  }

  .f-thumbs__slide__button {
    width: 60px !important;
    height: 60px !important;
  }

  /* Remove default active state styling */
  .f-thumbs__slide.is-nav-selected {
    border: none !important;
    box-shadow: none !important;
  }

  /* Override Fancybox's default active thumbnail styling */
  .is-classic .is-nav-selected .f-thumbs__slide__button::after {
    content: '' !important;
    position: absolute !important;
    top: auto !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    height: 2px !important;
    border: none !important;
    border-radius: 0 !important;
    background-color: #ec0009 !important;
    z-index: 10 !important;
    animation: none !important;
  }

  /* Tablet and mobile thumbnail sizes */
  @media screen and (max-width: 990px) {
    .f-thumbs__slide,
    .f-thumbs__slide__button {
      width: 48px !important;
      height: 48px !important;
    }
  }
</style>

