    border-radius: 50%;
    width: 3.75rem;
    height: 3.75rem;
    transition: background-color 0.2s ease;
    position: relative;
  }

  .f-button.is-close:hover {
    background-color: #e0e0e0;
  }

  .f-button.is-close svg {
    display: none;
  }

  .f-button.is-close::before {
