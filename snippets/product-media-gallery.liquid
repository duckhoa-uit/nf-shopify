  /* Position buttons relative to fancybox__content with higher specificity */
  .is-horizontal .f-carousel__nav .f-button.is-prev,
  .is-horizontal .fancybox__nav .f-button.is-prev,
  .f-button.is-prev {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: var(--f-button-prev-pos) !important; /* Use !important to override default styles */
  }

  .is-horizontal .f-carousel__nav .f-button.is-next,
  .is-horizontal .fancybox__nav .f-button.is-next,
  .f-button.is-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: var(--f-button-next-pos) !important; /* Use !important to override default styles */
  }

  /* Set default values for the CSS variables */
  :root {
    --f-button-prev-pos: -60px; /* 60px gap on desktop */
    --f-button-next-pos: -60px; /* 60px gap on desktop */
  }

  /* Responsive gaps for tablet and mobile */
  @media screen and (max-width: 990px) and (min-width: 768px) {
    :root {
      --f-button-prev-pos: -40px; /* 40px gap on tablet */
      --f-button-next-pos: -40px; /* 40px gap on tablet */
    }
  }

  @media screen and (max-width: 767px) {
    :root {
      --f-button-prev-pos: -20px; /* 20px gap on mobile */
      --f-button-next-pos: -20px; /* 20px gap on mobile */
