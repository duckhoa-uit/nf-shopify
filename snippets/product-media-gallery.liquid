    background-color: #ffffff;
    color: #0f0f0f;
    border: none;
    border-radius: 3px;
    box-shadow: 0px 3px 8px 0px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 14px;
