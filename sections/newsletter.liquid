{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .newsletter__wrapper {
    background-color: {{ section.settings.background_color }};
    position: relative;
    overflow: hidden;
    border-radius: 0px;
  }

  .newsletter__content {
    position: relative;
    z-index: 2;
    padding: 2rem;
  }

  .newsletter__yeti-image {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 100%;
    max-height: 300px;
    z-index: 1;
    object-fit: contain;
  }

  .newsletter__discount {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .newsletter__discount-circle {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background-color: #00AE70;
    border: 2px solid white;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .newsletter__discount-badge {
    border: 2px solid white;
    border-radius: 3px;
    padding: 0.5rem 1rem;
    font-size: 2.25rem;
    font-weight: 600;
    display: inline-block;
    margin-top: 0.5rem;
  }

  .newsletter-form__field-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media screen and (min-width: 750px) {
    .newsletter-form__field-wrapper {
      flex-direction: row;
      max-width: 600px;
    }
  }

  .newsletter__field {
    background-color: white;
    border-radius: 3px;
    padding: 0.75rem 1.25rem;
    flex-grow: 1;
    position: relative;
  }

  .newsletter__field .field__input {
    padding: 0;
    border: none;
    box-shadow: none;
    font-family: Archivo, sans-serif;
    font-size: 1rem;
    color: #4D4D4D;
  }

  .newsletter__field .field__input:focus {
    box-shadow: none;
    outline: none;
  }

  .newsletter__field .field__label {
    display: none;
  }

  .newsletter-form__button {
    background-color: #000;
    color: #fff;
    font-weight: 600;
    padding: 1rem 1.25rem;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    font-family: Archivo, sans-serif;
    font-size: 0.875rem;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
  }

  .newsletter__policy {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: white;
    font-family: Archivo, sans-serif;
    max-width: 600px;
  }

  .newsletter__title {
    font-family: 'Archivo SemiExpanded', Archivo, sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.333;
    margin-bottom: 1.5rem;
    color: white;
  }

  .newsletter__subtitle {
    font-family: Archivo, sans-serif;
    font-size: 0.875rem;
    line-height: 1.428;
    margin-bottom: 0.5rem;
    color: white;
  }

  @media screen and (max-width: 749px) {
    .newsletter__yeti-image {
      opacity: 0.4;
    }
  }
{%- endstyle -%}

<div class="newsletter center {% if section.settings.full_width == false %}newsletter--narrow page-width{% endif %}">
  <div class="newsletter__wrapper color-{{ section.settings.color_scheme }} gradient content-container isolate{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding">
    {% if section.settings.show_yeti_image %}
      <img
        src="{{ 'yeti.webp' | asset_url }}"
        alt="Yeti"
        width="300"
        height="300"
        loading="lazy"
        class="newsletter__yeti-image"
      >
    {% endif %}

    <div class="newsletter__content">
      <div class="newsletter__header">
        {% if section.settings.show_discount_badge %}
          <div class="newsletter__discount">
            <div class="newsletter__discount-circle">
              <svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 7L7 13L17 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="newsletter__subtitle">
              {{ section.settings.subtitle | default: 'Zľavový kupón pre prihlasených' }}
            </div>
          </div>
          <div class="newsletter__discount-badge">{{ section.settings.discount_amount | default: '-5 €' }}</div>
        {% endif %}

        <h2 class="newsletter__title">
          {{ section.settings.heading | default: 'Nehc vám neujde žiadna novinka ani zľava' }}
        </h2>
      </div>

      <div class="newsletter-form">
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__field-wrapper">
            <div class="newsletter__field field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="field__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Newsletter-success--{{ section.id }}"
                {% endif %}
                placeholder="{{ 'newsletter.placeholder' | t | default: 'Zadajte vaš e-mail' }}"
                required
              >
              <label class="field__label" for="NewsletterForm--{{ section.id }}">
                {{ 'newsletter.label' | t }}
              </label>
            </div>
            <button
              type="submit"
              class="newsletter-form__button"
              name="commit"
              id="Subscribe"
              aria-label="{{ 'newsletter.button_label' | t }}"
            >
              {{ section.settings.button_text | default: 'ODOSLAŤ' }}
              <svg width="10" height="7" viewBox="0 0 10 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.5 1L9 3.5M9 3.5L6.5 6M9 3.5H1" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <h3
              class="newsletter-form__message newsletter-form__message--success form__message"
              id="Newsletter-success--{{ section.id }}"
              tabindex="-1"
              autofocus
            >
              <span class="svg-wrapper">
                {{- 'icon-success.svg' | inline_asset_content -}}
              </span>
              {{- 'newsletter.success' | t }}
            </h3>
          {%- endif -%}
        {% endform %}
        {% if section.settings.show_policy_agreement %}
          <div class="newsletter__policy">{{ section.settings.policy_text | default: 'Odoslaním e-mailu súhlasíte so spracovaním osobných údajov.' }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.newsletter.settings.background_color.label",
      "default": "#2B3C48"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nehc vám neujde žiadna novinka ani zľava"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Zľavový kupón pre prihlasených"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "ODOSLAŤ"
    },
    {
      "type": "text",
      "id": "policy_text",
      "label": "Policy text",
      "default": "Odoslaním e-mailu súhlasíte so spracovaním osobných údajov."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.newsletter.settings.full_width.label"
    },
    {
      "type": "checkbox",
      "id": "show_yeti_image",
      "default": true,
      "label": "t:sections.newsletter.settings.show_yeti_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "default": true,
      "label": "t:sections.newsletter.settings.show_discount_badge.label"
    },
    {
      "type": "text",
      "id": "discount_amount",
      "label": "t:sections.newsletter.settings.discount_amount.label",
      "default": "-5 €"
    },
    {
      "type": "checkbox",
      "id": "show_policy_agreement",
      "default": true,
      "label": "t:sections.newsletter.settings.show_policy_agreement.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.newsletter.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name"
    }
  ]
}
{% endschema %}
