{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'product-card-hover.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;

    }
  }

  .products-per-page-form {
    margin-right: 1rem;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {% liquid
    comment
      Get products_per_page from URL parameter, default to 24
      We'll use JavaScript to detect this since Shopify request.parameters don't work reliably
    endcomment
    assign products_per_page = 24
  %}

  <script>
    // Detect products_per_page from URL parameter for Liquid template use
    (function () {
      const urlParams = new URLSearchParams(window.location.search);
      const productsPerPageParam = urlParams.get('products_per_page');
      const productsPerPage = productsPerPageParam ? parseInt(productsPerPageParam) : 24;

      // Store in global variable for use in Liquid calculations
      window.PRODUCTS_PER_PAGE = productsPerPage;

      // Also store in data attribute for easy access
      document.documentElement.setAttribute('data-products-per-page', productsPerPage);
    })();
  </script>

  {%- paginate collection.products by products_per_page -%}
    <div style="display: none;" data-debug-paginate="Items per page: {{ paginate.page_size }}"></div>
    <script>
      console.log('Paginate object - items per page:', {{ paginate.page_size }});
    </script>
    {% comment %} Scrollable Child Collections {% endcomment %}

    <div class="page-width">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      {{ 'custom-mobile-facets.css' | asset_url | stylesheet_tag }}
      {{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

      <div class="collection-header-controls mt-6 md:mb-12">
        {%- liquid
          assign has_children = false

          for child in collections
            if child.metafields.custom.parent_collection.value.handle == collection.handle or child.metafields.custom.parent_collection.value.id == collection.id
              assign has_children = true
              break
            endif
          endfor
        -%}

        <div class="collection-header-left">
          {%- if has_children -%}
            <div class="child-collections-wrapper">
              <div class="child-collections-scroll">
                <div class="child-collections-list">
                  {%- for child_collection in collections -%}
                    {%- if child_collection.metafields.custom.parent_collection.value.handle == collection.handle
                      or child_collection.metafields.custom.parent_collection.value.id == collection.id
                    -%}
                      {%- if child_collection.products.size > 0 -%}
                        <a
                          href="{{ child_collection.url }}"
                          class="child-collection-link {% if request.path == child_collection.url %}active{% endif %}"
                        >
                          <span class="child-collection-title">
                            {{- child_collection.metafields.custom.display_name | default: child_collection.title -}}
                          </span>
                        </a>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            {%- comment -%} Fallback: Render activities filter when no child collections exist {%- endcomment -%}
            {%- liquid
              assign activities_filter = null
              for filter in collection.filters
                if filter.param_name == 'filter.p.m.features.activities'
                  assign activities_filter = filter
                  break
                endif
              endfor
            -%}

            {%- if activities_filter and activities_filter.values.size > 0 -%}
              <div class="child-collections-wrapper">
                <div class="child-collections-scroll">
                  <div class="child-collections-list">
                    {%- for value in activities_filter.values -%}
                      {%- unless value.count == 0 and value.active == false -%}
                        <a
                          href="{{ value.url_to_add }}"
                          class="child-collection-link {% if value.active %}active{% endif %}"
                        >
                          <span class="child-collection-title">
                            {%- liquid
                              # Try to get translated label from metaobject entries
                              assign translated_label = value.label
                              assign metaobject_entries = shop.metaobjects.product_feature

                              if metaobject_entries and metaobject_entries.size > 0
                                for entry in metaobject_entries
                                  if entry.name and entry.name.value == value.label
                                    assign translated_label = entry.name.value
                                    break
                                  endif
                                endfor

                                # Try handle match if no exact match found
                                if translated_label == value.label
                                  assign value_handle = value.label | handleize
                                  for entry in metaobject_entries
                                    if entry.handle == value_handle and entry.name and entry.name.value != blank
                                      assign translated_label = entry.name.value
                                      break
                                    endif
                                  endfor
                                endif
                              endif
                            -%}
                            {{- translated_label -}}
                          </span>
                        </a>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="collection-header-right">
          <div class="filter-controls">
            {%- if section.settings.enable_sorting and collection.products.size > 0 -%}
              <div class="sorting-container hidden md:flex">
                <!-- Separate form for products per page (full page reload) -->
                <form
                  method="get"
                  action="{{ collection.url }}"
                  id="ProductsPerPageForm"
                  class="products-per-page-form"
                >
                  <div class="products-per-page">
                    <label for="ProductsPerPage">{{ 'products.facets.products_per_page' | t }}</label>
                    <div class="select after:border-0 after:shadow-none">
                      <select
                        name="products_per_page"
                        id="ProductsPerPage"
                        class="select__select pl-[5px]"
                        onchange="handleProductsPerPageChange(this);"
                      >
                        <option
                          value="24"
                          {% if products_per_page == 24 %}
                            selected
                          {% endif %}
                        >
                          24
                        </option>
                        <option
                          value="48"
                          {% if products_per_page == 48 %}
                            selected
                          {% endif %}
                        >
                          48
                        </option>
                        <option
                          value="120"
                          {% if products_per_page == 120 %}
                            selected
                          {% endif %}
                        >
                          120
                        </option>
                      </select>
                      <span class="svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </div>
                  </div>

                  <!-- Hidden inputs will be populated by JavaScript -->
                </form>

                <!-- Facets form for sorting only (AJAX) -->
                <facet-filters-form class="facets">
                  <form class="facets-form" id="FacetSortForm">
                    <div class="facet-filters sorting">
                      <div class="facet-filters__field">
                        <div class="select after:border-0 after:shadow-none">
                          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                          <select
                            name="sort_by"
                            class="facet-filters__sort select__select"
                            id="SortBy"
                            aria-describedby="a11y-refresh-page-message"
                          >
                            <option
                              value="manual"
                              {% if collection.sort_by == 'manual' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.manual' | t }}
                            </option>
                            <option
                              value="created-descending"
                              {% if collection.sort_by == 'created-descending' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.created_descending' | t }}
                            </option>
                            <option
                              value="price-ascending"
                              {% if collection.sort_by == 'price-ascending' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.price_ascending' | t }}
                            </option>
                            <option
                              value="price-descending"
                              {% if collection.sort_by == 'price-descending' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.price_descending' | t }}
                            </option>
                          </select>
                          <span class="svg-wrapper">
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </div>
                    </div>
                  </form>
                </facet-filters-form>
              </div>
            {%- endif -%}

            {%- if collection.products.size > 0 -%}
              <div class="filter-toggle">
                <button class="filter-toggle-btn" aria-expanded="true" aria-controls="main-collection-filters">
                  <span class="filter-icon">
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path d="M0.75 6.26308H12.9615C13.2984 7.62405 14.5295 8.63622 15.9931 8.63622C17.4567 8.63622 18.6878 7.62405 19.0246 6.26308H23.25C23.6642 6.26308 24 5.92727 24 5.51308C24 5.09889 23.6642 4.76308 23.25 4.76308H19.0246C18.6878 3.40211 17.4567 2.38989 15.993 2.38989C14.5294 2.38989 13.2983 3.40211 12.9615 4.76308H0.75C0.335812 4.76308 0 5.09889 0 5.51308C0 5.92727 0.335812 6.26308 0.75 6.26308ZM15.9931 3.88989C16.8881 3.88989 17.6163 4.61805 17.6163 5.51303C17.6163 6.40806 16.8881 7.13622 15.9931 7.13622C15.0981 7.13622 14.3699 6.40806 14.3699 5.51303C14.3699 4.61805 15.0981 3.88989 15.9931 3.88989ZM0.75 12.75H4.97541C5.31225 14.111 6.54333 15.1232 8.00695 15.1232C9.47058 15.1232 10.7017 14.111 11.0385 12.75H23.25C23.6642 12.75 24 12.4142 24 12C24 11.5858 23.6642 11.25 23.25 11.25H11.0385C10.7016 9.88905 9.47053 8.87683 8.00691 8.87683C6.54328 8.87683 5.3122 9.88905 4.97536 11.25H0.75C0.335812 11.25 0 11.5858 0 12C0 12.4142 0.335766 12.75 0.75 12.75ZM8.00691 10.3768C8.90194 10.3768 9.63009 11.105 9.63009 12C9.63009 12.895 8.90194 13.6232 8.00691 13.6232C7.11187 13.6232 6.38372 12.895 6.38372 12C6.38372 11.105 7.11187 10.3768 8.00691 10.3768ZM23.25 17.737H19.0246C18.6877 16.376 17.4567 15.3638 15.993 15.3638C14.5294 15.3638 13.2983 16.376 12.9615 17.737H0.75C0.335812 17.737 0 18.0728 0 18.487C0 18.9011 0.335812 19.237 0.75 19.237H12.9615C13.2984 20.5979 14.5295 21.6101 15.9931 21.6101C17.4567 21.6101 18.6878 20.5979 19.0246 19.237H23.25C23.6642 19.237 24 18.9011 24 18.487C24 18.0728 23.6642 17.737 23.25 17.737ZM15.9931 20.1101C15.0981 20.1101 14.3699 19.382 14.3699 18.487C14.3699 17.5919 15.0981 16.8638 15.9931 16.8638C16.8881 16.8638 17.6163 17.5919 17.6163 18.487C17.6163 19.382 16.8881 20.1101 15.9931 20.1101Z" fill="#EC0009"></path>
                    </svg>
                  </span>
                  <span class="filter-text">{{ 'products.facets.hide_filters' | t }}</span>
                </button>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="collection-container">
        <!-- Filter Sidebar -->
        {%- if section.settings.enable_filtering and collection.products.size > 0 -%}
          <div class="filter-sidebar {% if collection.products.size == 0 %}hidden{% endif %}">
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
              id="main-collection-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: collection,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: 'vertical',
                paginate: paginate,
                show_price_filter: true,
                price_filter_range_max: settings.price_filter_max
              %}
            </aside>
            {%- if section.settings.enable_sorting and collection.products.size > 0 -%}
              <div class="sorting-container mt-2 md:hidden">
                <!-- Separate form for products per page (full page reload) - Mobile Version -->
                <form
                  method="get"
                  action="{{ collection.url }}"
                  id="ProductsPerPageFormMobile"
                  class="products-per-page-form"
                >
                  <div class="products-per-page">
                    <label for="ProductsPerPageMobile">{{ 'products.facets.products_per_page' | t }}</label>
                    <div class="select after:border-0 after:shadow-none">
                      <select
                        name="products_per_page"
                        id="ProductsPerPageMobile"
                        class="select__select pl-[5px]"
                        onchange="handleProductsPerPageChange(this);"
                      >
                        <option
                          value="24"
                          {% if products_per_page == 24 %}
                            selected
                          {% endif %}
                        >
                          24
                        </option>
                        <option
                          value="48"
                          {% if products_per_page == 48 %}
                            selected
                          {% endif %}
                        >
                          48
                        </option>
                        <option
                          value="120"
                          {% if products_per_page == 120 %}
                            selected
                          {% endif %}
                        >
                          120
                        </option>
                      </select>
                      <span class="svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </div>
                  </div>

                  <!-- Hidden inputs will be populated by JavaScript -->
                </form>

                <!-- Facets form for sorting only (AJAX) -->
                <facet-filters-form class="facets">
                  <form class="facets-form" id="FacetSortFormMobile">
                    <div class="facet-filters sorting">
                      <div class="facet-filters__field">
                        <div class="select after:border-0 after:shadow-none">
                          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                          <select
                            name="sort_by"
                            class="facet-filters__sort select__select"
                            id="SortBy"
                            aria-describedby="a11y-refresh-page-message"
                          >
                            <option
                              value="manual"
                              {% if collection.sort_by == 'manual' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.manual' | t }}
                            </option>
                            <option
                              value="created-descending"
                              {% if collection.sort_by == 'created-descending' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.created_descending' | t }}
                            </option>
                            <option
                              value="price-ascending"
                              {% if collection.sort_by == 'price-ascending' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.price_ascending' | t }}
                            </option>
                            <option
                              value="price-descending"
                              {% if collection.sort_by == 'price-descending' %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ 'products.facets.sort_by.price_descending' | t }}
                            </option>
                          </select>
                          <span class="svg-wrapper">
                            {{- 'icon-caret.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </div>
                    </div>
                  </form>
                </facet-filters-form>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Product Grid Container -->
        <div class="product-grid-wrapper {% if collection.products.size == 0 %}full-width{% endif %}">
          <div
            class="product-grid-container {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            id="ProductGridContainer"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- if collection.products.size == 0 -%}
              <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div class="title-wrapper center">
                  <h2 class="title title--primary">
                    {{ 'sections.collection_template.empty' | t -}}
                    <br>
                    {{
                      'sections.collection_template.use_fewer_filters_html'
                      | t: link: collection.url, class: 'underlined-link link'
                    }}
                  </h2>
                </div>
              </div>
            {%- else -%}
              <div class="collection">
                <div class="loading-overlay gradient"></div>
                <ul
                  id="product-grid"
                  data-id="{{ section.id }}"
                  class="dawn-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                >
                  {% assign skip_card_product_styles = false %}
                  {%- for product in collection.products -%}
                    {% assign lazy_load = false %}
                    {%- if forloop.index > 2 -%}
                      {%- assign lazy_load = true -%}
                    {%- endif -%}
                    <li
                      class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: section.settings.image_shape,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        lazy_load: lazy_load,
                        skip_styles: skip_card_product_styles,
                        quick_add: section.settings.quick_add,
                        section_id: section.id
                      %}
                    </li>
                    {%- assign skip_card_product_styles = true -%}
                  {%- endfor -%}
                </ul>

                <div
                  class="product-count"
                  id="ProductCount"
                  data-total-count="{{ paginate.items }}"
                  data-current-page="{{ paginate.current_page }}"
                  data-default-per-page="{{ products_per_page }}"
                >
                  <p class="product-count-text">
                    <!-- Initial calculation will be updated by JavaScript -->
                    {% assign viewed_items = paginate.current_page | times: products_per_page %}
                    {% if viewed_items > paginate.items %}
                      {% assign viewed_items = paginate.items %}
                    {% endif %}
                    {{ 'products.facets.product_count' | t: viewed: viewed_items, total: paginate.items }}
                  </p>
                  <div class="product-count-progress">
                    <div
                      class="product-count-progress-bar"
                      style="width: {{ viewed_items | times: 100.0 | divided_by: paginate.items }}%"
                    ></div>
                  </div>
                </div>

                {%- if paginate.pages > 1 -%}
                  {% if paginate.next.url %}
                    <div class="view-more-container">
                      <button class="view-more-button" data-url="{{ paginate.next.url }}">
                        {{ 'products.facets.view_more' | t }}
                      </button>
                    </div>
                  {% endif %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
          <div class="max-w-[800px] mt-12 mb-8" id="collection-description-full">
            <div class="text-balance text-sm leading-5 lg:text-base lg:leading-6 text-[#3d3d3d]">
              {{ collection.description }}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

<script>
  // Handle products per page change while preserving filters/sorting
  // This function needs to be in global scope for onchange attribute
  function handleProductsPerPageChange(selectElement) {
    const newProductsPerPage = selectElement.value;
    const form = selectElement.closest('form');

    // Clear existing hidden inputs
    const existingHiddenInputs = form.querySelectorAll('input[type="hidden"]');
    existingHiddenInputs.forEach(input => input.remove());

    // Get current URL parameters to preserve filters/sorting
    const currentParams = new URLSearchParams(window.location.search);

    // Add all current parameters except products_per_page and page
    currentParams.forEach((value, key) => {
      if (key !== 'products_per_page' && key !== 'page') {
        const hiddenInput = document.createElement('input');
        hiddenInput.type = 'hidden';
        hiddenInput.name = key;
        hiddenInput.value = value;
        form.appendChild(hiddenInput);
      }
    });

    // Submit the form
    form.submit();
  }

  // Calculate correct pagination text based on actual products per page
  window.calculateCorrectPaginationText = function() {
    const productCountContainer = document.getElementById('ProductCount');
    if (!productCountContainer) return;

    const urlParams = new URLSearchParams(window.location.search);
    const actualProductsPerPage = parseInt(urlParams.get('products_per_page') || '24');
    const currentPage = parseInt(productCountContainer.getAttribute('data-current-page') || '1');
    const totalItems = parseInt(productCountContainer.getAttribute('data-total-count') || '0');

    // Calculate viewed items based on actual products per page
    let viewedItems = currentPage * actualProductsPerPage;
    if (viewedItems > totalItems) {
      viewedItems = totalItems;
    }

    // Update the data attributes with correct values
    productCountContainer.setAttribute('data-viewed-items', viewedItems);
    productCountContainer.setAttribute('data-actual-per-page', actualProductsPerPage);

    console.log('calculateCorrectPaginationText:', {
      actualProductsPerPage,
      currentPage,
      totalItems,
      viewedItems
    });
  };



  // Make functions globally available for facets system to call
  window.handleProductsPerPageWithJS = function() {
    const urlParams = new URLSearchParams(window.location.search);
    const requestedProductsPerPage = urlParams.get('products_per_page');

    // Always calculate correct pagination text first
    window.calculateCorrectPaginationText();

    if (requestedProductsPerPage && requestedProductsPerPage !== '24') {
      // If user requested different page size, we need to load the correct number of products
      const targetProductsPerPage = parseInt(requestedProductsPerPage);
      const currentProductGrid = document.querySelector('#product-grid');
      const productCountContainer = document.getElementById('ProductCount');

      if (currentProductGrid && productCountContainer) {
        const currentProducts = currentProductGrid.querySelectorAll('.grid__item');
        const visibleProducts = currentProductGrid.querySelectorAll('.grid__item:not([style*="display: none"])');
        const totalAvailableProducts = parseInt(productCountContainer.getAttribute('data-total-count') || '0');

        if (targetProductsPerPage > totalAvailableProducts) {
          // User wants more products than available - show all available products
          if (currentProducts.length >= totalAvailableProducts) {
            // Show all products already in DOM
            currentProducts.forEach((product, index) => {
              if (index < totalAvailableProducts) {
                product.style.display = '';
              }
            });
            window.updateProductCount();
            window.updateViewMoreButton();
          } else {
            // Need to load remaining products
            window.loadMoreProductsToReachTarget(totalAvailableProducts, currentProducts.length);
          }
        } else if (targetProductsPerPage <= totalAvailableProducts && currentProducts.length >= totalAvailableProducts) {
          // Special case: we have all products in DOM, show the requested amount or all available
          const productsToShow = Math.min(targetProductsPerPage, totalAvailableProducts);

          currentProducts.forEach((product, index) => {
            if (index < productsToShow) {
              product.style.display = '';
            } else {
              product.style.display = 'none';
            }
          });

          window.updateProductCount();
          window.updateViewMoreButton();
        } else if (currentProducts.length < targetProductsPerPage) {
          // Need to load more products via AJAX
          window.loadMoreProductsToReachTarget(targetProductsPerPage, currentProducts.length);
        } else if (currentProducts.length > targetProductsPerPage) {
          // Need to hide excess products
          window.hideExcessProducts(targetProductsPerPage);
        } else {
          // Already showing correct number, just update counts
          window.updateProductCount();
          window.updateViewMoreButton();
        }
      }

      // Update both desktop and mobile selectors to show correct value
      const desktopSelect = document.querySelector('#ProductsPerPage');
      const mobileSelect = document.querySelector('#ProductsPerPageMobile');

      if (desktopSelect) {
        desktopSelect.value = requestedProductsPerPage;
      }
      if (mobileSelect) {
        mobileSelect.value = requestedProductsPerPage;
      }
    }
  };

  window.updateProductCount = function(preserveFilteredCount = true, context = 'default') {
    // Update the product count text to reflect current displayed products
    const productGrid = document.querySelector('#product-grid');
    const productCountElement = document.querySelector('.product-count-text');
    const productCountContainer = document.getElementById('ProductCount');

    if (productGrid && productCountElement && productCountContainer) {
      const visibleProducts = productGrid.querySelectorAll('.grid__item:not([style*="display: none"])');

      // Get total products from data attribute (most reliable source)
      let totalProducts = parseInt(productCountContainer.getAttribute('data-total-count') || '0');

      // CRITICAL FIX: Handle Load More context properly
      if (context === 'load-more') {
        // For Load More, if visible products exceed original total, update total count
        // This happens when Load More loads products from additional pages
        if (visibleProducts.length > totalProducts) {
          totalProducts = visibleProducts.length;
          // Update data attribute for consistency
          productCountContainer.setAttribute('data-total-count', totalProducts.toString());
        }
      } else if (preserveFilteredCount) {
        // For other contexts, try to preserve the filtered count
        const currentText = productCountElement.textContent || '';
        const numbers = currentText.match(/\d+/g);

        if (numbers && numbers.length >= 2) {
          // Find the largest number that could be a total count
          const numberValues = numbers.map(n => parseInt(n));
          const potentialTotal = Math.max(...numberValues.filter(n => n >= visibleProducts.length));

          if (potentialTotal && potentialTotal !== totalProducts) {
            totalProducts = potentialTotal;
          }
        }
      }

      // Create the updated text using the same pattern as the Liquid template
      const productCountTemplate = {{ 'products.facets.product_count' | t: viewed: '__VIEWED__', total: '__TOTAL__' | json }};
      const productCountText = productCountTemplate
        .replace('__VIEWED__', visibleProducts.length)
        .replace('__TOTAL__', totalProducts);

      productCountElement.innerHTML = productCountText;

      // Update progress bar
      const progressBar = document.querySelector('.product-count-progress-bar');
      if (progressBar && totalProducts > 0) {
        const percentage = (visibleProducts.length / totalProducts) * 100;
        progressBar.style.width = `${percentage}%`;
      }

      // Update data attribute with current visible count
      productCountContainer.setAttribute('data-visible-count', visibleProducts.length);
    }
  };

  // Helper function to get current filtered product count
  window.getCurrentFilteredProductCount = function() {
    const productCountContainer = document.getElementById('ProductCount');

    // PRIMARY: Get count from data attribute (most reliable)
    if (productCountContainer) {
      const dataCount = productCountContainer.getAttribute('data-total-count');
      if (dataCount && !isNaN(dataCount)) {
        return parseInt(dataCount);
      }
    }

    // SECONDARY: Extract from current pagination text
    const productCountElement = document.querySelector('.product-count-text');
    if (productCountElement) {
      const currentText = productCountElement.textContent || '';
      const numbers = currentText.match(/\d+/g);

      if (numbers && numbers.length >= 2) {
        // The second number is typically the total
        return parseInt(numbers[numbers.length - 1]);
      }
    }

    // FALLBACK: Return 0 if we can't determine the count
    return 0;
  };

  window.updateViewMoreButton = function() {
    const viewMoreButton = document.querySelector('.view-more-button');
    if (!viewMoreButton) return;

    // Update button URL with current products_per_page parameter
    const urlParams = new URLSearchParams(window.location.search);
    const productsPerPage = urlParams.get('products_per_page');

    if (productsPerPage) {
      const currentUrl = viewMoreButton.dataset.url;
      if (currentUrl) {
        const url = new URL(currentUrl, window.location.origin);
        url.searchParams.set('products_per_page', productsPerPage);
        viewMoreButton.dataset.url = url.pathname + url.search;
      }
    }

    // Check if we should show/hide the button
    const productGrid = document.querySelector('#product-grid');
    if (productGrid) {
      const visibleProducts = productGrid.querySelectorAll('.grid__item:not([style*="display: none"])');
      const totalProducts = window.getCurrentFilteredProductCount();
      const hasNextPageUrl = viewMoreButton.dataset.url && viewMoreButton.dataset.url.trim() !== '';

      // Show button only if there's a next page URL AND we haven't loaded all products
      const shouldShow = hasNextPageUrl && totalProducts > 0 && visibleProducts.length < totalProducts;

      viewMoreButton.style.display = shouldShow ? 'block' : 'none';
    }
  };

  // Helper functions for loading products (global scope)
  window.loadMoreProductsToReachTarget = function(targetCount, currentCount) {
    // If we already have enough or more products, just update counts
    if (currentCount >= targetCount) {
      window.updateProductCount();
      window.updateViewMoreButton();
      return;
    }

    // Calculate how many products we need to load
    const productsNeeded = targetCount - currentCount;
    const pagesToLoad = Math.ceil(productsNeeded / 24);
    let loadedPages = 0;

    // Track actual products in DOM, not just counter
    function getCurrentProductCount() {
      const productGrid = document.querySelector('#product-grid');
      return productGrid ? productGrid.querySelectorAll('.grid__item').length : 0;
    }

    function loadNextPage() {
      const currentProductsInDOM = getCurrentProductCount();

      if (loadedPages >= pagesToLoad || currentProductsInDOM >= targetCount) {
        window.updateProductCount();
        window.updateViewMoreButton();
        return;
      }

      // Calculate next page more accurately
      const currentPage = 1; // We're always starting from page 1 with 24 products
      const nextPage = currentPage + 1 + loadedPages;

      const url = new URL(window.location);
      url.searchParams.set('page', nextPage);
      url.searchParams.delete('products_per_page'); // Remove to get default 24 per page

      fetch(url.toString())
        .then(response => response.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newItems = doc.querySelectorAll('#product-grid .grid__item');
          const productGrid = document.querySelector('#product-grid');

          if (newItems.length && productGrid) {
            let addedCount = 0;
            const currentProductsBeforeAdd = getCurrentProductCount();

            newItems.forEach((item) => {
              if (getCurrentProductCount() < targetCount) {
                productGrid.appendChild(item.cloneNode(true));
                addedCount++;
              }
            });

            const currentProductsAfterAdd = getCurrentProductCount();
            loadedPages++;

            // Check if we need to load more
            if (currentProductsAfterAdd < targetCount && newItems.length === 24) {
              loadNextPage();
            } else {
              window.updateProductCount();
              window.updateViewMoreButton();
            }
          } else {
            window.updateProductCount();
            window.updateViewMoreButton();
          }
        })
        .catch(error => {
          console.error(`Error loading page ${nextPage}:`, error);
          window.updateProductCount();
          window.updateViewMoreButton();
        });
    }

    loadNextPage();
  };

  window.hideExcessProducts = function(targetCount) {
    const productGrid = document.querySelector('#product-grid');
    if (productGrid) {
      const allProducts = productGrid.querySelectorAll('.grid__item');
      allProducts.forEach((product, index) => {
        if (index >= targetCount) {
          product.style.display = 'none';
        }
      });
      window.updateProductCount();
      window.updateViewMoreButton();
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    // Handle smooth scrolling for Read More link
    document.addEventListener('click', function(e) {
      const target = e.target.closest('a[href^="#"]');
      if (target) {
        const targetId = target.getAttribute('href');
        const targetElement = document.querySelector(targetId);

        if (targetElement) {
          e.preventDefault();

          // Scroll to the target element with smooth behavior
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });

          // Add the ID to the URL without refreshing the page
          history.pushState(null, null, targetId);
        }
      }
    });

    // Filter toggle functionality
    const filterToggleBtn = document.querySelector('.filter-toggle-btn');
    const filtersWrapper = document.querySelector('.facets-wrapper');
    const hasProducts = {% if collection.products.size > 0 %}true{% else %}false{% endif %};

    // Only initialize filter toggle if we have products and the necessary elements
    if (hasProducts && filterToggleBtn && filtersWrapper) {
      const handleFilterToggle = function() {
        const expanded = this.getAttribute('aria-expanded') === 'true';
        const newExpanded = !expanded;
        this.setAttribute('aria-expanded', newExpanded);

        // Toggle filter visibility
        filtersWrapper.classList.toggle('visible', newExpanded);
        filtersWrapper.closest('.filter-sidebar').classList.toggle('hidden', !newExpanded);
        document.querySelector('.product-grid-wrapper').classList.toggle('full-width', !newExpanded);

        // Update button text
        this.querySelector('.filter-text').textContent = newExpanded
          ? {{ 'products.facets.hide_filters' | t | json }}
          : {{ 'products.facets.filter_button' | t | json }};

        // Update icon rotation
        const filterIcon = this.querySelector('.filter-icon');
        if (filterIcon) {
          filterIcon.style.transform = newExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      };

      // Initialize filter state
      const initializeFilters = function() {
        const expanded = filterToggleBtn.getAttribute('aria-expanded') === 'true';
        filtersWrapper.classList.toggle('visible', expanded);
        filtersWrapper.closest('.filter-sidebar').classList.toggle('hidden', !expanded);
        document.querySelector('.product-grid-wrapper').classList.toggle('full-width', !expanded);
      };

      // Initialize on load
      initializeFilters();

      filterToggleBtn.addEventListener('click', handleFilterToggle);

      // Handle window resize
      let resizeTimeout;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function() {
          if (window.innerWidth >= 990) {
            filtersWrapper.classList.remove('visible');
            filterToggleBtn.setAttribute('aria-expanded', 'false');
            filterToggleBtn.querySelector('.filter-text').textContent = {{ 'products.facets.filter_button' | t | json }};
            const filterIcon = filterToggleBtn.querySelector('.filter-icon');
            if (filterIcon) {
              filterIcon.style.transform = 'rotate(0deg)';
            }
          }
        }, 200);
      });
    }

    // If no products, ensure product grid wrapper is full width and hide filter sidebar
    if (!hasProducts) {
      const productGridWrapper = document.querySelector('.product-grid-wrapper');
      const filterSidebar = document.querySelector('.filter-sidebar');
      if (productGridWrapper) {
        productGridWrapper.classList.add('full-width');
      }
      if (filterSidebar) {
        filterSidebar.classList.add('hidden');
        filterSidebar.style.width = '0';
      }
    }

    // Products per page is now handled by the facets system

    // Child collections scroll functionality
    const childCollectionsScroll = document.querySelector('.child-collections-scroll');
    if (childCollectionsScroll) {
      // Check if scrolling is needed
      const checkScrollable = function() {
        const isScrollable = childCollectionsScroll.scrollWidth > childCollectionsScroll.clientWidth;
        childCollectionsScroll.classList.toggle('scrollable', isScrollable);
        childCollectionsScroll.classList.toggle('grabbable', isScrollable);
      };

      // Check on load
      checkScrollable();

      // Check on resize
      window.addEventListener('resize', function() {
        checkScrollable();
      });

      // Grab to scroll functionality
      let isDown = false;
      let startX;
      let scrollLeft;

      childCollectionsScroll.addEventListener('mousedown', (e) => {
        isDown = true;
        childCollectionsScroll.classList.add('grabbing');
        startX = e.pageX - childCollectionsScroll.offsetLeft;
        scrollLeft = childCollectionsScroll.scrollLeft;
        e.preventDefault(); // Prevent text selection during drag
      });

      childCollectionsScroll.addEventListener('mouseleave', () => {
        isDown = false;
        childCollectionsScroll.classList.remove('grabbing');
      });

      childCollectionsScroll.addEventListener('mouseup', () => {
        isDown = false;
        childCollectionsScroll.classList.remove('grabbing');
      });

      childCollectionsScroll.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        const x = e.pageX - childCollectionsScroll.offsetLeft;
        const walk = (x - startX) * 1.5; // Scroll speed multiplier
        childCollectionsScroll.scrollLeft = scrollLeft - walk;
      });

      // Touch events for mobile
      let touchStartX;

      childCollectionsScroll.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].pageX - childCollectionsScroll.offsetLeft;
        scrollLeft = childCollectionsScroll.scrollLeft;
      }, { passive: true });

      childCollectionsScroll.addEventListener('touchmove', (e) => {
        if (e.touches.length > 1) return; // Ignore multi-touch
        const x = e.touches[0].pageX - childCollectionsScroll.offsetLeft;
        const walk = (x - touchStartX) * 1.5;
        childCollectionsScroll.scrollLeft = scrollLeft - walk;
        e.preventDefault(); // Prevent page scrolling while dragging
      }, { passive: false });
    }




    // View more functionality
    function handleViewMoreClick(e) {
      const viewMoreButton = e.target.closest('.view-more-button');
      if (!viewMoreButton) return;

      e.preventDefault();
      const baseUrl = viewMoreButton.dataset.url;
      if (!baseUrl) return;

      // Get current products per page setting
      const urlParams = new URLSearchParams(window.location.search);
      const currentProductsPerPage = urlParams.get('products_per_page');
      const targetProductsPerPage = currentProductsPerPage ? parseInt(currentProductsPerPage) : 24;

      // Get current state before loading
      const productGrid = document.querySelector('#product-grid');
      const productCountContainer = document.getElementById('ProductCount');
      const currentVisibleProducts = productGrid ? productGrid.querySelectorAll('.grid__item:not([style*="display: none"])').length : 0;
      const totalAvailableProducts = productCountContainer ? parseInt(productCountContainer.getAttribute('data-total-count') || '0') : 0;

      // Calculate how many products we actually need to load
      const remainingProductsNeeded = totalAvailableProducts - currentVisibleProducts;

      if (remainingProductsNeeded <= 0) {
        viewMoreButton.style.display = 'none';
        return;
      }

      // Load More should load in increments, not all remaining
      // Determine how many products to load this session (products per page or remaining, whichever is smaller)
      const productsToLoadThisSession = Math.min(targetProductsPerPage, remainingProductsNeeded);

      // Show loading state
      viewMoreButton.textContent = {{ 'products.facets.loading' | t | json }};
      viewMoreButton.disabled = true;

      // Calculate pages needed for this session only (each page has 24 products by default)
      const pagesToLoad = Math.ceil(productsToLoadThisSession / 24);
      const basePageUrl = new URL(baseUrl, window.location.origin);
      const currentPage = parseInt(basePageUrl.searchParams.get('page') || '2');

      let productsLoadedThisSession = 0; // Track products loaded in this View More session
      let pagesLoaded = 0;

      function loadNextBatch() {
        if (pagesLoaded >= pagesToLoad) {
          // Finished loading all required pages
          updateViewMoreButtonState();
          return;
        }

        const pageToLoad = currentPage + pagesLoaded;
        const fetchUrl = new URL(baseUrl, window.location.origin);
        fetchUrl.searchParams.set('page', pageToLoad.toString());
        // Don't set products_per_page in the fetch URL to get default 24 per page
        fetchUrl.searchParams.delete('products_per_page');

        // Preserve current filter parameters to maintain filtered results
        const currentUrlParams = new URLSearchParams(window.location.search);
        currentUrlParams.forEach((value, key) => {
          // Preserve all filter parameters except page and products_per_page
          if (key !== 'page' && key !== 'products_per_page') {
            fetchUrl.searchParams.set(key, value);
          }
        });

        fetch(fetchUrl.toString())
          .then(response => response.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newItems = doc.querySelectorAll('#product-grid .grid__item');
            const productGrid = document.querySelector('#product-grid');

            if (newItems.length && productGrid) {
              // Respect session limit for incremental loading
              const currentVisibleAfterPrevious = productGrid.querySelectorAll('.grid__item:not([style*="display: none"])').length;
              const stillNeedToLoadTotal = totalAvailableProducts - currentVisibleAfterPrevious;
              const stillNeedToLoadThisSession = productsToLoadThisSession - productsLoadedThisSession;
              let addedCount = 0;

              newItems.forEach((item, index) => {
                // Respect both session limit AND total available limit
                const canAddMore = addedCount < stillNeedToLoadThisSession &&
                                  productsLoadedThisSession < productsToLoadThisSession &&
                                  (currentVisibleAfterPrevious + addedCount) < totalAvailableProducts;

                if (canAddMore) {
                  productGrid.appendChild(item.cloneNode(true));
                  addedCount++;
                  productsLoadedThisSession++;
                }
              });

              // Immediately update pagination text and progress bar after adding products
              window.updateProductCount(true, 'load-more'); // Use Load More context
            }

            pagesLoaded++;

            // Check completion based on session limits for incremental loading
            const finalVisibleCount = productGrid.querySelectorAll('.grid__item:not([style*="display: none"])').length;
            const hasMoreProductsToLoad = finalVisibleCount < totalAvailableProducts;
            const hasMorePagesAvailable = newItems.length === 24;
            const sessionComplete = productsLoadedThisSession >= productsToLoadThisSession;

            // Complete this session if we've loaded the target amount OR no more products available
            if (sessionComplete || !hasMoreProductsToLoad || !hasMorePagesAvailable) {
              updateViewMoreButtonState();
            } else {
              loadNextBatch(); // Load next page within this session
            }
          })
          .catch(error => {
            console.error('Error loading more products:', error);
            viewMoreButton.textContent = {{ 'products.facets.view_more' | t | json }};
            viewMoreButton.disabled = false;
          });
      }

      function updateViewMoreButtonState() {
        // First, ensure pagination text is up to date
        window.updateProductCount(true, 'load-more'); // Use Load More context

        // Get current filtered product count for accurate comparison
        const totalProducts = window.getCurrentFilteredProductCount();
        // Recalculate visible products AFTER updateProductCount to ensure accuracy
        const currentVisibleProducts = document.querySelectorAll('#product-grid .grid__item:not([style*="display: none"])').length;

        // If we've loaded all available products, hide the button immediately
        if (totalProducts > 0 && currentVisibleProducts >= totalProducts) {
          viewMoreButton.style.display = 'none';
          viewMoreButton.disabled = true;
          return;
        }

        // Check if there are more pages available by trying to fetch next page
        const lastPageToCheck = currentPage + pagesLoaded;
        const checkUrl = new URL(baseUrl, window.location.origin);
        checkUrl.searchParams.set('page', lastPageToCheck.toString());
        checkUrl.searchParams.delete('products_per_page');

        fetch(checkUrl.toString())
          .then(response => response.text())
          .then(html => {
            // Double-check if all products are loaded before proceeding
            const currentVisibleAfterAjax = document.querySelectorAll('#product-grid .grid__item:not([style*="display: none"])').length;
            const totalProductsAfterAjax = window.getCurrentFilteredProductCount();

            if (totalProductsAfterAjax > 0 && currentVisibleAfterAjax >= totalProductsAfterAjax) {
              viewMoreButton.style.display = 'none';
              viewMoreButton.disabled = true;
              return;
            }

            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const nextPageButton = doc.querySelector('.view-more-button');
            const nextPageProducts = doc.querySelectorAll('#product-grid .grid__item');

            // Check if next page has products or if there's a next page button
            if ((nextPageButton?.dataset.url) || (nextPageProducts && nextPageProducts.length > 0)) {
              // Update current button with new URL, preserving products_per_page
              if (nextPageButton?.dataset.url) {
                const nextUrl = new URL(nextPageButton.dataset.url, window.location.origin);
                if (currentProductsPerPage) {
                  nextUrl.searchParams.set('products_per_page', currentProductsPerPage);
                }
                viewMoreButton.dataset.url = nextUrl.pathname + nextUrl.search;
              }

              viewMoreButton.textContent = {{ 'products.facets.view_more' | t | json }};
              viewMoreButton.disabled = false;
              viewMoreButton.style.display = 'block';
            } else {

              // No more pages available - but check if total count needs adjustment
              const actualTotalProducts = currentVisibleAfterAjax;

              // Update the pagination text with correct total
              const productCountElement = document.querySelector('.product-count-text');
              if (productCountElement && actualTotalProducts !== totalProductsAfterAjax) {
                const productCountTemplate = {{ 'products.facets.product_count' | t: viewed: '__VIEWED__', total: '__TOTAL__' | json }};
                const correctedText = productCountTemplate
                  .replace('__VIEWED__', actualTotalProducts)
                  .replace('__TOTAL__', actualTotalProducts);

                productCountElement.innerHTML = correctedText;

                // Update progress bar to 100%
                const progressBar = document.querySelector('.product-count-progress-bar');
                if (progressBar) {
                  progressBar.style.width = '100%';
                }
              }

              // Hide the button
              viewMoreButton.style.display = 'none';
              viewMoreButton.disabled = true;
            }

            // Re-initialize product card hover functionality if available
            if (window.ProductCardHover && typeof window.ProductCardHover.reinitialize === 'function') {
              window.ProductCardHover.reinitialize();
            }
          })
          .catch(error => {
            console.error('Error checking next page:', error);
            // On error, keep the button visible to allow user to try again
            viewMoreButton.textContent = {{ 'products.facets.view_more' | t | json }};
            viewMoreButton.disabled = false;
            viewMoreButton.style.display = 'block';
          });
      }

      // Start loading the required pages
      loadNextBatch();
    }

    // Add view more event listener
    document.addEventListener('click', handleViewMoreClick);

    // Initialize everything on page load
    function initializePage() {
      console.log('Initializing page...');

      // First, calculate correct pagination text based on URL parameters
      window.calculateCorrectPaginationText();

      // Then handle products per page adjustments
      window.handleProductsPerPageWithJS();

      // Update counts and button state after JS manipulation
      setTimeout(() => {
        window.updateProductCount();
        window.updateViewMoreButton();
        console.log('Page initialization complete');
      }, 200);
    }

    // Initialize when everything is ready
    initializePage();
  });
</script>

