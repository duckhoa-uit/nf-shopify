{% schema %}
{
  "name": "Info Box",
  "class": "section-info-box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Info Box",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

{%- liquid
  assign info_box_title = section.settings.title
  if info_box_title == blank
    assign info_box_title = 'sections.info_box.title' | t
  endif

  assign info_box_subtitle = section.settings.subtitle
  if info_box_subtitle == blank
    assign info_box_subtitle = 'sections.info_box.subtitle' | t
  endif

  assign info_box_button_text = section.settings.button_text
  if info_box_button_text == blank
    assign info_box_button_text = 'sections.info_box.button_text' | t
  endif

  assign info_box_button_url = section.settings.button_url
  case request.locale.iso_code
    when 'bg'
      assign info_box_button_url = 'https://northfinder.bg/pages/black-friday'
    when 'de'
      assign info_box_button_url = 'https://shop.northfinder.com/de/pages/black-friday'
    when 'hr'
      assign info_box_button_url = 'https://shop.northfinder.com/hr/pages/black-friday'
    when 'sk'
      assign info_box_button_url = 'https://northfinder.sk/pages/black-friday'
    when 'sl'
      assign info_box_button_url = 'https://shop.northfinder.com/sl/pages/black-friday'
  endcase
-%}

<div class="simple_infobox py-2 md:py-3 mb-1.5" style="background-color:#000;">
  <a
    href="{{ info_box_button_url }}"
    aria-label="{{ info_box_button_text }}"
    class="container mx-auto px-4 flex flex-col md:flex-row items-center gap-2 md:gap-4"
  >
    <div class="flex flex-col items-center text-center flex-1">
      <h2 class="font-archivo font-medium text-[15px] leading-[1.067em] mb-1" style="color:#fff;">
        {{ info_box_title }}
      </h2>
      <p class="infobox_subtitle hidden md:block font-archivo text-[13px] leading-[1.077em]" style="color:#CCCCCC;">
        {{ info_box_subtitle }}
      </p>
    </div>
    <span
      class="button_text inline-flex items-center px-4 py-[10px] rounded-3 text-sm font-medium leading-[0.875rem] uppercase transition-colors"
      style="background-color:#CC0000;color:#fff;"
    >
      {{ info_box_button_text }}
    </span>
  </a>
</div>