{% schema %}
{
  "name": "Info Box",
  "class": "section-info-box",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Nekompromisne proti vetru, dažďu a zime"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Objavte kvalitné oblečenie do nečasu"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "NAKUPOVAŤ"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Info Box",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<div class="simple_infobox">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between py-8">
      <div class="left_side md:w-1/2 mb-4 md:mb-0">
        <h2 class="title text-2xl md:text-3xl font-bold mb-2 text-vscode-descriptionForeground">
          {{ section.settings.title }}
        </h2>
        <p class="infobox_subtitle text-lg md:text-xl text-vscode-descriptionForeground">
          {{ section.settings.subtitle }}
        </p>
      </div>

      <div class="right_side md:w-1/2 text-right">
        <a
          href="{{ section.settings.button_url }}"
          class="button_text inline-block bg-amber-600 text-white px-6 py-3 rounded hover:bg-amber-700 transition-colors"
        >
          {{ section.settings.button_text }}
        </a>
      </div>
    </div>
  </div>
</div>
