{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'size-guide.css' | asset_url | stylesheet_tag }}

<div class="page-width page-width--narrow size-guide-container section-{{ section.id }}-padding flex flex-col items-center">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'text' %}
        <div class="size-guide-intro text-center mb-10" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h1 class="text-3xl font-bold text-center mb-8">{{ block.settings.heading }}</h1>
          {% endif %}

          {% if block.settings.subheading != blank %}
            <div class="text-xl mb-2">{{ block.settings.subheading }}</div>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="rte">{{ block.settings.text }}</div>
          {% endif %}
        </div>

      {% when 'measurement_guide' %}
        <div class="measurement-guide w-full md:max-w-3xl mb-10" {{ block.shopify_attributes }}>
          <h3 class="text-xl text-left mb-4">{{ block.settings.heading }}</h3>

          <div class="measurement-content flex flex-row items-center gap-8">
            <div class="measurement-instructions flex-1">
              {% if block.settings.instructions != blank %}
                <div class="rte">{{ block.settings.instructions }}</div>
              {% endif %}
            </div>

            {% if block.settings.figure_image != blank %}
              <div class="measurement-figure flex-1 text-center flex items-center justify-center">
                <img
                  src="{{ block.settings.figure_image }}"
                  alt="{{ block.settings.heading }}"
                  class="max-w-full h-auto"
                >
              </div>
            {% else %}
              {% render 'measure-figure-block', figure_type: block.settings.figure_type %}
            {% endif %}
          </div>
        </div>

      {% when 'size_table' %}
        <div class="size-table-wrapper mb-12 w-full md:max-w-3xl" {{ block.shopify_attributes }}>
          <h2 class="text-xl text-center font-bold mb-4">{{ block.settings.heading }}</h2>

          {% render 'size-guide-table', table_type: block.settings.table_type %}

          {% if block.settings.description != blank %}
            <div class="size-table-description mt-4 text-sm text-gray-600">
              {{ block.settings.description }}
            </div>
          {% endif %}
        </div>
    {% endcase %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Size Guide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Size Guide",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "default": "Find your perfect fit",
          "label": "Subheading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Use the tables below to find your size.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "measurement_guide",
      "name": "Measurement Guide",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "How to Measure your Body?",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "instructions",
          "default": "<ol><li>CHEST</li><li>WAIST</li><li>HIP</li><li>HEIGHT</li><li>INSEAM LENGTH</li></ol>",
          "label": "Instructions"
        },
        {
          "type": "select",
          "id": "figure_type",
          "options": [
            {
              "value": "man",
              "label": "Man"
            },
            {
              "value": "woman",
              "label": "Woman"
            },
            {
              "value": "foot",
              "label": "Foot"
            }
          ],
          "default": "man",
          "label": "Figure Type"
        },
        {
          "type": "url",
          "id": "figure_image",
          "label": "Figure Image URL",
          "info": "Optional: Use custom image URL instead of default figure"
        }
      ]
    },
    {
      "type": "size_table",
      "name": "Size Table",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Size Table",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "table_type",
          "options": [
            {
              "value": "men_clothing",
              "label": "Men's Clothing"
            },
            {
              "value": "women_clothing",
              "label": "Women's Clothing"
            },
            {
              "value": "men_footwear",
              "label": "Men's Footwear"
            },
            {
              "value": "women_footwear",
              "label": "Women's Footwear"
            }
          ],
          "default": "men_clothing",
          "label": "Table Type"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "info": "Optional description text below the table"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size Guide",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "measurement_guide"
        },
        {
          "type": "size_table",
          "settings": {
            "heading": "Men's Clothing",
            "table_type": "men_clothing"
          }
        },
        {
          "type": "size_table",
          "settings": {
            "heading": "Women's Clothing",
            "table_type": "women_clothing"
          }
        }
      ]
    }
  ]
}
{% endschema %}
