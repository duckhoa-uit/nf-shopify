 ════════════════════════════════════════ */
 #nfhp ._nfhp_s3 {
 background: #ffffff;
 padding-top: 40px;
 padding-bottom: 40px;
 }
 #nfhp ._nfhp_s3-title {
 font-size: 32px;
 font-weight: 900;
 color: #000000;
 text-transform: uppercase;
 letter-spacing: 0.02em;
 padding-inline: 24px;
 margin-bottom: 30px;
 text-align: center;
 }
 /* Horizontálne scrollovateľný rad kariet */
 #nfhp ._nfhp_s3-scroll {
 display: flex;
 gap: 25px;
 overflow-x: auto;
 scroll-snap-type: x mandatory;
 -webkit-overflow-scrolling: touch;
 padding-left: 24px;
 padding-right: 20px;
 padding-bottom: 15px;
 scroll-padding-left: 24px;
 /* Skryť scrollbar */
 scrollbar-width: none;
 }
 #nfhp ._nfhp_s3-scroll::-webkit-scrollbar {
 display: none;
 }
 #nfhp ._nfhp_s3-spacer {
 flex-shrink: 0;
 width: 20px;
 }
 /* Karta kolekcie */
 #nfhp ._nfhp_s3-card {
 position: relative;
 flex: 0 0 calc(100vw - 60px);
 max-width: 320px;
 height: 220px;
 border-radius: 14px;
 overflow: hidden;
 scroll-snap-align: start;
 cursor: pointer;
 background: #1a1a1a;
 text-decoration: none !important;
 }
 #nfhp ._nfhp_s3-card-img {
 position: absolute;
 inset: 0;
 width: 100%;
 height: 100%;
 object-fit: cover;
 object-position: center;
 transition: transform 0.4s ease;
 }
 #nfhp ._nfhp_s3-card:active ._nfhp_s3-card-img {
 transform: scale(1.04);
 }
 /* Gradient overlay */
 #nfhp ._nfhp_s3-card-overlay {
 position: absolute;
 inset: 0;
 background: linear-gradient(
 to top,
 rgba(0, 0, 0, 0.72) 0%,
 rgba(0, 0, 0, 0.15) 55%,
 rgba(0, 0, 0, 0.00) 100%
 );
 }
 /* NF logo — pravý horný roh */
 #nfhp ._nfhp_s3-nflogo {
 position: absolute;
 top: 12px;
 right: 12px;
 width: 32px;
 height: 32px;
 background: rgba(255, 255, 255, 0.22);
 backdrop-filter: blur(6px);
 -webkit-backdrop-filter: blur(6px);
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 }
 #nfhp ._nfhp_s3-nflogo svg {
 width: 18px;
 height: 18px;
 }
 /* Nadpis karty */
 #nfhp ._nfhp_s3-card-title {
 position: absolute;
 bottom: 24px;
 left: 0;
 right: 0;
 text-align: center;
 font-size: 14px;
 font-weight: 900;
 color: #ffffff;
 text-transform: uppercase;
 letter-spacing: 0.06em;
 line-height: 1.25;
 padding-inline: 12px;
 }
 /* Scroll indikátor (bodky) */
 #nfhp ._nfhp_s3-dots {
 display: flex;
 justify-content: center;
 gap: 6px;
 margin-top: 14px;
 padding-inline: 20px;
 }
 #nfhp ._nfhp_s3-dot {
 height: 3px;
 border-radius: 2px;
 background: #d0d0d0;
 transition: all 0.25s ease;
 }
 #nfhp ._nfhp_s3-dot._nfhp_s3-dot-active {
 background: #000000;
 width: 20px !important;
 }
 /* ════════════════════
 TABLET — 600px+
 ════════════════════ */
 @media (min-width: 600px) {
 #nfhp ._nfhp_s3 {
 padding: 60px 0;
 }
 #nfhp ._nfhp_s3-title {
 font-size: 40px;
 }
 /* Na tablete karta zaberá ~45vw — vidieť 2 karty + peek 3. */
 #nfhp ._nfhp_s3-card {
 flex: 0 0 calc(50vw - 28px);
 max-width: 380px;
 height: 260px;
 }
 }
 /* ════════════════════
 DESKTOP — 1024px+
 ════════════════════ */
 @media (min-width: 1024px) {
 #nfhp ._nfhp_s3 {
 padding: 80px 0;
 max-width: 1280px;
 margin-inline: auto;
 }
 #nfhp ._nfhp_s3-title {
 font-size: 48px;
 padding-inline: 80px;
 margin-bottom: 40px;
 }
 /* Grid — 3 karty vedľa seba, žiadny scroll */
 #nfhp ._nfhp_s3-scroll {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 overflow-x: visible;
 padding-left: 40px;
 padding-right: 40px;
 scroll-snap-type: none;
 gap: 20px;
 }
 #nfhp ._nfhp_s3-card {
 flex: unset;
 width: 100%;
 max-width: none;
 height: 320px;
 }
 /* Skryť scroll indikátor na desktope */
 #nfhp ._nfhp_s3-dots {
 display: none;
 }
 /* Hover efekty na kartách */
 #nfhp ._nfhp_s3-card {
 transition: transform 0.35s ease, box-shadow 0.35s ease;
 }
 #nfhp ._nfhp_s3-card:hover {
 transform: translateY(-6px);
 box-shadow: 0 20px 48px rgba(0, 0, 0, 0.22);
 }
 #nfhp ._nfhp_s3-card:hover ._nfhp_s3-card-img {
 transform: scale(1.06);
 }
 #nfhp ._nfhp_s3-card:hover ._nfhp_s3-card-overlay {
 background: linear-gradient(
 to top,
 rgba(0, 0, 0, 0.80) 0%,
 rgba(0, 0, 0, 0.25) 55%,
 rgba(0, 0, 0, 0.05) 100%
 );
 }
 #nfhp ._nfhp_s3-card:hover ._nfhp_s3-card-title {
 letter-spacing: 0.10em;
 transition: letter-spacing 0.35s ease;
 }
 }
 </style>
</head>
