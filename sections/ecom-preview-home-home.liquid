<script>
 (function () {
 var scroll = document.getElementById('nfhp_s3_scroll');
 var dots = document.getElementById('nfhp_s3_dots').children;
 if (!scroll) return;
 scroll.addEventListener('scroll', function () {
 var cards = scroll.querySelectorAll('._nfhp_s3-card');
 var cardWidth = cards[0].offsetWidth + 25; // šírka + gap
 var idx = Math.round(scroll.scrollLeft / cardWidth);
 for (var i = 0; i < dots.length; i++) {
 dots[i].classList.remove('_nfhp_s3-dot-active');
 dots[i].style.width = '8px';
 }
 if (dots[idx]) {
 dots[idx].classList.add('_nfhp_s3-dot-active');
 dots[idx].style.width = '20px';
 }
 });
 })();
</script>
