.nfbf ._filterstoggle{flex:none;display:inline-flex;align-items:center;gap:8px;min-height:42px;border:1px solid #E5E7EB;border-radius:999px;padding:0 18px;font-size:12.5px;font-weight:700;color:#15181C;background:#fff;cursor:pointer}
