.nfbf ._sizeblock{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-left:0}
.nfbf ._sizelabel{font-size:11px;font-weight:700;color:#5B6472;letter-spacing:.06em;text-transform:uppercase;margin-left:4px}
.nfbf ._activerow{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:16px}
@media(min-width:768px){
