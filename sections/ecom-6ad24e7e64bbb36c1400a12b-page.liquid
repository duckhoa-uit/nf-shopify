(function(){
 var PAGE_SIZE = 12;
 var grid = document.getElementById('bfGrid');
 var loadMoreBtn = document.getElementById('bfLoadMore');
 var gateWrap = document.getElementById('bfGateWrap');
 var PHASE = 'F2';
 var state = { series:'all', gender:'all', minDiscount:0, lastChance:false, sort:'rec', visible:PAGE_SIZE };
 function isMember(){ try{ return localStorage.getItem('nfMember')==='1'; }catch(e){ return false; } }
 function money(v){ if(v==null) return '—'; return v.toFixed(2).replace('.',',')+'&nbsp;€'; }
 function tr(key, vars){ return (window.nfwlT ? window.nfwlT(key, vars) : key); }
 function couponRow(p){
 return '<div class="_cf _cfcoupon"><span class="_old">'+money(p.price)+'</span>' +
 '<span class="_pr _prbig" style="color:#C4151C">'+money(p.final)+'</span>' +
 '<span class="_coupontag">'+tr('card.with_coupon')+'</span></div>';
 }
 function cardHTML(p){
 var badge='', priceHtml='';
 if(p.mode === 'direct'){
 badge = '<span class="_rk direct">'+tr('card.direct_badge',{pct:p.pct, price:money(p.price)})+'</span>';
 priceHtml = '<div class="_cf"><span class="_old">'+money(p.strike)+'</span><span class="_pr" style="color:#C4151C">'+money(p.price)+'</span></div>';
 } else if(p.mode === 'coupon'){
 badge = '<span class="_rk coupon">'+tr('card.coupon_badge',{pct:p.pct})+'</span>';
 priceHtml = couponRow(p);
 } else {
 badge = '<span class="_rk members">'+tr('card.members_badge',{pct:p.pct})+'</span>';
 if(isMember()){
 priceHtml = couponRow(p);
 } else {
 priceHtml = '<div class="_memberlock" data-lock="1">'+tr('card.member_lock')+'</div>';
 }
 }
 return '<article class="_card" data-id="'+p.id+'" data-series="'+p.series+'" data-gender="'+p.gender+'" data-pct="'+p.pct+'" data-lc="'+(p.last_chance?'1':'0')+'" data-price="'+p.price+'">' +
 '<div class="_im">'+badge+'</div>' +
 '<h3 class="_ct">'+p.name+'</h3>' + priceHtml +
 '<a class="_learnmore" href="#">'+tr('card.learn_more')+'</a>' +
 '</article>';
 }
 function phasePool(){
 if(PHASE === 'F2'){
 return window.BF_PRODUCTS.filter(function(p){ return p.flow==='PEAK' || p.is_ecom; });
 }
 return window.BF_PRODUCTS;
 }
 function renderCards(){
 var list = phasePool();
 grid.innerHTML = list.map(cardHTML).join('');
 grid.querySelectorAll('[data-lock="1"]').forEach(function(el){
 el.addEventListener('click', function(){
 document.getElementById('bfLoginBtn') && document.getElementById('bfLoginBtn').scrollIntoView({behavior:'smooth', block:'center'});
 });
 });
 state.visible = PAGE_SIZE;
 applyFilter();
 }
 renderCards();
 document.addEventListener('nfMemberChange', function(){
 renderCards();
 updateGate();
 });
 document.addEventListener('nfwlLocaleChange', renderCards);
 function updateGate(){
 if(!gateWrap) return;
 var locked = PHASE === 'F2' && !isMember();
 gateWrap.classList.toggle('_gated', locked);
 var overlay = document.getElementById('bfGateOverlay');
 if(overlay) overlay.hidden = !locked;
 }
 updateGate();
 var seriesSel = document.getElementById('bfSeries');
 if(seriesSel) seriesSel.addEventListener('change', function(){ state.series = this.value; state.visible = PAGE_SIZE; applyFilter(); });
 var genderRow = document.getElementById('bfGender');
 if(genderRow) genderRow.addEventListener('click', function(e){
 var btn = e.target.closest('[data-v]'); if(!btn) return;
 this.querySelectorAll('[data-active]').forEach(function(b){ b.removeAttribute('data-active'); });
 btn.setAttribute('data-active','true'); state.gender = btn.getAttribute('data-v');
 state.visible = PAGE_SIZE; applyFilter();
 });
 var discountSel = document.getElementById('bfDiscount');
 if(discountSel) discountSel.addEventListener('change', function(){ state.minDiscount = this.value; state.visible = PAGE_SIZE; applyFilter(); });
 var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 var filterPanel = document.getElementById('bfFilterPanel');
 function resizeFilterPanel(){
 if(!filterPanel || filterPanel.style.maxHeight === '0px' || filterPanel.style.maxHeight === '') return;
 filterPanel.style.maxHeight = reduceMotion ? 'none' : filterPanel.scrollHeight + 'px';
 }
 var lastBtn = document.getElementById('bfLast');
 if(lastBtn) lastBtn.addEventListener('click', function(){
 state.lastChance = this.getAttribute('data-active') !== 'true';
 this.setAttribute('data-active', state.lastChance ? 'true' : 'false');
 var sw = document.getElementById('bfSizeWrap');
 if(sw) sw.classList.toggle('show', state.lastChance);
 resizeFilterPanel();
 state.visible = PAGE_SIZE; applyFilter();
 });
 var sortSel = document.getElementById('bfSort');
 if(sortSel) sortSel.addEventListener('change', function(){ state.sort = this.value; applySort(); });
 if(loadMoreBtn) loadMoreBtn.addEventListener('click', function(){ state.visible += PAGE_SIZE; applyFilter(); });
 var filterToggle = document.getElementById('bfFiltersToggle');
 if(filterToggle && filterPanel) filterToggle.addEventListener('click', function(){
 var open = filterToggle.getAttribute('aria-expanded') === 'true';
 filterToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
 if(reduceMotion){ filterPanel.style.maxHeight = open ? '0' : 'none'; return; }
 filterPanel.style.maxHeight = open ? '0' : filterPanel.scrollHeight + 'px';
 });
 function updateFilterBadge(){
 var badge = document.getElementById('bfFilterBadge');
 if(!badge) return;
 var n = (state.series!=='all'?1:0) + (Number(state.minDiscount)>0?1:0) + (state.lastChance?1:0);
 badge.textContent = n; badge.hidden = n === 0;
 }
 function applyFilter(){
 var minD = Number(state.minDiscount)||0;
 var matched = [];
 grid.querySelectorAll('._card').forEach(function(card){
 var okS = state.series==='all' || card.dataset.series===state.series;
 var okG = state.gender==='all' || card.dataset.gender===state.gender || card.dataset.gender==='unisex';
 var okD = Number(card.dataset.pct) >= minD;
 var okL = !state.lastChance || card.dataset.lc === '1';
 if(okS && okG && okD && okL){ matched.push(card); } else { card.style.display='none'; }
 });
 matched.forEach(function(card,i){ card.style.display = i < state.visible ? '' : 'none'; });
 if(loadMoreBtn) loadMoreBtn.hidden = matched.length <= state.visible;
 updateFilterBadge();
 var countEl = document.getElementById('bfResultCount');
 if(countEl) countEl.textContent = tr('filters.showing', {shown: Math.min(state.visible, matched.length), total: matched.length});
 }
 function applySort(){
 var cards = Array.from(grid.querySelectorAll('._card'));
 var cmp = {
 rec: function(){ return 0; },
 price_asc: function(a,b){ return Number(a.dataset.price)-Number(b.dataset.price); },
 price_desc: function(a,b){ return Number(b.dataset.price)-Number(a.dataset.price); },
 discount: function(a,b){ return Number(b.dataset.pct)-Number(a.dataset.pct); }
 }[state.sort];
 if(state.sort !== 'rec') cards.sort(cmp);
 cards.forEach(function(c){ grid.appendChild(c); });
 }
})();
</script>
