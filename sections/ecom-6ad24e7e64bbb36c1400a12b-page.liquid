.nfbf ._seg{flex:1;justify-content:center;text-align:center;font-size:13.5px;min-height:36px}
.nfbf ._segmented{min-height:42px}
.nfbf ._dropwrap{flex:1 1 calc(50% - 5px);min-width:0}
.nfbf ._dropdown{width:100%;min-height:42px;font-size:13.5px}
.nfbf ._lastchance{width:100%;min-height:42px;font-size:13px}
.nfbf ._meta{justify-content:space-between;gap:10px}
.nfbf ._resultcount{display:none}
.nfbf ._meta{justify-content:flex-end}
.nfbf ._meta ._dropdown{width:auto;padding-right:28px}
.nfbf ._meta ._dropdown{width:100%}
}
/* ---- mobile: bump up base copy sizes a touch for readability ---- */
@media(max-width:767px){
.nfbf ._sub{font-size:15px}
.nfbf ._bcard h3{font-size:15.5px}
.nfbf ._bcard p{font-size:14px}
.nfbf ._logincopy h3{font-size:20px}
.nfbf ._logincopy p{font-size:14.5px}
.nfbf ._ct{font-size:14px}
.nfbf ._pr{font-size:16px}
.nfbf ._old{font-size:13px}
.nfbf ._coupontag{font-size:10px}
.nfbf ._rk{font-size:11.5px}
.nfbf ._loadmore{font-size:14px}
.nfbf ._faqq{font-size:15.5px}
.nfbf ._faqpanel p{font-size:14.5px}
.nfbf ._lbl{font-size:12px}
.nfbf ._mobhide{display:none}
}
/* ---- grid / cards ---- */
.nfbf ._grid12{display:grid;grid-template-columns:repeat(4,1fr);gap:28px 20px}
.nfbf ._card{display:flex;flex-direction:column;min-width:0}
.nfbf ._im{display:flex;align-items:flex-end;position:relative;border-radius:2px;aspect-ratio:3/4;background:linear-gradient(135deg,#F1F2F4,#E2E4E8);overflow:hidden;padding:10px}
.nfbf ._rk{display:inline-flex;align-items:center;padding:6px 10px;border-radius:2px;font-size:10.5px;font-weight:800;letter-spacing:.03em;text-transform:uppercase;color:#fff}
.nfbf ._rk.direct{background:#C4151C}
.nfbf ._rk.coupon{background:#111111}
.nfbf ._rk.members{background:#1D7A42}
.nfbf ._ct{margin-top:14px;font-size:13px;font-weight:800;text-transform:uppercase}
.nfbf ._cf{margin-top:6px;display:flex;align-items:baseline;gap:7px;flex-wrap:wrap}
.nfbf ._pr{font-size:15px;font-weight:800;color:#15181C}
.nfbf ._old{font-size:12px;color:#5B6472;text-decoration:line-through}
.nfbf ._prbig{font-size:17px}
.nfbf ._coupontag{font-size:10px;font-weight:600;color:#5B6472;text-transform:none;letter-spacing:0}
.nfbf ._memberlock{margin-top:8px;font-size:12.5px;font-weight:700;color:#15181C;border-bottom:1px solid #E5E7EB;width:fit-content;cursor:pointer}
.nfbf ._learnmore{display:inline-flex;margin-top:9px;padding-bottom:2px;font-size:12px;font-weight:700;color:#15181C;border-bottom:1px solid #E5E7EB;width:fit-content}
@media(max-width:1023px){.nfbf ._grid12{grid-template-columns:repeat(3,1fr)}}
@media(max-width:767px){.nfbf ._grid12{grid-template-columns:repeat(2,1fr);gap:20px 12px}}
.nfbf ._loadmorewrap{display:flex;justify-content:center;margin-top:36px}
.nfbf ._loadmore{border:1px solid #E5E7EB;border-radius:2px;padding:14px 32px;min-height:48px;font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:#15181C;background:transparent;transition:background .15s,color .15s}
@media(hover:hover){.nfbf ._loadmore:hover{background:#15181C;color:#fff}}
/* ---- F2 gate overlay ---- */
.nfbf ._gatewrap{position:relative}
.nfbf ._gateoverlay{position:absolute;inset:0;background:rgba(255,255,255,.88);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;text-align:center;flex-direction:column;gap:14px;z-index:5;padding:24px}
.nfbf ._gateoverlay h3{font-family:'Archivo',Helvetica,Arial,sans-serif;font-size:18px;font-weight:800;text-transform:uppercase}
.nfbf ._gateoverlay p{font-size:13px;color:#5B6472;max-width:40ch}
.nfbf ._gated ._grid12{filter:blur(6px);pointer-events:none;user-select:none}
/* ---- benefit cards (F1) ---- */
.nfbf ._benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin-top:28px}
.nfbf ._bcard{padding:0;display:flex;flex-direction:column;align-items:center}
.nfbf ._bicon{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:#C4151C;color:#fff;margin-bottom:16px}
.nfbf ._bicon svg{width:20px;height:20px}
.nfbf ._bcard h3{font-family:'Archivo',Helvetica,Arial,sans-serif;font-size:14.5px;font-weight:800;text-transform:uppercase;margin-bottom:6px}
.nfbf ._bcard p{font-size:13px;color:#5B6472;line-height:1.5}
@media(max-width:900px){.nfbf ._benefits{grid-template-columns:1fr;gap:28px}}
/* ---- FAQ ---- */
.nfbf ._faqwrap{max-width:680px;margin:0 auto}
.nfbf ._faqwrap h2{font-family:'Archivo',Helvetica,Arial,sans-serif;font-size:clamp(20px,2.4vw,28px);font-weight:800;text-transform:uppercase;margin-bottom:16px;text-align:center}
.nfbf ._faqrow{border-bottom:1px solid #E5E7EB}
.nfbf ._faqq{width:100%;padding:16px 0;font-size:14.5px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;text-align:left}
.nfbf ._faqx{font-size:18px;color:#5B6472;flex:none;transition:transform .25s ease}
.nfbf ._faqrow[data-open="true"] ._faqx{transform:rotate(45deg)}
.nfbf ._faqpanel{max-height:0;overflow:hidden;transition:max-height .3s ease}
.nfbf ._faqpanel p{padding-bottom:16px;font-size:13.5px;color:#5B6472;line-height:1.55}
