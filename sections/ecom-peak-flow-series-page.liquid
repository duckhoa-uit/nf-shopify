logs/vijesti/funkcionalni-materijali-pertex-koji-se-lako-pakira","sl":"/sl/blogs/novice/sl-pertex-quantum-lahka-prepustna-in-vzdrzljiva-tkanina-ki-poma","bg":"/blogs/novini/funktsionalni-materiali-lesno-opakovasht-se-pertex"},"logo":"peakflow-logo3-pertex.png"},{"name":"Dermizax™ EV","text":{"sk":"Prémiová nepremokavá membrána s vysokou priedušnosťou a pružnosťou. Maximálna ochrana bez obmedzenia pohybu.","en":"A premium waterproof membrane with high breathability and stretch. Maximum protection without restricting movement.","de":"Premium-Wasserdichtmembran mit hoher Atmungsaktivität und Elastizität. Maximaler Schutz ohne Einschränkung der Bewegung.","hr":"Vrhunska vodootporna membrana visoke prozračnosti i elastičnosti. Maksimalna zaštita bez ograničavanja pokreta.","sl":"Vrhunska nepremočljiva membrana z visoko zračnostjo in elastičnostjo. Največja zaščita brez omejevanja gibanja.","bg":"Първокласна водонепромокаема мембрана с висока дишаемост и еластичност. Максимална защита без ограничаване на движението."},"url":{"sk":"/blogs/novinky/sk-premium-funkcionalne-materialy","en":"/blogs/news/en-premium-functional-materials","de":"/de/blogs/nachrichten/hochwertige-funktionsmaterialien","hr":"/hr/blogs/vijesti/vrhunski-funkcionalni-materijali","sl":"/sl/blogs/novice","bg":"/blogs/novini/visokokachestveni-funktsionalni-materiali"},"logo":"peakflow-logo3-dermizax.png"}],"terrains":[{"name":{"sk":"Vysokohorská turistika","en":"High-mountain hiking","de":"Hochgebirgs­wandern","hr":"Visokogorsko planinarenje","sl":"Visokogorsko pohodništvo","bg":"Високопланински туризъм"},"img":"peakflow-teren6-turistika.jpg","alt":{"sk":"Turistka na skalnatom hrebeni v horách","en":"A hiker on a rocky mountain ridge","de":"Wanderin auf einem felsigen Bergkamm","hr":"Planinarka na stjenovitom planinskom grebenu","sl":"Pohodnica na skalnatem gorskem grebenu","bg":"Туристка на скалисто планинско било"},"url":"collections/peak-flow-series?filter.p.m.custom_features.activities=gid%3A%2F%2Fshopify%2FMetaobject%2F2713204982092"},{"name":{"sk":"Skialpinizmus","en":"Ski touring","de":"Skitouren","hr":"Turno skijanje","sl":"Turno smučanje","bg":"Ски туринг"},"img":"peakflow-teren7-skialp.jpg","alt":{"sk":"Dvojica skialpinistov pri výstupe nad dolinou","en":"Two ski tourers climbing above the valley","de":"Zwei Skitourengeher im Aufstieg über dem Tal","hr":"Dvoje turnih skijaša u usponu iznad doline","sl":"Turna smučarja med vzponom nad dolino","bg":"Двама ски туристи изкачват над долината"},"url":"collections/peak-flow-series?filter.p.m.custom_features.activities=gid%3A%2F%2Fshopify%2FMetaobject%2F2713204883788"},{"name":{"sk":"Lyžovanie a freeride","en":"Skiing & freeride","de":"Skifahren & Freeride","hr":"Skijanje i freeride","sl":"Smučanje in freeride","bg":"Ски и фрийрайд"},"img":"peakflow-teren6-lyzovanie.jpg","alt":{"sk":"Lyžiarka v bielej súprave pri zjazde","en":"A skier in a white outfit carving downhill","de":"Skifahrerin in weißem Outfit bei der Abfahrt","hr":"Skijašica u bijelom kompletu u spustu","sl":"Smučarka v belem kompletu med spustom","bg":"Скиорка в бял екип при спускане"},"url":"collections/peak-flow-series?filter.p.m.custom_features.activities=gid%3A%2F%2Fshopify%2FMetaobject%2F2713205211468"},{"name":{"sk":"Outdoor","en":"Outdoor","de":"Outdoor","hr":"Outdoor","sl":"Outdoor","bg":"Outdoor"},"img":"peakflow-teren6-outdoor.jpg","alt":{"sk":"Muž s čelovkou v noci v horách","en":"A man with a headlamp in the mountains at night","de":"Mann mit Stirnlampe nachts in den Bergen","hr":"Muškarac s čeonom svjetiljkom noću u planini","sl":"Moški s čelno svetilko ponoči v gorah","bg":"Мъж с челник нощем в планината"},"url":"collections/peak-flow-series?filter.p.m.custom_features.activities=gid%3A%2F%2Fshopify%2FMetaobject%2F2713204916556"}],"layers":[{"m":[1,5,1],"sk":{"short":"Základná","name":"Základná vrstva","text":"Odvádza pot od tela a drží ho v suchu. Vrstva, ktorú pri výstupe nevyzliekaš.","tech":"Dri-release® · Polartec®","when":"Vždy, priamo na telo. Celý deň od výstupu po zjazd."},"en":{"short":"Base","name":"Base layer","text":"Wicks sweat away from your body and keeps you dry. The layer you never take off on the climb.","tech":"Dri-release® · Polartec®","when":"Always, next to the skin. All day, from ascent to descent."},"de":{"short":"Basis","name":"Basisschicht","text":"Leitet Schweiß vom Körper ab und hält trocken. Die Schicht, die du im Aufstieg nie ausziehst.","tech":"Dri-release® · Polartec®","when":"Immer, direkt auf der Haut. Den ganzen Tag, vom Aufstieg bis zur Abfahrt."},"hr":{"short":"Osnovni","name":"Osnovni sloj","text":"Odvodi znoj s tijela i održava ga suhim. Sloj koji na usponu ne skidaš.","tech":"Dri-release® · Polartec®","when":"Uvijek, izravno na tijelo. Cijeli dan, od uspona do spusta."},"sl":{"short":"Osnovna","name":"Osnovna plast","text":"Odvaja pot s telesa in ga ohranja suhega. Plast, ki je med vzponom ne slečeš.","tech":"Dri-release® · Polartec®","when":"Vedno, neposredno na telo. Ves dan, od vzpona do spusta."},"bg":{"short":"Базов","name":"Базов слой","text":"Отвежда потта от тялото и го държи сухо. Слоят, който не сваляш при изкачване.","tech":"Dri-release® · Polartec®","when":"Винаги, директно върху тялото. Цял ден, от изкачването до спускането."}},{"m":[3,4,1],"sk":{"short":"Stredná","name":"Stredná vrstva","text":"Mikiny a vesty, ktoré hrejú a dýchajú. Pridáš ju na hrebeni alebo počas prestávky.","tech":"Polartec®","when":"Na hrebeni, vo vetre alebo pri prestávke."},"en":{"short":"Mid","name":"Mid layer","text":"Fleeces and vests that keep you warm and breathe. Add it on the ridge or during a break.","tech":"Polartec®","when":"On the ridge, in the wind or during a break."},"de":{"short":"Mittel","name":"Mittelschicht","text":"Pullover und Westen, die wärmen und atmen. Ziehst du am Grat oder in der Pause an.","tech":"Polartec®","when":"Am Grat, im Wind oder in der Pause."},"hr":{"short":"Srednji","name":"Srednji sloj","text":"Majice i prsluci koji griju i dišu. Dodaš ga na grebenu ili tijekom pauze.","tech":"Polartec®","when":"Na grebenu, na vjetru ili tijekom pauze."},"sl":{"short":"Srednja","name":"Srednja plast","text":"Puloverji in telovniki, ki grejejo in dihajo. Dodaš jo na grebenu ali med postankom.","tech":"Polartec®","when":"Na grebenu, v vetru ali med postankom."},"bg":{"short":"Среден","name":"Среден слой","text":"Суитшърти и елеци, които топлят и дишат. Добавяш го на билото или при почивка.","tech":"Polartec®","when":"На билото, при вятър или по време на почивка."}},{"m":[3,4,2],"sk":{"short":"Hybridná","name":"Hybridná vrstva","text":"Zateplený trup, pružné a priedušné boky. Na rýchle výstupy, keď sa hýbeš naplno.","tech":"Polartec® Alpha®","when":"Rýchly výstup v mraze, keď sa hýbeš naplno."},"en":{"short":"Hybrid","name":"Hybrid layer","text":"An insulated body with stretchy, breathable sides. For fast climbs when you’re moving hard.","tech":"Polartec® Alpha®","when":"A fast climb in the cold, when you’re moving hard."},"de":{"short":"Hybrid","name":"Hybridschicht","text":"Isolierter Rumpf, elastische und atmungsaktive Seiten. Für schnelle Aufstiege mit vollem Einsatz.","tech":"Polartec® Alpha®","when":"Schneller Aufstieg bei Frost, mit vollem Einsatz."},"hr":{"short":"Hibridni","name":"Hibridni sloj","text":"Izolirani trup, elastični i prozračni bokovi. Za brze uspone kad se krećeš punim gasom.","tech":"Polartec® Alpha®","when":"Brzi uspon na hladnoći, kad se krećeš punim gasom."},"sl":{"short":"Hibridna","name":"Hibridna plast","text":"Izoliran trup, raztegljivi in zračni boki. Za hitre vzpone, ko se giblješ s polno močjo.","tech":"Polartec® Alpha®","when":"Hiter vzpon v mrazu, ko se giblješ s polno močjo."},"bg":{"short":"Хибриден","name":"Хибриден слой","text":"Изолиран торс, еластични и дишащи страни. За бързи изкачвания, когато се движиш на пълни обороти.","tech":"Polartec® Alpha®","when":"Бързо изкачване в студа, на пълни обороти."}},{"m":[5,2,4],"sk":{"short":"Outer","name":"Outer layer","text":"Zateplená vonkajšia vrstva s PrimaLoft® alebo membránou na zjazd a mrazivé dni.","tech":"PrimaLoft® · Dermizax™EV","when":"Zjazd, lanovka a mrazivé dni bez veľkej námahy."},"en":{"short":"Outer","name":"Outer layer","text":"An insulated outer layer with PrimaLoft® or a membrane for descents and freezing days.","tech":"PrimaLoft® · Dermizax™EV","when":"Descents, chairlifts and freezing days with little exertion."},"de":{"short":"Außen","name":"Außenschicht","text":"Isolierte Außenschicht mit PrimaLoft® oder Membran für Abfahrten und frostige Tage.","tech":"PrimaLoft® · Dermizax™EV","when":"Abfahrt, Lift und frostige Tage ohne große Anstrengung."},"hr":{"short":"Vanjski","name":"Vanjski sloj","text":"Izolirani vanjski sloj s PrimaLoft® ili membranom za spust i ledene dane.","tech":"PrimaLoft® · Dermizax™EV","when":"Spust, žičara i ledeni dani bez velikog napora."},"sl":{"short":"Zunanja","name":"Zunanja plast","text":"Izolirana zunanja plast s PrimaLoft® ali membrano za spust in ledene dni.","tech":"PrimaLoft® · Dermizax™EV","when":"Spust, žičnica in ledeni dnevi brez večjega napora."},"bg":{"short":"Външен","name":"Външен слой","text":"Изолиран външен слой с PrimaLoft® или мембрана за спускане и мразовити дни.","tech":"PrimaLoft® · Dermizax™EV","when":"Спускане, лифт и мразовити дни без голямо натоварване."}},{"m":[1,3,5],"sk":{"short":"Hardshell","name":"Hardshell","text":"Nepremokavá a nepriefúkavá škrupina Dermizax™EV proti vetru, snehu a búrke.","tech":"Dermizax™EV","when":"Sneženie, búrka a vietor na hrebeni."},"en":{"short":"Hardshell","name":"Hardshell","text":"A waterproof, windproof Dermizax™EV shell against wind, snow and storms.","tech":"Dermizax™EV","when":"Snowfall, storms and wind on the ridge."},"de":{"short":"Hardshell","name":"Hardshell","text":"Wasser- und winddichte Dermizax™EV Schale gegen Wind, Schnee und Sturm.","tech":"Dermizax™EV","when":"Schneefall, Sturm und Wind am Grat."},"hr":{"short":"Hardshell","name":"Hardshell","text":"Vodootporna i vjetrootporna Dermizax™EV ljuska protiv vjetra, snijega i oluje.","tech":"Dermizax™EV","when":"Snijeg, oluja i vjetar na grebenu."},"sl":{"short":"Hardshell","name":"Hardshell","text":"Nepremočljiva in neprepihna lupina Dermizax™EV proti vetru, snegu in nevihti.","tech":"Dermizax™EV","when":"Sneženje, nevihta in veter na grebenu."},"bg":{"short":"Хардшел","name":"Хардшел","text":"Водо- и ветроустойчива обвивка Dermizax™EV срещу вятър, сняг и буря.","tech":"Dermizax™EV","when":"Снеговалеж, буря и вятър на билото."}}],"looks":[{"id":"look-01","activity":"SKIALPINIZMUS","title":{"sk":"Rýchly výstup","en":"Fast ascent","de":"Schneller Aufstieg","hr":"Brzi uspon","sl":"Hiter vzpon","bg":"Бързо изкачване"},"text":{"sk":"Keď pri výstupe stúpa tepová frekvencia, rozhoduje správna termoregulácia. Rýchloschnúca základná vrstva, aktívna izolácia Polartec® Alpha® Direct a strategicky umiestnené vetruodolné panely vytvárajú funkčný systém pre intenzívny pohyb v horách.","en":"When your heart rate climbs on the ascent, the right thermoregulation makes the difference. A quick-drying base layer, active Polartec® Alpha® Direct insulation and strategically placed windproof panels form a functional system for intense movement in the mountains.","de":"Wenn beim Aufstieg der Puls steigt, entscheidet die richtige Thermoregulation. Eine schnell trocknende Basisschicht, aktive Polartec® Alpha® Direct Isolierung und gezielt platzierte winddichte Einsätze bilden ein funktionelles System für intensive Bewegung in den Bergen.","hr":"Kad ti pri usponu raste puls, presudna je pravilna termoregulacija. Brzosušeći bazni sloj, aktivna izolacija Polartec® Alpha® Direct i strateški postavljeni vjetrootporni paneli čine funkcionalan sustav za intenzivno kretanje u planinama.","sl":"Ko ti med vzponom raste srčni utrip, odloča prava termoregulacija. Hitro sušeča osnovna plast, aktivna izolacija Polartec® Alpha® Direct in strateško nameščeni vetrovzdržni paneli ustvarjajo funkcionalen sistem za intenzivno gibanje v gorah.","bg":"Когато пулсът се покачва при изкачване, решава правилната терморегулация. Бързосъхнещ базов слой, активна изолация Polartec® Alpha® Direct и стратегически разположени ветроустойчиви панели създават функционална система за интензивно движение в планината."},"img":"peakflow-look-01.jpg","alt":"Outfit Peak Flow: pánsky skialpový outfit s mikinou BUKOVEC a hybridnou bundou SOLISKO","items":[{"handle":"h31","label":"Mikina","x":52.72,"y":23.06,"alts":["h38","h32"],"code":337},{"handle":"h40","label":"Batoh","x":61.9,"y":26.25,"alts":["h41"],"code":363},{"handle":"h33","label":"Bunda","x":53.12,"y":36.77,"alts":["h30","h36"],"code":630},{"handle":"h34","label":"Nohavice","x":57.11,"y":52.15,"alts":["h35"],"code":319}],"g":"m"},{"id":"look-02","activity":"SKIALPINIZMUS","title":{"sk":"V tempe do kopca","en":"Pace uphill","de":"Im Tempo bergauf","hr":"U tempu uzbrdo","sl":"V tempu navkreber","bg":"С темпо нагоре"},"text":{"sk":"Pri intenzívnom výstupe je kľúčová rovnováha medzi tepelným komfortom a priedušnosťou. Rýchloschnúca funkčná vrstva, aktívna izolácia Polartec® Alpha® Direct a vetruodolné panely pomáhajú regulovať telesnú teplotu a odvádzať vlhkosť bez obmedzenia pohybu.","en":"On an intense ascent, the balance between warmth and breathability is key. A quick-drying functional layer, active Polartec® Alpha® Direct insulation and windproof panels help regulate body temperature and wick moisture without restricting movement.","de":"Beim intensiven Aufstieg ist die Balance zwischen Wärme und Atmungsaktivität entscheidend. Eine schnell trocknende Funktionsschicht, aktive Polartec® Alpha® Direct Isolierung und winddichte Einsätze helfen, die Körpertemperatur zu regulieren und Feuchtigkeit abzuleiten, ohne die Bewegung einzuschränken.","hr":"Pri intenzivnom usponu ključna je ravnoteža između toplinske udobnosti i prozračnosti. Brzosušeći funkcionalni sloj, aktivna izolacija Polartec® Alpha® Direct i vjetrootporni paneli pomažu regulirati tjelesnu temperaturu i odvoditi vlagu bez ograničavanja pokreta.","sl":"Pri intenzivnem vzponu je ključno ravnovesje med toplotnim udobjem in zračnostjo. Hitro sušeča funkcionalna plast, aktivna izolacija Polartec® Alpha® Direct in vetrovzdržni paneli pomagajo uravnavati telesno temperaturo in odvajati vlago brez omejevanja gibanja.","bg":"При интензивно изкачване ключов е балансът между топлинен комфорт и дишане. Бързосъхнещ функционален слой, активна изолация Polartec® Alpha® Direct и ветроустойчиви панели помагат да регулираш телесната температура и да отвеждаш влагата, без да ограничават движението."},"img":"peakflow-look-02.jpg","alt":"Outfit Peak Flow: dámsky skialpový outfit s bundou KRIZNA","items":[{"handle":"h18","label":"Mikina","x":37.05,"y":27.45,"alts":["h20","h28"],"code":632},{"handle":"h40","label":"Batoh","x":45.03,"y":25.32,"alts":["h41"],"code":268},{"handle":"h42","label":"Bunda","x":57.21,"y":33.77,"alts":["h21","h22"],"code":632},{"handle":"h43","label":"Nohavice","x":58.61,"y":55.68,"alts":["h27","h26"],"code":282}],"g":"z"},{"id":"look-03","activity":"SKIALPINIZMUS","title":{"sk":"Na vrchole","en":"At the summit","de":"Am Gipfel","hr":"Na vrhu","sl":"Na vrhu","bg":"На върха"},"text":{"sk":"Výstup je za tebou. Na hrebeni fúka, teplota klesá a pred zjazdom prichádza čas doplniť ďalšiu vrstvu. Funkčná kombinácia oblečenia s izoláciou PrimaLoft® GOLD Active a materiálom Pertex® Quantum pomáha udržať teplo, chráni pred vetrom a poskytuje komfort aj počas zastávok v mrazivých podmienkach.","en":"The climb is behind you. The wind blows on the ridge, the temperature drops and before the descent it is time to add another layer. A functional combination with PrimaLoft® GOLD Active insulation and Pertex® Quantum fabric helps keep you warm, protects from wind and provides comfort during stops in freezing conditions.","de":"Der Aufstieg liegt hinter dir. Am Grat weht der Wind, die Temperatur sinkt und vor der Abfahrt ist es Zeit für eine weitere Schicht. Die funktionelle Kombination mit PrimaLoft® GOLD Active Isolierung und Pertex® Quantum hält warm, schützt vor Wind und sorgt auch bei Pausen in eisiger Kälte für Komfort.","hr":"Uspon je iza tebe. Na grebenu puše, temperatura pada i prije spusta vrijeme je za još jedan sloj. Funkcionalna kombinacija s izolacijom PrimaLoft® GOLD Active i materijalom Pertex® Quantum pomaže zadržati toplinu, štiti od vjetra i pruža udobnost i tijekom zastoja na mrazu.","sl":"Vzpon je za tabo. Na grebenu piha, temperatura pada in pred spustom je čas za dodatno plast. Funkcionalna kombinacija z izolacijo PrimaLoft® GOLD Active in materialom Pertex® Quantum pomaga ohranjati toploto, ščiti pred vetrom in nudi udobje tudi med postanki v mrazu.","bg":"Изкачването е зад теб. На билото духа, температурата пада и преди спускането е време за още един слой. Функционалната комбинация с изолация PrimaLoft® GOLD Active и материя Pertex® Quantum задържа топлината, пази от вятъра и дава комфорт и при спиране в мразовити условия."},"img":"peakflow-look-03.jpg","alt":"Outfit Peak Flow: pánsky skialpový outfit so zateplenou bundou OHNISTE","items":[{"handle":"h31","label":"Mikina","x":52.22,"y":24.85,"alts":["h38","h32"],"code":433},{"handle":"h41","label":"Batoh","x":43.94,"y":27.32,"alts":["h40"],"code":269},{"handle":"h36","label":"Bunda","x":49.73,"y":39.17,"alts":["h33","h30"],"code":811},{"handle":"h34","label":"Nohavice","x":57.51,"y":57.21,"alts":["h35"],"code":281}],"g":"m"},{"id":"look-04","activity":"SKIALPINIZMUS","title":{"sk":"Keď pritúhne","en":"When it gets cold","de":"Wenn es kalt wird","hr":"Kad zahladi","sl":"Ko pritisne mraz","bg":"Когато застуди"},"text":{"sk":"Mrazivé ráno, vietor na hrebeni alebo prestávka pred zjazdom. V horách sa podmienky menia rýchlo a správne vrstvenie rozhoduje o tepelnom komforte. Kombinácia merino vlny, flísu a prémiovej izolácie PrimaLoft® GOLD Active pomáha udržať teplo, regulovať vlhkosť a chrániť pred chladom aj v náročných zimných podmienkach.","en":"A frosty morning, wind on the ridge or a break before the descent. Conditions in the mountains change quickly and the right layering decides your warmth. A combination of merino wool, fleece and premium PrimaLoft® GOLD Active insulation helps keep you warm, manage moisture and protect from cold even in tough winter conditions.","de":"Ein frostiger Morgen, Wind am Grat oder eine Pause vor der Abfahrt. In den Bergen ändern sich die Bedingungen schnell und das richtige Layering entscheidet über die Wärme. Die Kombination aus Merinowolle, Fleece und Premium-Isolierung PrimaLoft® GOLD Active hält warm, reguliert Feuchtigkeit und schützt auch unter harten Winterbedingungen vor Kälte.","hr":"Mrazno jutro, vjetar na grebenu ili pauza prije spusta. U planinama se uvjeti brzo mijenjaju, a pravilno slojevanje odlučuje o toplini. Kombinacija merino vune, flisa i vrhunske izolacije PrimaLoft® GOLD Active pomaže zadržati toplinu, regulirati vlagu i štititi od hladnoće i u zahtjevnim zimskim uvjetima.","sl":"Mrzlo jutro, veter na grebenu ali premor pred spustom. V gorah se razmere hitro spreminjajo in pravilno plastenje odloča o toplotnem udobju. Kombinacija merino volne, flisa in vrhunske izolacije PrimaLoft® GOLD Active pomaga ohranjati toploto, uravnavati vlago in ščititi pred mrazom tudi v zahtevnih zimskih razmerah.","bg":"Мразовита сутрин, вятър на билото или почивка преди спускането. В планината условията се менят бързо и правилното наслояване решава топлинния комфорт. Комбинацията от мерино вълна, полар и първокласна изолация PrimaLoft® GOLD Active задържа топлината, регулира влагата и пази от студ и в тежки зимни условия."},"img":"peakflow-look-04.jpg","alt":"Outfit Peak Flow: dámsky skialpový outfit s bundou OPALENA","items":[{"handle":"h20","label":"Mikina","x":56.51,"y":22.06,"alts":["h18","h28"],"code":482},{"handle":"h40","label":"Batoh","x":40.84,"y":34.84,"alts":["h41"],"code":268},{"handle":"h21","label":"Bunda","x":55.01,"y":41.5,"alts":["h42","h22"],"code":577},{"handle":"h27","label":"Nohavice","x":50.72,"y":52.62,"alts":["h43","h26"],"code":366}],"g":"z"},{"id":"look-05","activity":"SKIALPINIZMUS","title":{"sk":"Keď podmienky pritvrdia","en":"When conditions get tough","de":"Wenn es hart wird","hr":"Kad uvjeti otežaju","sl":"Ko razmere postanejo zahtevne","bg":"Когато условията загрубеят"},"text":{"sk":"Strmé stúpanie, vietor a sneh. Pri náročnom zimnom výstupe potrebuješ výbavu, ktorá ťa chráni pred počasím, ale zároveň zvláda vysokú intenzitu pohybu. Aktívna izolácia Polartec® Alpha® Direct, membránové panely a pružný Blizzard® Thermal Comfort vytvárajú funkčný systém, ktorý pomáha regulovať teplotu, odvádzať vlhkosť a zachovať voľnosť pohybu.","en":"A steep climb, wind and snow. On a demanding winter ascent you need gear that protects you from the weather and handles high intensity. Active Polartec® Alpha® Direct insulation, membrane panels and stretchy Blizzard® Thermal Comfort form a functional system that helps regulate temperature, wick moisture and keep you moving freely.","de":"Steiler Anstieg, Wind und Schnee. Beim anspruchsvollen Winteraufstieg brauchst du Ausrüstung, die vor dem Wetter schützt und hohe Intensität mitmacht. Aktive Polartec® Alpha® Direct Isolierung, Membraneinsätze und elastisches Blizzard® Thermal Comfort bilden ein funktionelles System, das Temperatur reguliert, Feuchtigkeit ableitet und Bewegungsfreiheit erhält.","hr":"Strmi uspon, vjetar i snijeg. Pri zahtjevnom zimskom usponu trebaš opremu koja te štiti od vremena, a istovremeno podnosi visok intenzitet. Aktivna izolacija Polartec® Alpha® Direct, membranski paneli i elastični Blizzard® Thermal Comfort čine funkcionalan sustav koji regulira temperaturu, odvodi vlagu i čuva slobodu pokreta.","sl":"Strm vzpon, veter in sneg. Pri zahtevnem zimskem vzponu potrebuješ opremo, ki te ščiti pred vremenom in hkrati zmore visoko intenzivnost. Aktivna izolacija Polartec® Alpha® Direct, membranski paneli in raztegljiv Blizzard® Thermal Comfort ustvarjajo funkcionalen sistem, ki uravnava temperaturo, odvaja vlago in ohranja svobodo gibanja.","bg":"Стръмно изкачване, вятър и сняг. При трудно зимно изкачване ти трябва екипировка, която те пази от времето и издържа висока интензивност. Активна изолация Polartec® Alpha® Direct, мембранни панели и еластичен Blizzard® Thermal Comfort създават функционална система, която регулира температурата, отвежда влагата и запазва свободата на движение."},"img":"peakflow-look-05.jpg","alt":"Outfit Peak Flow: pánsky skialpový outfit s bundou SOKOLEC","items":[{"handle":"h38","label":"Mikina","x":49.73,"y":27.25,"alts":["h31","h32"],"code":298},{"handle":"h41","label":"Batoh","x":40.14,"y":30.11,"alts":["h40"],"code":281},{"handle":"h30","label":"Bunda","x":55.11,"y":41.16,"alts":["h33","h36"],"code":553},{"handle":"h35","label":"Nohavice","x":60.7,"y":57.34,"alts":["h34"],"code":811}],"g":"m"},{"id":"look-06","activity":"SKIALPINIZMUS","title":{"sk":"Keď rozhoduje tepelný komfort","en":"When warmth matters most","de":"Wenn Wärme entscheidet","hr":"Kad odlučuje toplina","sl":"Ko odloča toplota","bg":"Когато топлината решава"},"text":{"sk":"Mrazivé podmienky si vyžadujú premyslené vrstvenie. Funkčné materiály pomáhajú regulovať vlhkosť počas pohybu, zatiaľ čo izolácia PrimaLoft® poskytuje dodatočnú ochranu pred chladom. Od bundy cez zatepľovaciu sukňu až po rukavice, každá vrstva má svoje miesto.","en":"Freezing conditions call for well-thought-out layering. Functional materials help manage moisture on the move, while PrimaLoft® insulation adds protection from the cold. From the jacket to the insulated skirt to the gloves, every layer has its place.","de":"Eisige Bedingungen verlangen durchdachtes Layering. Funktionsmaterialien regulieren die Feuchtigkeit in Bewegung, während die PrimaLoft® Isolierung zusätzlich vor Kälte schützt. Von der Jacke über den Isolierrock bis zu den Handschuhen hat jede Schicht ihren Platz.","hr":"Mrazni uvjeti traže promišljeno slojevanje. Funkcionalni materijali reguliraju vlagu tijekom kretanja, dok izolacija PrimaLoft® pruža dodatnu zaštitu od hladnoće. Od jakne preko izolirane suknje do rukavica, svaki sloj ima svoje mjesto.","sl":"Mrzle razmere zahtevajo premišljeno plastenje. Funkcionalni materiali uravnavajo vlago med gibanjem, izolacija PrimaLoft® pa dodatno ščiti pred mrazom. Od jakne prek izolirnega krila do rokavic ima vsaka plast svoje mesto.","bg":"Мразовитите условия изискват обмислено наслояване. Функционалните материи регулират влагата при движение, а изолацията PrimaLoft® дава допълнителна защита от студа. От якето през изолиращата пола до ръкавиците всеки слой има своето място."},"img":"peakflow-look-06.jpg","alt":"Outfit Peak Flow: dámsky skialpový outfit so sukňou PODKOVA","items":[{"handle":"h18","label":"Mikina","x":56.71,"y":23.85,"alts":["h20","h28"],"code":812},{"handle":"h21","label":"Bunda","x":56.31,"y":33.31,"alts":["h42","h22"],"code":282},{"handle":"h41","label":"Batoh","x":35.55,"y":27.72,"alts":["h40"],"code":378},{"handle":"h23","label":"Sukňa","x":52.42,"y":52.22,"alts":["h17"],"code":269},{"handle":"h25","label":"Nohavice","x":51.02,"y":68.53,"alts":["h26","h43"],"code":512}],"g":"z"},{"id":"look-07","activity":"LYŽOVANIE","title":{"sk":"Od prvej po poslednú jazdu","en":"From first to last run","de":"Von der ersten bis zur letzten Abfahrt","hr":"Od prve do zadnje vožnje","sl":"Od prve do zadnje vožnje","bg":"От първото до последното спускане"},"text":{"sk":"Ranný mráz, vietor na lanovke, čerstvý sneh aj posledný zjazd dňa. Špičkový lyžiarsky outfit s prémiovou membránou Dermizax™ EV, vodným stĺpcom 20 000 mm a kvalitnou tepelnou izoláciou poskytuje spoľahlivú ochranu pred zimným počasím, tepelný komfort a voľnosť pohybu počas celého dňa na svahu.","en":"Morning frost, wind on the lift, fresh snow and the last run of the day. A top ski outfit with the premium Dermizax™ EV membrane, a 20,000 mm water column and quality insulation gives reliable protection from winter weather, warmth and freedom of movement all day on the slopes.","de":"Morgenfrost, Wind am Lift, Neuschnee und die letzte Abfahrt des Tages. Ein Top-Skioutfit mit der Premium-Membran Dermizax™ EV, 20.000 mm Wassersäule und hochwertiger Isolierung bietet zuverlässigen Schutz vor Winterwetter, Wärme und Bewegungsfreiheit den ganzen Tag auf der Piste.","hr":"Jutarnji mraz, vjetar na žičari, svježi snijeg i zadnji spust dana. Vrhunski skijaški komplet s membranom Dermizax™ EV, vodenim stupcem od 20 000 mm i kvalitetnom izolacijom pruža pouzdanu zaštitu od zimskog vremena, toplinu i slobodu pokreta cijeli dan na stazi.","sl":"Jutranji mraz, veter na žičnici, svež sneg in zadnji spust dneva. Vrhunski smučarski komplet z membrano Dermizax™ EV, vodnim stolpcem 20.000 mm in kakovostno izolacijo nudi zanesljivo zaščito pred zimskim vremenom, toplino in svobodo gibanja ves dan na smučišču.","bg":"Сутрешен мраз, вятър на лифта, пресен сняг и последното спускане за деня. Първокласен ски екип с мембрана Dermizax™ EV, воден стълб 20 000 mm и качествена изолация дава надеждна защита от зимното време, топлина и свобода на движение цял ден на пистата."},"img":"peakflow-look-07.jpg","alt":"Outfit Peak Flow: pánsky lyžiarsky outfit TIKHOMIR a TOMASZ","items":[{"handle":"h0","label":"Bunda","x":47.93,"y":33.84,"alts":["h1","h5","h11","h12"],"code":281},{"handle":"h44","label":"Rukavice","x":30.76,"y":25.12,"alts":[],"code":269},{"handle":"h6","label":"Nohavice","x":55.01,"y":56.21,"alts":["h4"],"code":269}],"g":"m"},{"id":"look-08","activity":"SKIALPINIZMUS","title":{"sk":"Vrstvy na celý deň","en":"Layers for the whole day","de":"Schichten für den ganzen Tag","hr":"Slojevi za cijeli dan","sl":"Plasti za cel dan","bg":"Слоеве за целия ден"},"text":{"sk":"Vesta, mikina a sukňa, ktoré sa dajú skladať podľa tempa.","en":"A vest, fleece and skirt you can combine to match your pace.","de":"Weste, Pullover und Rock, kombinierbar je nach Tempo.","hr":"Prsluk, majica i suknja koje kombiniraš prema tempu.","sl":"Telovnik, pulover in krilo, ki jih sestaviš po svojem tempu.","bg":"Елек, суитшърт и пола, които комбинираш според темпото."},"img":"peakflow-look-08.jpg","alt":"Outfit Peak Flow: dámsky skialpový outfit s vestou JAVOROVA","items":[{"handle":"h18","label":"Mikina","x":38.95,"y":23.19,"alts":["h20","h28"],"code":645},{"handle":"h40","label":"Batoh","x":42.84,"y":28.18,"alts":["h41"],"code":268},{"handle":"h15","label":"Vesta","x":53.72,"y":35.77,"alts":["h22","h21"],"code":577},{"handle":"h23","label":"Sukňa","x":54.32,"y":50.42,"alts":["h17"],"code":269},{"handle":"h25","label":"Nohavice","x":47.93,"y":62.67,"alts":["h26","h43"],"code":512}],"g":"z"},{"id":"look-09","activity":"LYŽOVANIE","title":{"sk":"Každý oblúk naplno","en":"Every turn to the full","de":"Jeder Schwung mit voller Kraft","hr":"Svaki zavoj punom snagom","sl":"Vsak zavoj na polno","bg":"Всеки завой докрай"},"text":{"sk":"Perfektne upravená zjazdovka a jazda bez obmedzení. Špičkový lyžiarsky outfit s membránou Dermizax™ EV a izoláciou PrimaLoft® poskytuje výnimočný tepelný komfort, ochranu pred zimným počasím a elasticitu pre prirodzený pohyb pri každom zjazde.","en":"A perfectly groomed slope and skiing without limits. A top ski outfit with the Dermizax™ EV membrane and PrimaLoft® insulation offers exceptional warmth, protection from winter weather and stretch for natural movement on every run.","de":"Perfekt präparierte Piste und Fahren ohne Grenzen. Ein Top-Skioutfit mit Dermizax™ EV Membran und PrimaLoft® Isolierung bietet außergewöhnliche Wärme, Schutz vor Winterwetter und Elastizität für natürliche Bewegung bei jeder Abfahrt.","hr":"Savršeno uređena staza i vožnja bez ograničenja. Vrhunski skijaški komplet s membranom Dermizax™ EV i izolacijom PrimaLoft® pruža iznimnu toplinu, zaštitu od zimskog vremena i elastičnost za prirodne pokrete u svakom spustu.","sl":"Popolno urejeno smučišče in vožnja brez omejitev. Vrhunski smučarski komplet z membrano Dermizax™ EV in izolacijo PrimaLoft® nudi izjemno toplotno udobje, zaščito pred zimskim vremenom in elastičnost za naravno gibanje pri vsakem spustu.","bg":"Перфектно подготвена писта и каране без ограничения. Първокласен ски екип с мембрана Dermizax™ EV и изолация PrimaLoft® дава изключителен топлинен комфорт, защита от зимното време и еластичност за естествено движение при всяко спускане."},"img":"peakflow-look-09.jpg","alt":"Outfit Peak Flow: pánsky lyžiarsky outfit TOHNIS a KREADY","items":[{"handle":"h44","label":"Rukavice","x":31.56,"y":25.12,"alts":[],"code":269},{"handle":"h1","label":"Bunda","x":49.03,"y":36.97,"alts":["h0","h5","h11","h12"],"code":300},{"handle":"h4","label":"Nohavice","x":57.61,"y":58.01,"alts":["h6"],"code":269}],"g":"m"},{"id":"look-10","activity":"LYŽOVANIE","title":{"sk":"Radosť z každej jazdy","en":"Joy in every run","de":"Freude an jeder Abfahrt","hr":"Radost u svakoj vožnji","sl":"Veselje ob vsaki vožnji","bg":"Радост от всяко спускане"},"text":{"sk":"Čerstvo upravené zjazdovky, plynulé oblúky a celý deň na lyžiach. Špičkový dámsky outfit s membránou Dermizax™ EV poskytuje spoľahlivú ochranu pred zimným počasím, tepelný komfort a slobodu pohybu, aby si sa mohla sústrediť len na lyžovanie.","en":"Freshly groomed slopes, smooth turns and a whole day on skis. A top women’s outfit with the Dermizax™ EV membrane gives reliable protection from winter weather, warmth and freedom of movement, so you can focus on skiing alone.","de":"Frisch präparierte Pisten, fließende Schwünge und ein ganzer Tag auf Ski. Ein Top-Damenoutfit mit Dermizax™ EV Membran bietet zuverlässigen Schutz vor Winterwetter, Wärme und Bewegungsfreiheit, damit du dich ganz aufs Skifahren konzentrieren kannst.","hr":"Svježe uređene staze, glatki zavoji i cijeli dan na skijama. Vrhunski ženski komplet s membranom Dermizax™ EV pruža pouzdanu zaštitu od zimskog vremena, toplinu i slobodu pokreta kako bi se mogla usredotočiti samo na skijanje.","sl":"Sveže urejena smučišča, tekoči zavoji in cel dan na smučeh. Vrhunski ženski komplet z membrano Dermizax™ EV nudi zanesljivo zaščito pred zimskim vremenom, toploto in svobodo gibanja, da se lahko posvetiš samo smučanju.","bg":"Прясно подготвени писти, плавни завои и цял ден на ски. Първокласен дамски екип с мембрана Dermizax™ EV дава надеждна защита от зимното време, топлина и свобода на движение, за да се съсредоточиш само върху карането."},"img":"peakflow-look-10.jpg","alt":"Outfit Peak Flow: dámsky lyžiarsky outfit KALEY a TIANNA","items":[{"handle":"h24","label":"Rukavice","x":37.95,"y":17.2,"alts":[],"code":269},{"handle":"h3","label":"Bunda","x":56.81,"y":34.51,"alts":["h16","h13","h14","h19"],"code":550},{"handle":"h2","label":"Nohavice","x":60,"y":53.75,"alts":["h29"],"code":300}],"g":"z"},{"id":"look-11","activity":"LYŽOVANIE","title":{"sk":"Výkon má svoj štýl","en":"Performance with style","de":"Leistung mit Stil","hr":"Performanse sa stilom","sl":"Zmogljivost s stilom","bg":"Представяне със стил"},"text":{"sk":"Dokonalý pocit z jazdy začína výbavou, na ktorú sa môžeš spoľahnúť. Špičkový lyžiarsky outfit s prémiovou membránou Dermizax™ EV, izoláciou PrimaLoft® a elastickou konštrukciou spája vysoký technický výkon, tepelný komfort a výrazný dizajn. Pre lyžiarov, ktorí nechcú robiť kompromisy medzi funkčnosťou a štýlom.","en":"The perfect ride starts with gear you can rely on. A top ski outfit with the premium Dermizax™ EV membrane, PrimaLoft® insulation and a stretch construction combines high technical performance, warmth and bold design. For skiers who won’t compromise between function and style.","de":"Das perfekte Fahrgefühl beginnt mit Ausrüstung, auf die du dich verlassen kannst. Ein Top-Skioutfit mit Premium-Membran Dermizax™ EV, PrimaLoft® Isolierung und elastischer Konstruktion vereint hohe technische Leistung, Wärme und markantes Design. Für Skifahrer, die keine Kompromisse zwischen Funktion und Stil machen.","hr":"Savršen osjećaj vožnje počinje opremom na koju se možeš osloniti. Vrhunski skijaški komplet s membranom Dermizax™ EV, izolacijom PrimaLoft® i elastičnom konstrukcijom spaja visoke tehničke performanse, toplinu i upečatljiv dizajn. Za skijaše koji ne žele kompromis između funkcionalnosti i stila.","sl":"Popoln občutek vožnje se začne z opremo, na katero se lahko zaneseš. Vrhunski smučarski komplet z membrano Dermizax™ EV, izolacijo PrimaLoft® in elastično konstrukcijo združuje visoko tehnično zmogljivost, toploto in izrazit dizajn. Za smučarje, ki ne sklepajo kompromisov med funkcionalnostjo in stilom.","bg":"Перфектното усещане при каране започва с екипировка, на която можеш да разчиташ. Първокласен ски екип с мембрана Dermizax™ EV, изолация PrimaLoft® и еластична конструкция съчетава високо техническо представяне, топлина и изразителен дизайн. За скиори, които не правят компромис между функционалност и стил."},"img":"peakflow-look-11.jpg","alt":"Outfit Peak Flow: pánsky lyžiarsky outfit VASILLI a TOMASZ","items":[{"handle":"h44","label":"Rukavice","x":30.76,"y":21.39,"alts":[],"code":269},{"handle":"h38","label":"Mikina","x":52.72,"y":23.39,"alts":["h31","h32"],"code":298},{"handle":"h5","label":"Bunda","x":47.13,"y":35.97,"alts":["h0","h1","h11","h12"],"code":550},{"handle":"h4","label":"Nohavice","x":55.51,"y":56.21,"alts":["h6"],"code":300}],"g":"m"},{"id":"look-12","activity":"LYŽOVANIE","title":{"sk":"Elegancia na svahu","en":"Elegance on the slopes","de":"Eleganz auf der Piste","hr":"Elegancija na stazi","sl":"Eleganca na smučišču","bg":"Елегантност на пистата"},"text":{"sk":"Dokonale upravené zjazdovky, plynulé oblúky a štýl, ktorý nezostane bez povšimnutia. Luxusný dámsky lyžiarsky outfit s prémiovou membránou Dermizax™ EV a izoláciou PrimaLoft® Eco Black spája výnimočný dizajn, tepelný komfort a voľnosť pohybu počas celého dňa na svahu.","en":"Perfectly groomed slopes, smooth turns and style that won’t go unnoticed. A luxury women’s ski outfit with the premium Dermizax™ EV membrane and PrimaLoft® Eco Black insulation combines exceptional design, warmth and freedom of movement all day on the slopes.","de":"Perfekt präparierte Pisten, fließende Schwünge und ein Stil, der nicht unbemerkt bleibt. Ein luxuriöses Damen-Skioutfit mit Premium-Membran Dermizax™ EV und PrimaLoft® Eco Black Isolierung vereint außergewöhnliches Design, Wärme und Bewegungsfreiheit den ganzen Tag auf der Piste.","hr":"Savršeno uređene staze, glatki zavoji i stil koji neće proći nezapaženo. Luksuzni ženski skijaški komplet s membranom Dermizax™ EV i izolacijom PrimaLoft® Eco Black spaja iznimni dizajn, toplinu i slobodu pokreta cijeli dan na stazi.","sl":"Popolno urejena smučišča, tekoči zavoji in stil, ki ne ostane neopažen. Luksuzni ženski smučarski komplet z membrano Dermizax™ EV in izolacijo PrimaLoft® Eco Black združuje izjemen dizajn, toploto in svobodo gibanja ves dan na smučišču.","bg":"Перфектно подготвени писти, плавни завои и стил, който не остава незабелязан. Луксозен дамски ски екип с мембрана Dermizax™ EV и изолация PrimaLoft® Eco Black съчетава изключителен дизайн, топлина и свобода на движение цял ден на пистата."},"img":"peakflow-look-12.jpg","alt":"Outfit Peak Flow: dámsky lyžiarsky outfit MERIBEL a TIANNA","items":[{"handle":"h16","label":"Bunda","x":54.92,"y":39.3,"alts":["h3","h13","h14","h19"],"code":482},{"handle":"h2","label":"Nohavice","x":46.93,"y":58.14,"alts":["h29"],"code":482}],"g":"z"}],"products":[{"handle":"h11","name":"TIKHOMIR1","type":0,"g":"m","c":"bundy","layer":4},{"handle":"h14","name":"KENSLEY","type":1,"g":"z","c":"bundy","layer":4},{"handle":"h33","name":"SOLISKO 3","type":2,"g":"m","c":"bundy","layer":3},{"handle":"h42","name":"KRIZNA 2","type":3,"g":"z","c":"bundy","layer":3},{"handle":"h7","name":"MURAN","type":4,"g":"m","c":"bundy","layer":5},{"handle":"h9","name":"MURANSKA","type":5,"g":"z","c":"bundy","layer":5},{"handle":"h36","name":"OHNISTE 1","type":6,"g":"m","c":"bundy","layer":4},{"handle":"h21","name":"OPALENA 1","type":7,"g":"z","c":"bundy","layer":4},{"handle":"h6","name":"TOMASZ","type":8,"g":"m","c":"nohavice"