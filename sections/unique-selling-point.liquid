{% style %}
  .usp-icon {
    width: 2rem;
    height: 2rem;
  }

  .usp-container {
    max-width: 1200px;
    margin: 0 auto;
  }
{% endstyle %}

<div class="w-full py-16">
  <div class="page-width usp-container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center mx-auto w-full">
      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img src="{{ 'usp-return.png' | asset_url }}" alt="{{ 'sections.unique-selling-point.returns.alt' | t }}" class="usp-icon" width="48" height="48">
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">{{ 'sections.unique-selling-point.returns.text' | t }}</p>
      </div>

      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img
            src="{{ 'usp-medal.png' | asset_url }}"
            alt="{{ 'sections.unique-selling-point.materials.alt' | t }}"
            class="usp-icon"
            width="48"
            height="48"
          >
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">{{ 'sections.unique-selling-point.materials.text' | t }}</p>
      </div>

      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img src="{{ 'usp-skiing.png' | asset_url }}" alt="{{ 'sections.unique-selling-point.tested.alt' | t }}" class="usp-icon" width="48" height="48">
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">{{ 'sections.unique-selling-point.tested.text' | t }}</p>
      </div>

      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img src="{{ 'usp-extra-benefits.svg' | asset_url }}" alt="{{ 'sections.unique-selling-point.members.alt' | t }}" class="usp-icon" width="48" height="48">
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">{{ 'sections.unique-selling-point.members.text' | t }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.unique-selling-point.name",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.unique-selling-point.name"
    }
  ]
}
{% endschema %}
