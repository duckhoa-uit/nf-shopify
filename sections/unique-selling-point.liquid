{% style %}
  .usp-icon {
    width: 2rem;
    height: 2rem;
  }
{% endstyle %}

<div class="w-full py-16">
  <div class="page-width">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center mx-auto w-full">
      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img src="{{ 'usp-return.png' | asset_url }}" alt="Returns" class="usp-icon" width="48" height="48">
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">Hassle-free returns and exchanges</p>
      </div>

      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img
            src="{{ 'usp-medal.png' | asset_url }}"
            alt="Certified Materials"
            class="usp-icon"
            width="48"
            height="48"
          >
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">We use certified outdoor materials</p>
      </div>

      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img src="{{ 'usp-skiing.png' | asset_url }}" alt="Tested" class="usp-icon" width="48" height="48">
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">Tested by athletes and mountain rescuers</p>
      </div>

      <div class="flex flex-col items-center">
        <div class="bg-[#ebebeb] rounded-full size-[3.75rem] mb-4 flex items-center justify-center">
          <img src="{{ 'usp-account-circle.png' | asset_url }}" alt="Members" class="usp-icon" width="48" height="48">
        </div>
        <p class="text-base font-medium text-[#000] leading-6 text-center">Extra benefits for registered members</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.unique-selling-point.name",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.unique-selling-point.name"
    }
  ]
}
{% endschema %}
