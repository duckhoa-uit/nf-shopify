{{ 'account.css' | asset_url | stylesheet_tag }}
{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'intl-tel-input.min.css' | asset_url | stylesheet_tag }}
{{ 'phone-input.css' | asset_url | stylesheet_tag }}

<!-- Load Shopify's global.js first to ensure CountryProvinceSelector is available -->
<script src="{{ 'global.js' | asset_url }}" defer></script>
<script src="{{ 'customer.js' | asset_url }}" defer></script>
<script src="{{ 'account-tabs.js' | asset_url }}" defer></script>
<script src="{{ 'account-mobile-menu.js' | asset_url }}" defer></script>
<script src="{{ 'account-addresses-redirect.js' | asset_url }}" defer></script>
<script src="{{ 'address-form-handler.js' | asset_url }}" defer></script>
<script src="{{ 'intl-tel-input.min.js' | asset_url }}" defer></script>
<script src="{{ 'phone-validation.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Default address styling */
  .default-badge {
    display: inline-block;
    background-color: #ED2024;
    color: white;
    font-size: 0.8rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .default-address-message {
    color: #ED2024;
    font-weight: bold;
  }

  .success-message {
    background-color: #f8f8f8;
    border-left: 4px solid #4CAF50;
    color: #4CAF50;
    padding: 10px 15px;
    margin-bottom: 20px;
    font-weight: bold;
  }

  /* Fix for address form visibility */
  #NewAddressForm.show-form {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    height: auto !important;
    overflow: visible !important;
  }

  /* Phone number field styling */
  .field {
    position: relative;
  }

  .error-message {
    color: #ED2024;
    font-size: 0.8rem;
    margin-top: 0.25rem;
    display: none;
  }

  input.invalid {
    border-color: #ED2024;
  }

  /* Fix for intl-tel-input alignment with our form fields */
  .field .iti,
  .phone-field-wrapper .iti {
    display: block;
    width: 100%;
  }

  /* Ensure phone field has consistent styling with other form fields */
  .phone-field-wrapper {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div
  class="customer account section-{{ section.id }}-padding"
  data-customer-addresses
>
  <div class="account-container">
    <div class="account-header">
      <a href="{{ routes.all_products_collection_url }}" class="account-back-link flex items-center">
        <span class="svg-wrapper mr-0 size-5">
          {{ 'arrow-left.svg' | inline_asset_content }}
        </span>
        <span class="mr-2 text-[#999]">|</span>
        <span>{{ 'customer.account.back_to_shopping' | t }}</span>
      </a>
      <h1 class="account-title">{{ 'customer.account.title' | t }}</h1>
    </div>

    <div class="account-main">
      <div class="account-sidebar">
        <div class="user-info">
          <div class="user-avatar-wrapper">
            <div class="user-avatar">
              {% assign first_letter = customer.name | slice: 0 | upcase %}
              {{ first_letter }}
            </div>
            <div class="avatar-edit-button">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">
                <circle cx="15" cy="15" r="13" fill="#EC0009" stroke="white" stroke-width="4"></circle>
                <path d="M21 14V16H9V14H21Z" fill="white"></path>
                <path d="M16 9V21H14V9H16Z" fill="white"></path>
              </svg>
            </div>
          </div>
          <div class="user-name">{{ customer.name }}</div>
          <div class="user-address">
            {% if customer.default_address %}
              {{ customer.default_address.street }}, {{ customer.default_address.city }}
            {% endif %}
          </div>
        </div>

        <ul class="account-tabs" role="tablist">
          <li role="presentation">
            <a href="{{ routes.account_url }}#settings" class="tab-link" data-tab="settings">
              {{- 'customer.account.basic_info' | t -}}
            </a>
          </li>
          <li role="presentation">
            <a href="{{ routes.account_addresses_url }}" class="tab-link active">
              {{- 'customer.account.addresses' | t -}}
            </a>
          </li>
          <li role="presentation">
            <a href="{{ routes.account_url }}#orders" class="tab-link" data-tab="orders">
              {{ 'customer.account.orders' | t }}
            </a>
          </li>
          <li>
            <a href="{{ routes.account_url }}#bonus" class="tab-link" data-tab="bonus">
              {{ 'customer.account.loyalty_bonus' | t }}
            </a>
          </li>
          <li role="presentation">
            <a href="{{ routes.account_url }}#account-settings" class="tab-link" data-tab="account-settings">
              {{- 'customer.account.settings' | t -}}
            </a>
          </li>
          <li role="presentation">
            <a href="{{ routes.account_url }}#wishlist" class="tab-link" data-tab="wishlist">
              {{- 'customer.account.wishlist' | t -}}
            </a>
          </li>
          <li>
            <a href="{{ routes.account_logout_url }}" class="logout-link">
              <span class="svg-wrapper">
                {{ 'logout.svg' | inline_asset_content }}
              </span>
              {{ 'customer.log_out' | t }}
            </a>
          </li>
        </ul>

        <button id="account-mobile-menu-button" class="account-mobile-menu-button md:hidden">
          <span class="button-text">{{ 'customer.account.addresses' | t }}</span>
          <span class="svg-wrapper ml-2">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </button>

        <template data-icon-caret>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </template>
      </div>

      <div class="account-content" data-customer-addresses>
        <!-- Hidden data attributes for translations -->
        <div style="display: none;">
          <span data-name-label>{{ 'customer.addresses.name' | t }}</span>
          <span data-email-label>{{ 'customer.addresses.email' | t }}</span>
          <span data-phone-label>{{ 'customer.addresses.phone' | t }}</span>
          <span data-address1-label>{{ 'customer.addresses.address1' | t }}</span>
          <span data-city-label>{{ 'customer.addresses.city' | t }}</span>
          <span data-zip-label>{{ 'customer.addresses.zip' | t }}</span>
          <span data-country-label>{{ 'customer.addresses.country' | t }}</span>
          <span data-company-label>{{ 'customer.addresses.company' | t }}</span>
          <span data-edit-label>{{ 'customer.addresses.edit' | t }}</span>
          <span data-delete-label>{{ 'customer.addresses.delete' | t }}</span>
          <span data-customer-email>{{ customer.email }}</span>
          <span data-form-error>{{ 'customer.addresses.error' | t }}</span>
          <span data-address-update-success>{{ 'customer.addresses.update_success' | t }}</span>
          <span data-address-add-success>
            {{- 'customer.addresses.add_success' | t | default: 'Address added successfully' -}}
          </span>
          <span data-add-address-title>{{ 'customer.addresses.add_new' | t }}</span>
          <span data-edit-icon>{{ 'icon-edit.svg' | inline_asset_content }}</span>
          <span data-delete-icon>{{ 'icon-trash.svg' | inline_asset_content }}</span>
          <span data-delete-confirm>{{ 'customer.addresses.delete_confirm' | t }}</span>
          <!-- Language and URL context for JavaScript -->
          <span data-current-locale>{{ request.locale.iso_code }}</span>
          <span data-account-addresses-url>{{ routes.account_addresses_url }}</span>
          <span data-account-url>{{ routes.account_url }}</span>
        </div>

        <div class="address-section">
          <div class="address-section-header">
            <h3 class="section-title">{{ 'customer.addresses.title' | t }}</h3>
            <button
              type="button"
              id="AddAddress"
              class="button"
              aria-expanded="false"
              aria-controls="AddressNewForm"
              onclick="document.getElementById('AddressNewForm').style.display = 'block'; this.setAttribute('aria-expanded', 'true'); document.getElementById('AddressNewForm').scrollIntoView({behavior: 'smooth'}); return false;"
            >
              <span class="svg-wrapper">
                {{ 'icon-plus.svg' | inline_asset_content }}
              </span>
              {{ 'customer.addresses.add_new' | t }}
            </button>
          </div>

          <div class="address-cards" id="address-cards">
            {% comment %}
              First display the default address
            {% endcomment %}
            {% if customer.default_address %}
              {% assign default_address = customer.default_address %}
              <div class="address-wrapper" data-address data-address-id="{{ default_address.id }}">
                <div class="address-card" data-address-id="{{ default_address.id }}">
                  <h3 class="address-card-title">
                    {% if default_address.company != blank %}
                      {{ default_address.company }},
                    {% elsif default_address.first_name != blank or default_address.last_name != blank %}
                      {{ default_address.first_name }}
                      {{ default_address.last_name }},
                    {% else %}
                      N/A,
                    {% endif %}

                    <span class="default-badge">{{ 'customer.addresses.default' | t }}</span>
                  </h3>
                  <p class="address-card-summary">
                    {% if default_address.address1 != blank %}
                      {{ default_address.address1 -}}
                      {%- if default_address.city != blank %}, {{ default_address.city }}{% endif %}
                    {% elsif default_address.city != blank %}
                      {{ default_address.city }}
                    {% else %}
                      N/A
                    {% endif %}
                  </p>

                  <div class="address-divider"></div>

                  <div class="address-details">
                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.name' | t }}</span>
                      <span class="field-value">
                        {%- if default_address.first_name != blank or default_address.last_name != blank -%}
                          {{- default_address.first_name }}
                          {{ default_address.last_name -}}
                        {%- else -%}
                          N/A
                        {%- endif -%}
                      </span>
                    </div>

                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.email' | t }}</span>
                      <span class="field-value">
                        {%- if customer.email != blank %}{{ customer.email }}{% else %}N/A{% endif -%}
                      </span>
                    </div>

                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.phone' | t }}</span>
                      <span class="field-value">
                        {%- if default_address.phone != blank %}{{ default_address.phone }}{% else %}N/A{% endif -%}
                      </span>
                    </div>

                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.address1' | t }}</span>
                      <span class="field-value">
                        {%- if default_address.address1 != blank -%}
                          {{- default_address.address1 -}}
                        {%- else -%}
                          N/A
                        {%- endif -%}
                      </span>
                    </div>

                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.city' | t }}</span>
                      <span class="field-value">
                        {%- if default_address.city != blank %}{{ default_address.city }}{% else %}N/A{% endif -%}
                      </span>
                    </div>

                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.zip' | t }}</span>
                      <span class="field-value">
                        {%- if default_address.zip != blank %}{{ default_address.zip }}{% else %}N/A{% endif -%}
                      </span>
                    </div>

                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.country' | t }}</span>
                      <span class="field-value">
                        {%- if default_address.country != blank %}{{ default_address.country }}{% else %}N/A{% endif -%}
                      </span>
                    </div>

                    <div class="address-field">
                      <span class="field-label">{{ 'customer.addresses.company' | t }}</span>
                      <span class="field-value">
                        {%- if default_address.company != blank %}{{ default_address.company }}{% else %}N/A{% endif -%}
                      </span>
                    </div>
                  </div>

                  <div class="address-actions">
                    <button
                      type="button"
                      class="button btn-edit"
                      aria-expanded="false"
                      aria-controls="EditAddress_{{ default_address.id }}"
                      data-address-id="{{ default_address.id }}"
                    >
                      <span class="svg-wrapper">
                        {{ 'icon-edit.svg' | inline_asset_content }}
                      </span>
                      {{ 'customer.addresses.edit' | t }}
                    </button>

                    <button
                      type="button"
                      class="button button--tertiary btn-delete"
                      data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
                      data-target="{{ default_address.url }}"
                    >
                      <span class="svg-wrapper">
                        {{ 'icon-trash.svg' | inline_asset_content }}
                      </span>
                      <span class="btn-spinner"></span>
                    </button>
                  </div>
                </div>

                <div class="address-edit-form" id="EditAddress_{{ default_address.id }}" style="display: none;">
                  {% form 'customer_address', default_address, class: 'address-form' %}
                    <div class="form-row mb-0">
                      <div class="form-group mb-1">
                        {% capture first_name_id %}EditAddress_{{ default_address.id }}_FirstName{% endcapture %}
                        {%
                          render 'form-field',
                          type: 'text',
                          id: first_name_id,
                          name: 'address[first_name]',
                          value: default_address.first_name,
                          label: 'customer.addresses.first_name' | t,
                          required: true,
                          min_length: '2',
                          title: 'customer.addresses.first_name_min_length' | t | default: 'First name should contain at least 2 characters'
                        %}
                      </div>

                      <div class="form-group mb-1">
                        {% capture last_name_id %}EditAddress_{{ default_address.id }}_LastName{% endcapture %}
                        {%
                          render 'form-field',
                          type: 'text',
                          id: last_name_id,
                          name: 'address[last_name]',
                          value: default_address.last_name,
                          label: 'customer.addresses.last_name' | t,
                          required: true,
                          min_length: '2',
                          title: 'customer.addresses.last_name_min_length' | t | default: 'Last name should contain at least 2 characters'
                        %}
                      </div>
                    </div>

                    <div class="form-row">
                      <div class="form-group pt-7">
                        {% capture company_id %}EditAddress_{{ default_address.id }}_Company{% endcapture %}
                        {%
                          render 'form-field',
                          type: 'text',
                          id: company_id,
                          name: 'address[company]',
                          value: default_address.company,
                          label: 'customer.addresses.company' | t
                        %}
                      </div>

                      <div class="form-group">
                        {% capture phone_id %}EditAddress_{{ default_address.id }}_Phone{% endcapture %}
                        {%
                          render 'phone-field',
                          id: phone_id,
                          name: 'address[phone]',
                          value: default_address.phone,
                          label: 'customer.addresses.phone' | t,
                          required: true
                        %}
                      </div>
                    </div>

                    <div class="form-group">
                      {% capture address1_id %}EditAddress_{{ default_address.id }}_Address1{% endcapture %}
                      {%
                        render 'form-field',
                        type: 'text',
                        id: address1_id,
                        name: 'address[address1]',
                        value: default_address.address1,
                        label: 'customer.addresses.address1' | t,
                        required: true,
                        min_length: '5',
                        title: 'customer.addresses.address_min_length' | t | default: 'Address should be at least 5 characters long'
                      %}
                    </div>

                    <div class="form-group">
                      {% capture address2_id %}EditAddress_{{ default_address.id }}_Address2{% endcapture %}
                      {%
                        render 'form-field',
                        type: 'text',
                        id: address2_id,
                        name: 'address[address2]',
                        value: default_address.address2,
                        label: 'customer.addresses.address2' | t
                      %}
                    </div>

                    <div class="form-row">
                      <div class="form-group">
                        {% capture city_id %}EditAddress_{{ default_address.id }}_City{% endcapture %}
                        {%
                          render 'form-field',
                          type: 'text',
                          id: city_id,
                          name: 'address[city]',
                          value: default_address.city,
                          label: 'customer.addresses.city' | t,
                          required: true,
                          min_length: '2',
                          title: 'customer.addresses.city_min_length' | t | default: 'City name should contain at least 2 characters'
                        %}
                      </div>

                      <div class="form-group">
                        {% capture zip_id %}EditAddress_{{ default_address.id }}_Zip{% endcapture %}
                        {%
                          render 'form-field',
                          type: 'text',
                          id: zip_id,
                          name: 'address[zip]',
                          value: default_address.zip,
                          label: 'customer.addresses.zip' | t,
                          required: true,
                          pattern: '[0-9A-Za-z\s\-]{3,10}',
                          title: 'customer.addresses.zip_min_length' | t | default: 'Postal/ZIP code should be 3-10 characters'
                        %}
                      </div>
                    </div>

                    <div class="form-row">
                      <div class="form-group">
                        <label for="AddressCountry_{{ default_address.id }}">
                          {{- 'customer.addresses.country' | t -}}
                        </label>
                        <div class="select-wrapper">
                          <select
                            id="AddressCountry_{{ default_address.id }}"
                            name="address[country]"
                            data-address-country-select
                            data-form-id="{{ default_address.id }}"
                            data-default="{{ default_address.country }}"
                            required
                          >
                            {{ all_country_option_tags }}
                          </select>
                        </div>
                      </div>

                      <div
                        class="form-group"
                        id="AddressProvinceContainer_{{ default_address.id }}"
                        style="display:none;"
                      >
                        <label for="AddressProvince_{{ default_address.id }}">
                          {{- 'customer.addresses.province' | t -}}
                        </label>
                        <div class="select-wrapper">
                          <select
                            id="AddressProvince_{{ default_address.id }}"
                            name="address[province]"
                            data-default="{{ default_address.province }}"
                          ></select>
                        </div>
                      </div>
                    </div>

                    <div class="form-actions">
                      <button type="submit" class="button btn">
                        <span class="btn-text">{{ 'customer.addresses.update' | t }}</span>
                        <span class="btn-spinner"></span>
                      </button>
                      <button
                        type="reset"
                        class="button button--tertiary"
                      >
                        {{ 'customer.addresses.cancel' | t }}
                      </button>
                    </div>
                  {% endform %}
                </div>
              </div>
            {% endif %}

            {% comment %}
              Then display all non-default addresses
            {% endcomment %}
            {% for address in customer.addresses %}
              {% if address.id != customer.default_address.id %}
                <div class="address-wrapper" data-address data-address-id="{{ address.id }}">
                  <div class="address-card" data-address-id="{{ address.id }}">
                    <h3 class="address-card-title">
                      {% if address.company != blank %}
                        {{ address.company }},
                      {% elsif address.first_name != blank or address.last_name != blank %}
                        {{ address.first_name }}
                        {{ address.last_name }},
                      {% else %}
                        N/A,
                      {% endif %}

                      {% if address == customer.default_address %}
                        <span class="default-badge">{{ 'customer.addresses.default' | t }}</span>
                      {% endif %}
                    </h3>
                    <p class="address-card-summary">
                      {% if address.address1 != blank %}
                        {{ address.address1 -}}
                        {%- if address.city != blank %}, {{ address.city }}{% endif %}
                      {% elsif address.city != blank %}
                        {{ address.city }}
                      {% else %}
                        N/A
                      {% endif %}
                    </p>

                    <div class="address-divider"></div>

                    <div class="address-details">
                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.name' | t }}</span>
                        <span class="field-value">
                          {%- if address.first_name != blank or address.last_name != blank -%}
                            {{- address.first_name }}
                            {{ address.last_name -}}
                          {%- else -%}
                            N/A
                          {%- endif -%}
                        </span>
                      </div>

                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.email' | t }}</span>
                        <span class="field-value">
                          {%- if customer.email != blank %}{{ customer.email }}{% else %}N/A{% endif -%}
                        </span>
                      </div>

                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.phone' | t }}</span>
                        <span class="field-value">
                          {%- if address.phone != blank %}{{ address.phone }}{% else %}N/A{% endif -%}
                        </span>
                      </div>

                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.address1' | t }}</span>
                        <span class="field-value">
                          {%- if address.address1 != blank %}{{ address.address1 }}{% else %}N/A{% endif -%}
                        </span>
                      </div>

                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.city' | t }}</span>
                        <span class="field-value">
                          {%- if address.city != blank %}{{ address.city }}{% else %}N/A{% endif -%}
                        </span>
                      </div>

                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.zip' | t }}</span>
                        <span class="field-value">
                          {%- if address.zip != blank %}{{ address.zip }}{% else %}N/A{% endif -%}
                        </span>
                      </div>

                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.country' | t }}</span>
                        <span class="field-value">
                          {%- if address.country != blank %}{{ address.country }}{% else %}N/A{% endif -%}
                        </span>
                      </div>

                      <div class="address-field">
                        <span class="field-label">{{ 'customer.addresses.company' | t }}</span>
                        <span class="field-value">
                          {%- if address.company != blank %}{{ address.company }}{% else %}N/A{% endif -%}
                        </span>
                      </div>
                    </div>

                    <div class="address-actions">
                      <button
                        type="button"
                        class="button btn-edit"
                        aria-expanded="false"
                        aria-controls="EditAddress_{{ address.id }}"
                        data-address-id="{{ address.id }}"
                      >
                        <span class="svg-wrapper">
                          {{ 'icon-edit.svg' | inline_asset_content }}
                        </span>
                        {{ 'customer.addresses.edit' | t }}
                      </button>

                      <button
                        type="button"
                        class="button button--tertiary btn-delete"
                        data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
                        data-target="{{ address.url }}"
                      >
                        <span class="svg-wrapper">
                          {{ 'icon-trash.svg' | inline_asset_content }}
                        </span>
                        <span class="btn-spinner"></span>
                      </button>
                    </div>
                  </div>

                  <div class="address-edit-form" id="EditAddress_{{ address.id }}" style="display: none;">
                    {% form 'customer_address', address, class: 'address-form' %}
                      <div class="form-row mb-0">
                        <div class="form-group mb-1">
                          {% capture first_name_id %}EditAddress_{{ address.id }}_FirstName{% endcapture %}
                          {%
                            render 'form-field',
                            type: 'text',
                            id: first_name_id,
                            name: 'address[first_name]',
                            value: address.first_name,
                            label: 'customer.addresses.first_name' | t,
                            required: true,
                            min_length: '2',
                            title: 'customer.addresses.first_name_min_length' | t | default: 'First name should contain at least 2 characters'
                          %}
                        </div>

                        <div class="form-group mb-1">
                          {% capture last_name_id %}EditAddress_{{ address.id }}_LastName{% endcapture %}
                          {%
                            render 'form-field',
                            type: 'text',
                            id: last_name_id,
                            name: 'address[last_name]',
                            value: address.last_name,
                            label: 'customer.addresses.last_name' | t,
                            required: true,
                            min_length: '2',
                            title: 'customer.addresses.last_name_min_length' | t | default: 'Last name should contain at least 2 characters'
                          %}
                        </div>
                      </div>

                      <div class="form-row mb-0">
                        <div class="form-group pt-7">
                          {% capture company_id %}EditAddress_{{ address.id }}_Company{% endcapture %}
                          {%
                            render 'form-field',
                            type: 'text',
                            id: company_id,
                            name: 'address[company]',
                            value: address.company,
                            label: 'customer.addresses.company' | t
                          %}
                        </div>

                        <div class="form-group">
                          {% capture phone_id %}EditAddress_{{ address.id }}_Phone{% endcapture %}
                          {%
                            render 'phone-field',
                            id: phone_id,
                            name: 'address[phone]',
                            value: address.phone,
                            label: 'customer.addresses.phone' | t,
                            required: true
                          %}
                        </div>
                      </div>

                      <div class="form-group">
                        {% capture address1_id %}EditAddress_{{ address.id }}_Address1{% endcapture %}
                        {%
                          render 'form-field',
                          type: 'text',
                          id: address1_id,
                          name: 'address[address1]',
                          value: address.address1,
                          label: 'customer.addresses.address1' | t,
                          required: true,
                          min_length: '5',
                          title: 'customer.addresses.address_min_length' | t | default: 'Address should be at least 5 characters long'
                        %}
                      </div>

                      <div class="form-group">
                        {% capture address2_id %}EditAddress_{{ address.id }}_Address2{% endcapture %}
                        {%
                          render 'form-field',
                          type: 'text',
                          id: address2_id,
                          name: 'address[address2]',
                          value: address.address2,
                          label: 'customer.addresses.address2' | t
                        %}
                      </div>

                      <div class="form-row mb-0">
                        <div class="form-group">
                          {% capture city_id %}EditAddress_{{ address.id }}_City{% endcapture %}
                          {%
                            render 'form-field',
                            type: 'text',
                            id: city_id,
                            name: 'address[city]',
                            value: address.city,
                            label: 'customer.addresses.city' | t,
                            required: true,
                            min_length: '2',
                            title: 'customer.addresses.city_min_length' | t | default: 'City name should contain at least 2 characters'
                          %}
                        </div>

                        <div class="form-group">
                          {% capture zip_id %}EditAddress_{{ address.id }}_Zip{% endcapture %}
                          {%
                            render 'form-field',
                            type: 'text',
                            id: zip_id,
                            name: 'address[zip]',
                            value: address.zip,
                            label: 'customer.addresses.zip' | t,
                            required: true,
                            pattern: '[0-9A-Za-z\s\-]{3,10}',
                            title: 'customer.addresses.zip_min_length' | t | default: 'Postal/ZIP code should be 3-10 characters'
                          %}
                        </div>
                      </div>

                      <div class="form-row">
                        <div class="form-group">
                          <label for="AddressCountry_{{ address.id }}">{{ 'customer.addresses.country' | t }}</label>
                          <div class="select-wrapper">
                            <select
                              id="AddressCountry_{{ address.id }}"
                              name="address[country]"
                              data-address-country-select
                              data-form-id="{{ address.id }}"
                              data-default="{{ address.country }}"
                              required
                            >
                              {{ all_country_option_tags }}
                            </select>
                          </div>
                        </div>

                        <div class="form-group" id="AddressProvinceContainer_{{ address.id }}" style="display:none;">
                          <label for="AddressProvince_{{ address.id }}">{{ 'customer.addresses.province' | t }}</label>
                          <div class="select-wrapper">
                            <select
                              id="AddressProvince_{{ address.id }}"
                              name="address[province]"
                              data-default="{{ address.province }}"
                            ></select>
                          </div>
                        </div>
                      </div>

                      {% if address != customer.default_address %}
                        <div class="form-group">
                          {%
                            render 'checkbox-field',
                            id: 'address_default_address_' | append: address.id,
                            name: 'address[default]',
                            value: '1',
                            label: 'customer.addresses.set_default' | t
                          %}
                        </div>
                      {% endif %}

                      <div class="form-actions">
                        <button type="submit" class="button btn">
                          <span class="btn-text">{{ 'customer.addresses.update' | t }}</span>
                          <span class="btn-spinner"></span>
                        </button>
                        <button
                          type="reset"
                          class="button button--tertiary"
                        >
                          {{ 'customer.addresses.cancel' | t }}
                        </button>
                      </div>
                    {% endform %}
                  </div>
                </div>
              {% endif %}
            {%- endfor -%}

            <!-- Add Address Form -->
            <div id="AddressNewForm" class="address-wrapper" style="display: none;">
              {% form 'customer_address', customer.new_address, class: 'address-form' %}
                <div class="form-row mb-0">
                  <div class="form-group mb-1">
                    {%
                      render 'form-field',
                      type: 'text',
                      id: 'AddressFirstName_new',
                      name: 'address[first_name]',
                      value: '',
                      label: 'customer.addresses.first_name' | t,
                      required: true,
                      min_length: '2',
                      title: 'customer.addresses.first_name_min_length' | t | default: 'First name should contain at least 2 characters'
                    %}
                  </div>

                  <div class="form-group mb-1">
                    {%
                      render 'form-field',
                      type: 'text',
                      id: 'AddressLastName_new',
                      name: 'address[last_name]',
                      value: '',
                      label: 'customer.addresses.last_name' | t,
                      required: true,
                      min_length: '2',
                      title: 'customer.addresses.last_name_min_length' | t | default: 'Last name should contain at least 2 characters'
                    %}
                  </div>
                </div>

                <div class="form-row mb-0">
                  <div class="form-group pt-7">
                    {%
                      render 'form-field',
                      type: 'text',
                      id: 'AddressCompany_new',
                      name: 'address[company]',
                      value: '',
                      label: 'customer.addresses.company' | t
                    %}
                  </div>

                  <div class="form-group">
                    {%
                      render 'phone-field',
                      id: 'AddressPhone_new',
                      name: 'address[phone]',
                      value: '',
                      label: 'customer.addresses.phone' | t,
                      required: true
                    %}
                  </div>
                </div>

                <div class="form-group">
                  {%
                    render 'form-field',
                    type: 'text',
                    id: 'AddressAddress1_new',
                    name: 'address[address1]',
                    value: '',
                    label: 'customer.addresses.address1' | t,
                    required: true,
                    min_length: '5',
                    title: 'customer.addresses.address_min_length' | t | default: 'Address should be at least 5 characters long'
                  %}
                </div>

                <div class="form-group">
                  {%
                    render 'form-field',
                    type: 'text',
                    id: 'AddressAddress2_new',
                    name: 'address[address2]',
                    value: '',
                    label: 'customer.addresses.address2' | t
                  %}
                </div>

                <div class="form-row mb-0">
                  <div class="form-group">
                    {%
                      render 'form-field',
                      type: 'text',
                      id: 'AddressCity_new',
                      name: 'address[city]',
                      value: '',
                      label: 'customer.addresses.city' | t,
                      required: true,
                      min_length: '2',
                      title: 'customer.addresses.city_min_length' | t | default: 'City name should contain at least 2 characters'
                    %}
                  </div>

                  <div class="form-group">
                    {%
                      render 'form-field',
                      type: 'text',
                      id: 'AddressZip_new',
                      name: 'address[zip]',
                      value: '',
                      label: 'customer.addresses.zip' | t,
                      required: true,
                      pattern: '[0-9A-Za-z\s\-]{3,10}',
                      title: 'customer.addresses.zip_min_length' | t | default: 'Postal/ZIP code should be 3-10 characters'
                    %}
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
                    <div class="select-wrapper">
                      <select
                        id="AddressCountryNew"
                        name="address[country]"
                        data-address-country-select
                        data-form-id="new"
                        data-default=""
                        required
                      >
                        {{ all_country_option_tags }}
                      </select>
                    </div>
                  </div>

                  <div class="form-group" id="AddressProvinceContainerNew" style="display:none;">
                    <label for="AddressProvinceNew">{{ 'customer.addresses.province' | t }}</label>
                    <div class="select-wrapper">
                      <select
                        id="AddressProvinceNew"
                        name="address[province]"
                        data-default=""
                      ></select>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  {%
                    render 'checkbox-field',
                    id: 'address_default_address_new',
                    name: 'address[default]',
                    value: '1',
                    label: 'customer.addresses.set_default' | t
                  %}
                </div>

                <div class="form-actions">
                  <button type="submit" class="button btn" id="AddressSubmit">
                    <span class="btn-text">{{ 'customer.addresses.add' | t }}</span>
                    <span class="btn-spinner"></span>
                  </button>
                  <button
                    type="reset"
                    class="button button--tertiary"
                  >
                    {{ 'customer.addresses.cancel' | t }}
                  </button>
                </div>
              {% endform %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

