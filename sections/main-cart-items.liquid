{{ 'nf-cart.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Styles for variant dropdown */
  .nf-cart-item__variant-selector {
    position: relative;
    display: inline-block;
  }

  .nf-cart-item__variant-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent;
    border: none;
    padding-right: 20px;
    font-size: inherit;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
    outline: none;
  }

  .nf-cart-item__variant-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* Error message styles */
  .cart-errors,
  .cart-item__error-text {
    color: #d20000;
    font-size: 0.875rem;
    margin: 0.5rem 0;
    padding: 0.5rem;
    background-color: rgba(210, 0, 0, 0.07);
    border-radius: 4px;
    text-align: center;
  }

  .cart-errors.hidden,
  .cart-item__error-text.hidden {
    display: none;
  }

  /* Loading spinner styles */
  .nf-cart-item__grid .loading__spinner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.7);
    z-index: 5;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .nf-cart-item__grid {
    position: relative;
  }

  .nf-cart-item__grid .loading__spinner::after {
    content: '';
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #ccc;
    border-top-color: #000;
    animation: spin 1s linear infinite;
  }

  /* Quantity loading indicator */
  .quantity-loading-indicator {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .quantity-loading-indicator.hidden {
    display: none;
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Price display styles */
  .nf-cart-item__price {
    text-align: right;
    min-width: 120px;
  }

  .nf-cart-item__unit-prices {
    margin-bottom: 0.25rem;
  }

  .nf-cart-item__line-total {
    font-weight: 600;
    font-size: 1.1em;
  }

  .nf-cart-item__price-regular.cart-item__old-price {
    text-decoration: line-through;
    color: #999;
    margin-right: 0.5rem;
  }

  .nf-cart-item__price-sale.cart-item__final-price {
    color: #d20000;
    font-weight: bold;
  }

  .price--end {
    text-align: right;
    justify-content: flex-end;
    display: flex;
  }

  .cart-item__old-price.price.price--end {
    text-decoration: line-through;
    color: #999;
    margin-right: 0.5rem;
  }

  /* Unit price styling */
  .unit-price {
    font-size: 0.875rem;
    color: #666;
    margin-top: 0.25rem;
    text-align: right;
  }

  .discounts__discount {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .discounts__discount svg {
    width: 16px;
    height: 16px;
    margin-right: 0.5rem;
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'cart-sync.js' | asset_url }}" defer="defer"></script>

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="nf-cart-header">
      {% if cart != empty %}
        <h1 class="title title--primary font-archivo-expanded font-extrabold text-2xl leading-7 my-0 uppercase">
          {{ 'sections.cart.title' | t }}
        </h1>
        {% comment %}
          <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
            {{- 'general.continue_shopping' | t -}}
          </a>
        {% endcomment %}
        <h2 class="nf-cart-summary__title my-0">{{ 'sections.cart.summary' | t | default: 'Summary' }}</h2>
      {% endif %}
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div id="cart-errors" class="cart-errors hidden">
        <!-- Error messages will be displayed here -->
      </div>
      <div class="nf-cart-wrapper">
        <div class="nf-cart-main">
          {% if cart != empty %}
            {% comment %}
              {% if section.settings.show_promo_banner %}
                <div class="nf-promo-banner">
                  <div class="nf-promo-banner__icon">i</div>
                  <p class="nf-promo-banner__text">{{ section.settings.promo_banner_text }}</p>
                </div>
              {% endif %}
            {% endcomment %}

            <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
              <div class="js-contents">
                {%- if cart != empty -%}
                  <ul class="nf-cart-items">
                    {%- for item in cart.items -%}
                      <li class="nf-cart-item" id="CartItem-{{ item.index | plus: 1 }}" data-item-key="{{ item.key }}">
                        <div class="nf-cart-item__grid">
                          <div class="loading__spinner hidden"></div>
                          <div class="nf-cart-item__media">
                            <div class="nf-cart-item__image-container">
                              {% comment %} Extract color value from variant options {% endcomment %}
                              {% assign color_value = null %}
                              {% if item.product.options contains 'Color' and item.variant.title contains '/' %}
                                {% assign variant_options = item.variant.title | split: ' / ' %}
                                {% assign color_index = 0 %}
                                {% for option in item.product.options %}
                                  {% if option == 'Color' %}
                                    {% break %}
                                  {% endif %}
                                  {% assign color_index = color_index | plus: 1 %}
                                {% endfor %}
                                {% assign color_value = variant_options[color_index] | default: null %}
                              {% elsif item.variant.title contains '/' %}
                                {% assign variant_options = item.variant.title | split: ' / ' %}
                                {% if variant_options.first != 'Default Title' %}
                                  {% assign color_value = variant_options.first %}
                                {% endif %}
                              {% endif %}

                              {% comment %} Try to get color-specific image {% endcomment %}
                              {% if color_value != blank %}
                                {% capture variant_image_url %}{% render 'get-variant-color-image',
                                  product: item.product,
                                  color_value: color_value,
                                  width: 300,
                                  height: 300,
                                  crop: 'center',
                                  image_type: 'M'
                                %}{% endcapture %}
                                {% assign variant_image_url = variant_image_url | strip %}
                              {% endif %}

                              {% if variant_image_url != blank %}
                                <img
                                  src="{{ variant_image_url }}"
                                  class="nf-cart-item__image"
                                  alt="{{ item.title | escape }}"
                                  loading="lazy"
                                  width="150"
                                  height="150"
                                >
                              {% elsif item.image %}
                                <img
                                  src="{{ item.image | image_url: width: 300 }}"
                                  class="nf-cart-item__image"
                                  alt="{{ item.image.alt | escape }}"
                                  loading="lazy"
                                  width="150"
                                  height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                                >
                              {% endif %}

                              {% if item.product.tags contains 'new' or item.product.tags contains 'Novinka' %}
                                <div class="nf-tag nf-tag--new">{{ 'products.product.new' | t | default: 'New' }}</div>
                              {% endif %}
                              {% if item.original_price != item.final_price %}
                                <div class="nf-tag nf-tag--sale">
                                  -
                                  {{-
                                    item.original_price
                                    | minus: item.final_price
                                    | times: 100.0
                                    | divided_by: item.original_price
                                    | round
                                  -}}
                                  %
                                </div>
                              {% endif %}
                            </div>
                          </div>

                          <div class="nf-cart-item__content">
                            <div class="nf-cart-item__info">
                              <div class="flex items-start justify-between">
                                <a href="{{ item.url }}" class="nf-cart-item__name">
                                  {{- item.product.title | escape -}}
                                </a>
                                <div class="nf-cart-item__price">
                                  {%- comment -%} Unit Price Display {%- endcomment -%}
                                  {%- if item.original_price != item.final_price -%}
                                    <div class="nf-cart-item__unit-prices">
                                      <span class="visually-hidden">
                                        {{- 'products.product.price.regular_price' | t -}}
                                      </span>
                                      <s class="nf-cart-item__price-regular cart-item__old-price">
                                        {{- item.original_price | money -}}
                                      </s>
                                      <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                                      <strong class="nf-cart-item__price-sale cart-item__final-price">
                                        {{- item.final_price | money -}}
                                      </strong>
                                    </div>
                                  {%- else -%}
                                    <span class="nf-cart-item__price-regular">{{ item.original_price | money }}</span>
                                  {%- endif -%}

                                  {%- comment -%} Line Total Price Display {%- endcomment -%}
                                  {% comment %}
                                    <div class="nf-cart-item__line-total">
                                      {%- if item.original_line_price != item.final_line_price -%}
                                        <div class="nf-cart-item__line-discounted-prices">
                                          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                                          <s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s>
                                          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                                          <span class="price price--end">{{ item.final_line_price | money }}</span>
                                        </div>
                                      {%- else -%}
                                        <span class="price price--end">{{ item.original_line_price | money }}</span>
                                      {%- endif -%}

                                      {%- if item.variant.available and item.unit_price_measurement -%}
                                        <div class="unit-price caption">
                                          <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                                          {{ item.unit_price | money }}
                                          <span aria-hidden="true">/</span>
                                          <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                                          {%- if item.unit_price_measurement.reference_value != 1 -%}
                                            {{- item.unit_price_measurement.reference_value -}}
                                          {%- endif -%}
                                          {{ item.unit_price_measurement.reference_unit }}
                                        </div>
                                      {%- endif -%}
                                    </div>
                                  {% endcomment %}
                                </div>
                              </div>

                              {% if item.product.description != blank %}
                                <p class="nf-cart-item__description">
                                  {{ item.product.description | strip_html | truncatewords: 15 }}
                                </p>
                              {% endif %}

                              <div class="nf-cart-item__variants">
                                {%- if item.product.has_only_default_variant == false -%}
                                  {%- for option in item.options_with_values -%}
                                    <div class="nf-cart-item__variant-item">
                                      <span class="nf-cart-item__variant-label">{{ option.name }}:</span>
                                      <span class="nf-cart-item__variant-value">{{ option.value }}</span>
                                    </div>
                                  {%- endfor -%}
                                {%- endif -%}

                                <div class="nf-cart-item__variant-item">
                                  <span class="nf-cart-item__variant-label">
                                    {{- 'products.product.quantity.label' | t }}:</span
                                  >
                                  <div class="nf-cart-item__variant-selector">
                                    <select
                                      class="nf-cart-item__variant-select focus:outline-none focus-visible:outline-none focus:ring-0"
                                      name="updates[{{ item.key }}]"
                                      data-item-key="{{ item.key }}"
                                      data-is-quantity="true"
                                      data-index="{{ item.key }}"
                                      data-previous-value="{{ item.quantity }}"
                                      step="1"
                                    >
                                      {%- for i in (1..20) -%}
                                        <option
                                          value="{{ i }}"
                                          {% if i == item.quantity %}
                                            selected
                                          {% endif %}
                                        >
                                          {{ i }}
                                        </option>
                                      {%- endfor -%}
                                    </select>
                                    <svg
                                      class="nf-cart-item__variant-arrow"
                                      width="10"
                                      height="6"
                                      viewBox="0 0 10 6"
                                      fill="none"
                                    >
                                      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1"/>
                                    </svg>
                                    <span class="quantity-loading-indicator hidden">
                                      <svg
                                        class="animate-spin -ml-1 mr-2 h-4 w-4 text-black"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                      >
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                      </svg>
                                    </span>
                                  </div>
                                </div>
                              </div>

                              <ul
                                class="discounts list-unstyled"
                                role="list"
                                aria-label="{{ 'customer.order.discount' | t }}"
                              >
                                {%- for discount in item.line_level_discount_allocations -%}
                                  <li class="discounts__discount">
                                    {{- 'icon-discount.svg' | inline_asset_content -}}
                                    {{ discount.discount_application.title | escape }}
                                  </li>
                                {%- endfor -%}
                              </ul>

                              <div class="nf-cart-item__actions text-[#3D3D3D] flex items-center">
                                <!-- Save for Later button will be injected here by save-for-later.js -->

                                <span class="border-l border-[#ccc] h-4"></span>

                                <cart-remove-button
                                  id="Remove-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.key }}"
                                  class=""
                                >
                                  <button
                                    type="button"
                                    class="nf-cart-item__action-btn nf-cart-item__action-btn--remove"
                                  >
                                    <span class="underline">{{ 'sections.cart.remove' | t | default: 'Remove' }}</span>
                                  </button>
                                </cart-remove-button>
                              </div>

                              <div
                                id="Line-item-error-{{ item.index | plus: 1 }}"
                                class="cart-item__error-text hidden"
                              ></div>
                            </div>
                          </div>
                        </div>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>

            {% if section.settings.show_related_products %}
              <div class="nf-related-products">
                <h2 class="nf-related-products__title">
                  {{ 'products.product.related_products' | t | default: 'You may also like' }}
                </h2>
                <!-- Related products content would go here - this requires product recommendations -->
              </div>
            {% endif %}

            {% if section.settings.show_wishlist_link %}
              <div class="nf-wishlist-link">
                <h2 class="nf-wishlist-link__title">
                  {{ 'products.product.wishlist' | t | default: 'Wishlist' }}
                </h2>
                <!-- Wishlist content would go here -->
              </div>
            {% endif %}
          {% endif %}
        </div>

        <div class="nf-cart-sidebar">
          <div class="nf-cart-summary">
            <div class="nf-cart-summary__total">
              <span class="nf-cart-summary__total-label">{{ 'cart.summary.total' | t | default: 'Total' }}</span>
              <span class="nf-cart-summary__total-value">{{ cart.total_price | money }}</span>
            </div>
            <p class="text-sm">
              {{
                'cart.general.shipping_at_checkout'
                | t
                | default: 'Taxes, discounts and shipping calculated at checkout.'
              }}
            </p>
          </div>

          <div class="nf-cart-checkout">
            <button type="submit" class="nf-cart-checkout__button" name="checkout" form="cart">
              <span class="button-text">{{ 'sections.cart.checkout' | t | default: 'Check out' }}</span>
              <span class="button-spinner" style="display: none;">
                {{- 'loading-spinner.svg' | inline_asset_content -}}
              </span>
            </button>

            {% if section.settings.show_login_button and shop.customer_accounts_enabled and customer == null %}
              <a href="{{ routes.account_login_url }}" class="nf-cart-login__button">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M8 8C10.2091 8 12 6.20914 12 4C12 1.79086 10.2091 0 8 0C5.79086 0 4 1.79086 4 4C4 6.20914 5.79086 8 8 8Z" fill="currentColor"/>
                  <path d="M8 9C5.33333 9 0 10.3333 0 13V16H16V13C16 10.3333 10.6667 9 8 9Z" fill="currentColor"/>
                </svg>
                {{ 'customer.login_page.sign_in' | t | default: 'Sign in' }}
              </a>
            {% endif %}
          </div>

          {% if section.settings.show_loyalty_benefits %}
            <div class="nf-cart-benefits">
              <h3 class="nf-cart-benefits__title">
                {{ 'cart.benefits.title' | t | default: 'Benefits for registered customers' }}
              </h3>

              <div class="nf-cart-benefits__loyalty">
                <div class="nf-cart-benefits__icon flex items-center gap-1">
                  <span class="svg-wrapper [&_svg]:size-[1.125rem]">
                    {{- 'icon-currency.svg' | inline_asset_content -}}
                  </span>
                  <h4 class="nf-cart-benefits__loyalty-title">
                    {{ 'cart.benefits.loyalty' | t | default: 'Loyalty bonus' }}
                  </h4>
                </div>
                <ul class="nf-cart-benefits__loyalty-list">
                  <li class="nf-cart-benefits__loyalty-item">
                    <span class="nf-cart-benefits__loyalty-bullet"></span>
                    <p>
                      {{
                        'cart.benefits.loyalty_text_1'
                        | t
                        | default: 'Register and earn a loyalty bonus for every purchase.'
                      }}
                    </p>
                  </li>
                  <li class="nf-cart-benefits__loyalty-item">
                    <span class="nf-cart-benefits__loyalty-bullet"></span>
                    <p>
                      {{
                        'cart.benefits.loyalty_text_2'
                        | t
                        | default: 'The bonus will be credited to your account on the 15th day after delivery.'
                      }}
                    </p>
                  </li>
                  <li class="nf-cart-benefits__loyalty-item">
                    <span class="nf-cart-benefits__loyalty-bullet"></span>
                    <p>
                      {{
                        'cart.benefits.loyalty_text_3'
                        | t
                        | default: 'You can deduct it from your next purchase, up to 25% of its value.'
                      }}
                    </p>
                  </li>
                  <li class="nf-cart-benefits__loyalty-item">
                    <span class="nf-cart-benefits__loyalty-bullet"></span>
                    <p>
                      {{
                        'cart.benefits.loyalty_text_4'
                        | t
                        | default: 'We recommend using the bonus within the next 150 days.'
                      }}
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>

    <div id="main-cart-footer" data-id="{{ section.id }}">
      <div class="js-contents">
        {%- if cart != empty -%}
          <div class="cart__footer">
            <!-- Cart footer content is handled by cart.js -->
            <!-- This section should only contain cart summary information, not line items -->
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-items>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const cartForm = document.getElementById('cart');
    const cartTotalElement = document.querySelector('.nf-cart-summary__total-value');

    // Function to update the cart total display
    function updateCartTotal(cartData) {
      if (!cartTotalElement || !cartData) return;

      // Format the total price using the Shopify money format
      const totalPrice = cartData.total_price || cartData.items_subtotal_price || 0;

      // Use the Shopify money format from the window object if available
      if (window.Shopify && window.Shopify.formatMoney) {
        cartTotalElement.textContent = window.Shopify.formatMoney(totalPrice);
      } else {
        // Simple fallback formatting if Shopify.formatMoney is not available
        const formattedPrice = (totalPrice / 100).toFixed(2);
        cartTotalElement.textContent = `€${formattedPrice}`;
      }
    }

    // Listen for cart update events
    if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS === 'object') {
      subscribe(PUB_SUB_EVENTS.cartUpdate, (event) => {
        if (event.cartData) {
          updateCartTotal(event.cartData);
        }

        // Auto reload page when cart is updated from external sources (like wishlist app)
        // to ensure cart items are properly refreshed
        if (event.source && event.source !== 'cart-items' && event.source !== 'cart-sync') {
          // Immediate reload without delay since we're skipping notification
          window.location.reload();
        }
      });
    }

    // Set up a global flag to indicate we're on cart page
    window.isCartPage = true;

    // Handle quantity changes
    const quantitySelects = document.querySelectorAll('.nf-cart-item__variant-select[data-is-quantity="true"]');

    // Initialize previous value for all quantity selects
    quantitySelects.forEach((select) => {
      // Store the initial value as the previous value
      select.setAttribute('data-previous-value', select.value);

      // Add focus event to store the current value before it changes
      select.addEventListener('focus', function () {
        // Store the current value as the previous value when the select is focused
        this.setAttribute('data-old-value', this.value);
      });
    });

    quantitySelects.forEach((select) => {
      select.addEventListener('change', function (event) {
        event.preventDefault();

        // Get the cart-items component
        const cartItems = document.querySelector('cart-items');
        if (cartItems) {
          // Use the cart-items component's updateQuantity method
          const itemKey = this.dataset.itemKey;
          const newQuantity = parseInt(this.value);

          if (itemKey && !isNaN(newQuantity)) {
            // Get the old value that was stored on focus
            const oldValue = this.getAttribute('data-old-value') || this.getAttribute('data-previous-value');

            // Store the old value for error recovery
            this.setAttribute('data-previous-value', oldValue);

            // Show loading indicator
            const loadingIndicator = this.parentNode.querySelector('.quantity-loading-indicator');
            if (loadingIndicator) {
              loadingIndicator.classList.remove('hidden');
            }

            // Hide the dropdown arrow while loading
            const arrow = this.parentNode.querySelector('.nf-cart-item__variant-arrow');
            if (arrow) {
              arrow.classList.add('hidden');
            }

            // Disable the select while loading
            this.disabled = true;

            // Update the cart
            cartItems.updateQuantity(itemKey, newQuantity);

            // Re-enable the select and hide loading indicator after a timeout (in case the request fails silently)
            setTimeout(() => {
              if (loadingIndicator) {
                loadingIndicator.classList.add('hidden');
              }
              if (arrow) {
                arrow.classList.remove('hidden');
              }
              this.disabled = false;
            }, 5000); // 5 second timeout as a fallback
          }
        }
      });
    });

    // Prevent the default form submission
    cartForm.addEventListener('submit', async function (event) {
      // Only prevent default if it's a quantity change
      // Allow checkout button to work normally
      if (event.submitter && event.submitter.name === 'checkout') {
        // Validate cart before checkout if cart sync is available
        if (window.cartSyncManager) {
          event.preventDefault();

          const isValid = await window.cartSyncManager.validateBeforeCheckout();
          if (isValid) {
            // Proceed with checkout by creating a new form to avoid event listeners
            event.submitter.disabled = true;
            event.submitter.textContent = 'Processing...';

            // Create a new form element to avoid any existing event listeners
            const newForm = document.createElement('form');
            newForm.method = 'POST';
            newForm.action = cartForm.action;

            // Copy all form data
            const formData = new FormData(cartForm);
            for (let [key, value] of formData.entries()) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = key;
              input.value = value;
              newForm.appendChild(input);
            }

            // Add checkout parameter
            const checkoutInput = document.createElement('input');
            checkoutInput.type = 'hidden';
            checkoutInput.name = 'checkout';
            checkoutInput.value = 'checkout';
            newForm.appendChild(checkoutInput);

            document.body.appendChild(newForm);
            newForm.submit();
          } else {
            // User chose to review cart, do nothing
            console.log('[CartSync] User chose to review cart before checkout');
          }
          return false;
        }
        return true;
      }

      event.preventDefault();
      return false;
    });
  });
</script>

