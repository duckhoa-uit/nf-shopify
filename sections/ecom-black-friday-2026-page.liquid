.nfbf ._gated ._grid12{filter:blur(6px);pointer-events:none;user-select:none}
/* ---- benefit cards (F1) ---- */
.nfbf ._benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin-top:28px}
.nfbf ._bcard{padding:0;display:flex;flex-direction:column;align-items:center}
.nfbf ._bicon{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:#C4151C;color:#fff;margin-bottom:16px}
.nfbf ._bicon svg{width:20px;height:20px}
.nfbf ._bcard h3{font-family:'Archivo',Helvetica,Arial,sans-serif;font-size:14.5px;font-weight:800;text-transform:uppercase;margin-bottom:6px}
.nfbf ._bcard p{font-size:13px;color:#5B6472;line-height:1.5}
@media(max-width:900px){.nfbf ._benefits{grid-template-columns:1fr;gap:28px}}
/* ---- FAQ ---- */
.nfbf ._faqwrap{max-width:680px;margin:0 auto}
.nfbf ._faqwrap h2{font-family:'Archivo',Helvetica,Arial,sans-serif;font-size:clamp(20px,2.4vw,28px);font-weight:800;text-transform:uppercase;margin-bottom:16px;text-align:center}
.nfbf ._faqrow{border-bottom:1px solid #E5E7EB}
.nfbf ._faqq{width:100%;padding:16px 0;font-size:14.5px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;text-align:left}
.nfbf ._faqx{font-size:18px;color:#5B6472;flex:none;transition:transform .25s ease}
.nfbf ._faqrow[data-open="true"] ._faqx{transform:rotate(45deg)}
.nfbf ._faqpanel{max-height:0;overflow:hidden;transition:max-height .3s ease}
.nfbf ._faqpanel p{padding-bottom:16px;font-size:13.5px;color:#5B6472;line-height:1.55}
</style>
<div class="nfbf"><div class="_wrap" style="padding-top:48px;padding-bottom:56px;"><div class="_faqwrap" id="bfFaq"><h2><span data-t="faq.heading">Časté otázky</span></h2><div class="_faqrow" data-open="true">
 <button class="_faqq"><span data-t="faq.q1">Kedy začína Black Friday?</span><span class="_faqx">+</span></button>
 <div class="_faqpanel"><p><span data-t="faq.a1">Verejný predaj beží od 10. novembra do 2. decembra 23:59. Členovia NF Flowline nakupujú už od 5. novembra.</span></p></div>
 </div><div class="_faqrow">
 <button class="_faqq"><span data-t="faq.q2">Čo je NF Flowline?</span><span class="_faqx">+</span></button>
 <div class="_faqpanel"><p><span data-t="faq.a2">Členský program s early access, dopravou zadarmo a vernostnými bodmi.</span></p></div>
 </div><div class="_faqrow">
 <button class="_faqq"><span data-t="faq.q3">Môžem vrátiť tovar kúpený počas Black Friday?</span><span class="_faqx">+</span></button>
 <div class="_faqpanel"><p><span data-t="faq.a3">Áno — vrátenie je predĺžené do 31. 12. 2026, takže sa to dá kúpiť aj ako darček. Na SK a CZ je vrátenie zadarmo.</span></p></div>
 </div><div class="_faqrow">
 <button class="_faqq"><span data-t="faq.q4">Platia ceny po skončení akcie?</span><span class="_faqx">+</span></button>
 <div class="_faqpanel"><p><span data-t="faq.a4">Nie, ceny sa vracajú na pôvodné od 3. decembra.</span></p></div>
 </div></div>
<script>
(function(){
 var wrap = document.getElementById('bfFaq');
 if(!wrap) return;
 var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 wrap.querySelectorAll('._faqrow').forEach(function(row){
 var btn = row.querySelector('._faqq'), panel = row.querySelector('._faqpanel');
 function setOpen(open){
 row.setAttribute('data-open', open ? 'true' : 'false');
 if(reduce){ panel.style.maxHeight = open ? 'none' : '0'; return; }
 panel.style.maxHeight = open ? panel.scrollHeight + 'px' : '0';
 }
 setOpen(row.getAttribute('data-open') === 'true');
 btn.addEventListener('click', function(){ setOpen(row.getAttribute('data-open') !== 'true'); });
 });
})();
</script>
