<script>
(function(){
 function isMember(){ try{ return localStorage.getItem('nfMember')==='1'; }catch(e){ return false; } }
 function setMember(v){ try{ localStorage.setItem('nfMember', v?'1':'0'); }catch(e){} }
 function refreshState(){
 var state = document.getElementById('bfLoginState');
 if(state) state.hidden = !isMember();
 document.dispatchEvent(new CustomEvent('nfMemberChange'));
 }
 var lb = document.getElementById('bfLoginBtn'), rb = document.getElementById('bfRegisterBtn');
 if(lb) lb.addEventListener('click', function(){ setMember(true); refreshState(); });
