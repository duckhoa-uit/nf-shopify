<script>
(function(){
 var root = document.getElementById('nfau');
 if(!root || root.dataset.ready) return;
 root.dataset.ready = '1';
 /* EComposer sections can be transformed or clipped, which breaks position:fixed.
 Move the runtime UI to the document root once and it is viewport-fixed for good. */
 if(root.parentNode !== document.body) document.body.appendChild(root);
 var prog = root.querySelector('.u-prog'), fill = root.querySelector('.u-prog i');
 var jump = root.querySelector('.u-jump'), jbtn = root.querySelector('.u-jumpbtn');
 var top = root.querySelector('.u-top');
 jbtn.addEventListener('click', function(){
 var open = jump.getAttribute('data-open') === '1';
 jump.setAttribute('data-open', open ? '0' : '1');
 jbtn.setAttribute('aria-expanded', open ? 'false' : 'true');
 });
 jump.addEventListener('click', function(e){
 if(e.target.closest('a')){ jump.setAttribute('data-open','0'); jbtn.setAttribute('aria-expanded','false'); }
 });
 document.addEventListener('keydown', function(e){
 if(e.key === 'Escape'){ jump.setAttribute('data-open','0'); jbtn.setAttribute('aria-expanded','false'); }
 });
 top.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });
 /* progress is measured over the article body only, so it reads 100% at the end of
 the text rather than somewhere inside the footer */
 function track(){ return document.querySelector('#nfa.nfa-article'); }
 var raf = 0;
 function paint(){
 raf = 0;
 var t = track(), y = window.pageYOffset || document.documentElement.scrollTop, pct = 0, on = false;
 if(t){
 var box = t.getBoundingClientRect();
 var start = box.top + y - window.innerHeight * 0.35;
 var span = Math.max(1, t.offsetHeight - window.innerHeight * 0.35);
 pct = Math.min(1, Math.max(0, (y - start) / span));
 on = y > start;
 }
 prog.classList.toggle('is-on', on);
 fill.style.width = (pct * 100).toFixed(2) + '%';
 /* the bar only appears once there is a table of contents worth jumping around */
 if(!jump.hasAttribute('hidden')) jump.classList.toggle('is-on', on && pct < 0.985);
 top.classList.toggle('is-on', y > 900);
 }
 function onScroll(){ if(!raf) raf = requestAnimationFrame(paint); }
 window.addEventListener('scroll', onScroll, {passive:true});
 window.addEventListener('resize', onScroll, {passive:true});
 paint();
})();
