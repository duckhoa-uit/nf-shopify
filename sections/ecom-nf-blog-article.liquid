<script>
(function(){
 if(window.__nfaFilm) return; window.__nfaFilm = 1;
 function boot(){
 var box = document.querySelector('#nfa.nfa-extra [data-nfa-yt]');
 if(!box) return;
 var id = box.getAttribute('data-nfa-yt');
 function play(){
 if(box.dataset.playing) return;
 box.dataset.playing = '1';
 var f = document.createElement('iframe');
 f.src = 'https://www.youtube-nocookie.com/embed/' + id +
 '?autoplay=1&rel=0&modestbranding=1';
 f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; ' +
 'picture-in-picture; web-share';
 f.setAttribute('allowfullscreen',''); f.title = document.title;
 box.innerHTML = ''; box.appendChild(f);
 }
 var c = box.querySelector('.f-cover');
 if(c) c.addEventListener('click', play);
 /* the button plays inline but stays a real link, so middle-click still works
 and it degrades to YouTube with JS off */
 var l = document.querySelector('[data-nfa-playlink]');
 if(l) l.addEventListener('click', function(e){
 if(e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
 e.preventDefault();
 box.scrollIntoView({block:'center', behavior:'smooth'});
 play();
 });
 }
 if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
 else boot();
})();
</script>
