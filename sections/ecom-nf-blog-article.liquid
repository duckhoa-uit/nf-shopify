#nfa,#nfa *,#nfa *::before,#nfa *::after{box-sizing:border-box}
#nfa{width:100vw;position:relative;left:50%;transform:translateX(-50%);overflow-x:clip;
 --ink:#111111;--grey:#707072;--line:#e5e5e5;--soft:#f5f5f5;--hair:#dcdcdc;
 /* the scale from the buying-guide template, unchanged: fluid, anchored at 1280 and 1920 */
 --fs-body:clamp(15.5px,14px + .31vw,20px);--lh-body:1.6;
 --fs-h1:clamp(27px,23px + .47vw,32px);--lh-h1:1.2;
