 wrapper swallows the column span, and the vertical rhythm collapses to zero
 because a heading or paragraph that opens a wrapper has no previous sibling to
 take a margin from. Flattening them first lets every rule below apply to migrated
 posts exactly as it does to text written in Shopify's own editor. */
 var OURS = '.nfa-film,.nfa-prod,.nfa-tablewrap,.nfa-embed';
 var BLOCK = 'p,h1,h2,h3,h4,h5,h6,ul,ol,table,figure,img,picture,iframe,blockquote,hr,pre,div';
 var MEDIA = 'img,picture,iframe,svg';
 var INLINE = {A:1,SPAN:1,STRONG:1,B:1,EM:1,I:1,U:1,SMALL:1,CODE:1,BR:1,SVG:1,
 LABEL:1,SUP:1,SUB:1,ABBR:1,MARK:1,S:1,TIME:1};
 function unwrap(b){
 for(var pass = 0; pass < 8; pass++){
 var divs = [].slice.call(b.querySelectorAll('div')).filter(function(d){
 return !d.closest(OURS);
 });
 if(!divs.length) return;
 divs.forEach(function(d){
 var parent = d.parentNode;
 if(!parent) return;
 if(!d.querySelector(BLOCK)){
 /* a wrapper holding nothing but words is a paragraph the builder forgot to
 mark as one; unwrapping it would drop the words straight into the grid */
 var p = document.createElement('p');
 while(d.firstChild) p.appendChild(d.firstChild);
 parent.replaceChild(p, d);
 return;
 }
 while(d.firstChild) parent.insertBefore(d.firstChild, d);
 parent.removeChild(d);
 });
 }
 }
 /* Flattening can leave inline content — a stray <strong>, a text-only link, a run of
 words — sitting directly in the grid, where it becomes a cell of its own with no
 prose styling and no margin. Collect each such run back into a paragraph. An
 anchor that wraps an image is not inline: it stays a block so it can span. */
 function tidy(b){
 var node = b.firstChild, run = null;
 while(node){
 var next = node.nextSibling, loose = false;
 if(node.nodeType === 3){
 if((node.nodeValue || '').trim() !== '') loose = true;
 else { b.removeChild(node); node = next; continue; }
 } else if(node.nodeType === 1){
 loose = !!INLINE[(node.nodeName || '').toUpperCase()] && !node.querySelector(MEDIA);
 } else { b.removeChild(node); node = next; continue; }
 if(loose){
 if(!run){ run = document.createElement('p'); b.insertBefore(run, node); }
 run.appendChild(node);
 } else {
 run = null;
 }
 node = next;
 }
 }
 function normalise(b){
 unwrap(b);
 tidy(b);
 [].forEach.call(b.querySelectorAll('table'), function(t){
 if(t.parentElement && t.parentElement.classList.contains('nfa-tablewrap')) return;
 var w = document.createElement('div');
 w.className = 'nfa-tablewrap';
 t.parentNode.insertBefore(w, t); w.appendChild(t);
 });
 /* iframes the author pasted may sit inside a <p>; lift them so they can span */
 [].forEach.call(b.querySelectorAll('p > iframe:only-child'), function(f){
 var p = f.parentElement;
 p.parentNode.insertBefore(f, p); p.remove();
 });
 }
 /* ───────── 2 · shortcodes ─────────
 The escape hatch for guides that need media or products several times inside the
 text, which the rich-text editor cannot express:
 [video: YOUTUBE_ID]
 [products: handle-one, handle-two, handle-three]
 Anything that is not one of these is left alone. */
 var YT_RE = /^\s*\[video:\s*([\w-]{6,})\s*\]\s*$/i;
 var PR_RE = /^\s*\[products:\s*([^\]]+)\]\s*$/i;
 function ytBlock(id){
 var wrap = document.createElement('div');
 wrap.className = 'nfa-embed nfa-film';
 wrap.setAttribute('data-nfa-yt', id);
 wrap.innerHTML =
 '<button class="f-cover" type="button">' +
 '<img src="https://i.ytimg.com/vi/' + id + '/maxresdefault.jpg" ' +
 'width="1280" height="720" alt="" loading="lazy" decoding="async">' +
 '<span class="f-play"><span><svg width="22" height="22" viewBox="0 0 24 24" ' +
 'fill="#fff" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg></span></span>' +
 '</button>';
 wrap.querySelector('.f-cover').addEventListener('click', function(){ play(wrap, id); });
 return wrap;
 }
 function play(box, id){
 if(box.dataset.playing) return;
 box.dataset.playing = '1';
 var f = document.createElement('iframe');
 f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1';
 f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; ' +
 'picture-in-picture; web-share';
 f.setAttribute('allowfullscreen',''); f.title = document.title;
 box.innerHTML = ''; box.appendChild(f);
 }
 function money(cents){
 var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR';
 var loc = (window.Shopify && Shopify.locale) || 'en';
 try {
 return new Intl.NumberFormat(loc, {style:'currency', currency:cur,
 minimumFractionDigits:0, maximumFractionDigits:2}).format(cents/100);
 } catch(e){ return (cents/100).toFixed(2) + ' ' + cur; }
 }
 function productBlock(handles, labels){
 var box = document.createElement('aside');
 box.className = 'nfa-embed nfa-prod';
 var kick = document.createElement('p');
 kick.className = 'p-kicker'; kick.textContent = labels.from;
 var list = document.createElement('ul');
 list.className = 'p-rows';
 box.appendChild(kick); box.appendChild(list);
 handles.forEach(function(h){
 h = h.trim(); if(!h) return;
 /* no encodeURIComponent: a handle pasted from the address bar already carries
 %C2%AE for the ® in Vibram®, and encoding it again gives %25C2%25AE -> 404.
 Raw is safe either way — the browser encodes what still needs encoding. */
 fetch('/products/' + h + '.js', {headers:{'Accept':'application/json'}})
 .then(function(r){ if(!r.ok) throw 0; return r.json(); })
 .then(function(d){
 var img = (d.featured_image || (d.images||[])[0] || '');
 if(img && img.indexOf('//') === 0) img = 'https:' + img;
 var thumb = img ? img.split('?')[0] + '?width=300&height=200&crop=center' : '';
 /* Built through the DOM, not an HTML string. EComposer rewrites anything
 that looks like a relative link in an href attribute, and when that
 attribute lives inside a JS string it rewrites the closing quote too --
 which is a syntax error that kills this whole script. Absolute URLs are
 left alone, relative ones are not, so no href may be written as text. */
 var li = document.createElement('li');
 var a = document.createElement('a');
 a.setAttribute('href', '/products/' + d.handle);
 var media = document.createElement('div');
 media.className = 'p-media';
 if(thumb){
 var im = document.createElement('img');
 im.src = thumb; im.width = 300; im.height = 200; im.alt = '';
 im.loading = 'lazy'; im.decoding = 'async';
 media.appendChild(im);
 }
 var info = document.createElement('div'); info.className = 'p-info';
 var tp = document.createElement('div'); tp.className = 'p-top';
 var nm = document.createElement('p'); nm.className = 'p-name';
 nm.textContent = d.title;
 var pr = document.createElement('p'); pr.className = 'p-price';
 pr.textContent = money(d.price);
 var go = document.createElement('span'); go.className = 'p-go';
 go.textContent = labels.shop;
 tp.appendChild(nm); tp.appendChild(pr);
 info.appendChild(tp); info.appendChild(go);
 a.appendChild(media); a.appendChild(info);
 li.appendChild(a);
 list.appendChild(li);
 }).catch(function(){ /* a handle that no longer exists simply does not appear */ });
 });
 return box;
 }
 function shortcodes(b, labels){
 [].forEach.call(b.querySelectorAll('p'), function(p){
 var txt = p.textContent || '';
 var m = YT_RE.exec(txt);
 if(m){ p.parentNode.replaceChild(ytBlock(m[1]), p); return; }
 m = PR_RE.exec(txt);
 if(m){ p.parentNode.replaceChild(productBlock(m[1].split(','), labels), p); }
 });
 }
 /* ───────── 3 · table of contents ─────────
 Editors do not agree on heading level: some articles mark sections with h2,
 others start at h3. So take the shallowest level that occurs more than once and
 treat that as the section level. Ids are positional (nfa-sec-1, -2 …) rather than
 slugified, so headings in any alphabet get a stable anchor and no two can collide.
 With fewer than two sections there is nothing to navigate, so the rail and the
 mobile bar stay hidden instead of showing a list of one. */
 var heads = [], railLinks = [], jumpLinks = [];
 /* editors leave empty headings behind as spacing; they must not become blank rows */
 function named(b, sel){
 return [].slice.call(b.querySelectorAll(sel)).filter(function(h){
 return (h.textContent || '').trim() !== '';
 });
 }
 function sections(b){
 var levels = ['h1','h2','h3','h4'], i, pick = -1;
 for(i = 0; i < levels.length; i++){
 if(named(b, levels[i]).length > 1){ pick = i; break; }
 }
 if(pick < 0) return {tag: '', nodes: []};
 /* Take that level and everything shallower, in document order. A post can close
 with a lone h2 after a run of h3s — that is still a section, and picking one
 level alone would drop it out of the list. */
 return {tag: levels[pick], nodes: named(b, levels.slice(0, pick + 1).join(','))};
 }
 function fill(list){
 if(!list) return [];
 list.innerHTML = '';
 return heads.map(function(h){
 var li = document.createElement('li'), a = document.createElement('a');
 a.href = '#' + h.id; a.textContent = (h.textContent || '').trim();
 li.appendChild(a); list.appendChild(li);
 return a;
 });
 }
 function buildToc(b){
 var found = sections(b);
 heads = found.nodes;
 /* tells the CSS which level is acting as the section heading, so an article
 written entirely in h3 still gets section-sized headings */
 b.setAttribute('data-hl', found.tag);
 heads.forEach(function(h, i){ if(!h.id) h.id = 'nfa-sec-' + (i + 1); });
 var rail = document.querySelector('#nfa .a-rail');
 var bar = document.querySelector('#nfau .u-jump');
 if(heads.length < 2){
 if(rail) rail.hidden = true;
 if(bar) bar.hidden = true;
 return;
 }
 if(rail) rail.hidden = false;
 if(bar) bar.hidden = false;
 railLinks = fill(document.querySelector('#nfa [data-nfa-rail]'));
 jumpLinks = fill(document.querySelector('#nfau [data-nfa-jumptoc]'));
 spy();
 }
 function offset(){
 var bar = document.querySelector('#nfau .u-jump');
 var vis = bar && !bar.hidden && getComputedStyle(bar).display !== 'none'
 && bar.classList.contains('is-on');
 return vis ? 76 : 28;
 }
 document.addEventListener('click', function(e){
 var a = e.target.closest('#nfa .a-rail a, #nfau .u-jumplist a');
 if(!a) return;
 var t = document.getElementById(a.getAttribute('href').slice(1));
 if(!t) return;
 e.preventDefault();
 window.scrollTo({top: t.getBoundingClientRect().top + (window.pageYOffset||0) - offset(),
 behavior: reduce ? 'auto' : 'smooth'});
 if(history.replaceState) history.replaceState(null, '', '#' + t.id);
 });
 var raf = 0;
 function spy(){
 raf = 0;
 var probe = window.innerHeight * 0.28, active = -1;
 for(var i = 0; i < heads.length; i++){
 if(heads[i].getBoundingClientRect().top <= probe) active = i; else break;
 }
 [railLinks, jumpLinks].forEach(function(set){
 set.forEach(function(a, i){
 if(i === active) a.setAttribute('aria-current','true');
 else a.removeAttribute('aria-current');
 });
 });
 }
 window.addEventListener('scroll', function(){ if(!raf) raf = requestAnimationFrame(spy); },
 {passive:true});
 window.addEventListener('resize', function(){ if(!raf) raf = requestAnimationFrame(spy); },
 {passive:true});
 function boot(){
 /* a live article has exactly one body; looping costs nothing and means a page
 that somehow renders two of them still gets both normalised */
 var all = document.querySelectorAll('#nfa .a-body');
 if(!all.length) return;
 [].forEach.call(all, function(b){
 var labels = {from: b.getAttribute('data-l-from') || 'From this article',
 shop: b.getAttribute('data-l-shop') || 'Shop Now'};
 normalise(b);
 shortcodes(b, labels);
 });
 buildToc(all[0]);
 }
 if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
 else boot();
})();
