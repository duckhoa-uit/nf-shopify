{%- comment -%}
 Film and products, both optional and both from article metafields. If neither is
 set the section outputs nothing at all — an article without them must not show an
 empty box. Namespace is `custom`; the `default:` chain also tries `my_fields`, which
 is the other namespace Shopify installs by default.
 custom.video_url url or text — the film
 custom.products list.product_reference — the exact models (best relevance)
 custom.collection collection_reference — fallback: first 4 of a collection
{%- endcomment -%}
{%- assign nfa_video = article.metafields.custom.video_url.value
 | default: article.metafields.my_fields.video_url.value -%}
{%- assign yid = '' -%}
{%- if nfa_video contains 'youtu.be/' -%}
 {%- assign yid = nfa_video | split: 'youtu.be/' | last | split: '?' | first -%}
{%- elsif nfa_video contains 'v=' -%}
 {%- assign yid = nfa_video | split: 'v=' | last | split: '&' | first -%}
{%- endif -%}
{%- assign nfa_items = article.metafields.custom.products.value -%}
{%- assign nfa_coll = article.metafields.custom.collection.value -%}
{%- if nfa_items == blank and nfa_coll != blank -%}
 {%- assign nfa_items = nfa_coll.products -%}
{%- endif -%}
{%- if yid != blank or nfa_items != blank -%}
<style>
#nfa,#nfa *,#nfa *::before,#nfa *::after{box-sizing:border-box}
#nfa{width:100vw;position:relative;left:50%;transform:translateX(-50%);overflow-x:clip;
 --ink:#111111;--grey:#707072;--line:#e5e5e5;--soft:#f5f5f5;--hair:#dcdcdc;
 /* the scale from the buying-guide template, unchanged: fluid, anchored at 1280 and 1920 */
 --fs-body:clamp(15.5px,14px + .31vw,20px);--lh-body:1.6;
 --fs-h1:clamp(27px,23px + .47vw,32px);--lh-h1:1.2;
 --fs-h2:clamp(20px,16.5px + .39vw,24px);--lh-h2:1.25;
 --fs-h3:clamp(17px,14px + .45vw,22px);
 --fs-s:clamp(13.5px,11.5px + .23vw,16px);
 --fs-q:clamp(16.5px,14px + .31vw,20px);
 font-family:'Montserrat',system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
