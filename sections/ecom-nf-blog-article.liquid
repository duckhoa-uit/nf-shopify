 function fill(list){
 if(!list) return [];
 list.innerHTML = '';
 return heads.map(function(h){
 var li = document.createElement('li'), a = document.createElement('a');
 a.href = '#' + h.id; a.textContent = (h.textContent || '').trim();
 li.appendChild(a); list.appendChild(li);
