{%- comment -%}
 Related articles. The theme normally renders this, but `Apply for all blog post`
 replaces the theme's article template — so the template has to bring its own.
 Same blog, newest first, current article excluded, three shown.
{%- endcomment -%}
{%- assign nfa_rel = 0 -%}
{%- for a in article.blog.articles limit: 4 -%}
 {%- if a.id != article.id -%}{%- assign nfa_rel = nfa_rel | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if nfa_rel > 0 -%}
<style>
#nfa,#nfa *,#nfa *::before,#nfa *::after{box-sizing:border-box}
#nfa{width:100vw;position:relative;left:50%;transform:translateX(-50%);overflow-x:clip;
 --ink:#111111;--grey:#707072;--line:#e5e5e5;--soft:#f5f5f5;--hair:#dcdcdc;
 /* the scale from the buying-guide template, unchanged: fluid, anchored at 1280 and 1920 */
 --fs-body:clamp(15.5px,14px + .31vw,20px);--lh-body:1.6;
 --fs-h1:clamp(27px,23px + .47vw,32px);--lh-h1:1.2;
 --fs-h2:clamp(20px,16.5px + .39vw,24px);--lh-h2:1.25;
 --fs-h3:clamp(17px,15px + .22vw,20px);
 --fs-s:clamp(13.5px,11.5px + .23vw,16px);
 --fs-q:clamp(16.5px,14px + .31vw,20px);
 font-family:'Montserrat',system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
 font-weight:500;color:var(--ink);background:#fff;
 -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
#nfa h1,#nfa h2,#nfa h3,#nfa h4,#nfa p,#nfa ul,#nfa ol,#nfa li,#nfa figure,#nfa blockquote,
#nfa table{margin:0;padding:0}
#nfa a{color:inherit;text-decoration:none}
#nfa img{display:block;max-width:100%;height:auto}
#nfa button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
#nfa .nfa-grid{max-width:1440px;margin:0 auto;padding:0 48px;display:grid;
 grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px}
#nfa .nfa-col{grid-column:3 / span 6;min-width:0}
#nfa .nfa-full{grid-column:1 / -1;min-width:0}
#nfa .nfa-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
 clip:rect(0 0 0 0);white-space:nowrap;border:0}
#nfa a:focus-visible,#nfa button:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
#nfa .nfa-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;
 padding:0 22px;border-radius:2px;font-size:14.5px;font-weight:600;line-height:1;
 transition:background .15s ease,border-color .15s ease;white-space:nowrap}
#nfa .nfa-btn--dark{background:var(--ink);color:#fff}
#nfa .nfa-btn--dark:hover{background:#000}
#nfa .nfa-btn--dark:focus-visible{outline-color:#fff;outline-offset:-5px}
#nfa .nfa-btn--wide{width:100%;height:48px;font-size:15.5px}
@media (max-width:1023px){
 #nfa .nfa-grid{padding:0 24px;grid-template-columns:minmax(0,1fr);column-gap:0}
 #nfa .nfa-col,#nfa .nfa-full{grid-column:1}
}
/* ── film + product blocks ─────────────────────────────────────────────────
 In the shared prelude on purpose: they are used BOTH by the shortcodes inside the
 article body and by the metafield-driven section after it. Putting them in one
 section's own stylesheet would let a later section's copy of this prelude win on
 source order — that has bitten this project twice. */
#nfa .nfa-film{position:relative;background:var(--soft);margin-top:34px}
#nfa .nfa-film button.f-cover{display:block;width:100%;padding:0;position:relative;cursor:pointer}
#nfa .nfa-film img{width:100%;aspect-ratio:16/9;object-fit:cover;margin:0}
#nfa .nfa-film iframe{display:block;width:100%;aspect-ratio:16/9;border:0;margin:0}
#nfa .nfa-film .f-play{position:absolute;inset:0;display:flex;align-items:center;
 justify-content:center;pointer-events:none}
#nfa .nfa-film .f-play > span{width:64px;height:64px;border-radius:2px;
 background:rgba(17,17,17,.88);display:flex;align-items:center;justify-content:center;
 transition:background .15s ease,transform .15s ease}
#nfa .nfa-film button.f-cover:hover .f-play > span{background:#000;transform:scale(1.04)}
#nfa .nfa-prod{margin-top:34px;border:1px solid var(--line);padding:18px}
#nfa .nfa-prod .p-kicker{font-size:11px !important;font-weight:700;letter-spacing:.11em;
 text-transform:uppercase;color:var(--grey);line-height:1 !important;
 padding-bottom:13px;border-bottom:1px solid var(--line)}
#nfa .p-rows{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
#nfa .p-rows > li{padding:0}
#nfa .p-rows > li::before{display:none}
#nfa .p-rows > li + li{border-top:1px solid var(--line)}
#nfa .p-rows a{display:grid;grid-template-columns:140px minmax(0,1fr);gap:18px;
 align-items:center;padding:15px 0;text-decoration:none;font-weight:500}
#nfa .p-rows img{width:100%;aspect-ratio:3/2;object-fit:cover;background:var(--soft);margin:0}
#nfa .p-top{display:flex;align-items:baseline;justify-content:space-between;gap:14px}
#nfa .p-name{font-size:16.5px !important;line-height:1.25 !important;font-weight:700;
 letter-spacing:.02em;margin:0 !important}
#nfa .p-price{font-size:15px !important;line-height:1.4 !important;font-weight:600;
 margin:0 !important;white-space:nowrap}
#nfa .p-go{margin-top:8px;display:inline-flex;align-items:center;gap:7px;font-size:14px;
 font-weight:600;color:var(--grey);transition:color .15s ease}
#nfa .p-go::after{content:"\2192"}
#nfa .p-rows a:hover .p-name{text-decoration:underline;text-underline-offset:4px;
 text-decoration-thickness:1px}
#nfa .p-rows a:hover .p-go{color:var(--ink)}
@media (max-width:1023px){
 #nfa .nfa-prod{padding:16px}
 #nfa .p-rows a{grid-template-columns:92px minmax(0,1fr);gap:14px;padding:14px 0}
 #nfa .p-name{font-size:15.5px !important}
}
@media (prefers-reduced-motion:reduce){
 #nfa .nfa-film .f-play > span,#nfa .p-go{transition:none}
}
/* ── Section 5 · related articles ────────────────────────────────────────── */
#nfa.nfa-related{padding:clamp(24px,3vw,36px) 0 clamp(48px,5vw,72px)}
#nfa .r-head{margin-bottom:22px}
#nfa .r-head h2{font-size:var(--fs-h2);line-height:var(--lh-h2);font-weight:600;
 letter-spacing:-.01em}
#nfa .r-grid{list-style:none;margin:0;padding:0;display:grid;
 grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
#nfa .r-card a{display:block}
#nfa .r-card img{width:100%;aspect-ratio:3/2;object-fit:cover;background:var(--soft)}
#nfa .r-ph{width:100%;aspect-ratio:3/2;background:var(--soft)}
#nfa .r-cat{margin-top:16px;font-size:var(--fs-s);line-height:1.4;color:var(--grey)}
#nfa .r-title{margin-top:4px;font-size:var(--fs-q);line-height:1.3;font-weight:600;
 letter-spacing:-.01em}
#nfa .r-card a:hover .r-title{text-decoration:underline;text-underline-offset:4px;
 text-decoration-thickness:1px}
@media (max-width:1023px){
 #nfa .r-head{margin-bottom:0;padding-bottom:18px}
 #nfa .r-grid{display:block;border-top:1px solid var(--line)}
 #nfa .r-card{padding:22px 0}
 #nfa .r-card a{display:grid;grid-template-columns:minmax(0,1fr) 110px;gap:18px;
 align-items:start}
 #nfa .r-card .r-media{grid-column:2;grid-row:1 / span 2}
 #nfa .r-card img,#nfa .r-ph{aspect-ratio:1/1}
 #nfa .r-cat{grid-column:1;grid-row:1;margin-top:0}
 #nfa .r-title{grid-column:1;grid-row:2;margin-top:4px}
}
</style>
<section id="nfa" class="nfa-related" aria-labelledby="nfa-rel-h">
 <div class="nfa-grid">
 <div class="nfa-full r-head">
 <h2 id="nfa-rel-h">{{ t_rel }}</h2>
 </div>
 </div>
 <div class="nfa-grid">
 <ul class="nfa-full r-grid">
 {%- assign shown = 0 -%}
 {%- for a in article.blog.articles -%}
 {%- if a.id == article.id -%}{%- continue -%}{%- endif -%}
 {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
 {%- assign shown = shown | plus: 1 -%}
 <li class="r-card">
 <a href="{{ a.url }}">
 <div class="r-media">
 {%- if a.image %}
 <img src="{{ a.image | image_url: width: 600 }}"
 srcset="{{ a.image | image_url: width: 320 }} 320w,
 {{ a.image | image_url: width: 480 }} 480w,
 {{ a.image | image_url: width: 700 }} 700w"
 sizes="(min-width:1024px) 30vw, 110px"
 width="600" height="400"
 alt="{{ a.image.alt | default: a.title | escape }}"
 loading="lazy" decoding="async">
 {%- else %}
 <div class="r-ph"></div>
 {%- endif %}
 </div>
 {%- if a.tags.size > 0 %}
 <p class="r-cat">{{ a.tags | first | remove: 'cat:' | capitalize }}</p>
 {%- else %}
 <p class="r-cat">{{ a.published_at | date: format: 'date' }}</p>
 {%- endif %}
 <p class="r-title">{{ a.title }}</p>
 </a>
 </li>
 {%- endfor -%}
 </ul>
 </div>
</section>
{%- endif -%}</div></div> </div><div class="ecom-section__overlay"><div class="ecom-overlay"></div></div></section> 
</div></div>
