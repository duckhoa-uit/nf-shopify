<section id="nfa" class="nfa-article">
 <div class="nfa-grid">
 {%- comment -%}
 The rail is built by JS from the h2s the author wrote, and hides itself when
 there are fewer than two — a contents list of one item is worse than none.
 {%- endcomment -%}
 <nav class="a-rail" aria-label="{{ t_in | escape }}" hidden>
 <p class="a-rail-h">{{ t_in }}</p>
 <ol data-nfa-rail></ol>
 </nav>
 <div class="a-body"
 data-l-from="{{ t_from | escape }}"
 data-l-shop="{{ t_shop | escape }}">
 {{ article.content }}
 </div>
 </div>
</section>
