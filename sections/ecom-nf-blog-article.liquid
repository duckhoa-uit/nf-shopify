 });
 }
 function buildToc(b){
 heads = [].slice.call(b.querySelectorAll('h2'));
 heads.forEach(function(h, i){ if(!h.id) h.id = 'nfa-sec-' + (i + 1); });
 var rail = document.querySelector('#nfa .a-rail');
 var bar = document.querySelector('#nfau .u-jump');
 if(heads.length < 2){
 if(rail) rail.hidden = true;
 if(bar) bar.hidden = true;
 return;
 }
 if(rail) rail.hidden = false;
 if(bar) bar.hidden = false;
 railLinks = fill(document.querySelector('#nfa [data-nfa-rail]'));
 jumpLinks = fill(document.querySelector('#nfau [data-nfa-jumptoc]'));
 spy();
 }
 function offset(){
 var bar = document.querySelector('#nfau .u-jump');
 var vis = bar && !bar.hidden && getComputedStyle(bar).display !== 'none'
 && bar.classList.contains('is-on');
 return vis ? 76 : 28;
 }
 document.addEventListener('click', function(e){
 var a = e.target.closest('#nfa .a-rail a, #nfau .u-jumplist a');
 if(!a) return;
 var t = document.getElementById(a.getAttribute('href').slice(1));
 if(!t) return;
 e.preventDefault();
 window.scrollTo({top: t.getBoundingClientRect().top + (window.pageYOffset||0) - offset(),
