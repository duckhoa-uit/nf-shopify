<script>
(function(){
 if(window.__nfaBody) return;
 window.__nfaBody = 1;
 var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 function body(){ return document.querySelector('#nfa .a-body'); }
 /* ───────── 1 · make the editor's HTML safe to lay out ─────────
 Authors paste whatever the rich-text editor gives them. Two things need help:
 a table that would widen the page, and a bare YouTube URL on its own line. */
 function normalise(b){
 [].forEach.call(b.querySelectorAll('table'), function(t){
 if(t.parentElement && t.parentElement.classList.contains('nfa-tablewrap')) return;
 var w = document.createElement('div');
 w.className = 'nfa-tablewrap';
 t.parentNode.insertBefore(w, t); w.appendChild(t);
 });
 /* iframes the author pasted may sit inside a <p>; lift them so they can span */
 [].forEach.call(b.querySelectorAll('p > iframe:only-child'), function(f){
 var p = f.parentElement;
 p.parentNode.insertBefore(f, p); p.remove();
 });
 }
 /* ───────── 2 · shortcodes ─────────
 The escape hatch for guides that need media or products several times inside the
 text, which the rich-text editor cannot express:
 [video: YOUTUBE_ID]
 [products: handle-one, handle-two, handle-three]
 Anything that is not one of these is left alone. */
 var YT_RE = /^\s*\[video:\s*([\w-]{6,})\s*\]\s*$/i;
 var PR_RE = /^\s*\[products:\s*([^\]]+)\]\s*$/i;
 function ytBlock(id){
 var wrap = document.createElement('div');
 wrap.className = 'nfa-embed nfa-film';
 wrap.setAttribute('data-nfa-yt', id);
 wrap.innerHTML =
 '<button class="f-cover" type="button">' +
 '<img src="https://i.ytimg.com/vi/' + id + '/maxresdefault.jpg" ' +
 'width="1280" height="720" alt="" loading="lazy" decoding="async">' +
 '<span class="f-play"><span><svg width="22" height="22" viewBox="0 0 24 24" ' +
 'fill="#fff" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg></span></span>' +
 '</button>';
 wrap.querySelector('.f-cover').addEventListener('click', function(){ play(wrap, id); });
 return wrap;
 }
 function play(box, id){
 if(box.dataset.playing) return;
 box.dataset.playing = '1';
 var f = document.createElement('iframe');
 f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1';
 f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; ' +
 'picture-in-picture; web-share';
 f.setAttribute('allowfullscreen',''); f.title = document.title;
 box.innerHTML = ''; box.appendChild(f);
 }
 function money(cents){
 var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR';
 var loc = (window.Shopify && Shopify.locale) || 'en';
 try {
 return new Intl.NumberFormat(loc, {style:'currency', currency:cur,
 minimumFractionDigits:0, maximumFractionDigits:2}).format(cents/100);
 } catch(e){ return (cents/100).toFixed(2) + ' ' + cur; }
 }
 function productBlock(handles, labels){
 var box = document.createElement('aside');
 box.className = 'nfa-embed nfa-prod';
 box.innerHTML = '<p class="p-kicker">' + labels.from + '</p><ul class="p-rows"></ul>';
