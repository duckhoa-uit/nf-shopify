 fetch('/products/' + h + '.js', {headers:{'Accept':'application/json'}})
 .then(function(r){ if(!r.ok) throw 0; return r.json(); })
 .then(function(d){
 var img = (d.featured_image || (d.images||[])[0] || '');
 if(img && img.indexOf('//') === 0) img = 'https:' + img;
 var thumb = img ? img.split('?')[0] + '?width=300&height=200&crop=center' : '';
 var li = document.createElement('li');
 li.innerHTML =
 '<a href="{{ecom_root_url}}products/" + d.handle + '">' +
 '<div class="p-media">' + (thumb ?
 '<img src="' + thumb + '" width="300" height="200" alt="" loading="lazy">' : '') +
 '</div>' +
 '<div class="p-info"><div class="p-top">' +
 '<p class="p-name">' + d.title + '</p>' +
 '<p class="p-price">' + money(d.price) + '</p>' +
 '</div><span class="p-go">' + labels.shop + '</span></div>' +
 '</a>';
 list.appendChild(li);
 }).catch(function(){ /* a handle that no longer exists simply does not appear */ });
 });
