{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} isolate gradient discover_northfinder_element">
  <div class="section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">
    <div class="page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="text-center font-bold text-3xl mb-8 {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {%- for block in section.blocks -%}
          <div
            class="category-card relative overflow-hidden rounded-lg{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <div class="category-image-container relative aspect-[4/3] overflow-hidden">
                <img
                  srcset="
                    {%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | image_url: width: 535 }} 535w,{%- endif -%}
                    {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if block.settings.image.width >= 1070 -%}{{ block.settings.image | image_url: width: 1070 }} 1070w,{%- endif -%}
                    {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                  "
                  src="{{ block.settings.image | image_url: width: 535 }}"
                  sizes="(min-width: 1200px) 400px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                >
              </div>
            {%- else -%}
              <div class="category-image-container bg-foreground/10 aspect-[4/3] flex items-center justify-center">
                {{ 'image' | placeholder_svg_tag: 'w-full h-48 text-foreground/50' }}
              </div>
            {%- endif -%}

            <div class="category-info p-4">
              <h3 class="text-xl font-bold mb-4">{{ block.settings.category_title }}</h3>

              <div class="flex flex-wrap gap-2">
                {%- if block.settings.men_collection_url != blank -%}
                  <a
                    href="{{ block.settings.men_collection_url }}"
                    class="inline-block px-4 py-2 bg-white text-black text-sm font-medium rounded hover:bg-gray-100 transition-colors"
                  >
                    {{ 'For men' }}
                  </a>
                {%- endif -%}

                {%- if block.settings.women_collection_url != blank -%}
                  <a
                    href="{{ block.settings.women_collection_url }}"
                    class="inline-block px-4 py-2 bg-white text-black text-sm font-medium rounded hover:bg-gray-100 transition-colors"
                  >
                    {{ 'For women' }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Discover Categories",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "DISCOVER ON NORTHFINDER",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "name": "Category",
      "type": "category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "category_title",
          "default": "Category Title",
          "label": "Category title"
        },
        {
          "type": "url",
          "id": "men_collection_url",
          "label": "Men's collection link"
        },
        {
          "type": "url",
          "id": "women_collection_url",
          "label": "Women's collection link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discover Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "category_title": "Jackets"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "Fleece sweatshirts"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "Pants"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .category-card {
    transition: transform 0.3s ease-in-out;
  }

  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
{% endstylesheet %}
