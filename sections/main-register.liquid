{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer register section-{{ section.id }}-padding">
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <h2 class="form__message" tabindex="-1" autofocus>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        {{ 'templates.contact.form.error_heading' | t }}
      </h2>
      <ul>
        {%- for field in form.errors -%}
          <li>
            {%- if field == 'form' -%}
              {{ form.errors.messages[field] }}
            {%- else -%}
              <a href="#RegisterForm-{{ field }}">
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="field">
      <input
        type="text"
        name="customer[first_name]"
        id="RegisterForm-FirstName"
        {% if form.first_name %}
          value="{{ form.first_name }}"
        {% endif %}
        autocomplete="given-name"
        placeholder="{{ 'customer.register.first_name' | t }}"
      >
      <label for="RegisterForm-FirstName">
        {{ 'customer.register.first_name' | t }}
      </label>
    </div>
    <div class="field">
      <input
        type="text"
        name="customer[last_name]"
        id="RegisterForm-LastName"
        {% if form.last_name %}
          value="{{ form.last_name }}"
        {% endif %}
        autocomplete="family-name"
        placeholder="{{ 'customer.register.last_name' | t }}"
      >
      <label for="RegisterForm-LastName">
        {{ 'customer.register.last_name' | t }}
      </label>
    </div>
    <div class="field">
      <input
        type="email"
        name="customer[email]"
        id="RegisterForm-email"
        {% if form.email %}
          value="{{ form.email }}"
        {% endif %}
        spellcheck="false"
        autocapitalize="off"
        autocomplete="email"
        aria-required="true"
        {% if form.errors contains 'email' %}
          aria-invalid="true"
          aria-describedby="RegisterForm-email-error"
        {% endif %}
        placeholder="{{ 'customer.register.email' | t }}"
      >
      <label for="RegisterForm-email">
        {{ 'customer.register.email' | t }}
      </label>
    </div>
    {%- if form.errors contains 'email' -%}
      <span id="RegisterForm-email-error" class="form__message">
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        {{ form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email }}.
      </span>
    {%- endif -%}
    <div class="field">
      <input
        type="password"
        name="customer[password]"
        id="RegisterForm-password"
        aria-required="true"
        minlength="8"
        title="{{ 'customer.register.password_requirements' | t | default: 'Password must be at least 8 characters and include at least one uppercase letter, one lowercase letter, one number, and one special character' }}"
        {% if form.errors contains 'password' %}
          aria-invalid="true"
          aria-describedby="RegisterForm-password-error"
        {% endif %}
        placeholder="{{ 'customer.register.password' | t }}"
      >
      <label for="RegisterForm-password">
        {{ 'customer.register.password' | t }}
      </label>
    </div>
    <div class="password-requirements flex flex-col items-start text-xs mt-1 text-[#666666]">
      <p>
        {{ 'customer.register.password_requirements' | t | default: 'Password must meet the following requirements:' }}
      </p>
      <ul class="mt-1 ml-4 list-disc">
        <li class="requirement-length">At least 8 characters</li>
        <li class="requirement-lowercase">At least one lowercase letter</li>
        <li class="requirement-uppercase">At least one uppercase letter</li>
        <li class="requirement-number">At least one number</li>
        <li class="requirement-special">At least one special character</li>
      </ul>
    </div>
    {%- if form.errors contains 'password' -%}
      <span id="RegisterForm-password-error" class="form__message">
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        {{ form.errors.translated_fields.password | capitalize }}
        {{ form.errors.messages.password }}.
      </span>
    {%- endif -%}
    <button>
      {{ 'customer.register.submit' | t }}
    </button>
  {%- endform -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    console.log('DOM Content Loaded - Initializing password validation');

    // Get the form element - using the correct ID from the rendered DOM
    const registerForm = document.getElementById('create_customer');
    console.log('Register Form found:', !!registerForm);

    // Debug form details
    if (registerForm) {
      console.log('Form ID:', registerForm.id);
      console.log('Form Action:', registerForm.action);
      console.log('Form Method:', registerForm.method);
      console.log('Form has novalidate:', registerForm.hasAttribute('novalidate'));
    }

    // Add form submission validation
    if (registerForm) {
      // Disable the native form validation
      registerForm.setAttribute('novalidate', 'novalidate');
      console.log('Added novalidate attribute to form');

      // First, completely disable the form's native submit behavior
      registerForm.onsubmit = function() {
        console.log('Native onsubmit handler called - preventing default');
        return false;
      };

      // Add a submit event listener with capture phase to ensure it runs first
      registerForm.addEventListener('submit', function (e) {
        console.log('Form submit event triggered');

        // Always prevent the default submission first - multiple ways for redundancy
        if (e.preventDefault) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
        e.returnValue = false;
        console.log('Default form submission prevented');

        // Get the password input
        const passwordInput = document.getElementById('RegisterForm-password');
        console.log('Password input found:', !!passwordInput);

        if (passwordInput) {
          console.log('Password value:', passwordInput.value);

          // Validate the password
          const validation = validatePassword(passwordInput.value);
          console.log('Password validation result:', validation);

          if (!validation.isValid) {
            console.log('Password validation failed');

            // Get the password-requirements div directly from the form
            const requirementsEl = registerForm.querySelector('.password-requirements');
            console.log('Requirements element found:', !!requirementsEl);

            if (requirementsEl) {
              // Update individual requirement indicators
              const lengthEl = requirementsEl.querySelector('.requirement-length');
              const lowercaseEl = requirementsEl.querySelector('.requirement-lowercase');
              const uppercaseEl = requirementsEl.querySelector('.requirement-uppercase');
              const numberEl = requirementsEl.querySelector('.requirement-number');
              const specialEl = requirementsEl.querySelector('.requirement-special');

              console.log('Requirement elements found:', {
                length: !!lengthEl,
                lowercase: !!lowercaseEl,
                uppercase: !!uppercaseEl,
                number: !!numberEl,
                special: !!specialEl
              });

              // Update classes based on validation
              updateRequirementClass(lengthEl, validation.minLength);
              updateRequirementClass(lowercaseEl, validation.hasLowercase);
              updateRequirementClass(uppercaseEl, validation.hasUppercase);
              updateRequirementClass(numberEl, validation.hasNumber);
              updateRequirementClass(specialEl, validation.hasSpecial);
            }

            // Show error message
            passwordInput.setCustomValidity('Password must meet all requirements');
            passwordInput.reportValidity();
            passwordInput.focus();
            console.log('Form submission stopped due to invalid password');
            return false; // Stop here and don't submit
          } else {
            // Clear any previous validation message
            passwordInput.setCustomValidity('');
            console.log('Password validation passed');
          }
        }

        console.log('Proceeding with form submission');
        // If we get here, validation passed, so submit the form programmatically
        // Use setTimeout to ensure this happens after all other handlers
        setTimeout(function() {
          console.log('Submitting form programmatically');
          try {
            // Create a new submit event that bypasses our validation
            const submitEvent = new Event('submit-validated', { bubbles: true, cancelable: false });
            registerForm.dispatchEvent(submitEvent);

            // Submit the form directly
            registerForm.submit();
            console.log('Form submitted successfully');
          } catch (error) {
            console.error('Error submitting form:', error);

            // Fallback method - create a hidden submit button and click it
            const submitButton = document.createElement('button');
            submitButton.type = 'submit';
            submitButton.style.display = 'none';
            registerForm.appendChild(submitButton);
            submitButton.click();
            registerForm.removeChild(submitButton);
          }
        }, 10);

        return false;
      }, true); // true for capture phase
    }

    // Password validation functions
    function validatePassword(password) {
      const minLength = password.length >= 8;
      const hasLowercase = /[a-z]/.test(password);
      const hasUppercase = /[A-Z]/.test(password);
      const hasNumber = /\d/.test(password);
      const hasSpecial = /[!@#$%^&*()_+\-=\[\]{};':\"\\|,.<>\/?]/.test(password);

      return {
        minLength,
        hasLowercase,
        hasUppercase,
        hasNumber,
        hasSpecial,
        isValid: minLength && hasLowercase && hasUppercase && hasNumber && hasSpecial,
      };
    }

    // Setup password validation UI
    const passwordInput = document.getElementById('RegisterForm-password');
    console.log('Setting up real-time password validation for:', !!passwordInput);

    if (passwordInput) {
      // Add input event listener
      passwordInput.addEventListener('input', function () {
        console.log('Password input event triggered');
        const validation = validatePassword(this.value);
        console.log('Real-time validation result:', validation);

        // Get the form element directly
        const form = document.getElementById('create_customer');
        // Look for the password-requirements div in the form
        const requirementsEl = form ? form.querySelector('.password-requirements') : document.querySelector('.password-requirements');
        console.log('Requirements element found (real-time):', !!requirementsEl);

        if (requirementsEl) {
          // Update individual requirement indicators
          const lengthEl = requirementsEl.querySelector('.requirement-length');
          const lowercaseEl = requirementsEl.querySelector('.requirement-lowercase');
          const uppercaseEl = requirementsEl.querySelector('.requirement-uppercase');
          const numberEl = requirementsEl.querySelector('.requirement-number');
          const specialEl = requirementsEl.querySelector('.requirement-special');

          console.log('Real-time requirement elements found:', {
            length: !!lengthEl,
            lowercase: !!lowercaseEl,
            uppercase: !!uppercaseEl,
            number: !!numberEl,
            special: !!specialEl
          });

          // Update classes based on validation
          updateRequirementClass(lengthEl, validation.minLength);
          updateRequirementClass(lowercaseEl, validation.hasLowercase);
          updateRequirementClass(uppercaseEl, validation.hasUppercase);
          updateRequirementClass(numberEl, validation.hasNumber);
          updateRequirementClass(specialEl, validation.hasSpecial);

          // Update overall validation state
          if (validation.isValid) {
            this.setCustomValidity('');
            console.log('Real-time validation passed');
          } else if (this.value.length > 0) {
            this.setCustomValidity('Password must meet all requirements');
            console.log('Real-time validation failed');
          } else {
            this.setCustomValidity('');
            console.log('Empty password field');
          }
        }
      });

      // Also add a keyup event listener as a backup
      passwordInput.addEventListener('keyup', function() {
        console.log('Password keyup event triggered');
        // Trigger the input event handler
        const event = new Event('input', { bubbles: true });
        this.dispatchEvent(event);
      });

      // Helper function to update requirement class
      function updateRequirementClass(element, isValid) {
        if (!element) {
          console.log('Element not found for class update');
          return;
        }

        console.log('Updating element class:', element.textContent, 'isValid:', isValid);
        console.log('Before update - classList:', Array.from(element.classList));

        try {
          if (isValid) {
            element.classList.add('requirement-success');
            element.classList.remove('requirement-error');
            element.classList.remove('text-[#666666]');
            console.log('Added green class');
          } else {
            element.classList.add('requirement-error');
            element.classList.remove('requirement-success');
            element.classList.remove('text-[#666666]');
            console.log('Added red class');
          }

          // Force a repaint to ensure the changes take effect
          void element.offsetWidth;

          console.log('After update - classList:', Array.from(element.classList));
        } catch (error) {
          console.error('Error updating classes:', error);
        }
      }
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
