#nfwl-kat ._track{grid-template-columns:repeat(2,1fr);gap:10px;padding:0 20px}
#nfwl-kat ._kct{font-size:19px}
}
.nfwl ._trust{background:#111;padding:64px 0 68px}
.nfwl ._trust ._h2{font-size:clamp(26px,3.4vw,44px);font-weight:800;line-height:1;letter-spacing:-.02em;text-transform:uppercase;color:#fff}
.nfwl ._trust ._h2 ._hl{font-style:normal;color:#e3350e}
.nfwl ._stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:38px;border-top:1px solid rgba(255,255,255,.18);padding-top:40px}
.nfwl ._st{padding:0 28px;display:flex;flex-direction:column;border-left:1px solid rgba(255,255,255,.18)}
.nfwl ._st:first-child{border-left:0;padding-left:0}
.nfwl ._sv{font-size:clamp(32px,4.2vw,60px);font-weight:800;line-height:.95;letter-spacing:-.02em;color:#fff}
.nfwl ._sl{margin-top:10px;font-size:13px;font-weight:500;line-height:1.4;color:rgba(255,255,255,.72)}
@media(max-width:1023px){.nfwl ._trust{padding:48px 0 52px}.nfwl ._st{padding:0 16px}}
@media(max-width:767px){
.nfwl ._trust{padding:40px 0 44px}
.nfwl ._trust ._h2{font-size:26px}
.nfwl ._stats{grid-template-columns:1fr;gap:26px;margin-top:28px;padding-top:26px}
.nfwl ._st{padding:0;border-left:0}
.nfwl ._sv{font-size:36px}
}
</style>
