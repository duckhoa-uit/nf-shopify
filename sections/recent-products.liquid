{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'product-card-hover.js' | asset_url }}" defer></script>

{%- liquid
  assign heading_setting = section.settings.heading | default: ''
  assign heading_translated = 'sections.recent_products.heading' | t
  if heading_setting != blank
    assign heading_text = heading_setting
  else
    assign heading_text = heading_translated
  endif
-%}

{%- style -%}
  .recently-viewed-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: flex;
    overflow-x: hidden;
  }

  .recently-viewed-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 auto;
    width: 100%;
    margin-right: 36px;
  }

  @media screen and (min-width: 640px) {
    .recently-viewed-swiper:not(.swiper-initialized) .swiper-slide {
      width: calc((100% - 36px) / 2.2);
    }
  }

  @media screen and (min-width: 1024px) {
    .recently-viewed-swiper:not(.swiper-initialized) .swiper-slide {
      width: calc((100% - 72px) / 3.2);
    }
  }

  .recently-viewed .tag-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .recently-viewed .tag-container::-webkit-scrollbar {
    display: none;
  }
  .recently-viewed .tag-container ~ .shadow-left {
    opacity: var(--scroll-shadow-left, 0);
  }
  .recently-viewed .tag-container ~ .shadow-right {
    opacity: var(--scroll-shadow-right, 1);
  }

  /* Skeleton placeholder shown while server-rendered cards are being fetched */
  .recently-viewed__skeleton {
    background: #f3f3f3;
    border-radius: 4px;
    aspect-ratio: 1 / 1;
    width: 100%;
    animation: recently-viewed-pulse 1.4s ease-in-out infinite;
  }
  .recently-viewed__skeleton-line {
    background: #f3f3f3;
    border-radius: 2px;
    height: 14px;
    margin-top: 12px;
    animation: recently-viewed-pulse 1.4s ease-in-out infinite;
  }
  .recently-viewed__skeleton-line--short {
    width: 40%;
  }
  @keyframes recently-viewed-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }

  /* Fade-in for fetched cards */
  .recently-viewed .swiper-slide > .recently-viewed__card-host {
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .recently-viewed .swiper-slide > .recently-viewed__card-host.is-loaded {
    opacity: 1;
  }

  /* Hide whole section when no recently-viewed entries exist */
  .recently-viewed-section[hidden] {
    display: none !important;
  }
{%- endstyle -%}

<div
  class="recently-viewed-section page-width mt-4"
  data-recently-viewed-section
  data-routes-root="{{ routes.root_url }}"
  data-current-product-id="{% if product %}{{ product.id }}{% endif %}"
  hidden
>
  <h2 class="product-recommendations__heading font-archivo-expanded text-base lg:text-2xl font-semibold text-[#0f0f0f] mb-7">
    {{ heading_text | escape }}
  </h2>

  <div class="swiper recently-viewed-swiper w-full pb-5">
    <div class="swiper-wrapper recently-viewed">
      <!-- Skeleton + server-rendered cards injected here -->
    </div>
    <div class="swiper-scrollbar"></div>
    <div class="swiper-button-next">
      <span class="icon">
        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="56" height="56" rx="28" fill="white"></rect>
          <path d="M26 40L34 28L26 16" stroke="#0F0F0F" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
    <div class="swiper-button-prev">
      <span class="icon">
        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="56" height="56" rx="28" transform="matrix(-1 0 0 1 56 0)" fill="white"></rect>
          <path d="M30 40L22 28L30 16" stroke="#0F0F0F" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  // ---- Storage schema --------------------------------------------------
  // v3 stores only locale-stable identifiers. Cards are server-rendered on
  // demand via /products/{handle}?section_id=recent-product-card so they
  // always reflect the active locale + market currency.
  var STORAGE_KEY = 'recentlyViewedProduct';
  var VERSION_KEY = 'recentlyViewedProductVersion';
  var SCHEMA_VERSION = '3';
  var MAX_PRODUCTS = 8;

  function readList() {
    if (localStorage.getItem(VERSION_KEY) !== SCHEMA_VERSION) {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.setItem(VERSION_KEY, SCHEMA_VERSION);
      return [];
    }
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      var parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      // Filter to entries that match the v3 shape.
      return parsed.filter(function (e) {
        return e && typeof e.id !== 'undefined' && typeof e.handle === 'string' && e.handle.length > 0;
      });
    } catch (err) {
      return [];
    }
  }

  function writeList(list) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    localStorage.setItem(VERSION_KEY, SCHEMA_VERSION);
  }

  // ---- Capture current PDP product ------------------------------------
  {%- if product and product != empty -%}
  (function captureCurrent() {
    var entry = {
      id: {{ product.id | json }},
      handle: {{ product.handle | json }},
      viewedAt: Date.now()
    };
    var list = readList().filter(function (e) { return String(e.id) !== String(entry.id); });
    list.unshift(entry);
    if (list.length > MAX_PRODUCTS) list.length = MAX_PRODUCTS;
    writeList(list);
  })();
  {%- endif -%}

  // ---- Render ---------------------------------------------------------
  var section = document.querySelector('[data-recently-viewed-section]');
  if (!section) return;

  var routesRoot = section.getAttribute('data-routes-root') || '/';
  if (routesRoot.charAt(routesRoot.length - 1) !== '/') routesRoot += '/';
  var currentProductId = section.getAttribute('data-current-product-id') || '';
  var wrapper = section.querySelector('.recently-viewed');

  function buildSkeletonSlide() {
    var slide = document.createElement('div');
    slide.className = 'swiper-slide';
    slide.innerHTML = [
      '<div class="card-wrapper h-full">',
      '  <div class="flex flex-col h-full relative">',
      '    <div class="recently-viewed__skeleton"></div>',
      '    <div class="recently-viewed__skeleton-line"></div>',
      '    <div class="recently-viewed__skeleton-line recently-viewed__skeleton-line--short"></div>',
      '  </div>',
      '</div>'
    ].join('\n');
    return slide;
  }

  function buildCardSlide(html) {
    var slide = document.createElement('div');
    slide.className = 'swiper-slide';
    var host = document.createElement('div');
    host.className = 'recently-viewed__card-host';
    host.innerHTML = html;
    slide.appendChild(host);
    requestAnimationFrame(function () { host.classList.add('is-loaded'); });
    return slide;
  }

  function fetchCardHTML(handle) {
    var url = routesRoot + 'products/' + encodeURIComponent(handle) + '?section_id=recent-product-card';
    return fetch(url, { credentials: 'same-origin' })
      .then(function (res) { return res.ok ? res.text() : null; })
      .catch(function () { return null; });
  }

  function initSwiper() {
    if (typeof Swiper === 'undefined') return null;
    return new Swiper('.recently-viewed-swiper', {
      direction: 'horizontal',
      spaceBetween: 36,
      grabCursor: true,
      breakpoints: {
        320:  { slidesPerView: 1 },
        640:  { slidesPerView: 3 },
        1200: { slidesPerView: 4 }
      },
      navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
      scrollbar:  { el: '.swiper-scrollbar' }
    });
  }

  function initHover() {
    if (window.productCardHover && typeof window.productCardHover.reinitialize === 'function') {
      window.productCardHover.reinitialize();
    } else if (typeof window.ProductCardHover === 'function') {
      window.productCardHover = new window.ProductCardHover();
    }
  }

  function whenLibsReady() {
    return new Promise(function (resolve) {
      var swiperReady = typeof Swiper !== 'undefined';
      var hoverReady  = typeof ProductCardHover !== 'undefined';
      if (swiperReady && hoverReady) return resolve();

      var swiperScript = document.querySelector('script[src*="swiper-bundle.min.js"]');
      var hoverScript  = document.querySelector('script[src*="product-card-hover.js"]');
      var pending = 0;

      function done() { if (--pending <= 0) resolve(); }
      if (!swiperReady && swiperScript) { pending++; swiperScript.addEventListener('load', done, { once: true }); }
      if (!hoverReady && hoverScript)   { pending++; hoverScript.addEventListener('load', done, { once: true }); }
      if (pending === 0) resolve();
    });
  }

  function render() {
    var list = readList().filter(function (e) {
      return !currentProductId || String(e.id) !== String(currentProductId);
    });
    if (list.length === 0) {
      section.setAttribute('hidden', '');
      return;
    }
    section.removeAttribute('hidden');

    // 1. Insert skeletons immediately to prevent CLS
    wrapper.innerHTML = '';
    var skeletons = list.map(function () {
      var s = buildSkeletonSlide();
      wrapper.appendChild(s);
      return s;
    });

    // 2. Init Swiper on skeletons so the carousel structure is stable
    var swiperInstance = null;
    whenLibsReady().then(function () {
      swiperInstance = initSwiper();

      // 3. Fetch all cards in parallel, replace skeletons as they arrive
      Promise.all(list.map(function (entry, idx) {
        return fetchCardHTML(entry.handle).then(function (html) {
          if (!html) {
            // Failed fetch: drop the skeleton
            if (skeletons[idx] && skeletons[idx].parentNode) {
              skeletons[idx].parentNode.removeChild(skeletons[idx]);
            }
            return;
          }
          var newSlide = buildCardSlide(html);
          if (skeletons[idx] && skeletons[idx].parentNode) {
            skeletons[idx].parentNode.replaceChild(newSlide, skeletons[idx]);
          } else {
            wrapper.appendChild(newSlide);
          }
        });
      })).then(function () {
        // 4. After all settled, refresh Swiper layout + hover bindings
        if (swiperInstance && typeof swiperInstance.update === 'function') {
          swiperInstance.update();
        }
        initHover();

        // If everything failed and no slides remain, hide the section.
        if (!wrapper.querySelector('.swiper-slide')) {
          section.setAttribute('hidden', '');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', render);
  } else {
    render();
  }
})();
</script>

{% schema %}
{
  "name": "Recent Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Recently Viewed",
      "label": "Title",
      "info": "Leave blank to use the translated default (sections.recent_products.heading)."
    }
  ]
}
{% endschema %}
