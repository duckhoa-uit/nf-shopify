(function(){
 function isMember(){
 if (typeof window.nfwlShopifyCustomer === 'boolean') return window.nfwlShopifyCustomer;
 try { return localStorage.getItem('nfMember')==='1'; } catch(e) { return false; }
 }
 function setMember(v){ try{ localStorage.setItem('nfMember', v?'1':'0'); }catch(e){} }
 function trackEvent(name, label){
 try { window.dataLayer && window.dataLayer.push({event:name, event_label:label}); } catch(e){}
 try { window.fbq && window.fbq('trackCustom', name, {label:label}); } catch(e){}
 }
 function refreshState(){
 var state = document.getElementById('bfLoginState');
 if(state){ state.classList.toggle('show', isMember()); state.setAttribute('aria-hidden', isMember() ? 'false' : 'true'); }
 if('F2' === 'F1'){
 var member = isMember();
 document.querySelectorAll('._nonmemberonly').forEach(function(el){ el.hidden = member; });
 document.querySelectorAll('._memberonly').forEach(function(el){ el.hidden = !member; });
 var rb = document.getElementById('bfRegisterBtn');
 if(rb) rb.hidden = member;
 }
 document.dispatchEvent(new CustomEvent('nfMemberChange'));
 }
 // the hero CTA links here via a plain #bfLoginBtn anchor — intercept it so the
 // jump centers the login buttons in the viewport instead of the browser's
 // default top-align (which on mobile left the buttons awkwardly low).
 document.querySelectorAll('a[href="#bfLoginBtn"]').forEach(function(a){
 a.addEventListener('click', function(e){
 var target = document.getElementById('bfLoginBtn');
 if(!target) return;
 e.preventDefault();
 var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 target.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block: 'center'});
 });
 });
 var lb = document.getElementById('bfLoginBtn'), rb = document.getElementById('bfRegisterBtn');
 // Northfinder uses Shopify's new passwordless customer-accounts flow — login
 // and signup are the SAME entry point (/customer_authentication/login), the
 // system figures out new-vs-returning by email. We point the return_to at
 // whatever page this is actually running on, so people land back here after.
 try {
 var returnTo = encodeURIComponent(window.location.pathname + window.location.search);
 var authHref = '/customer_authentication/login?return_to=' + returnTo;
 if(lb) lb.setAttribute('href', authHref);
 if(rb) rb.setAttribute('href', authHref);
 } catch(e) {}
 // real navigation happens via href. If the Liquid probe above gave us a real
 // customer flag, that's authoritative; the localStorage flip below only
 // matters as a preview fallback.
 if(lb) lb.addEventListener('click', function(){ setMember(true); trackEvent('bf2026_login_click', 'F2'); });
 if(rb) rb.addEventListener('click', function(){ setMember(true); trackEvent('bf2026_register_click', 'F2'); });
 refreshState();
})();
