": " više za članove", "sl": " več za člane", "bg": " още за членове"}, "login.f2gate.more_sub": {"sk": "Prihlás sa a odomkni celý katalóg.", "en": "Log in to unlock the full catalogue.", "de": "Melde dich an, um den ganzen Katalog freizuschalten.", "hr": "Prijavi se i otključaj cijeli katalog.", "sl": "Prijavi se in odkleni celoten katalog.", "bg": "Влез, за да отключиш целия каталог."}, "benefits.heading": {"sk": "Čo ťa čaká", "en": "What's coming", "de": "Das erwartet dich", "hr": "Što te čeka", "sl": "Kaj te čaka", "bg": "Какво следва"}, "benefits.sub": {"sk": "Bezplatné členstvo. Žiadne záväzky.", "en": "Free membership. No obligations.", "de": "Kostenlose Mitgliedschaft. Keine Verpflichtungen.", "hr": "Besplatno članstvo. Bez obaveza.", "sl": "Brezplačno članstvo. Brez obveznosti.", "bg": "Безплатно членство. Без задължения."}, "benefits.1.title": {"sk": "O päť dní skôr", "en": "Five days early", "de": "Fünf Tage früher", "hr": "Pet dana ranije", "sl": "Pet dni prej", "bg": "Пет дни по-рано"}, "benefits.1.text": {"sk": "Nakupuj už od 5. novembra.", "en": "Shop from November 5.", "de": "Kaufe schon ab 5. November.", "hr": "Kupuj već od 5. studenog.", "sl": "Nakupuj že od 5. novembra.", "bg": "Пазарувай от 5 ноември."}, "benefits.2.title": {"sk": "Najnižšie ceny v roku", "en": "Lowest prices of the year", "de": "Niedrigste Preise des Jahres", "hr": "Najniže cijene u godini", "sl": "Najnižje cene v letu", "bg": "Най-ниски цени през годината"}, "benefits.2.text": {"sk": "Super ceny na zimnú výbavu.", "en": "Great prices on winter gear.", "de": "Top-Preise für Winterausrüstung.", "hr": "Super cijene za zimsku opremu.", "sl": "Super cene za zimsko opremo.", "bg": "Страхотни цени за зимна екипировка."}, "benefits.3.title": {"sk": "Bez rizika", "en": "No risk", "de": "Kein Risiko", "hr": "Bez rizika", "sl": "Brez tveganja", "bg": "Без риск"}, "benefits.3.text": {"sk": "Výmena a vrátenie do 31. 12. 2026.", "en": "Exchanges and returns until Dec 31, 2026.", "de": "Umtausch und Rückgabe bis 31.12.2026.", "hr": "Zamjena i povrat do 31. 12. 2026.", "sl": "Menjava in vračilo do 31. 12. 2026.", "bg": "Размяна и връщане до 31.12.2026 г."}, "filters.f2.heading": {"sk": "Objav svoje Black Friday favority", "en": "Discover your Black Friday favourites", "de": "Entdecke deine Black-Friday-Favoriten", "hr": "Otkrij svoje Black Friday favorite", "sl": "Odkrij svoje Black Friday favorite", "bg": "Открий своите фаворити за Black Friday"}, "filters.f2.sub": {"sk": "Skorší prístup je tu! Ako člen NF Flowline máš prednostný prístup k Black Friday zľavám až do 60 %. Prezri si ponuku, vyber si svoje obľúbené kúsky a nakupuj skôr než ostatní.", "en": "Early Access is here! As an NF Flowline member you get priority access to Black Friday discounts of up to 60%. Browse the range, pick your favourites, and shop before everyone else.", "de": "Der frühzeitige Zugang ist da! Als NF-Flowline-Mitglied hast du bevorzugten Zugang zu Black-Friday-Rabatten von bis zu 60 %. Stöbere im Sortiment, wähle deine Favoriten und kaufe vor allen anderen ein.", "hr": "Raniji pristup je tu! Kao član NF Flowlinea imaš prednosni pristup Black Friday popustima do 60 %. Pregledaj ponudu, odaberi svoje favorite i kupuj prije svih ostalih.", "sl": "Zgodnejši dostop je tu! Kot član NF Flowline imaš prednostni dostop do popustov za Black Friday do 60 %. Prebrskaj ponudbo, izberi svoje najljubše kose in nakupuj pred vsemi ostalimi.", "bg": "По-ранният достъп е тук! Като член на NF Flowline имаш приоритетен достъп до намаления за Black Friday до 60%. Разгледай предложенията, избери любимите си и пазарувай преди всички останали."}, "filters.f3.heading": {"sk": "Celý sortiment", "en": "The full range", "de": "Das gesamte Sortiment", "hr": "Cijeli asortiman", "sl": "Celoten izbor", "bg": "Целият асортимент"}, "filters.f3.sub": {"sk": "Priame precenenie, členské kupóny aj posledné kusy, všetko na jednom mieste.", "en": "Direct markdowns, member coupons and last pieces — all in one place.", "de": "Direkte Preissenkungen, Mitgliedsgutscheine und letzte Stücke — alles an einem Ort.", "hr": "Izravno sniženje, kuponi za članove i posljednji komadi, sve na jednom mjestu.", "sl": "Neposredno znižanje, kuponi za člane in zadnji kosi, vse na enem mestu.", "bg": "Директни намаления, членски купони и последни бройки, всичко на едно място."}, "filters.gender.all": {"sk": "Všetci", "en": "Everyone", "de": "Alle", "hr": "Svi", "sl": "Vsi", "bg": "Всички"}, "filters.gender.women": {"sk": "Ženy", "en": "Women", "de": "Damen", "hr": "Žene", "sl": "Ženske", "bg": "Жени"}, "filters.gender.men": {"sk": "Muži", "en": "Men", "de": "Herren", "hr": "Muškarci", "sl": "Moški", "bg": "Мъже"}, "hero.shortcut.women": {"sk": "Dámska ponuka", "en": "Shop women's", "de": "Damenmode entdecken", "hr": "Ženska ponuda", "sl": "Ženska ponudba", "bg": "Дамска колекция"}, "hero.shortcut.men": {"sk": "Pánska ponuka", "en": "Shop men's", "de": "Herrenmode entdecken", "hr": "Muška ponuda", "sl": "Moška ponudba", "bg": "Мъжка колекция"}, "filters.category.all": {"sk": "Všetky kategórie", "en": "All categories", "de": "Alle Kategorien", "hr": "Sve kategorije", "sl": "Vse kategorije", "bg": "Всички категории"}, "filters.category.lastpieces": {"sk": "Posledné kusy", "en": "Last pieces", "de": "Letzte Stücke", "hr": "Posljednji komadi", "sl": "Zadnji kosi", "bg": "Последни бройки"}, "filters.category.outdoorwear": {"sk": "Outdoor", "en": "Outdoor", "de": "Outdoor", "hr": "Outdoor", "sl": "Outdoor", "bg": "Outdoor"}, "filters.category.skiwear": {"sk": "Lyžiarske", "en": "Ski", "de": "Ski", "hr": "Skijaško", "sl": "Smučarsko", "bg": "Ски"}, "filters.category.sportwear": {"sk": "Športové", "en": "Sport", "de": "Sport", "hr": "Sportsko", "sl": "Športno", "bg": "Спорт"}, "filters.category.skitouring": {"sk": "Skialp", "en": "Ski touring", "de": "Skitouren", "hr": "Ski touring", "sl": "Turno smučanje", "bg": "Ски туринг"}, "filters.category.equipment": {"sk": "Vybavenie", "en": "Equipment", "de": "Au