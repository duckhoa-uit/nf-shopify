{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-card {
    position: relative;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .collection-card__image-wrapper {
    position: relative;
    overflow: hidden;
    flex-grow: 1;
    {% if section.settings.image_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif section.settings.image_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif section.settings.image_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% endif %}
  }

  .collection-card__image {
    position: absolute;
    height: 100%;
    width: 100%;
    object-fit: cover;
    background-color: rgb(var(--color-foreground));
    transition: transform 0.3s ease-in-out;
  }

  .collection-card:hover .collection-card__image {
    transform: scale(1.05);
  }

  .collection-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    {% if section.settings.show_card_overlay %}
      background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.7) 100%);
    {% endif %}
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
  }

  .collection-card__title {
    color: #fff;
    text-transform: uppercase;
    font-weight: 800;
    margin: 0 0 1rem;
    font-size: calc(var(--font-heading-scale) * 2rem);
    text-align: center;
    font-family: var(--font-heading-family);
  }

  .collection-card__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    width: 100%;
    margin-top: 0.5rem;
  }

  .collection-card__button {
    display: inline-block;
    min-width: auto;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.625rem 1.25rem;
    background-color: #fff;
    color: #0F0F0F;
    border-radius: 3px;
    text-decoration: none;
    text-align: center;
    transition: background-color 0.3s
    , color 0.3s;
  }

  .collection-card__button:hover {
    background-color: #0F0F0F;
    color: #fff;
  }

  .collection__grid-wrapper {
    padding: 0 1.5rem;
  }

  .desktop-only {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .desktop-only {
      display: flex;
    }

    .collection__grid-wrapper {
      padding: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-card__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      width: 100%;
      {% if section.settings.mobile_button_style == 'split' %}
        justify-content: space-between;
      {% elsif section.settings.mobile_button_style == 'stacked' %}
        flex-direction: column;
        justify-content: center;
      {% else %}
        justify-content: center;
      {% endif %}
      margin-top: 0.75rem;
    }

    .collection-card__title {
      font-family: var(--font-archivo-expanded);
      font-size: 18px;
      line-height: 1.167;
      font-weight: 800;
      margin-bottom: 0;
      text-align: center;
      width: 100%;
    }

    .collection-card__overlay {
      padding: 1rem;
      align-items: center;
      background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.7) 100%);
    }

    .collection-card__button {
      min-width: auto;
      {% if section.settings.mobile_button_style == 'split' %}
        width: calc(50% - 0.1875rem);
      {% elsif section.settings.mobile_button_style == 'stacked' %}
        width: 100%;
        margin-bottom: 0.375rem;
      {% else %}
        width: auto;
        margin: 0 0.1875rem;
      {% endif %}
      font-size: 13px;
      line-height: 1.23;
      padding: 8px 12px;
      font-weight: 600;
      font-family: 'Archivo'
      , sans-serif;
      border-radius: 3px;
    }

    .dawn-grid {
      row-gap: 16px;
      column-gap: 0;
    }

    .page-width.section-{{ section.id }}
    -padding {
      padding: 24px 16px;
    }

    .grid__item {
      padding-left: 0;
      padding-right: 0;
    }

    .collection__grid-wrapper {
      padding: 0;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = 1
-%}

<div class="isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <h2 class="font-extrabold font-archivo-expanded text-base lg:text-2xl leading-7 text-[#0F0F0F] uppercase mb-3 lg:mb-6">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}

    <div class="collection__grid-wrapper{% if section.settings.full_width %} collection__grid-wrapper--full-width{% endif %}{% if section.settings.full_width == false %} page-width-desktop{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} -mx-4 md:mx-0 gap-1 md:gap-4">
      <ul
        id="Grid-{{ section.id }}"
        data-id="{{ section.id }}"
        class="dawn-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--1-col-tablet-down"
        role="list">
        {%- for block in section.blocks -%}
          {% assign blockType = block.type %}

          <li
            id="Item-{{ section.id }}-{{ forloop.index }}"
            class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}>
            <div class="collection-card">
              <div class="collection-card__image-wrapper">
                {%- if block.settings.image != blank -%}
                  <img
                    srcset="{%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
                            {%- if block.settings.image.width >= 533 -%}{{ block.settings.image | image_url: width: 533 }} 533w,{%- endif -%}
                            {%- if block.settings.image.width >= 720 -%}{{ block.settings.image | image_url: width: 720 }} 720w,{%- endif -%}
                            {%- if block.settings.image.width >= 1066 -%}{{ block.settings.image | image_url: width: 1066 }} 1066w,{%- endif -%}
                            {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                            {{ block.settings.image | image_url }} {{ block.settings.image.width }}w"
                    src="{{ block.settings.image | image_url: width: 720 }}"
                    sizes="(min-width: 1200px) 600px, (min-width: 990px) calc(50vw - 50px), (min-width: 750px) calc(50vw - 30px), 100vw"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    class="collection-card__image">
                {%- elsif blockType == 'collection' and block.settings.collection != blank and block.settings.collection.featured_image != blank -%}
                  <img
                    srcset="{{ block.settings.collection.featured_image | image_url: width: 533 }} 533w,
                            {{ block.settings.collection.featured_image | image_url: width: 720 }} 720w,
                            {{ block.settings.collection.featured_image | image_url: width: 1066 }} 1066w,
                            {{ block.settings.collection.featured_image | image_url: width: 1500 }} 1500w"
                    src="{{ block.settings.collection.featured_image | image_url: width: 720 }}"
                    sizes="(min-width: 1200px) 600px, (min-width: 990px) calc(50vw - 50px), (min-width: 750px) calc(50vw - 30px), 100vw"
                    alt="{{ block.settings.collection.title | escape }}"
                    height="{{ block.settings.collection.featured_image.height }}"
                    width="{{ block.settings.collection.featured_image.width }}"
                    loading="lazy"
                    class="collection-card__image">
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collection-card__image' }}
                {%- endif -%}

                <div class="collection-card__overlay">
                  <h3 class="collection-card__title">
                    {%- if block.settings.custom_title != blank -%}
                      {{ block.settings.custom_title }}
                    {%- elsif blockType == 'collection' and block.settings.collection != blank -%}
                      {{ block.settings.collection.title }}
                    {%- else -%}
                      Category Title
                    {%- endif -%}
                  </h3>

                  <div class="collection-card__buttons">
                    {%- if block.settings.men_collection != blank -%}
                      <a href="{{ block.settings.men_collection.url }}" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_men' | t }}
                      </a>
                    {%- elsif blockType == 'collection' and block.settings.collection != blank -%}
                      <a href="{{ block.settings.collection.url }}?filter.p.m.custom.gender=Men" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_men' | t }}
                      </a>
                    {%- else -%}
                      <a href="#" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_men' | t }}
                      </a>
                    {%- endif -%}

                    {%- if block.settings.women_collection != blank -%}
                      <a href="{{ block.settings.women_collection.url }}" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_women' | t }}
                      </a>
                    {%- elsif blockType == 'collection' and block.settings.collection != blank -%}
                      <a href="{{ block.settings.collection.url }}?filter.p.m.custom.gender=Women" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_women' | t }}
                      </a>
                    {%- else -%}
                      <a href="#" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_women' | t }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </li>
        {%- else -%}
          {%- for i in (1..section.settings.columns_desktop) -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
              {% endif %}>
              <div class="collection-card">
                <div class="collection-card__image-wrapper">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collection-card__image' }}

                  <div class="collection-card__overlay">
                    <h3 class="collection-card__title">
                      {{ 'onboarding.collection_title' | t }}
                    </h3>

                    <div class="collection-card__buttons">
                      <a href="#" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_men' | t }}
                      </a>

                      <a href="#" class="collection-card__button">
                        {{ 'general.discover_northfinder.for_women' | t }}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "t:sections.featured-collection.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "text",
        "id": "title",
        "default": "Featured collections",
        "label": "t:sections.featured-collection.settings.title.label"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "options": [
          {
            "value": "square",
            "label": "Square (1:1)"
          },
          {
            "value": "portrait",
            "label": "Portrait (3:4)"
          },
          {
            "value": "landscape",
            "label": "Landscape (4:3)"
          }
        ],
        "default": "square",
        "label": "Image ratio"
      },
      {
        "type": "checkbox",
        "id": "show_card_overlay",
        "default": true,
        "label": "Show overlay gradient"
      },
      {
        "type": "select",
        "id": "mobile_button_style",
        "options": [
          {
            "value": "full",
            "label": "Full width buttons"
          },
          {
            "value": "split",
            "label": "Split width buttons"
          },
          {
            "value": "stacked",
            "label": "Stacked buttons"
          }
        ],
        "default": "split",
        "label": "Mobile button style"
      },
      {
        "type": "range",
        "id": "columns_desktop",
        "min": 1,
        "max": 5,
        "step": 1,
        "default": 2,
        "label": "t:sections.featured-collection.settings.columns_desktop.label"
      },
      {
        "type": "checkbox",
        "id": "full_width",
        "label": "t:sections.featured-collection.settings.full_width.label",
        "default": false
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "name": "Collection",
        "type": "collection",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Banner image",
            "info": "Required - This image will be displayed as the banner"
          },
          {
            "type": "text",
            "id": "custom_title",
            "label": "Category title",
            "default": "Category Title"
          },
          {
            "type": "url",
            "id": "men_collection",
            "label": "Men's collection"
          },
          {
            "type": "url",
            "id": "women_collection",
            "label": "Women's collection"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Featured Collections",
        "blocks": [
          {
            "type": "collection"
          },
          {
            "type": "collection"
          }
        ],
        "settings": {
          "columns_desktop": 2,
          "image_ratio": "square",
          "show_card_overlay": true,
          "mobile_button_style": "split"
        }
      }
    ]
  }
{% endschema %}