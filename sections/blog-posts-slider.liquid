{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-meta.css' | asset_url | stylesheet_tag }}
{{ 'section-blog-posts-slider.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .blog-posts-slider__placeholder {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 60px 20px;
    background: #f4f4f4;
    border-radius: 8px;
    text-align: center;
  }
{%- endstyle -%}

{%- liquid
  assign blocks_size = section.blocks.size
  assign has_blocks = false
  if blocks_size > 0
    assign has_blocks = true
  endif
-%}

<div class="blog-posts-slider color-{{ section.settings.color_scheme }} gradient{% if section.settings.heading == blank %} no-heading{% endif %} section-{{ section.id }}-padding">
  <div class="page-width isolate">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2
          id="SectionHeading-{{ section.id }}"
          class="font-extrabold font-archivo-expanded text-lg lg:text-2xl leading-7 text-[#0F0F0F] uppercase"
        >
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endunless -%}
  </div>

  <div class="blog-posts-slider__container">
    <div class="swiper blog-posts-slider__swiper">
      <div id="Slider-{{ section.id }}" class="swiper-wrapper">
        {%- if has_blocks -%}
          {%- for block in section.blocks -%}
            {%- assign article = block.settings.article -%}
            {%- if article != blank -%}
              <div
                id="Slide-{{ section.id }}-{{ forloop.index0 | plus: 1 }}"
                class="swiper-slide blog-posts-slider__slide"
                {{ block.shopify_attributes }}
              >
                <div class="blog-posts-slider__card">
                  <div class="blog-posts-slider__image">
                    {%- if article.image -%}
                      <img
                        srcset="
                          {%- if article.image.width >= 165 -%}{{ article.image | image_url: width: 165 }} 165w,{%- endif -%}
                          {%- if article.image.width >= 360 -%}{{ article.image | image_url: width: 360 }} 360w,{%- endif -%}
                          {%- if article.image.width >= 535 -%}{{ article.image | image_url: width: 535 }} 535w,{%- endif -%}
                          {%- if article.image.width >= 750 -%}{{ article.image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if article.image.width >= 1070 -%}{{ article.image | image_url: width: 1070 }} 1070w,{%- endif -%}
                          {%- if article.image.width >= 1500 -%}{{ article.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                        "
                        src="{{ article.image | image_url: width: 533 }}"
                        sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                        alt="{{ article.image.alt | escape }}"
                        loading="lazy"
                        width="{{ article.image.width }}"
                        height="{{ article.image.height }}"
                        class="blog-posts-slider__image-img"
                      >
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <div class="blog-posts-slider__image-overlay"></div>
                  </div>
                  <div class="blog-posts-slider__content">
                    {% render 'article-meta', article: article %}
                    <h3 class="blog-posts-slider__title">{{ block.settings.custom_title | default: article.title }}</h3>
                    <div class="blog-posts-slider__excerpt">
                      {{
                        block.settings.custom_excerpt
                        | default: article.excerpt_or_content
                        | strip_html
                        | truncatewords: 15
                      }}
                    </div>
                    <a href="{{ article.url }}" class="blog-posts-slider__button">
                      {{ 'blogs.article.read_more' | t }}
                    </a>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="blog-posts-slider__placeholder">
            <p>{{ 'sections.blog_posts_slider.add_posts' | t }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="swiper-scrollbar"></div>

      <div class="swiper-button-next opacity-100 right-8">
        <span class="icon">
          <svg
            width="56"
            height="56"
            viewBox="0 0 56 56"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect
              width="56"
              height="56"
              rx="28"
              fill="white"></rect>
            <path
              d="M26 40L34 28L26 16"
              stroke="#0F0F0F"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </span>
      </div>
      <div class="swiper-button-prev opacity-100 left-8">
        <span class="icon">
          <svg
            width="56"
            height="56"
            viewBox="0 0 56 56"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect
              width="56"
              height="56"
              rx="28"
              transform="matrix(-1 0 0 1 56 0)"
              fill="white"></rect>
            <path
              d="M30 40L22 28L30 16"
              stroke="#0F0F0F"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Make sure Swiper is loaded
    if (typeof Swiper === 'undefined') {
      // Wait for Swiper to load since we're using defer
      const swiperScript = document.querySelector('script[src*="swiper-bundle.min.js"]');
      swiperScript.addEventListener('load', initSwiper);
    } else {
      initSwiper();
    }

    function initSwiper() {
      var blogPostsSlider = new Swiper('.blog-posts-slider__swiper', {
        direction: 'horizontal',
        grabCursor: true,
        scrollbar: {
          el: '.swiper-scrollbar',
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        breakpoints: {
          // when window width is >= 320px
          320: {
            slidesPerView: 1,
            spaceBetween: 6,
          },
          // when window width is >= 640px
          750: {
            slidesPerView: 'auto',
            centeredSlides: true,
            loop: true,
          },
        },
      });
    }
  });
</script>

{% schema %}
{
  "name": "Blog Posts Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Blog Northfinder",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "blog_post",
      "name": "Blog Post",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (optional)"
        },
        {
          "type": "textarea",
          "id": "custom_excerpt",
          "label": "Custom Excerpt (optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Blog Posts Slider",
      "blocks": [
        {
          "type": "blog_post"
        },
        {
          "type": "blog_post"
        },
        {
          "type": "blog_post"
        }
      ]
    }
  ]
}
{% endschema %}
