{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
  {{ 'component-localization-form.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'custom-language-selector.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<style>
  /* Custom styles for announcement bar localization */
  .announcement-bar-section .localization-form {
    padding: 0;
    margin: 0;
  }

  /* Custom language selector styles */
  .language-selector-wrapper {
    position: relative;
  }

  .custom-language-button {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .language-flag {
    display: block;
    border: 1px solid #e0e0e0;
  }

  .custom-language-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    z-index: 50;
    min-width: 180px;
    margin-top: 5px;
  }

  .custom-language-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .custom-language-item {
    padding: 0;
  }

  .custom-language-link {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    text-decoration: none;
    color: #333;
    transition: background-color 0.2s;
  }

  .custom-language-link:hover {
    background-color: #f5f5f5;
  }

  .custom-language-link[aria-current="true"] {
    background-color: #f0f0f0;
  }

  .language-name {
    margin-left: 8px;
    font-size: 14px;
  }
</style>

<div class="bg-[#F5F5F5] text-[0.8125rem] leading-[0.875rem] text-secondary-foreground hidden lg:block">
  <div class="page-width">
    <nav class="w-full flex flex-row justify-between h-[1.875rem] items-center">
      <div class="italic flex items-center">
        <div class="">
          <ul class="">
            <li>
              {% if section.settings.announcement_link != blank %}
              <a class="text-secondary-foreground" href="{{ section.settings.announcement_link }}">
                {{- section.settings.announcement_text -}}
              </a>
              {% else %}
              <span class="text-secondary-foreground">
                {{- section.settings.announcement_text -}}
              </span>
              {% endif %}
            </li>
          </ul>
        </div>
      </div>
      <div class="nav_right flex justify-end items-center">
        <div class="flex gap-6 justify-between items-center [&_a]:text-secondary-foreground [&_a]:cursor-pointer">
          {% comment %}
            {% if section.settings.category1_link != blank %}
            <div>
              <a href="{{ section.settings.category1_link }}">
                {{- section.settings.category1_text -}}
              </a>
            </div>
            {% endif %}
            {% if section.settings.category2_link != blank %}
            <div>
              <a href="{{ section.settings.category2_link }}">
                {{- section.settings.category2_text -}}
              </a>
            </div>
            {% endif %}
            {% if section.settings.category3_link != blank %}
            <div>
              <a href="{{ section.settings.category3_link }}">
                {{- section.settings.category3_text -}}
              </a>
            </div>
            {% endif %}
          {% endcomment %}
          {% if section.settings.blog_link != blank %}
          <div>
            <a href="{{ section.settings.blog_link }}">
              {{ 'general.navigation.blog' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.contact_link != blank %}
          <div>
            <a href="{{ section.settings.contact_link }}">
              {{ 'general.navigation.contact' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.faq_link != blank %}
          <div>
            <a href="{{ section.settings.faq_link }}">
              {{ 'general.navigation.faq' | t }}
            </a>
          </div>
          {% endif %}
          {%- if shop.customer_accounts_enabled -%}
            {% if section.settings.show_register and customer == null %}
            <div>
              <a href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a>
            </div>
            {% endif %}
            {% if section.settings.show_login and customer == null %}
            <div>
              <a href="{{ routes.account_login_url }}">{{ 'customer.login_page.sign_in' | t }}</a>
            </div>
            {% endif %}
            {% if customer != null %}
            <div>
              <a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
            </div>
            {% endif %}
          {%- endif -%}
          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <div class="language-selector-wrapper">
              <localization-form>
                {%- form 'localization', id: 'AnnouncementBarLanguageForm', class: 'localization-form' -%}
                  <div>
                    <h2 class="visually-hidden" id="AnnouncementBarLanguageLabel">
                      {{ 'localization.language_label' | t }}
                    </h2>
                    {%- render 'custom-language-selector', localPosition: 'AnnouncementBarLanguage' -%}
                  </div>
                {%- endform -%}
              </localization-form>
            </div>
          {%- endif -%}
        </div>
      </div>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Official outdoor eshop | Fast delivery | Hassle-free returns and exchanges"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "url",
      "id": "blog_link",
      "label": "Blog Link"
    },
    {
      "type": "url",
      "id": "faq_link",
      "label": "FAQ Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Link"
    },
    {
      "type": "text",
      "id": "category1_text",
      "label": "Category 1 Text",
      "default": "Men"
    },
    {
      "type": "url",
      "id": "category1_link",
      "label": "Category 1 Link"
    },
    {
      "type": "text",
      "id": "category2_text",
      "label": "Category 2 Text",
      "default": "Women"
    },
    {
      "type": "url",
      "id": "category2_link",
      "label": "Category 2 Link"
    },
    {
      "type": "text",
      "id": "category3_text",
      "label": "Category 3 Text",
      "default": "Kids"
    },
    {
      "type": "url",
      "id": "category3_link",
      "label": "Category 3 Link"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable Language Selector",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_register",
      "label": "Show Register Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_login",
      "label": "Show Login Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "settings": {}
    }
  ]
}
{% endschema %}
