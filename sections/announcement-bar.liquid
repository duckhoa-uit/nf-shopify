{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<style>
  /* Top-bar localization: compact trigger button only.
     Shared dropdown styles live in component-localization-form.css */
  .announcement-bar-section .header-localization {
    display: flex;
    align-items: center;
    gap: 1rem;
    -webkit-font-smoothing: antialiased;
  }

  .announcement-bar-section .header-localization .localization-form {
    padding: 0;
    margin: 0;
  }

  .announcement-bar-section .header-localization .disclosure {
    position: relative;
    z-index: 20;
  }

  /* Trigger button — compact, right-aligned dropdown, 40px hit area */
  .announcement-bar-section .header-localization .disclosure .localization-form__select {
    position: relative;
    padding: 0.25rem 1.25rem 0.25rem 0;
    height: auto;
    min-height: 0;
    font-size: 0.8125rem;
    line-height: 1.1;
    color: inherit;
    background: transparent;
    transition-property: color, opacity;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select::before {
    content: '';
    position: absolute;
    inset: -1rem -0.25rem;
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select:hover {
    color: #111;
    text-decoration: none;
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select:active {
    scale: 0.96;
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select .icon-caret {
    right: 0;
    height: 0.5rem;
  }
  .announcement-bar-section
    .header-localization
    .disclosure
    .localization-form__select[aria-expanded='true']
    .icon-caret {
    transform: rotate(180deg);
  }

  /* Opt the announcement bar out of CSS Anchor Positioning entirely.
     Anchor positioning has surprising failure modes when the trigger
     sits near the viewport edge. Plain absolute positioning relative
     to `.disclosure` is reliable. ID selectors + !important to beat
     the generic @supports rule in component-localization-form.css. */
  #AnnouncementBarCountryForm .disclosure__list-wrapper,
  #AnnouncementBarLanguageForm .disclosure__list-wrapper {
    position: absolute !important;
    inset: auto !important;
    top: calc(100% + 0.5rem) !important;
    right: 0 !important;
    left: auto !important;
    bottom: auto !important;
    margin: 0 !important;
    position-anchor: none !important;
    position-try-fallbacks: none !important;
  }

</style>

<div class="bg-[#F5F5F5] text-[0.8125rem] leading-[0.875rem] text-secondary-foreground hidden lg:block relative z-30">
  <div class="page-width">
    <nav class="w-full flex flex-row justify-between h-[1.875rem] items-center">
      <div class="italic flex items-center">
        <div class="">
          <ul class="">
            <li>
              {% if section.settings.announcement_link != blank %}
              <a class="text-secondary-foreground" href="{{ section.settings.announcement_link }}">
                {{- section.settings.announcement_text -}}
              </a>
              {% else %}
              <span class="text-secondary-foreground">
                {{- section.settings.announcement_text -}}
              </span>
              {% endif %}
            </li>
          </ul>
        </div>
      </div>
      <div class="nav_right flex justify-end items-center">
        <div class="flex gap-6 justify-between items-center [&_a]:text-secondary-foreground [&_a]:cursor-pointer">
          {% comment %}
            {% if section.settings.category1_link != blank %}
            <div>
              <a href="{{ section.settings.category1_link }}">
                {{- section.settings.category1_text -}}
              </a>
            </div>
            {% endif %}
            {% if section.settings.category2_link != blank %}
            <div>
              <a href="{{ section.settings.category2_link }}">
                {{- section.settings.category2_text -}}
              </a>
            </div>
            {% endif %}
            {% if section.settings.category3_link != blank %}
            <div>
              <a href="{{ section.settings.category3_link }}">
                {{- section.settings.category3_text -}}
              </a>
            </div>
            {% endif %}
          {% endcomment %}
          {% if section.settings.blog_link != blank %}
          <div>
            <a href="{{ section.settings.blog_link }}">
              {{ 'general.navigation.blog' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.contact_link != blank %}
          <div>
            <a href="{{ section.settings.contact_link }}">
              {{ 'general.navigation.contact' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.faq_link != blank %}
          <div>
            <a href="{{ section.settings.faq_link }}">
              {{ 'general.navigation.faq' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.show_register and customer == null %}
          <div>
            <a href="{{ routes.account_register_url }}" data-auth-trigger="register">{{ 'customer.register.title' | t }}</a>
          </div>
          {% endif %}
          {% if section.settings.show_login and customer == null %}
          <div>
            <a href="{{ routes.account_login_url }}" data-auth-trigger="login">{{ 'customer.login_page.sign_in' | t }}</a>
          </div>
          {% endif %}
          {% if customer != null %}
          <div>
            <a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
          </div>
          {% endif %}
          {%- liquid
            assign show_ab_country = false
            assign show_ab_language = false
            if section.settings.enable_country_selector and localization.available_countries.size > 1
              assign show_ab_country = true
            endif
            if section.settings.enable_language_selector and localization.available_languages.size > 1
              assign show_ab_language = true
            endif
          -%}
          {%- if show_ab_country or show_ab_language -%}
            <div class="header-localization">
              {%- if show_ab_country -%}
                <localization-form data-prevent-hide>
                  {%- form 'localization', id: 'AnnouncementBarCountryForm', class: 'localization-form' -%}
                    <div>
                      <h2 class="visually-hidden" id="AnnouncementBarCountryLabel">
                        {{ 'localization.country_label' | t }}
                      </h2>
                      {%- render 'country-localization', localPosition: 'AnnouncementBarCountry' -%}
                    </div>
                  {%- endform -%}
                </localization-form>
              {%- endif -%}
              {%- if show_ab_language -%}
                <localization-form data-prevent-hide>
                  {%- form 'localization', id: 'AnnouncementBarLanguageForm', class: 'localization-form' -%}
                    <div>
                      <h2 class="visually-hidden" id="AnnouncementBarLanguageLabel">
                        {{ 'localization.language_label' | t }}
                      </h2>
                      {%- render 'language-localization', localPosition: 'AnnouncementBarLanguage' -%}
                    </div>
                  {%- endform -%}
                </localization-form>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Official outdoor eshop | Fast delivery | Hassle-free returns and exchanges"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "url",
      "id": "blog_link",
      "label": "Blog Link"
    },
    {
      "type": "url",
      "id": "faq_link",
      "label": "FAQ Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Link"
    },
    {
      "type": "text",
      "id": "category1_text",
      "label": "Category 1 Text",
      "default": "Men"
    },
    {
      "type": "url",
      "id": "category1_link",
      "label": "Category 1 Link"
    },
    {
      "type": "text",
      "id": "category2_text",
      "label": "Category 2 Text",
      "default": "Women"
    },
    {
      "type": "url",
      "id": "category2_link",
      "label": "Category 2 Link"
    },
    {
      "type": "text",
      "id": "category3_text",
      "label": "Category 3 Text",
      "default": "Kids"
    },
    {
      "type": "url",
      "id": "category3_link",
      "label": "Category 3 Link"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable Country Selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable Language Selector",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_register",
      "label": "Show Register Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_login",
      "label": "Show Login Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "settings": {}
    }
  ]
}
{% endschema %}
