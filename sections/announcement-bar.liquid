{%- liquid
  assign show_ab_country = false
  assign show_ab_language = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign show_ab_country = true
  endif
  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign show_ab_language = true
  endif
-%}

{%- if section.blocks.size > 1 -%}
  {{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<style>
  /* Top-bar localization: compact trigger button only.
     Shared dropdown styles live in component-localization-form.css */
  .announcement-bar-section .header-localization {
    display: flex;
    align-items: center;
    gap: 1rem;
    -webkit-font-smoothing: antialiased;
  }

  .announcement-bar-section .header-localization .localization-form {
    padding: 0;
    margin: 0;
  }

  .announcement-bar-section .header-localization .disclosure {
    position: relative;
    z-index: 20;
  }

  /* Trigger button — compact, right-aligned dropdown, 40px hit area */
  .announcement-bar-section .header-localization .disclosure .localization-form__select {
    position: relative;
    padding: 0.25rem 1.25rem 0.25rem 0;
    height: auto;
    min-height: 0;
    font-size: 0.8125rem;
    line-height: 1.1;
    color: inherit;
    background: transparent;
    transition-property: color, opacity;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select::before {
    content: '';
    position: absolute;
    inset: -1rem -0.25rem;
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select:hover {
    color: #111;
    text-decoration: none;
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select:active {
    scale: 0.96;
  }
  .announcement-bar-section .header-localization .disclosure .localization-form__select .icon-caret {
    right: 0;
    height: 0.5rem;
  }
  .announcement-bar-section
    .header-localization
    .disclosure
    .localization-form__select[aria-expanded='true']
    .icon-caret {
    transform: rotate(180deg);
  }

  /* Opt the announcement bar out of CSS Anchor Positioning entirely.
     Anchor positioning has surprising failure modes when the trigger
     sits near the viewport edge. Plain absolute positioning relative
     to `.disclosure` is reliable. ID selectors + !important to beat
     the generic @supports rule in component-localization-form.css. */
  #AnnouncementBarCountryForm .disclosure__list-wrapper,
  #AnnouncementBarLanguageForm .disclosure__list-wrapper {
    position: absolute !important;
    inset: auto !important;
    top: calc(100% + 0.5rem) !important;
    right: 0 !important;
    left: auto !important;
    bottom: auto !important;
    margin: 0 !important;
    position-anchor: none !important;
    position-try-fallbacks: none !important;
  }

  /* Carousel container: keep the bar at a fixed 30px height even with the slider. */
  .announcement-bar-section .announcement-bar {
    width: 100%;
    min-width: 0;
    height: 1.875rem;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .announcement-bar-section .announcement-bar-slider {
    width: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .announcement-bar-section .ab-slider {
    width: 100%;
    min-width: 0;
    flex: 1 1 auto;
    margin: 0;
    display: flex;
    flex-direction: row;
    overflow: hidden;
    scrollbar-width: none;
  }
  .announcement-bar-section .ab-slider::-webkit-scrollbar {
    display: none;
  }
  .announcement-bar-section .ab-slide {
    flex: 0 0 100%;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 0;
  }
  .announcement-bar-section .announcement-bar__message {
    margin: 0;
    padding: 0;
    text-align: center;
    font-size: inherit;
    line-height: 1.875rem;
    letter-spacing: 0;
    min-height: 0;
    /* Keep one line; never push the bar taller. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .announcement-bar-section .announcement-bar__link {
    color: inherit;
    text-decoration: none;
  }
  .announcement-bar-section .announcement-bar__link:hover {
    text-decoration: underline;
  }
  .announcement-bar-section .slider-button {
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 150ms ease;
  }
  .announcement-bar-section .slider-button:hover {
    opacity: 1;
  }
  .announcement-bar-section .slider-button .svg-wrapper {
    width: 0.75rem;
    height: 0.75rem;
    display: inline-flex;
  }
  .announcement-bar-section .slider-button--prev .svg-wrapper {
    transform: rotate(90deg);
  }
  .announcement-bar-section .slider-button--next .svg-wrapper {
    transform: rotate(-90deg);
  }
  .announcement-bar-section .slider-button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  /* Honour reduced-motion: SlideshowComponent already skips autoplay,
     but make sure the fade-in/out transforms don't animate either. */
  @media (prefers-reduced-motion: reduce) {
    .announcement-bar-slider--fade-in-next .announcement-bar__message,
    .announcement-bar-slider--fade-in-previous .announcement-bar__message,
    .announcement-bar-slider--fade-out-next .announcement-bar__message,
    .announcement-bar-slider--fade-out-previous .announcement-bar__message {
      animation: none !important;
    }
  }
</style>

<div class="bg-[#F5F5F5] text-[0.8125rem] leading-[0.875rem] text-secondary-foreground relative z-30">
  <div class="page-width">
    <nav class="w-full flex flex-row justify-center lg:justify-between h-[1.875rem] items-center gap-4">
      <div class="italic flex items-center justify-center lg:justify-start overflow-hidden lg:overflow-visible" style="min-width: 0; flex: 1 1 0; max-width: 100%;">
        {%- if section.blocks.size == 0 -%}
          {%- if section.settings.announcement_text != blank -%}
            <div class="announcement-bar w-full lg:w-auto" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
              {%- if section.settings.announcement_link != blank -%}
                <a class="announcement-bar__link text-secondary-foreground" href="{{ section.settings.announcement_link }}">
                  <p class="announcement-bar__message">{{ section.settings.announcement_text | escape }}</p>
                </a>
              {%- else -%}
                <p class="announcement-bar__message text-secondary-foreground">{{ section.settings.announcement_text | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- elsif section.blocks.size == 1 -%}
          {%- assign block = section.blocks.first -%}
          <div class="announcement-bar w-full lg:w-auto" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              {%- if block.settings.link != blank -%}
                <a class="announcement-bar__link text-secondary-foreground" href="{{ block.settings.link }}">
                  <p class="announcement-bar__message">{{ block.settings.text | escape }}</p>
                </a>
              {%- else -%}
                <p class="announcement-bar__message text-secondary-foreground">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- else -%}
          <slideshow-component
            class="announcement-bar w-full lg:w-auto"
            role="region"
            aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
            aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
          >
            <div class="announcement-bar-slider slider-buttons">
              <button
                type="button"
                class="slider-button slider-button--prev"
                name="previous"
                aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </button>
              <div
                class="slider slider--everywhere ab-slider"
                id="Slider-{{ section.id }}"
                aria-live="polite"
                aria-atomic="true"
                data-autoplay="{{ section.settings.auto_rotate }}"
                data-speed="{{ section.settings.change_slides_speed }}"
              >
                {%- for block in section.blocks -%}
                  <div
                    class="slideshow__slide slider__slide ab-slide"
                    id="Slide-{{ section.id }}-{{ forloop.index }}"
                    {{ block.shopify_attributes }}
                    role="group"
                    aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                    aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                    tabindex="-1"
                  >
                    {%- if block.settings.text != blank -%}
                      {%- if block.settings.link != blank -%}
                        <a class="announcement-bar__link text-secondary-foreground" href="{{ block.settings.link }}">
                          <p class="announcement-bar__message">{{ block.settings.text | escape }}</p>
                        </a>
                      {%- else -%}
                        <p class="announcement-bar__message text-secondary-foreground">{{ block.settings.text | escape }}</p>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
              <button
                type="button"
                class="slider-button slider-button--next"
                name="next"
                aria-label="{{ 'sections.announcements.next_announcement' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </slideshow-component>

          {%- if request.design_mode -%}
            <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
            <style>
              .announcement-bar-slider .slider__slide[aria-hidden='true'] {
                visibility: hidden;
              }
            </style>
          {%- endif -%}
        {%- endif -%}
      </div>
      <div class="nav_right hidden lg:flex justify-end items-center">
        <div class="flex gap-6 justify-between items-center [&_a]:text-secondary-foreground [&_a]:cursor-pointer">
          {% if section.settings.blog_link != blank %}
          <div>
            <a href="{{ section.settings.blog_link }}">
              {{ 'general.navigation.blog' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.contact_link != blank %}
          <div>
            <a href="{{ section.settings.contact_link }}">
              {{ 'general.navigation.contact' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.faq_link != blank %}
          <div>
            <a href="{{ section.settings.faq_link }}">
              {{ 'general.navigation.faq' | t }}
            </a>
          </div>
          {% endif %}
          {% if section.settings.show_login and customer == null %}
          <div>
            <a href="{{ routes.account_login_url }}">{{ 'customer.login_page.sign_in' | t }}</a>
          </div>
          {% endif %}
          {% if customer != null %}
          <div>
            <a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
          </div>
          {% endif %}
          {%- if show_ab_country or show_ab_language -%}
            <div class="header-localization">
              {%- if show_ab_country -%}
                <localization-form data-prevent-hide>
                  {%- form 'localization', id: 'AnnouncementBarCountryForm', class: 'localization-form' -%}
                    <div>
                      <h2 class="visually-hidden" id="AnnouncementBarCountryLabel">
                        {{ 'localization.country_label' | t }}
                      </h2>
                      {%- render 'country-localization', localPosition: 'AnnouncementBarCountry' -%}
                    </div>
                  {%- endform -%}
                </localization-form>
              {%- endif -%}
              {%- if show_ab_language -%}
                <localization-form data-prevent-hide>
                  {%- form 'localization', id: 'AnnouncementBarLanguageForm', class: 'localization-form' -%}
                    <div>
                      <h2 class="visually-hidden" id="AnnouncementBarLanguageLabel">
                        {{ 'localization.language_label' | t }}
                      </h2>
                      {%- render 'language-localization', localPosition: 'AnnouncementBarLanguage' -%}
                    </div>
                  {%- endform -%}
                </localization-form>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add one or more announcement blocks to rotate messages. When 0 blocks are configured, the legacy Announcement Text below is used."
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "header",
      "content": "Legacy single announcement"
    },
    {
      "type": "paragraph",
      "content": "Used only when no announcement blocks are added below."
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Official outdoor eshop | Fast delivery | Hassle-free returns and exchanges"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "header",
      "content": "Utility links (desktop)"
    },
    {
      "type": "url",
      "id": "blog_link",
      "label": "Blog Link"
    },
    {
      "type": "url",
      "id": "faq_link",
      "label": "FAQ Link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Link"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable Country Selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable Language Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_login",
      "label": "Show Login Link",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "settings": {}
    }
  ]
}
{% endschema %}
