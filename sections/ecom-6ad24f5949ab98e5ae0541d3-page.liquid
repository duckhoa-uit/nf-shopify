de": "Early Access ist da! Als NF-Flowline-Mitglied hast du bevorzugten Zugang zu Black-Friday-Rabatten von bis zu 60 %. Stöbere im Sortiment, wähle deine Favoriten und kaufe vor allen anderen ein.", "hr": "Early Access je tu! Kao član NF Flowlinea imaš prednosni pristup Black Friday popustima do 60 %. Pregledaj ponudu, odaberi svoje favorite i kupuj prije svih ostalih.", "sl": "Early Access je tu! Kot član NF Flowline imaš prednostni dostop do popustov za Black Friday do 60 %. Prebrskaj ponudbo, izberi svoje najljubše kose in nakupuj pred vsemi ostalimi.", "bg": "Early Access е тук! Като член на NF Flowline имаш приоритетен достъп до намаления за Black Friday до 60%. Разгледай предложенията, избери любимите си и пазарувай преди всички останали."}, "filters.f3.heading": {"sk": "Celý sortiment", "en": "The full range", "de": "Das gesamte Sortiment", "hr": "Cijeli asortiman", "sl": "Celoten izbor", "bg": "Целият асортимент"}, "filters.f3.sub": {"sk": "Priame precenenie, členské kupóny aj posledné kusy, všetko na jednom mieste.", "en": "Direct markdowns, member coupons and last pieces — all in one place.", "de": "Direkte Preissenkungen, Mitgliedsgutscheine und letzte Stücke — alles an einem Ort.", "hr": "Izravno sniženje, kuponi za članove i posljednji komadi, sve na jednom mjestu.", "sl": "Neposredno znižanje, kuponi za člane in zadnji kosi, vse na enem mestu.", "bg": "Директни намаления, членски купони и последни бройки, всичко на едно място."}, "filters.gender.all": {"sk": "Všetci", "en": "Everyone", "de": "Alle", "hr": "Svi", "sl": "Vsi", "bg": "Всички"}, "filters.gender.women": {"sk": "Ženy", "en": "Women", "de": "Damen", "hr": "Žene", "sl": "Ženske", "bg": "Жени"}, "filters.gender.men": {"sk": "Muži", "en": "Men", "de": "Herren", "hr": "Muškarci", "sl": "Moški", "bg": "Мъже"}, "hero.shortcut.women": {"sk": "Dámska ponuka", "en": "Shop women's", "de": "Damenmode entdecken", "hr": "Ženska ponuda", "sl": "Ženska ponudba", "bg": "Дамска колекция"}, "hero.shortcut.men