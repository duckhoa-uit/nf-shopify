а отстъпка"}, "filters.loadmore": {"sk": "Zobraziť viac", "en": "Show more", "de": "Mehr anzeigen", "hr": "Prikaži više", "sl": "Pokaži več", "bg": "Покажи още"}, "filters.toggle": {"sk": "Filtre", "en": "Filters", "de": "Filter", "hr": "Filteri", "sl": "Filtri", "bg": "Филтри"}, "filters.showing": {"sk": "Zobrazených {shown} z {total}", "en": "Showing {shown} of {total}", "de": "{shown} von {total} angezeigt", "hr": "Prikazano {shown} od {total}", "sl": "Prikazanih {shown} od {total}", "bg": "Показани {shown} от {total}"}, "filters.empty": {"sk": "Žiadne produkty nezodpovedajú zvoleným filtrom. Skús ich zmeniť.", "en": "No products match these filters. Try adjusting them.", "de": "Keine Produkte entsprechen diesen Filtern. Passe sie an.", "hr": "Nijedan proizvod ne odgovara odabranim filterima. Pokušaj ih promijeniti.", "sl": "Noben izdelek ne ustreza izbranim filtrom. Poskusi jih spremeniti.", "bg": "Няма продукти, отговарящи на тези филтри. Опитай да ги промениш."}, "filters.gender_label": {"sk": "Pohlavie", "en": "Gender", "de": "Geschlecht", "hr": "Spol", "sl": "Spol", "bg": "Пол"}, "filters.category_label": {"sk": "Kategória", "en": "Category", "de": "Kategorie", "hr": "Kategorija", "sl": "Kategorija", "bg": "Категория"}, "filters.discount_label": {"sk": "Zľava", "en": "Discount", "de": "Rabatt", "hr": "Popust", "sl": "Popust", "bg": "Отстъпка"}, "filters.size.all": {"sk": "Všetky veľkosti", "en": "All sizes", "de": "Alle Größen", "hr": "Sve veličine", "sl": "Vse velikosti", "bg": "Всички размери"}, "filters.sort_label": {"sk": "Zoradiť", "en": "Sort by", "de": "Sortieren", "hr": "Sortiraj", "sl": "Razvrsti", "bg": "Сортирай"}, "filters.show_results": {"sk": "Zobraziť výsledky", "en": "Show results", "de": "Ergebnisse anzeigen", "hr": "Prikaži rezultate", "sl": "Prikaži rezultate", "bg": "Покажи резултати"}, "filters.close": {"sk": "Zavrieť", "en": "Close", "de": "Schließen", "hr": "Zatvori", "sl": "Zapri", "bg": "Затвори"}, "card.coupon_badge": {"sk": "Extra &minus;{pct}% v košíku", "en": "Extra &minus;{pct}% in cart", "de": "Extra &minus;{pct}% im Warenkorb", "hr": "Extra &minus;{pct}% u košarici", "sl": "Extra &minus;{pct}% v košarici", "bg": "Extra &minus;{pct}% в количката"}, "card.members_badge": {"sk": "&minus;{pct}% pre členov", "en": "&minus;{pct}% for members", "de": "&minus;{pct}% für Mitglieder", "hr": "&minus;{pct}% za članove", "sl": "&minus;{pct}% za člane", "bg": "&minus;{pct}% за членове"}, "card.direct_badge": {"sk": "&minus;{pct}%", "en": "&minus;{pct}%", "de": "&minus;{pct}%", "hr": "&minus;{pct}%", "sl": "&minus;{pct}%", "bg": "&minus;{pct}%"}, "card.with_coupon": {"sk": "s kupónom", "en": "with coupon", "de": "mit Gutschein", "hr": "s kuponom", "sl": "s kuponom", "bg": "с купон"}, "card.lastchance_badge": {"sk": "Posledné kusy", "en": "Last pieces", "de": "Letzte Stücke", "hr": "Posljednji komadi", "sl": "Zadnji kosi", "bg": "Последни бройки"}, "recent.heading_viewed": {"sk": "Nedávno prezerané", "en": "Recently viewed", "de": "Zuletzt angesehen", "hr": "Nedavno pregledano", "sl": "Nedavno ogledano", "bg": "Наскоро разгледани"}, "recent.heading_suggested": {"sk": "Mohlo by sa vám páčiť", "en": "You might also like", "de": "Das könnte dir auch gefallen", "hr": "Moglo bi vam se svidjeti", "sl": "Morda vam bo všeč tudi", "bg": "Може да харесате и"}, "card.member_lock": {"sk": "Prihlás sa pre cenu &rarr;", "en": "Log in for price &rarr;", "de": "Für Preis anmelden &rarr;", "hr": "Prijavi se za cijenu &rarr;", "sl": "Prijavi se za ceno &rarr;", "bg": "Влез за цена &rarr;"}, "card.learn_more": {"sk": "Nakúpiť &rarr;", "en": "Shop now &rarr;", "de": "Jetzt kaufen &rarr;", "hr": "Kupi sada &rarr;", "sl": "Kupi zdaj &rarr;", "bg": "Пазарувай сега &rarr;"}, "faq.heading": {"sk": "Časté otázky", "en": "FAQ", "de": "Häufige Fragen", "hr": "Često postavljana pitanja", "sl": "Pogosta vprašanja", "bg": "Често задавани въпроси"}, "faq.q1": {"sk": "Kedy sa začína Black Friday?", "en": "When does Black Friday start?", "de": "Wann beginnt der Black Friday?", "hr": "Kada počinje Black Friday?", "sl": "Kdaj se začne črni petek?", "bg": "Кога започва Black Friday?"}, "faq.a1": {"sk": "Členovia vernostného programu NF Flowline (registrovaní zákazníci) získajú skorší prístup k Black Friday zľavám už 5. novembra. Pre všetkých ostatných sa Black Friday začína 10. novembra a potrvá do 2. decembra.", "en": "Members of the NF Flowline loyalty programme (registered customers) get early access to Black Friday discounts from November 5. For everyone else, Black Friday starts on November 10 and runs until December 2.", "de": "Mitglieder des Treueprogramms NF Flowline (registrierte Kunden) erhalten bereits ab dem 5. November frühzeitigen Zugang zu den Black-Friday-Rabatten. Für alle anderen beginnt der Black Friday am 10. November und läuft bis zum 2. Dezember.", "hr": "Članovi programa vjernosti NF Flowline (registrirani kupci) ostvaruju raniji pristup Black Friday popustima već 5. studenog. Za sve ostale Black Friday počinje 10. studenog i traje do 2. prosinca.", "sl": "Člani programa zvestobe NF Flowline (registrirane stranke) dobijo zgodnejši dostop do popustov za Black Friday že 5. novembra. Za vse ostale se Black Friday začne 10. novembra in traja do 2. decembra.", "bg": "Членовете на програмата за лоялност NF Flowline (регистрирани клиенти) получават по-ранен достъп до намаленията за Black Friday вече на 5 ноември. За всички останали Black Friday започва на 10 ноември и продължава до 2 декември."}, "faq.q2": {"sk": "Čo je vernostný program NF Flowline?", "en": "What is the NF Flowline loyalty programme?", "de": "Was ist das Treueprogramm NF Flowline?", "hr": "Što je program vjernosti NF Flowline?", "sl": "Kaj je program zvestobe NF Flowline?", "bg": "Какво представлява програмата за лоялност NF Flowline?"}, "faq.a2": {"sk": "Členstvo v NF Flowline ti prináša množstvo výhod! Registráciou sa automaticky stávaš členom nášho vernostného programu. Podľa výšky svojich nákupov budeš zaradený do jednej z troch úrovní – Flow, Path alebo Peak. Každá úroveň ti prináša 3 až 7-násobok vernostných bodov za nákup, 8–12 % zľavu na vybrané produkty, dopravu zdarma a ďalšie výhody vo forme kupónov. Čím vyššia úroveň, tým viac výhod môžeš využívať!", "en": "NF Flowline membership brings you plenty of benefits! By registering, you automatically become a member of our loyalty programme. Based on how much you shop, you'll be placed into one of three tiers – Flow, Path or Peak. Each tier gives you 3 to 7 times the loyalty points per purchase, an 8–12% discount on selected products, free shipping and further perks in the form of coupons. The higher the tier, the more benefits you can enjoy!", "de": "Die NF-Flowline-Mitgliedschaft bringt dir viele Vorteile! Mit der Registrierung wirst du automatisch Mitglied unseres Treueprogramms. Je nach Höhe deiner Einkäufe wirst du einer von drei Stufen zugeordnet – Flow, Path oder Peak. Jede Stufe bringt dir das 3- bis 7-Fache an Treuepunkten pro Einkauf, 8–12 % Rabatt auf ausgewählte Produkte, kostenlosen Versand und weitere Vorteile in Form von Gutscheinen. Je höher die Stufe, desto mehr Vorteile kannst du nutzen!", "hr": "Članstvo u NF Flowlineu donosi ti mnoštvo pogodnosti! Registracijom automatski postaješ član našeg programa vjernosti. Ovisno o visini svojih kupnji, bit ćeš razvrstan u jednu od tri razine – Flow, Path ili Peak. Svaka razina donosi ti 3 do 7 puta više bodova vjernosti po kupnji, 8–12 % popusta na odabrane proizvode, besplatnu dostavu i dodatne pogodnosti u obliku kupona. Što je razina viša, to više pogodnosti možeš iskoristiti!", "sl": "Članstvo v NF Flowline ti prinaša številne ugodnosti! Z registracijo samodejno postaneš član našega programa zvestobe. Glede na višino svojih nakupov boš uvrščen v eno od treh stopenj – Flow, Path ali Peak. Vsaka stopnja ti prinaša 3- do 7-kratno število zvestobnih točk na nakup, 8–12 % popust na izbrane izdelke, brezplačno dostavo in dodatne ugodnosti v obliki kuponov. Višja kot je stopnja, več ugodnosti lahko izkoristiš!", "bg": "Членството в NF Flowline ти носи множество предимства! С регистрацията автоматично ставаш член на нашата програма за лоялност. В зависимост от стойността на покупките си ще бъдеш включен в едно от трите нива – Flow, Path или Peak. Всяко ниво ти носи от 3 до 7 пъти повече точки лоялност за покупка, 8–12% отстъпка за избрани продукти, безплатна доставка и допълнителни предимства под формата на купони. Колкото по-високо е нивото, толкова повече предимства можеш да ползваш!"}, "faq.q3": {"sk": "Môžem vrátiť tovar kúpený počas Black Friday?", "en": "Can I return items bought during Black Friday?", "de": "Kann ich Artikel vom Black Friday zurückgeben?", "hr": "Mogu li vratiti proizvode kupljene za Black Friday?", "sl": "Ali lahko vrnem izdelke, kupljene med črnim petkom?", "bg": "Мога ли да върна продукти, закупени по време на Black Friday?"}, "faq.a3": {"sk": "Áno, vrátenie je predĺžené do 31. 12. 2026, takže sa to dá kúpiť aj ako darček. Na Slovensku a v Česku je vrátenie tovaru zadarmo cez Packetu / Zásielkovňu.", "en": "Yes — returns are extended until Dec 31, 2026, so it also works as a gift. In Slovakia and Czechia, returns are free via Packeta / Zásielkovňa.", "de": "Ja — die Rückgabe ist bis 31.12.2026 verlängert, perfekt also auch als Geschenk. In der Slowakei und in Tschechien ist die Rückgabe über Packeta / Zásielkovňa kostenlos.", "hr": "Da, povrat je produžen do 31. 12. 2026, pa je prikladno i za poklon. U Slovačkoj i Češkoj povrat je besplatan putem Packete / Zásielkovňe.", "sl": "Da, vračilo je podaljšano do 31. 12. 2026, zato je primerno tudi za darilo. Na Slovaškem in Češkem je vračilo brezplačno prek Packete / Zásielkovňe.", "bg": "Да, връщането е удължено до 31.12.2026 г., така че става и за подарък. В Словакия и Чехия връщането е безплатно през Packeta / Zásielkovňa."}, "faq.q4": {"sk": "Platia ceny po skončení akcie?", "en": "Do the prices stay after the sale?", "de": "Gelten die Preise nach der Aktion weiter?", "hr": "Vrijede li cijene nakon završetka akcije?", "sl": "Ali cene veljajo po koncu akcije?", "bg": "Валидни ли са цените след края на промоцията?"}, "faq.a4": {"sk": "Nie, ceny sa vracajú na pôvodné od 3. decembra.", "en": "No, prices return to normal from December 3.", "de": "Nein, die Preise kehren ab 3. Dezember zu den regulären zurück.", "hr": "Ne, cijene se vraćaju na redovne od 3. prosinca.", "sl": "Ne, cene se vrnejo na redne od 3. decembra.", "bg": "Не, цените се връщат към обичайните от 3 декември."}, "faq.f1.q3": {"sk": "Stojí členstvo niečo?", "en": "Does membership cost anything?", "de": "Kostet die Mitgliedschaft etwas?", "hr": "Košta li članstvo nešto?", "sl": "Ali članstvo kaj stane?", "bg": "Струва ли нещо членството?"}, "faq.f1.a3": {"sk": "Nie, registrácia do NF Flowline je úplne zadarmo a bez záväzkov. Zaregistruj sa ešte dnes a získaj prednostný prístup k Black Friday zľavám už od 5. novembra.", "en": "No, registering for NF Flowline is completely free with no obligations. Register today and get priority access to Black Friday discounts from November 5.", "de": "Nein, die Anmeldung bei NF Flowline ist völlig kostenlos und unverbindlich. Registriere dich noch heute und erhalte bevorzugten Zugang zu Black-Friday-Rabatten ab dem 5. November.", "hr": "Ne, registracija u NF Flowline je potpuno besplatna i bez obaveza. Registriraj se već danas i ostvari prednosni pristup Black Friday popustima već od 5. studenog.", "sl": "Ne, registracija v NF Flowline je popolnoma brezplačna in brez obveznosti. Registriraj se še danes in pridobi prednostni dostop do popustov za Black Friday že od 5. novembra.", "bg": "Не, регистрацията в NF Flowline е напълно безплатна и без задължения. Регистрирай се още днес и получи приоритетен достъп до намаленията за Black Friday вече от 5 ноември."}, "faq.f1.q2": {"sk": "Čo presne získam ako člen vernostného programu NF Flowline?", "en": "What exactly do I get as a member of the NF Flowline loyalty programme?", "de": "Was genau bekomme ich als Mitglied des Treueprogramms NF Flowline?", "hr": "Što točno dobivam kao član programa vjernosti NF Flowline?", "sl": "Kaj točno dobim kot član programa zvestobe NF Flowline?", "bg": "Какво точно получавам като член на програмата за лоялност NF Flowline?"}, "faq.f1.a2": {"sk": "Členstvo v NF Flowline ti prináša množstvo výhod! Podľa výšky svojich nákupov budeš zaradený do jednej z troch úrovní – Flow, Path alebo Peak. Každá úroveň ti prináša 3 až 7-násobok vernostných bodov za nákup, 8–12 % zľavu na vybrané produkty, dopravu zdarma a ďalšie výhody vo forme kupónov. Čím vyššia úroveň, tým viac výhod môžeš využívať!", "en": "NF Flowline membership brings you plenty of benefits! Based on how much you shop, you'll be placed into one of three tiers – Flow, Path or Peak. Each tier gives you 3 to 7 times the loyalty points per purchase, an 8–12% discount on selected products, free shipping and further perks in the form of coupons. The higher the tier, the more benefits you can enjoy!", "de": "Die NF-Flowline-Mitgliedschaft bringt dir viele Vorteile! Je nach Höhe deiner Einkäufe wirst du einer von drei Stufen zugeordnet – Flow, Path oder Peak. Jede Stufe bringt dir das 3- bis 7-Fache an Treuepunkten pro Einkauf, 8–12 % Rabatt auf ausgewählte Produkte, kostenlosen Versand und weitere Vorteile in Form von Gutscheinen. Je höher die Stufe, desto mehr Vorteile kannst du nutzen!", "hr": "Članstvo u NF Flowlineu donosi ti mnoštvo pogodnosti! Ovisno o visini svojih kupnji, bit ćeš razvrstan u jednu od tri razine – Flow, Path ili Peak. Svaka razina donosi ti 3 do 7 puta više bodova vjernosti po kupnji, 8–12 % popusta na odabrane proizvode, besplatnu dostavu i dodatne pogodnosti u obliku kupona. Što je razina viša, to više pogodnosti možeš iskoristiti!", "sl": "Članstvo v NF Flowline ti prinaša številne ugodnosti! Glede na višino svojih nakupov boš uvrščen v eno od treh stopenj – Flow, Path ali Peak. Vsaka stopnja ti prinaša 3- do 7-kratno število zvestobnih točk na nakup, 8–12 % popust na izbrane izdelke, brezplačno dostavo in dodatne ugodnosti v obliki kuponov. Višja kot je stopnja, več ugodnosti lahko izkoristiš!", "bg": "Членството в NF Flowline ти носи множество предимства! В зависимост от стойността на покупките си ще бъдеш включен в едно от трите нива – Flow, Path или Peak. Всяко ниво ти носи от 3 до 7 пъти повече точки лоялност за покупка, 8–12% отстъпка за избрани продукти, безплатна доставка и допълнителни предимства под формата на купони. Колкото по-високо е нивото, толкова повече предимства можеш да ползваш!"}, "faq.f1.q5": {"sk": "Ako získam zľavu na tieto produkty?", "en": "How do I get the discount on these products?", "de": "Wie bekomme ich den Rabatt auf diese Produkte?", "hr": "Kako da dobijem popust na ove proizvode?", "sl": "Kako dobim popust na te izdelke?", "bg": "Как да получа отстъпка за тези продукти?"}, "faq.f1.a5": {"sk": "Od 5. novembra sa členom NF Flowline zľava automaticky uplatní v košíku. Stačí sa prihlásiť do svojho účtu a nakupovať – žiadny zľavový kód nepotrebuješ.", "en": "From November 5, the discount applies automatically in the cart for NF Flowline members. Just log in to your account and shop — no discount code needed.", "de": "Ab dem 5. November wird der Rabatt für NF-Flowline-Mitglieder automatisch im Warenkorb angewendet. Melde dich einfach in deinem Konto an und kaufe ein — du brauchst keinen Rabattcode.", "hr": "Od 5. studenog popust se članovima NF Flowlinea automatski primjenjuje u košarici. Dovoljno je prijaviti se u svoj račun i kupovati – kod za popust ti ne treba.", "sl": "Od 5. novembra se popust članom NF Flowline samodejno uporabi v košarici. Dovolj je, da se prijaviš v svoj račun in nakupuješ – kode za popust ne potrebuješ.", "bg": "От 5 ноември отстъпката се прилага автоматично в количката за членове на NF Flowline. Просто влез в профила си и пазарувай, не е нужен промо код."}, "faq.f1.q4": {"sk": "Som už členom NF Flowline, musím sa registrovať znova?", "en": "I'm already an NF Flowline member, do I need to register again?", "de": "Ich bin bereits NF-Flowline-Mitglied, muss ich mich erneut registrieren?", "hr": "Već sam član NF Flowlinea, moram li se ponovno registrirati?", "sl": "Že sem član NF Flowline, se moram ponovno registrirati?", "bg": "Вече съм член на NF Flowline, трябва ли да се регистрирам отново?"}, "faq.f1.a4": {"sk": "Nie, opätovná registrácia nie je potrebná. Stačí sa 5. novembra prihlásiť do svojho účtu a získaš skorší prístup k Black Friday zľavám. Zvýhodnené ceny sa ti zobrazia priamo pri produktoch.", "en": "No, you don't need to register again. Just log in to your account on November 5 to get early access to Black Friday discounts. The discounted prices will show directly on the products.", "de": "Nein, eine erneute Registrierung ist nicht nötig. Melde dich am 5. November einfach in deinem Konto an, um früheren Zugang zu den Black-Friday-Rabatten zu erhalten. Die reduzierten Preise werden dir direkt bei den Produkten angezeigt.", "hr": "Ne, ponovna registracija nije potrebna. Dovoljno je 5. studenog prijaviti se u svoj račun i ostvarit ćeš raniji pristup Black Friday popustima. Snižene cijene prikazat će se izravno uz proizvode.", "sl": "Ne, ponovna registracija ni potrebna. Dovolj je, da se 5. novembra prijaviš v svoj račun, in pridobil boš zgodnejši dostop do popustov za Black Friday. Znižane cene bodo prikazane neposredno pri izdelkih.", "bg": "Не, не е нужна повторна регистрация. Просто влез в профила си на 5 ноември, за да получиш по-ранен достъп до намаленията за Black Friday. Намалените цени ще се показват директно при продуктите."}, "faq.f2.q1": {"sk": "Kto môže nakupovať ako prvý?", "en": "Who can shop first?", "de": "Wer darf zuerst einkaufen?", "hr": "Tko može kupovati prvi?", "sl": "Kdo lahko nakupuje prvi?", "bg": "Кой може да пазарува първи?"}, "faq.f2.a1": {"sk": "Skorší prístup k zľavám majú členovia vernostného programu NF Flowline. Zaregistruj sa zadarmo, prihlás sa do svojho účtu a nakupuj za výhodné ceny už teraz!", "en": "Early access to the discounts is reserved for members of the NF Flowline loyalty programme. Register for free, log in to your account and shop at great prices right now!", "de": "Frühzeitigen Zugang zu den Rabatten haben Mitglieder des Treueprogramms NF Flowline. Registriere dich kostenlos, melde dich in deinem Konto an und kaufe schon jetzt zu Top-Preisen ein!", "hr": "Raniji pristup popustima imaju članovi programa vjernosti NF Flowline. Registriraj se besplatno, prijavi se u svoj račun i kupuj po povoljnim cijenama već sada!", "sl": "Zgodnejši dostop do popustov imajo člani programa zvestobe NF Flowline. Registriraj se brezplačno, prijavi se v svoj račun in nakupuj po ugodnih cenah že zdaj!", "bg": "По-ранен достъп до намаленията имат членовете на програмата за лоялност NF Flowline. Регистрирай се безплатно, влез в профила си и пазарувай на изгодни цени още сега!"}, "faq.f2.q2": {"sk": "Čo ak ešte nie som členom NF Flowline?", "en": "What if I'm not an NF Flowline member yet?", "de": "Was, wenn ich noch kein NF-Flowline-Mitglied bin?", "hr": "Što ako još nisam član NF Flowlinea?", "sl": "Kaj če še nisem član NF Flowline?", "bg": "Какво, ако все още не съм член на NF Flowline?"}, "faq.f2.a2": {"sk": "Zaregistruj sa zadarmo a získaj skorší prístup k zľavám. Nakupovať môžeš až do 9. novembra.", "en": "Register for free and get early access to the discounts. You can shop until November 9.", "de": "Registriere dich kostenlos und erhalte frühzeitigen Zugang zu den Rabatten. Du kannst bis zum 9. November einkaufen.", "hr": "Registriraj se besplatno i ostvari raniji pristup popustima. Kupovati možeš do 9. studenog.", "sl": "Registriraj se brezplačno in si zagotovi zgodnejši dostop do popustov. Nakupuješ lahko do 9. novembra.", "bg": "Регистрирай се безплатно и получи по-ранен достъп до намаленията. Можеш да пазаруваш до 9 ноември."}, "faq.f2.q3": {"sk": "Budú neskôr väčšie zľavy?", "en": "Will there be bigger discounts later?", "de": "Gibt es später größere Rabatte?", "hr": "Hoće li kasnije biti veći popusti?", "sl": "Ali bodo kasneje večji popusti?", "bg": "Ще има ли по-големи отстъпки по-късно?"}, "faq.f2.a3": {"sk": "Nie, výška zľavy pre členov zostáva počas celého Black Friday rovnaká. Od 10. novembra však pribudnú ďalšie produkty so zníženou cenou, takže si budeš môcť vybrať z ešte širšej ponuky.", "en": "No, the discount for members stays the same throughout Black Friday. From November 10, though, more products at reduced prices will be added, so you'll be able to choose from an even wider range.", "de": "Nein, die Höhe des Rabatts für Mitglieder bleibt während des gesamten Black Friday gleich. Ab dem 10. November kommen jedoch weitere Produkte mit reduziertem Preis hinzu, sodass du aus einem noch größeren Angebot wählen kannst.", "hr": "Ne, visina popusta za članove ostaje ista tijekom cijelog Black Fridaya. Od 10. studenog dodat će se, međutim, još proizvoda sa sniženom cijenom, pa ćeš moći birati iz još šire ponude.", "sl": "Ne, višina popusta za člane ostane enaka ves čas Black Fridaya. Od 10. novembra pa bo dodanih še več izdelkov z znižano ceno, tako da boš lahko izbiral iz še širše ponudbe.", "bg": "Не, размерът на отстъпката за членове остава един и същ през целия Black Friday. От 10 ноември обаче ще се добавят още продукти с намалена цена, така че ще можеш да избираш от още по-широко предложение."}, "faq.f3.q1": {"sk": "Ako dlho trvá výpredaj?", "en": "How long does the sale run?", "de": "Wie lange läuft der Sale?", "hr": "Koliko dugo traje akcija?", "sl": "Kako dolgo traja razprodaja?", "bg": "Колко дълго продължава разпродажбата?"}, "faq.f3.a1": {"sk": "Do 2. decembra. Ceny sa vracajú na pôvodné od 3. decembra.", "en": "Until December 2. Prices return to normal from December 3.", "de": "Bis 2. Dezember. Die Preise kehren ab 3. Dezember zu den regulären zurück.", "hr": "Do 2. prosinca. Cijene se vraćaju na redovne od 3. prosinca.", "sl": "Do 2. decembra. Cene se vrnejo na redne od 3. decembra.", "bg": "До 2 декември. Цените се връщат към обичайните от 3 декември."}, "faq.f3.q2": {"sk": "Prečo sa pri niektorých produktoch zľava nezobrazuje hneď?", "en": "Why doesn't the discount show right away on some products?", "de": "Warum wird der Rabatt bei manchen Produkten nicht sofort angezeigt?", "hr": "Zašto se kod nekih proizvoda popust ne prikazuje odmah?", "sl": "Zakaj se pri nekaterih izdelkih popust ne prikaže takoj?", "bg": "Защо при някои продукти отстъпката не се показва веднага?"}, "faq.f3.a2": {"sk": "Pri niektorých produktoch sa zľava uplatní automaticky až v košíku. Informáciu o zľave nájdeš priamo pri produkte a po vložení do košíka sa ti znížená cena automaticky odpočíta.", "en": "For some products, the discount is only applied automatically in the cart. You'll find information about the discount directly on the product, and once added to the cart, the reduced price is deducted automatically.", "de": "Bei manchen Produkten wird der Rabatt erst automatisch im Warenkorb angewendet. Die Information zum Rabatt findest du direkt beim Produkt, und sobald du es in den Warenkorb legst, wird der reduzierte Preis automatisch abgezogen.", "hr": "Kod nekih proizvoda popust se automatski primjenjuje tek u košarici. Informaciju o popustu pronaći ćeš izravno uz proizvod, a nakon dodavanja u košaricu snižena cijena automatski se odbija.", "sl": "Pri nekaterih izdelkih se popust samodejno uporabi šele v košarici. Informacijo o popustu najdeš neposredno pri izdelku, po dodajanju v košarico pa se znižana cena samodejno odšteje.", "bg": "При някои продукти отстъпката се прилага автоматично едва в количката. Информация за отстъпката ще намериш директно при продукта, а след добавяне в количката намалената цена се приспада автоматично."}};
window.NFWL_LOCALES = ["sk", "en", "de", "hr", "sl", "bg"];
window.nfwlLocale = function(){
 try {
 var forced = localStorage.getItem('nfwlPreviewLocale');
 if (forced && window.NFWL_LOCALES.indexOf(forced) !== -1) return forced;
 var l = (window.Shopify && Shopify.locale) || document.documentElement.lang || 'sk';
 l = String(l).toLowerCase().slice(0,2);
 return window.NFWL_LOCALES.indexOf(l) !== -1 ? l : 'sk';
 } catch(e) { return 'sk'; }
};
window.nfwlT = function(key, vars){
 var loc = window.nfwlLocale();
 var row = window.NFWL_T[key] || {};
 var s = row[loc] || row.sk || key;
 if (vars) Object.keys(vars).forEach(function(k){ s = s.split('{'+k+'}').join(vars[k]); });
 return s;
};
window.nfwlApplyLocale = function(){
 document.querySelectorAll('[data-t]').forEach(function(el){
 var key = el.getAttribute('data-t');
 var val = window.nfwlT(key);
 if (el.innerHTML !== val) el.innerHTML = val;
 });
};
document.addEventListener('nfwlLocaleChange', window.nfwlApplyLocale);
window.nfwlApplyLocale();
window.nfwlAnimateCount = function(el){
 var text = el.textContent;
 var m = text.match(/\d[\d\s.,]*\d|\d/);
 if(!m) return;
 var raw = m[0];
 var sep = raw.indexOf(',') !== -1 ? ',' : (raw.indexOf(' ') !== -1 ? ' ' : (raw.indexOf('.') !== -1 ? '.' : ''));
 var target = parseInt(raw.replace(/[^\d]/g,''), 10);
 if(!target) return;
 var start = null, dur = 1100;
 function frame(now){
 if(start===null) start = now;
 var p = Math.min(1, (now-start)/dur);
 var eased = 1 - Math.pow(1-p, 3);
 var current = Math.round(target*eased);
 var formatted = sep ? String(current).replace(/\B(?=(\d{3})+(?!\d))/g, sep) : String(current);
 el.textContent = text.replace(raw, formatted);
 if(p < 1) requestAnimationFrame(frame); else el.textContent = text;
 }
 requestAnimationFrame(frame);
};
window.nfwlRevealObserver = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? null : new IntersectionObserver(function(entries){
 entries.forEach(function(e){
 if(e.isIntersecting){
 e.target.classList.add('show');
 e.target.querySelectorAll('._sv').forEach(window.nfwlAnimateCount);
 window.nfwlRevealObserver.unobserve(e.target);
 }
 });
}, {threshold:0.12});
window.nfwlReveal = function(){
 document.querySelectorAll('._reveal:not([data-reveal-bound])').forEach(function(el){
 el.setAttribute('data-reveal-bound','1');
 if(window.nfwlRevealObserver){ window.nfwlRevealObserver.observe(el); } else { el.classList.add('show'); }
 });
};
window.nfwlReveal();
