<script>
(function(){
 var t=document.getElementById('stToc');
 if(t){
 var mq=window.matchMedia('(max-width:900px)');
 function sync(){ if(mq.matches) t.removeAttribute('open'); else t.setAttribute('open',''); }
 sync();
 if(mq.addEventListener) mq.addEventListener('change',sync); else if(mq.addListener) mq.addListener(sync);
 window.addEventListener('resize',sync,{passive:true});
 t.querySelectorAll('.st-toc a').forEach(function(a){
 a.addEventListener('click',function(){ if(mq.matches) t.removeAttribute('open'); });
 });
 }
 var secs=[].slice.call(document.querySelectorAll('#nfst .st-sec[id]'));
 var links={};
 document.querySelectorAll('#nfst .st-toc a').forEach(function(a){ links[a.getAttribute('href').slice(1)]=a; });
 function spy(){
 var akt=null;
 for(var i=0;i<secs.length;i++){ if(secs[i].getBoundingClientRect().top<=140) akt=secs[i]; }
 if(window.scrollY<200) akt=null;
 Object.keys(links).forEach(function(id){ links[id].classList.toggle('is-active', !!akt && id===akt.id); });
 }
 if(secs.length){ window.addEventListener('scroll',spy,{passive:true});
 window.addEventListener('resize',spy,{passive:true}); spy(); }
 var b=document.getElementById('stTop');
 if(b){
 function tog(){ b.classList.toggle('is-visible', window.scrollY>800); }
 window.addEventListener('scroll',tog,{passive:true}); tog();
 b.addEventListener('click',function(e){ e.preventDefault();
 window.scrollTo({top:0,behavior:'smooth'}); });
 }
})();
</script>
