{{ 'discover-northfinder.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="flex flex-col items-start w-full discover_northfinder_element page-width section-{{ section.id }}-padding">
  <h2 class="font-extrabold font-archivo-expanded text-base lg:text-2xl leading-7 text-[#0F0F0F] uppercase mb-3 lg:mb-6">
    {{ 'sections.discover-northfinder.title' | t }}
  </h2>

  <div class="swiper w-full">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="relative overflow-hidden bg-foreground/10 w-full">
            <h3 class="absolute top-6 left-6 text-foreground font-medium text-[1.3125rem] leading-6 z-10">
              {{ block.settings['slide-text'] }}
            </h3>

            {%- if block.settings.image != blank -%}
              <div class="relative aspect-square overflow-hidden">
                <img
                  srcset="
                    {%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | image_url: width: 535 }} 535w,{%- endif -%}
                    {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if block.settings.image.width >= 1070 -%}{{ block.settings.image | image_url: width: 1070 }} 1070w,{%- endif -%}
                    {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                  "
                  src="{{ block.settings.image | image_url: width: 535 }}"
                  sizes="(min-width: 1200px) 400px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                >
              </div>
            {%- else -%}
              <div class="bg-foreground/10 aspect-square flex items-center justify-center">
                {{ 'image' | placeholder_svg_tag: 'w-full h-48 text-foreground/50' }}
              </div>
            {%- endif -%}

            <div class="px-3 py-4 md:p-6 absolute left-0 bottom-0 w-full">
              <div class="flex flex-wrap gap-1.5">
                <a
                  href="{{ block.settings.men_collection.url | default: '#' }}"
                  class="inline-block px-3 py-2 text-[13px] md:text-[15px] md:px-5 md:py-[10px] bg-background text-foreground base leading-4 font-medium rounded-3 hover:bg-foreground hover:text-background transition-colors"
                >
                  {{ 'general.discover_northfinder.for_men' | t }}
                </a>

                <a
                  href="{{ block.settings.women_collection.url | default: '#' }}"
                  class="inline-block px-3 py-2 text-[13px] md:text-[15px] md:px-5 md:py-[10px] bg-background text-foreground base leading-4 font-medium rounded-3 hover:bg-foreground hover:text-background transition-colors"
                >
                  {{ 'general.discover_northfinder.for_women' | t }}
                </a>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="swiper-scrollbar"></div>
    <div class="swiper-button-next">
      <span class="icon">
        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="56" height="56" rx="28" fill="white"></rect> <path d="M26 40L34 28L26 16" stroke="#0F0F0F" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
    <div class="swiper-button-prev">
      <span class="icon">
        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="56" height="56" rx="28" transform="matrix(-1 0 0 1 56 0)" fill="white"></rect> <path d="M30 40L22 28L30 16" stroke="#0F0F0F" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Make sure Swiper is loaded
    if (typeof Swiper === 'undefined') {
      // Wait for Swiper to load since we're using defer
      const swiperScript = document.querySelector('script[src*="swiper-bundle.min.js"]');
      swiperScript.addEventListener('load', initSwiper);
    } else {
      initSwiper();
    }

    function initSwiper() {
      var mySwiper = new Swiper('.discover_northfinder_element .swiper', {
        direction: 'horizontal',
        spaceBetween: 8,
        grabCursor: true,
        breakpoints: {
          // when window width is >= 320px
          320: {
            slidesPerView: 1.2,
          },
          // when window width is >= 640px
          640: {
            slidesPerView: 2.2,
          },
          // when window width is >= 1024px
          1024: {
            slidesPerView: 3.1,
          },
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        scrollbar: {
          el: '.swiper-scrollbar',
        },
        a11y: {%- render 'swiper-a11y' -%},
      });
    }
  });
</script>

{% schema %}
{
  "name": "Discover on Northfinder",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Category image" },
        { "type": "text", "id": "slide-text", "label": "Category title", "default": "Category Title" },
        { "type": "collection", "id": "men_collection", "label": "Men's collection" },
        { "type": "collection", "id": "women_collection", "label": "Women's collection" }
      ]
    }
  ],
  "presets": [{ "name": "Discover Northfinder" }]
}
{% endschema %}
