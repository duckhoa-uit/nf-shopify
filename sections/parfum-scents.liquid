</div>

{% schema %}
{
  "name": "t:sections.parfum_scents.name",
  "tag": "section",
  "class": "section-parfum-scents",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tag_text",
      "default": "t:sections.parfum_scents.settings.tag_text.default",
      "label": "t:sections.parfum_scents.settings.tag_text.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.parfum_scents.settings.heading.default",
      "label": "t:sections.parfum_scents.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "default": "t:sections.parfum_scents.settings.description.default",
      "label": "t:sections.parfum_scents.settings.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.parfum_scents.settings.urls.header"
    },
    {
      "type": "url",
      "id": "active_fresh_url",
      "label": "t:sections.parfum_scents.settings.active_fresh_url.label"
    },
    {
      "type": "url",
      "id": "outdoor_flow_url",
      "label": "t:sections.parfum_scents.settings.outdoor_flow_url.label"
    },
    {
      "type": "url",
      "id": "adventure_mist_url",
      "label": "t:sections.parfum_scents.settings.adventure_mist_url.label"
    },
    {
      "type": "url",
      "id": "classic_fresh_url",
      "label": "t:sections.parfum_scents.settings.classic_fresh_url.label"
    },
    {
      "type": "url",
      "id": "pure_essence_url",
      "label": "t:sections.parfum_scents.settings.pure_essence_url.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "t:sections.parfum_scents.presets.name"
    }
  ]
}
{% endschema %}
