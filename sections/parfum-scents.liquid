              <div class="parfum-scents__detail">
                <div class="parfum-scents__detail-header">
                  <div class="parfum-scents__icon">
                    {{ 'tshirt-light.svg' | inline_asset_content }}
                  </div>
                  <span class="parfum-scents__detail-label">{{ 'sections.parfum_scents.best_for' | t }}</span>
                </div>
                <p class="parfum-scents__detail-text">
                  {{ 'sections.parfum_scents.cards.classic_fresh.best_for' | t }}
                </p>
              </div>
            </div>
          </div>

          <div class="parfum-scents__button-wrapper">
            <a
              href="{{ section.settings.classic_fresh_url | default: '#' }}"
              class="button button--secondary parfum-scents__button"
            >
              {{ 'sections.parfum_scents.explore_scent' | t }}
            </a>
          </div>
        </div>
        <div class="parfum-scents__image">
          <img
            src="{{ 'parfum_classic_fresh-37ff15.png' | asset_url }}"
            alt="{{ 'sections.parfum_scents.cards.classic_fresh.name' | t }}"
            loading="lazy"
