{{ 'section-parfum-scents.css' | asset_url | stylesheet_tag }}

<div class="parfum-scents section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.tag_text != blank
      or section.settings.heading != blank
      or section.settings.description != blank
    -%}
      <div class="parfum-scents__header">
        <div class="parfum-scents__header-container">
          {%- if section.settings.tag_text != blank -%}
            <div class="parfum-scents__tag">
              <span class="parfum-scents__tag-text">{{ section.settings.tag_text }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="parfum-scents__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
        </div>
        {%- if section.settings.description != blank -%}
          <div class="parfum-scents__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="parfum-scents__grid">
      <!-- Active Fresh Card -->
      <div class="parfum-scents__card parfum-scents__card--active-fresh">
        <div class="parfum-scents__image">
          <img
            src="{{ 'parfum_active_fresh-73cee9.png' | asset_url }}"
            alt="{{ 'sections.parfum_scents.cards.active_fresh.name' | t }}"
            loading="lazy"
            width="461"
            height="430"
          >
        </div>
        <div class="parfum-scents__content">
          <div class="parfum-scents__info">
            <h3 class="parfum-scents__name">{{ 'sections.parfum_scents.cards.active_fresh.name' | t }}</h3>

            <div class="parfum-scents__details">
              <div class="parfum-scents__detail">
                <div class="parfum-scents__detail-header">
                  <div class="parfum-scents__icon">
                    {{ 'flask-light.svg' | inline_asset_content }}
                  </div>
                  <span class="parfum-scents__detail-label">{{ 'sections.parfum_scents.fragrance_profile' | t }}</span>
                </div>
                <p class="parfum-scents__detail-text">
                  {{ 'sections.parfum_scents.cards.active_fresh.fragrance' | t }}
                </p>
              </div>

              <div class="parfum-scents__detail">
                <div class="parfum-scents__detail-header">
                  <div class="parfum-scents__icon">
                    {{ 'dumbbells-light.svg' | inline_asset_content }}
                  </div>
                  <span class="parfum-scents__detail-label">{{ 'sections.parfum_scents.best_for' | t }}</span>
                </div>
                <p class="parfum-scents__detail-text">{{ 'sections.parfum_scents.cards.active_fresh.best_for' | t }}</p>
              </div>
            </div>
          </div>

          <div class="parfum-scents__button-wrapper">
            <a
              href="{{ section.settings.active_fresh_url | default: '#' }}"
              class="button button--secondary parfum-scents__button"
            >
              {{ 'sections.parfum_scents.explore_scent' | t }}
            </a>
          </div>
        </div>
      </div>

      <!-- Outdoor Flow Card -->
      <div class="parfum-scents__card parfum-scents__card--outdoor-flow">
        <div class="parfum-scents__content">
          <div class="parfum-scents__info">
            <h3 class="parfum-scents__name">{{ 'sections.parfum_scents.cards.outdoor_flow.name' | t }}</h3>

            <div class="parfum-scents__details">
              <div class="parfum-scents__detail">
                <div class="parfum-scents__detail-header">
                  <div class="parfum-scents__icon">
                    {{ 'flask-light.svg' | inline_asset_content }}
                  </div>
                  <span class="parfum-scents__detail-label">{{ 'sections.parfum_scents.fragrance_profile' | t }}</span>
                </div>
                <p class="parfum-scents__detail-text">
                  {{ 'sections.parfum_scents.cards.outdoor_flow.fragrance' | t }}
                </p>
              </div>

              <div class="parfum-scents__detail">
                <div class="parfum-scents__detail-header">
                  <div class="parfum-scents__icon">
                    {{ 'alpine-skiing-light.svg' | inline_asset_content }}
                  </div>
                  <span class="parfum-scents__detail-label">{{ 'sections.parfum_scents.best_for' | t }}</span>
                </div>
                <p class="parfum-scents__detail-text">{{ 'sections.parfum_scents.cards.outdoor_flow.best_for' | t }}</p>
              </div>
            </div>
          </div>

          <div class="parfum-scents__button-wrapper">
            <a
              href="{{ section.settings.outdoor_flow_url | default: '#' }}"
              class="button button--secondary parfum-scents__button"
            >
              {{ 'sections.parfum_scents.explore_scent' | t }}
            </a>
          </div>
        </div>
        <div class="parfum-scents__image">
          <img
            src="{{ 'parfum_outdoor_flow-53b46c.png' | asset_url }}"
            alt="{{ 'sections.parfum_scents.cards.outdoor_flow.name' | t }}"
            loading="lazy"
            width="461"
            height="430"
          >
        </div>
      </div>

      <!-- Adventure Mist Card -->
      <div class="parfum-scents__card parfum-scents__card--adventure-mist">
        <div class="parfum-scents__image">
          <img
