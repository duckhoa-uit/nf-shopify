(function(){
 function nfFixLinks(){
 var locale=(window.Shopify&&Shopify.locale)?Shopify.locale:'en';
 if(locale==='de-at'||locale==='at')locale='de';
 var isDefault=(locale==='en');
 document.querySelectorAll('a[href*="shop.northfinder.com"]:not([data-nf-nofix])').forEach(function(a){
