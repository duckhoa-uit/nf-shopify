 a.href=h.replace('https://shop.northfinder.com/','https://shop.northfinder.com/'+locale+'/');
 }
 });
 }
 if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',nfFixLinks);}
 else{nfFixLinks();}
})();
