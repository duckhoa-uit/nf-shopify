{{ 'account.css' | asset_url | stylesheet_tag }}
{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'flatpickr.min.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .default-address::before {
    content: '{{ 'customer.addresses.default' | t }}';
  }
{%- endstyle -%}

<div class="customer account section-{{ section.id }}-padding"
  data-address-update-success="{{ 'customer.addresses.update_success' | t }}"
  data-info-update-success="{{ 'customer.account.info_update_success' | t }}"
  data-password-mismatch="{{ 'customer.account.password_mismatch' | t }}"
  data-password-update-success="{{ 'customer.account.password_update_success' | t }}"
  data-delete-account-confirm="{{ 'customer.account.delete_confirm' | t }}"
  data-delete-account-success="{{ 'customer.account.delete_success' | t }}"
  data-add-address-title="{{ 'customer.addresses.add_new' | t }}"
  data-form-error="{{ 'customer.form_errors.error' | t }}"
  data-firstname-error="{{ 'customer.form_errors.first_name' | t }}"
  data-lastname-error="{{ 'customer.form_errors.last_name' | t }}"
>
  <div class="account-container">
    <div class="account-header">
      <a href="{{ routes.all_products_collection_url }}" class="account-back-link flex items-center">
        <span class="svg-wrapper mr-0 size-5">
          {{ 'arrow-left.svg' | inline_asset_content }}
        </span>
        <span class="mr-2 text-[#999]">|</span>
        <span>{{ 'customer.account.back_to_shopping' | t }}</span>
      </a>
      <h1 class="account-title">{{ 'customer.account.title' | t }}</h1>
    </div>

    <div class="account-main">
      <div class="account-sidebar">
        <div class="user-info">
          <div class="user-avatar-wrapper">
            <div class="user-avatar">
              {% assign first_letter = customer.name | slice: 0 | upcase %}
              {{ first_letter }}
            </div>
            <div class="avatar-edit-button">
              <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">
                <circle cx="15" cy="15" r="13" fill="#EC0009" stroke="white" stroke-width="4"></circle>
                <path d="M21 14V16H9V14H21Z" fill="white"></path>
                <path d="M16 9V21H14V9H16Z" fill="white"></path>
              </svg>
            </div>
          </div>
          <div class="user-name">{{ customer.name }}</div>
          <div class="user-address">
            {% if customer.default_address %}
              {{ customer.default_address.street }}, {{ customer.default_address.city }}
            {% endif %}
          </div>
        </div>

        <ul class="account-tabs" role="tablist">
          <li role="presentation">
            <a href="#settings" role="tab" class="tab-link active" data-tab="settings">
              {{- 'customer.account.basic_info' | t -}}
            </a>
          </li>
          <li role="presentation">
            <a href="{{ routes.account_addresses_url }}" class="tab-link" data-tab="addresses">
              {{- 'customer.account.addresses' | t -}}
            </a>
          </li>
          <li role="presentation">
            <a href="#orders" role="tab" class="tab-link" data-tab="orders">{{ 'customer.account.orders' | t }}</a>
          </li>
          <li>
            <a href="#bonus" role="tab" class="tab-link" data-tab="bonus">
              {{ 'customer.account.loyalty_bonus' | t }}
              <span class="bonus-pill">48,64 € <span class="bonus-badge">%</span></span>
            </a>
          </li>
          <li role="presentation">
            <a href="#account-settings" role="tab" class="tab-link" data-tab="account-settings">
              {{- 'customer.account.settings' | t -}}
            </a>
          </li>
          <li role="presentation">
            <a href="#wishlist" role="tab" class="tab-link" data-tab="wishlist">
              {{- 'customer.account.wishlist' | t -}}
            </a>
          </li>
          <li>
            <a href="{{ routes.account_logout_url }}" class="logout-link">
              <span class="svg-wrapper">
                {{ 'logout.svg' | inline_asset_content }}
              </span>
              {{ 'customer.log_out' | t }}
            </a>
          </li>
        </ul>

        <button id="account-mobile-menu-button" class="account-mobile-menu-button md:hidden">
          <span class="button-text">{{ 'customer.account.menu' | t | default: 'Menu' }}</span>
          <span class="svg-wrapper ml-2">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </button>

        <template data-icon-caret>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </template>
      </div>

      <div class="account-content">
        <!-- Settings Tab (Basic Info) -->
        {% render 'account-tab-settings', customer: customer %}

        <!-- Addresses Tab - Now handled by main-addresses.liquid -->

        <!-- Orders Tab -->
        {% render 'account-tab-orders', customer: customer %}

        <!-- Bonus Tab -->
        {% render 'account-tab-bonus' %}

        <!-- Account Settings Tab -->
        {% render 'account-tab-account-settings' %}

        <!-- Wishlist Tab -->
        {% render 'account-tab-wishlist' %}
      </div>
    </div>
  </div>
</div>

{% render 'account-mobile-menu' %}

<script src="https://cdn.jsdelivr.net/npm/flatpickr" defer="defer"></script>
<script src="{{ 'account-page.js' | asset_url }}" defer></script>
<script src="{{ 'account-forms.js' | asset_url }}" defer></script>
<script src="{{ 'account-tabs.js' | asset_url }}" defer></script>
<script src="{{ 'account-mobile-menu.js' | asset_url }}" defer></script>
<script src="{{ 'order-reorder.js' | asset_url }}" defer></script>
<script src="{{ 'account-addresses-redirect.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
