._card ._foot{margin-top:auto;padding-top:16px;display:flex;align-items:center;justify-content:space-between;gap:16px}
._card:hover ._shot img{transform:scale(1.03)}
._card:hover ._arw{background:var(--ink);border-color:var(--ink);color:#FFFFFF}
._card:hover ._h{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
._lk{display:block;height:100%}
@media(max-width:767px){._card ._h{font-size:17px}}
/* ── LIST S2 · latest band: the newest episode large, the next three compact ─── */
._ls2{padding:var(--block-y) 0 var(--sec-y)}
._ls2 ._head{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:var(--block-y)}
._ls2 ._all{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:1px solid var(--ink);border-radius:var(--r);
 font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;transition:background-color .18s var(--ease),color .18s var(--ease)}
._ls2 ._all:hover{background:var(--ink);color:#FFFFFF}
._ls2 ._grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:32px}
._ls2 ._lead ._shot{aspect-ratio:16/10}
._ls2 ._lead ._h{font-size:clamp(20px,17px + .4vw,26px);-webkit-line-clamp:2}
._ls2 ._lead ._deck{-webkit-line-clamp:3}
._ls2 ._list{display:flex;flex-direction:column}
._ls2 ._row{display:grid;grid-template-columns:minmax(0,1fr) 120px;gap:16px;align-items:center;padding:20px 0;border-top:1px solid var(--line)}
._ls2 ._list ._row:first-child{padding-top:0;border-top:0}
._ls2 ._row ._rh{margin-top:8px;font-size:17px;font-weight:700;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
._ls2 ._row ._rd{margin-top:6px;font-size:14px;font-weight:500;line-height:1.5;color:var(--ink-60);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
._ls2 ._row ._thumb{position:relative;aspect-ratio:4/3;border-radius:var(--r);overflow:hidden;background:var(--line)}
._ls2 ._row ._thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
._ls2 ._row ._thumb ._ph{position:absolute;inset:0}
._ls2 ._row:hover ._rh{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
._ls2 ._row:hover ._thumb img{transform:scale(1.04)}
@media(max-width:1199px){._ls2 ._grid{grid-template-columns:minmax(0,1fr);gap:32px}._ls2 ._list ._row:first-child{padding-top:20px;border-top:1px solid var(--line)}}
@media(max-width:767px){._ls2 ._head{flex-direction:column;align-items:stretch}._ls2 ._all{width:100%;justify-content:center;height:48px}._ls2 ._row{grid-template-columns:minmax(0,1fr) 96px}}
