 {%- assign t_ch1sub = 'Cum am f?cut pantofi pentru munte' -%}{%- assign t_ch2sub = 'Peak Flow, de la prima schi?? la prima coborâre' -%}{%- assign t_ch3sub = 'Un sezon pe schiuri de tur?, deasupra limitei p?durii' -%}
 {%- assign t_ch4sub = 'Ce trebuie s? duc? un rucsac — ?i cât nu are voie s? cânt?reasc?' -%}{%- assign t_archive = 'Toate articolele' -%}{%- assign t_page = 'Pagina' -%}
