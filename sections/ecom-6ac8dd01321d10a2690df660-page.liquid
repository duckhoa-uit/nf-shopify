(function(){
 var PAGE_SIZE = 8;
 var grid = document.getElementById('bf26Grid');
 var loadMoreBtn = document.getElementById('bf26LoadMore');
 var state = { activity:'all', category:'all', gender:'all', minDiscount:0, lastChance:false, sort:'rec', visible:PAGE_SIZE };
 function priceNum(p){
 var s = (p || '').replace(/&nbsp;|\u00a0/g,' ').replace('€','').trim().replace(/\./g,'').replace(',', '.');
 var n = parseFloat(s);
 return isNaN(n) ? 999999 : n;
 }
 function cardHTML(p){
 var badge = '', priceBlock = '';
 if(p.state === 'direct'){
 badge = '<span class="_rk direct">&minus;'+p.pct+'%</span>';
 priceBlock = '<div class="_cf">'+(p.old? '<span class="_old">'+p.old+'</span>':'')+'<span class="_pr">'+p.price+'</span></div>';
 } else if(p.state === 'coupon'){
 badge = '<span class="_rk coupon">&minus;'+p.pct+'% extra in cart</span>';
 priceBlock = '<div class="_cf"><span class="_pr flat">'+p.price+'</span></div>';
 } else {
 badge = '<span class="_rk members">&minus;'+p.pct+'% members</span>';
 priceBlock = '<div class="_join2">Join to see price</div>';
 }
 return '<article class="_card" data-id="'+p.id+'" data-activity="'+p.activity+'" data-cat="'+p.cat+'" data-gender="'+p.gender+'" data-pct="'+p.pct+'" data-price="'+priceNum(p.price)+'">' +
 '<div class="_im">'+badge+
 '<img src="'+p.img+'" alt="'+p.name+'" loading="lazy" width="800" height="1000">' +
 '</div>' +
 '<h3 class="_ct">'+p.name+'</h3>' + priceBlock +
 '<a class="_learnmore" href="{{ecom_root_url}}collections/black-friday">Learn more &rarr;</a>' +
 '</article>';
 }
 function renderCards(list){
 grid.innerHTML = list.map(cardHTML).join('');
 state.visible = PAGE_SIZE;
 applyFilter();
 }
 renderCards(window.BF26_PRODUCTS);
 // ---- live collection fetch: on a specific Activity pick, pull the REAL
 // full assortment from this store's own collection JSON (same-origin,
 // e.g. /collections/activity-hiking.json) instead of the small embedded
 // sample. Silently falls back to the sample when the fetch can't run
 // (local preview, different host, collection not published, etc). ----
 var CAT_MAP = {Jacket:'jackets',Vest:'jackets',Trousers:'pants',Shorts:'pants',Skirt:'pants',
 Fleece:'fleece','T-shirt':'base',Gloves:'accessories',Cap:'accessories',Scarf:'accessories'};
 var liveCache = {};
 function mapGender(title){
 if(/^Men's/i.test(title)) return 'men';
 if(/^Women's/i.test(title)) return 'women';
 return 'unisex';
 }
 function shortName(title){
 var m = title.match(/[A-Z][A-Z0-9]{2,}/g);
 return m ? m[m.length-1] : title.split(' ').slice(-1)[0];
 }
 function shopifyToCard(sp, activity){
 var v = (sp.variants && sp.variants[0]) || {};
 var price = parseFloat(v.price) || 0; if(price > 1000) price = price/100;
 var compare = v.compare_at_price ? parseFloat(v.compare_at_price) : null;
 if(compare && compare > 1000) compare = compare/100;
 var pct = (compare && compare > price) ? Math.round((compare-price)/compare*100) : 20;
 var img = (sp.images && sp.images[0] && sp.images[0].src) ? sp.images[0].src.split('?')[0]+'?width=600' : '';
 return {
 id: 'sp'+sp.id, name: shortName(sp.title), activity: activity,
 cat: CAT_MAP[sp.product_type] || 'base', gender: mapGender(sp.title), img: img,
 price: price.toFixed(2).replace('.',',')+'&nbsp;€',
 old: (compare && compare > price) ? compare.toFixed(2).replace('.',',')+'&nbsp;€' : '',
 state: 'direct', pct: pct
 };
 }
 function loadActivity(activity){
 if(activity === 'all') { renderCards(window.BF26_PRODUCTS); return; }
 if(liveCache[activity]) { renderCards(liveCache[activity]); return; }
 var fallback = function(){
 // not running on the live store (or collection unavailable) — keep the embedded
 // sample, still correctly filtered to this activity by applyFilter() in renderCards()
 renderCards(window.BF26_PRODUCTS);
 };
 try {
 fetch('/collections/activity-'+activity+'.json?limit=48', {credentials:'same-origin'})
 .then(function(r){ if(!r.ok) throw new Error('no json'); return r.json(); })
 .then(function(data){
 if(!data || !data.products || !data.products.length) throw new Error('empty');
 var cards = data.products.map(function(sp){ return shopifyToCard(sp, activity); });
 liveCache[activity] = cards;
 renderCards(cards);
 })
 .catch(fallback);
 } catch(err) {
 fallback();
 }
 }
 var activitySel = document.getElementById('bf26Activity');
 if(activitySel) activitySel.addEventListener('change', function(){
 state.activity = this.value; state.visible = PAGE_SIZE; loadActivity(state.activity);
 });
 var genderRow = document.getElementById('bf26Gender');
 if(genderRow) genderRow.addEventListener('click', function(e){
 var btn = e.target.closest('[data-v]'); if(!btn) return;
 this.querySelectorAll('[data-active]').forEach(function(b){ b.removeAttribute('data-active'); });
 btn.setAttribute('data-active','true'); state.gender = btn.getAttribute('data-v');
 state.visible = PAGE_SIZE; applyFilter();
 });
 var discountSel = document.getElementById('bf26Discount');
 if(discountSel) discountSel.addEventListener('change', function(){
 state.minDiscount = this.value; state.visible = PAGE_SIZE; applyFilter();
 });
 var categorySel = document.getElementById('bf26Category');
 if(categorySel) categorySel.addEventListener('change', function(){
 state.category = this.value; state.visible = PAGE_SIZE; applyFilter();
 });
 var lastBtn = document.getElementById('bf26Last');
 if(lastBtn) lastBtn.addEventListener('click', function(){
 state.lastChance = this.getAttribute('data-active') !== 'true';
 this.setAttribute('data-active', state.lastChance ? 'true' : 'false');
 state.visible = PAGE_SIZE; applyFilter();
 });
 var sortSel = document.getElementById('bf26Sort');
 if(sortSel) sortSel.addEventListener('change', function(){ state.sort = this.value; applySort(); });
 if(loadMoreBtn) loadMoreBtn.addEventListener('click', function(){ state.visible += PAGE_SIZE; applyFilter(); });
 function applyFilter(){
 var minD = Number(state.minDiscount)||0;
 var matched = [];
 grid.querySelectorAll('._card').forEach(function(card){
 var okA = state.activity==='all' || card.dataset.activity===state.activity;
 var okC = state.category==='all' || card.dataset.cat===state.category;
 var okG = state.gender==='all' || card.dataset.gender===state.gender || card.dataset.gender==='unisex';
 var okD = Number(card.dataset.pct) >= minD;
 var okL = !state.lastChance || Number(card.dataset.pct) >= 50;
 if(okA && okC && okG && okD && okL){ matched.push(card); } else { card.style.display = 'none'; }
 });
 matched.forEach(function(card, i){ card.style.display = i < state.visible ? '' : 'none'; });
 if(loadMoreBtn) loadMoreBtn.hidden = matched.length <= state.visible;
 }
 function applySort(){
 var cards = Array.from(grid.querySelectorAll('._card'));
 var cmp = {
 rec: function(){ return 0; },
 price_asc: function(a,b){ return Number(a.dataset.price) - Number(b.dataset.price); },
 price_desc: function(a,b){ return Number(b.dataset.price) - Number(a.dataset.price); },
 discount: function(a,b){ return Number(b.dataset.pct) - Number(a.dataset.pct); }
 }[state.sort];
 if(state.sort !== 'rec') cards.sort(cmp);
 cards.forEach(function(c){ grid.appendChild(c); });
 }
})();
</script>
