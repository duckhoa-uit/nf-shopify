.nfbf{width:100vw;position:relative;left:50%;transform:translateX(-50%);overflow-x:hidden;background:#000;color:#fff}
.nfbf img{display:block;max-width:100%}
.nfbf a,.nfbf a:visited,.nfbf a:hover,.nfbf a:active{text-decoration:none!important;color:inherit}
.nfbf :where(h1,h2,h3,h4,h5,h6,p,span,b,em,i,li,strong,small){color:inherit;font-family:inherit}
.nfbf button{background:none;border:0;padding:0;cursor:pointer;font:inherit;color:inherit}
.nfbf :focus-visible{outline:2px solid #fff;outline-offset:2px}
.nfbf ._wrap{padding:0 32px}
@media(max-width:1023px){.nfbf ._wrap{padding:0 24px}}
@media(max-width:767px){.nfbf ._wrap{padding:0 20px}}
@media(prefers-reduced-motion:reduce){.nfbf *{transition:none!important;animation:none!important}}
</style>
<style>
.nfbf ._close{padding:60px 0 40px}
.nfbf ._rule{height:2px;background:#EC1C24;margin-bottom:26px}
.nfbf ._ch{color:#EC1C24;font-weight:800;line-height:1;letter-spacing:-.02em;font-size:clamp(28px,5.6vw,64px);text-transform:uppercase}
.nfbf ._nl{position:relative;border-radius:4px;overflow:hidden;background-size:cover;background-position:center 30%;min-height:360px;display:flex;align-items:center;justify-content:center;text-align:center;margin:40px 0}
.nfbf ._nl::before{content:"";position:absolute;inset:0;background:rgba(0,0,0,.5)}
.nfbf ._nlc{position:relative;z-index:2;color:#fff;max-width:400px;padding:20px}
.nfbf ._nlc h2{font-size:clamp(20px,2.4vw,28px);font-weight:800;text-transform:uppercase}
.nfbf ._nlf{display:flex;gap:10px;margin-top:16px}
.nfbf ._nlf input{flex:1;border:none;border-radius:999px;padding:0 16px;height:44px;font-family:inherit;font-size:12px;background:rgba(255,255,255,.14);color:#fff}
.nfbf ._nlf input::placeholder{color:rgba(255,255,255,.65)}
.nfbf ._nlf button{border-radius:999px;background:#fff;color:#000;border:none;height:44px;padding:0 20px;font-weight:800;font-size:12px;text-transform:uppercase}
.nfbf ._faq{max-width:680px}
.nfbf ._faq h2{font-size:22px;font-weight:800;text-transform:uppercase;margin-bottom:16px}
.nfbf details{border-bottom:1px solid #222;padding:14px 0}
.nfbf details summary{font-size:14px;font-weight:700;cursor:pointer;list-style:none;display:flex;justify-content:space-between}
.nfbf details summary::-webkit-details-marker{display:none}
.nfbf details summary::after{content:"+";color:#777}
.nfbf details[open] summary::after{content:"\2212"}
.nfbf details p{margin-top:8px;font-size:13px;color:#999}
.nfbf ._foot{border-top:1px solid #222;margin-top:48px;padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:11.5px;color:#777}
</style>
<div class="nfbf">
<div class="_wrap _close">
 <div class="_rule"></div>
 <h2 class="_ch" data-t="close_h">Biggest sale.</h2>
 <h2 class="_ch" data-t="close_h2">No excuses.</h2>
