{{ 'materials.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient materials-section">
  <div class="section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.title != blank -%}
        <div class="section-header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} mb-0">
          <h2 class="font-extrabold font-archivo-expanded text-base lg:text-2xl leading-7 text-gray-950 uppercase mb-3 lg:mb-6">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {% render 'materials-tabs', blocks: section.blocks, tabs_id: section.id %}
      {%- else -%}
        <div class="placeholder-container">
          <div class="placeholder">
            <div class="placeholder-content">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              <h4>Materials Section</h4>
              <p>Add material blocks to create tabs showcasing different materials</p>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Materials",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "MATERIALS",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "name": "Single Material",
      "type": "material",
      "settings": [
        {
          "type": "text",
          "id": "material_name",
          "default": "PERTEX® SHIELD",
          "label": "Material name",
          "info": "This will be displayed as the tab title"
        },
        {
          "type": "article",
          "id": "article",
          "label": "Blog article",
          "info": "Auto-loads thumbnail, title, description and URL. Fields below override the article values."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Material image",
          "info": "Overrides article image. Displayed if no video URL is provided or as video poster"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Supports YouTube, Vimeo, or direct MP4 links. Will override image if provided."
        },
        {
          "type": "text",
          "id": "title",
          "default": "ULTIMATE PROTECTION FOR THE MOUNTAINS",
          "label": "Title",
          "info": "Overrides article title"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>The ultralight and powerful Pertex® Shield material excels in its ability to protect against adverse weather and at the same time offers excellent comfort during active movement. It is one of the best membranes on the outdoor clothing market.</p>",
          "label": "Description",
          "info": "Overrides article excerpt"
        },
        {
          "type": "text",
          "id": "button_text",
          "default": "READ MORE",
          "label": "Button text",
          "info": "Button will be displayed even if URL is not provided"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL",
          "info": "Overrides article URL"
        },
        {
          "type": "checkbox",
          "id": "show_title_above_media_on_mobile",
          "label": "Show title above media on mobile",
          "default": false,
          "info": "When enabled, the title will appear above the media on mobile devices"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Materials",
      "blocks": [
        {
          "type": "material",
          "settings": {
            "material_name": "PERTEX® SHIELD",
            "title": "ULTIMATE PROTECTION FOR THE MOUNTAINS",
            "description": "<p>The ultralight and powerful Pertex® Shield material excels in its ability to protect against adverse weather and at the same time offers excellent comfort during active movement. It is one of the best membranes on the outdoor clothing market.</p>",
            "button_text": "READ MORE"
          }
        },
        {
          "type": "material",
          "settings": {
            "material_name": "POLARTEC® ALPHA®",
            "title": "ACTIVE INSULATION FOR OUTDOOR ACTIVITIES",
            "description": "<p>Active insulation is a popular partner for outdoor enthusiasts. The more intensively you exercise, the more it \"works\" in your favor. In addition, it allows you to lighten your equipment load by some extra grams.</p>",
            "button_text": "READ MORE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
