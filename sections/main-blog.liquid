{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .blog-search-form {
    margin-bottom: 2rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .blog-search-form {
      max-width: 410px;
    }
  }

  .blog-search-input {
    position: relative;
    display: flex;
    align-items: center;
  }

  .blog-search-input input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #808080;
    background-color: #FFFFFF;
    border-radius: 3px;
    font-family: Archivo, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.43;
    color: #666666;
  }

  .blog-search-input input::placeholder {
    color: #666666;
  }

  .blog-search-input .icon {
    position: absolute;
    right: 12px;
  }

  .blog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #d1d0d0;
    padding-bottom: 1rem;
  }

  .blog-category {
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    position: relative;
  }

  .blog-category.active {
    color: #EC0009;
  }

  .blog-category.active::after {
    content: '';
    position: absolute;
    bottom: -1rem;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #EC0009;
  }

  .blog-articles {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .blog-articles {
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .load-more-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .load-more-button {
    background-color: #0F0F0F;
    color: #FFFFFF;
    border: none;
    border-radius: 3px;
    padding: 12px 60px;
    font-family: Archivo, sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 1.14;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: opacity 0.2s ease;
  }

  .load-more-button:hover:not([disabled]) {
    opacity: 0.9;
  }

  .load-more-button.loading {
    background-color: #333333;
  }

  .load-more-button[disabled] {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .loading-spinner {
    animation: spin 1s linear infinite;
    height: 20px;
    width: 20px;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .no-results-message {
    text-align: center;
    padding: 2rem 0;
    font-size: 1rem;
    color: #666;
    display: none;
  }
{%- endstyle -%}

<div class="main-blog page-width section-{{ section.id }}-padding">
  <h1 class="font-extrabold font-archivo-expanded text-lg lg:text-2xl leading-7 text-[#0F0F0F] uppercase mb-6{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ blog.title | escape }}
  </h1>

  {% if section.settings.enable_search %}
    <div class="blog-search-form">
      <form
        id="blog-search-form"
        role="search"
        onsubmit="return false;"
      >
        <div class="blog-search-input">
          <input
            type="search"
            id="blog-search-input"
            name="q"
            placeholder="{{ 'blogs.main_blog.search_placeholder' | t }}"
            value="{{ search.terms | escape }}"
          >
          <span class="icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              id="blog-search-submit"
              style="cursor: pointer;"
            >
              <path
                d="M19 19L14.65 14.65M17 9C17 13.4183 13.4183 17 9 17C4.58172 17 1 13.4183 1 9C1 4.58172 4.58172 1 9 1C13.4183 1 17 4.58172 17 9Z"
                stroke="#0F0F0F"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </form>
    </div>
  {% endif %}

  {% if section.settings.enable_filtering %}
    <div class="blog-categories">
      <div class="blog-category active" data-category="all">{{ 'blogs.main_blog.all_articles' | t }}</div>
      <div class="blog-category" data-category="skialp">#{{ 'blogs.main_blog.categories.skialp' | t }}</div>
      <div class="blog-category" data-category="adventure">#{{ 'blogs.main_blog.categories.adventure' | t }}</div>
      <div class="blog-category" data-category="tips">#{{ 'blogs.main_blog.categories.tips' | t }}</div>
      <div class="blog-category" data-category="gear">#{{ 'blogs.main_blog.categories.gear' | t }}</div>
    </div>
  {% endif %}

  {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div class="blog-articles">
      <div class="no-results-message">{{ 'blogs.main_blog.no_results' | t }}</div>
      {%- for article in blog.articles -%}
        <div
          class="blog-articles__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {% if article.tags.size > 0 %}
            data-tags="{{ article.tags | join: ' ' | downcase }}"
          {% endif %}
        >
          {%- render 'article-card',
            article: article,
            media_height: section.settings.image_height,
            media_aspect_ratio: article.image.aspect_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: true
          -%}
        </div>
      {%- endfor -%}
    </div>

    {% if section.settings.enable_load_more and paginate.pages > 1 %}
      <div class="load-more-container">
        <button class="load-more-button" id="main-blog-load-more-button">
          <span class="load-more-text">{{ 'blogs.main_blog.view_more' | t }}</span>
          <span class="loading-spinner" style="display: none;">
            <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
        </button>
      </div>
    {% else %}
      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {% endif %}
  {%- endpaginate -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Get DOM elements
    const categories = document.querySelectorAll('.blog-category');
    const articles = document.querySelectorAll('.blog-articles__article');
    const searchForm = document.getElementById('blog-search-form');
    const searchInput = document.getElementById('blog-search-input');
    const searchButton = document.getElementById('blog-search-submit');

    // Current filters state
    let currentCategory = 'all';
    let currentSearchQuery = '';
    let currentPage = 1;

    // Function to filter articles based on category and search query
    function filterArticles() {
      let visibleCount = 0;
      const noResultsMessage = document.querySelector('.no-results-message');
      const loadMoreButton = document.getElementById('main-blog-load-more-button');

      articles.forEach((article) => {
        let showByCategory = true;
        let showBySearch = true;

        // Category filtering
        if (currentCategory !== 'all') {
          const tags = article.getAttribute('data-tags');
          showByCategory = tags && tags.includes(currentCategory.toLowerCase());
        }

        // Search filtering
        if (currentSearchQuery) {
          const articleContent = article.textContent.toLowerCase();
          showBySearch = articleContent.includes(currentSearchQuery.toLowerCase());
        }

        // Show article only if it passes both filters
        if (showByCategory && showBySearch) {
          article.style.display = 'block';
          visibleCount++;
        } else {
          article.style.display = 'none';
        }
      });

      // Show/hide no results message
      if (visibleCount === 0) {
        noResultsMessage.style.display = 'block';
        if (loadMoreButton) {
          loadMoreButton.style.display = 'none';
        }
      } else {
        noResultsMessage.style.display = 'none';
        if (loadMoreButton && currentPage < 3) {
          loadMoreButton.style.display = 'flex';
        }
      }
    }

    // Category filtering
    categories.forEach((category) => {
      category.addEventListener('click', function () {
        // Remove active class from all categories
        categories.forEach((cat) => cat.classList.remove('active'));

        // Add active class to clicked category
        this.classList.add('active');

        // Update current category
        currentCategory = this.getAttribute('data-category');

        // Apply filters
        filterArticles();
      });
    });

    // Search functionality
    function handleSearch() {
      currentSearchQuery = searchInput.value.trim();
      filterArticles();
    }

    // Search on enter key
    searchInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleSearch();
      }
    });

    // Search on click
    searchButton.addEventListener('click', function() {
      handleSearch();
    });

    // Load more functionality
    const loadMoreButton = document.getElementById('main-blog-load-more-button');
    const loadMoreText = loadMoreButton ? loadMoreButton.querySelector('.load-more-text') : null;
    const loadingSpinner = loadMoreButton ? loadMoreButton.querySelector('.loading-spinner') : null;

    if (loadMoreButton) {
      loadMoreButton.addEventListener('click', function () {
        // Don't do anything if button is disabled
        if (loadMoreButton.hasAttribute('disabled')) {
          return;
        }

        // Show loading state
        if (loadMoreText) loadMoreText.style.display = 'none';
        if (loadingSpinner) loadingSpinner.style.display = 'inline-block';
        loadMoreButton.classList.add('loading');

        currentPage++;
        const nextPageUrl = window.location.pathname + '?page=' + currentPage;

        fetch(nextPageUrl)
          .then((response) => {
            if (!response.ok) {
              throw new Error('Network response was not ok');
            }
            return response.text();
          })
          .then((html) => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newArticles = doc.querySelectorAll('.blog-articles__article');
            const articlesContainer = document.querySelector('.blog-articles');

            // Check if we got any new articles
            if (newArticles.length === 0) {
              console.log('No more articles to load');
              // Hide the button completely
              loadMoreButton.style.display = 'none';
              return;
            }

            // Add new articles to the grid
            newArticles.forEach((article) => {
              const clonedArticle = article.cloneNode(true);
              articlesContainer.appendChild(clonedArticle);

              // Apply current filters to newly loaded articles
              if (currentCategory !== 'all' || currentSearchQuery) {
                // Add the data-tags attribute to the cloned article
                if (article.hasAttribute('data-tags')) {
                  clonedArticle.setAttribute('data-tags', article.getAttribute('data-tags'));
                }

                let showByCategory = true;
                let showBySearch = true;

                // Category filtering
                if (currentCategory !== 'all') {
                  const tags = clonedArticle.getAttribute('data-tags');
                  showByCategory = tags && tags.includes(currentCategory.toLowerCase());
                }

                // Search filtering
                if (currentSearchQuery) {
                  const articleContent = clonedArticle.textContent.toLowerCase();
                  showBySearch = articleContent.includes(currentSearchQuery.toLowerCase());
                }

                // Show article only if it passes both filters
                if (!(showByCategory && showBySearch)) {
                  clonedArticle.style.display = 'none';
                }
              }
            });

            // Reset loading state
            if (loadMoreText) loadMoreText.style.display = 'inline';
            if (loadingSpinner) loadingSpinner.style.display = 'none';
            loadMoreButton.classList.remove('loading');

            // Check if we've reached the last page
            const paginationInfo = doc.querySelector('.pagination');
            const nextPageExists = doc.querySelectorAll('.blog-articles__article').length > 0;

            if (!nextPageExists || !paginationInfo || currentPage >= 3) {
              // Hide the button completely when no more articles or reached last page
              loadMoreButton.style.display = 'none';
            }
          })
          .catch((error) => {
            console.error('Error loading more articles:', error);

            // Reset loading state
            if (loadMoreText) loadMoreText.style.display = 'inline';
            if (loadingSpinner) loadingSpinner.style.display = 'none';
            loadMoreButton.classList.remove('loading');

            // Hide the button on error
            loadMoreButton.style.display = 'none';
          });
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label",
      "info": "t:sections.main-blog.settings.image_height.info"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_filtering.label"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_search.label"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "t:sections.main-blog.settings.posts_per_page.label"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_load_more.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-blog.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
