{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .blog-search-form {
    margin-bottom: 2rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .blog-search-form {
      max-width: 410px;
    }
  }

  .blog-search-input {
    position: relative;
    display: flex;
    align-items: center;
  }

  .blog-search-input input {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #808080;
    background-color: #FFFFFF;
    border-radius: 3px;
    font-family: Archivo, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.43;
    color: #666666;
  }

  .blog-search-input input::placeholder {
    color: #666666;
  }

  .blog-search-input .icon {
    position: absolute;
    right: 12px;
  }

  .blog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #d1d0d0;
    padding-bottom: 1rem;
  }

  .blog-category {
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    position: relative;
    text-decoration: none;
    color: inherit;
    display: inline-block;
  }

  .blog-category:hover {
    text-decoration: none;
    color: inherit;
  }

  .blog-category.active {
    color: #EC0009;
  }

  .blog-category.active::after {
    content: '';
    position: absolute;
    bottom: -1rem;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #EC0009;
  }

  .blog-articles {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .blog-articles {
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 3rem;
    }
  }

  .load-more-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* Use unified button system - override specific properties for load-more */
  .load-more-button.button {
    min-width: 160px;
    padding: 12px 60px;
  }

  .no-results-message {
    text-align: center;
    padding: 2rem 0;
    font-size: 1rem;
    color: #666;
    display: none;
  }
{%- endstyle -%}

<div class="main-blog page-width section-{{ section.id }}-padding">
  <h1 class="font-extrabold font-archivo-expanded text-lg lg:text-2xl leading-7 text-gray-950 uppercase mb-6{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ blog.title | escape }}
  </h1>

  {% if section.settings.enable_search %}
    <div class="blog-search-form">
      <form
        id="blog-search-form"
        role="search"
        onsubmit="return false;"
      >
        <div class="blog-search-input">
          <input
            type="search"
            id="blog-search-input"
            name="q"
            placeholder="{{ 'blogs.main_blog.search_placeholder' | t }}"
            value="{{ search.terms | escape }}"
          >
          <span class="icon">
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              id="blog-search-submit"
              style="cursor: pointer;"
            >
              <path
                d="M19 19L14.65 14.65M17 9C17 13.4183 13.4183 17 9 17C4.58172 17 1 13.4183 1 9C1 4.58172 4.58172 1 9 1C13.4183 1 17 4.58172 17 9Z"
                stroke="#0F0F0F"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </form>
    </div>
  {% endif %}

  {%- assign has_user_tag = false -%}
  {%- if current_tags != blank -%}
    {%- assign has_user_tag = true -%}
  {%- endif -%}

  {% if section.settings.enable_filtering %}
    <div class="blog-categories">
      <!-- All articles link - active when no chip-tag is selected -->
      <a
        href="{{ blog.url }}{% if request.params.search %}?search={{ request.params.search | url_encode }}{% endif %}"
        class="blog-category{% unless has_user_tag %} active{% endunless %}"
      >
        {{ 'blogs.main_blog.all_articles' | t }}
      </a>

      {%- for tag in blog.all_tags -%}
        {%- liquid
          assign tag_handle = tag | handleize
          assign tag_lc = tag | downcase
          assign cat_prefix = tag_lc | slice: 0, 4
          assign chip_label = tag
          if cat_prefix == 'cat:'
            assign cat_slug = tag | remove_first: 'cat:' | remove_first: 'CAT:' | remove_first: 'Cat:' | strip | downcase | handleize
            assign cat_entry = shop.metaobjects.blog_category[cat_slug]
            if cat_entry != blank and cat_entry.name != blank
              assign chip_label = cat_entry.name
            else
              assign chip_label = tag | remove_first: 'cat:' | remove_first: 'CAT:' | remove_first: 'Cat:' | strip | capitalize
            endif
          endif
        -%}
        <a
          href="{{ blog.url }}/tagged/{{ tag_handle }}{% if request.params.search %}?search={{ request.params.search | url_encode }}{% endif %}"
          class="blog-category{% if current_tags contains tag %} active{% endif %}"
          aria-current="{% if current_tags contains tag %}page{% endif %}"
        >
          #{{ chip_label }}
        </a>
      {%- endfor -%}
    </div>
  {% endif %}

  {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div class="blog-articles">
      <div class="no-results-message">{{ 'blogs.main_blog.no_results' | t }}</div>
      {%- for article in blog.articles -%}
        <div
          class="blog-articles__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {% if article.tags.size > 0 %}
            data-tags="{{ article.tags | join: ' ' | downcase }}"
          {% endif %}
        >
          {%- render 'article-card',
            article: article,
            media_height: section.settings.image_height,
            media_aspect_ratio: article.image.aspect_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: true
          -%}
        </div>
      {%- endfor -%}
    </div>

    {% if section.settings.enable_load_more and paginate.pages > 1 %}
      <div class="load-more-container">
        <button class="button load-more-button" id="main-blog-load-more-button">
          <span class="button-text">{{ 'blogs.main_blog.view_more' | t }}</span>
          <span class="button-spinner" style="display: none;">
            {{- 'loading-spinner.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    {% else %}
      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {% endif %}
  {%- endpaginate -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Get DOM elements for search functionality
    const searchForm = document.getElementById('blog-search-form');
    const searchInput = document.getElementById('blog-search-input');
    const searchButton = document.getElementById('blog-search-submit');

    // Current search state
    let currentSearchQuery = '';
    const initialPage = {{ paginate.current_page | default: 1 }};
    let currentPage = initialPage;
    const totalPages = {{ paginate.pages | default: 1 }};
    let searchTimeout;

    // Initialize search from URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const searchFromUrl = urlParams.get('search');

    if (searchFromUrl) {
      currentSearchQuery = searchFromUrl;
      // Update search input field
      if (searchInput) {
        searchInput.value = searchFromUrl;
      }
    }

    // Function to filter articles based on search query only (categories handled by server)
    function filterArticles() {
      let visibleCount = 0;
      const noResultsMessage = document.querySelector('.no-results-message');
      const loadMoreButton = document.getElementById('main-blog-load-more-button');

      // Get all current articles (including newly loaded ones)
      const currentArticles = document.querySelectorAll('.blog-articles__article');

      currentArticles.forEach((article) => {
        let showBySearch = true;

        // Search filtering only (categories handled by Shopify server-side)
        if (currentSearchQuery) {
          const articleContent = article.textContent.toLowerCase();
          showBySearch = articleContent.includes(currentSearchQuery.toLowerCase());
        }

        // Show article based on search filter
        if (showBySearch) {
          article.style.display = 'block';
          visibleCount++;
        } else {
          article.style.display = 'none';
        }
      });

      // Show/hide no results message and load more button
      if (visibleCount === 0) {
        noResultsMessage.style.display = 'block';
        if (loadMoreButton) {
          loadMoreButton.style.display = 'none';
        }
      } else {
        noResultsMessage.style.display = 'none';

        // Hide load more button if search is active and visible count is less than pagination size
        // This prevents showing load more when search results are limited
        if (loadMoreButton) {
          const postsPerPage = {{ section.settings.posts_per_page | default: 8 }};
          const totalArticles = currentArticles.length;

          // Hide load more button if:
          // 1. Search is active AND visible count < posts per page, OR
          // 2. We're on the first page and visible count < posts per page (indicating no more pages)
          if ((currentSearchQuery && visibleCount < postsPerPage) ||
              (currentPage === 1 && visibleCount < postsPerPage && totalArticles <= postsPerPage)) {
            loadMoreButton.style.display = 'none';
          } else if (visibleCount > 0) {
            loadMoreButton.style.display = 'flex';
          }
        }
      }
    }

    // Search functionality
    function handleSearch() {
      currentSearchQuery = searchInput.value.trim();

      // Update URL with search query (preserve current tag filtering)
      updateSearchURL();

      filterArticles();
    }

    // Function to update URL with search query while preserving tag filtering
    function updateSearchURL() {
      const currentUrl = new URL(window.location);

      if (currentSearchQuery) {
        currentUrl.searchParams.set('search', currentSearchQuery);
      } else {
        currentUrl.searchParams.delete('search');
      }

      // Update URL without page reload
      history.pushState({
        search: currentSearchQuery
      }, '', currentUrl.toString());
    }

    // Real-time search with debouncing
    searchInput.addEventListener('input', function () {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        handleSearch();
      }, 300); // 300ms debounce delay
    });

    // Search on enter key (immediate search)
    searchInput.addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        clearTimeout(searchTimeout); // Cancel debounced search
        handleSearch(); // Execute immediately
      }
    });

    // Search on click (immediate search)
    searchButton.addEventListener('click', function () {
      clearTimeout(searchTimeout); // Cancel debounced search
      handleSearch(); // Execute immediately
    });

    // Load more functionality
    const loadMoreButton = document.getElementById('main-blog-load-more-button');
    const loadMoreText = loadMoreButton ? loadMoreButton.querySelector('.button-text') : null;
    const loadingSpinner = loadMoreButton ? loadMoreButton.querySelector('.button-spinner') : null;

    if (loadMoreButton) {
      loadMoreButton.addEventListener('click', function () {
        // Don't do anything if button is disabled
        if (loadMoreButton.hasAttribute('disabled')) {
          return;
        }

        // Show loading state using unified button system
        loadMoreButton.classList.add('loading');

        currentPage++;
        const nextPageUrl = window.location.pathname + '?page=' + currentPage;

        fetch(nextPageUrl)
          .then((response) => {
            if (!response.ok) {
              throw new Error('Network response was not ok');
            }
            return response.text();
          })
          .then((html) => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newArticles = doc.querySelectorAll('.blog-articles__article');
            const articlesContainer = document.querySelector('.blog-articles');

            // Check if we got any new articles
            if (newArticles.length === 0) {
              console.log('No more articles to load');
              // Hide the button completely
              loadMoreButton.style.display = 'none';
              return;
            }

            // Add new articles to the grid
            newArticles.forEach((article) => {
              const clonedArticle = article.cloneNode(true);
              articlesContainer.appendChild(clonedArticle);

              // Apply search filter to newly loaded articles (categories handled by server)
              if (currentSearchQuery) {
                let showBySearch = true;

                // Search filtering only
                if (currentSearchQuery) {
                  const articleContent = clonedArticle.textContent.toLowerCase();
                  showBySearch = articleContent.includes(currentSearchQuery.toLowerCase());
                }

                // Hide article if it doesn't match search
                if (!showBySearch) {
                  clonedArticle.style.display = 'none';
                }
              }
            });

            // Reset loading state using unified button system
            loadMoreButton.classList.remove('loading');

            // Check if we've reached the last page using pagination data
            if (currentPage >= totalPages) {
              // Hide the button completely when we've reached the last page
              loadMoreButton.style.display = 'none';
            }
          })
          .catch((error) => {
            console.error('Error loading more articles:', error);

            // Reset loading state using unified button system
            loadMoreButton.classList.remove('loading');

            // Hide the button on error
            loadMoreButton.style.display = 'none';
          });
      });
    }

    // Handle browser back/forward buttons for search
    window.addEventListener('popstate', function(event) {
      if (event.state) {
        // Restore search state from history
        currentSearchQuery = event.state.search || '';

        // Update search input to match state
        if (searchInput) {
          searchInput.value = currentSearchQuery;
        }

        // Apply search filter
        filterArticles();
      }
    });



    // Apply initial search filter if present
    if (currentSearchQuery) {
      filterArticles();
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label",
      "info": "t:sections.main-blog.settings.image_height.info"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_filtering.label"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_search.label"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "t:sections.main-blog.settings.posts_per_page.label"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_load_more.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-blog.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
