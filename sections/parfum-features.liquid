{{ 'section-parfum-features.css' | asset_url | stylesheet_tag }}

<div class="parfum-features section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="parfum-features__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="parfum-features__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="parfum-features__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="parfum-features__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'feature' -%}
              <div class="parfum-features__card" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <div class="parfum-features__icon">
                    <div class="parfum-features__icon-wrapper">
                      {%- assign icon_file = block.settings.icon | append: '.svg' -%}
                      {{ icon_file | inline_asset_content }}
                    </div>
                  </div>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="parfum-features__title">
                    {{ block.settings.title }}
                  </h3>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.parfum-features.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.parfum-features.settings.heading.default",
      "label": "t:sections.parfum-features.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "t:sections.parfum-features.settings.description.default",
      "label": "t:sections.parfum-features.settings.description.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.parfum-features.blocks.feature.name",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "t:sections.parfum-features.blocks.feature.settings.icon.label",
          "info": "t:sections.parfum-features.blocks.feature.settings.icon.info"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "t:sections.parfum-features.blocks.feature.settings.title.default",
          "label": "t:sections.parfum-features.blocks.feature.settings.title.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.parfum-features.presets.name",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "basket-light",
            "title": "Developed to support your activity"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "flask-light",
            "title": "Long-lasting outdoor-inspired fragrances"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "materials-light",
            "title": "No fabric buildup or residue"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "seedling-light",
            "title": "Vegan"
          }
        }
      ]
    }
  ]
}
{% endschema %}
