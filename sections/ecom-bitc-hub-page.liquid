{%- assign SHOW_READ_TIME = false -%}
{%- comment -%}
 `blog` exists on a blog template. On the hub page it is nil, so the handle is read
 from the path — the segment after /blogs/, which survives a locale prefix like /de/ —
 and only then does it fall back to BITC_BLOG.
{%- endcomment -%}
{%- assign bitc_blog = blog -%}
{%- if bitc_blog == blank -%}
 {%- assign bitc_bh = request.path | split: '/blogs/' | last | split: '/' | first -%}
 {%- if blogs[bitc_bh] != blank -%}{%- assign bitc_blog = blogs[bitc_bh] -%}{%- endif -%}
{%- endif -%}
{%- if bitc_blog == blank -%}{%- assign bitc_blog = blogs[BITC_BLOG] -%}{%- endif -%}
{%- comment -%}
 Where the series shares a blog, the archive lives at the series tag URL and every
 "all articles" link has to keep that filter on.
{%- endcomment -%}
{%- assign bitc_all_url = bitc_blog.url -%}
{%- assign bitc_tag_prefix = bitc_blog.url | append: '/tagged/' -%}
{%- if BITC_SERIES != blank -%}
 {%- assign bitc_all_url = bitc_blog.url | append: '/tagged/' | append: BITC_SERIES -%}
 {%- assign bitc_tag_prefix = bitc_all_url | append: '+' -%}
{%- endif -%}
{%- comment -%}
 The series tag is the floor of this view, not a filter on it — so it never counts as
 the active topic and never shows up as one of the pills.
{%- endcomment -%}
{%- assign feat_h = FEATURED | split: ',' -%}
{%- assign FEATURED_C = ',' | append: FEATURED | append: ',' -%}
{%- assign bitc_tag = blank -%}
{%- for tg in current_tags -%}
 {%- assign tgh = tg | handle -%}
 {%- if tgh != BITC_SERIES -%}{%- assign bitc_tag = tg -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{%- assign bitc_tagh = bitc_tag | handle -%}
<script>
(function(){
 if (window.__bitcInit) return; window.__bitcInit = true;
 var RM = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
 function ready(fn){
 if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, {once:true});
 else fn();
 }
 ready(function(){
 /* 1 — the filter bar earns its hairline only once it is actually stuck */
 var bar = document.querySelector('[data-bitc-sticky]');
 if (bar && 'IntersectionObserver' in window){
 var probe = document.createElement('div');
 probe.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none';
 bar.parentNode.insertBefore(probe, bar);
 new IntersectionObserver(function(e){
 bar.classList.toggle('_stuck', !e[0].isIntersecting);
 }, {threshold:[1]}).observe(probe);
 }
 /* 2 — topic row: edge fades that say there is more, and arrow-key paging */
 var wrap = document.querySelector('[data-bitc-pillwrap]');
 var pills = wrap && wrap.querySelector('[data-bitc-pills]');
 if (pills){
 var edges = function(){
 var over = pills.scrollWidth - pills.clientWidth;
 wrap.classList.toggle('_ovl', pills.scrollLeft > 4);
 wrap.classList.toggle('_ovr', over > 4 && pills.scrollLeft < over - 4);
 };
 edges();
 requestAnimationFrame(edges);
 if (document.fonts && document.fonts.ready) document.fonts.ready.then(edges);
 pills.addEventListener('scroll', edges, {passive:true});
 window.addEventListener('resize', edges);
 var on = pills.querySelector('[aria-current="true"]');
 if (on && on.offsetLeft > pills.clientWidth - on.offsetWidth) pills.scrollLeft = on.offsetLeft - 16;
 var items = [].slice.call(pills.querySelectorAll('._pill'));
 pills.addEventListener('keydown', function(ev){
 var i = items.indexOf(document.activeElement);
 if (i < 0) return;
 var j = ev.key === 'ArrowRight' ? i+1 : ev.key === 'ArrowLeft' ? i-1 : -1;
 if (j < 0 || j >= items.length) return;
 ev.preventDefault(); items[j].focus();
 });
 }
 /* 3 — click to play: the YouTube player is fetched only when somebody asks for it,
 so an unwatched film costs the visitor nothing and sets no cookie up front */
 document.addEventListener('click', function(ev){
 var t = ev.target;
 var b = t && t.closest ? t.closest('[data-yt]') : null;
 if (!b) return;
 var id = b.getAttribute('data-yt');
 if (!id) return;
 ev.preventDefault();
 var host = b.closest('[data-bitc-hl]');
 var hl = (host && host.getAttribute('data-bitc-hl')) || document.documentElement.lang || 'en';
 hl = hl.slice(0, 2).toLowerCase();
 var f = document.createElement('iframe');
 f.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) +
 '?autoplay=1&rel=0&hl=' + hl + '&cc_lang_pref=' + hl + '&cc_load_policy=1';
 f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
 f.setAttribute('allowfullscreen', '');
 f.title = b.getAttribute('aria-label') || 'video';
 var wrap = document.createElement('div');
 wrap.className = b.className;
 wrap.appendChild(f);
 b.parentNode.replaceChild(wrap, b);
 });
 /* 4 — cards fade up in reading order, and never stay hidden without JS */
 var cards = [].slice.call(document.querySelectorAll('._rv'));
 if (!cards.length) return;
 if (RM || !('IntersectionObserver' in window)){
 cards.forEach(function(c){ c.style.transitionDelay = '0ms'; c.classList.add('_in'); });
 return;
 }
 var io = new IntersectionObserver(function(entries){
 entries.forEach(function(e){
 if (!e.isIntersecting) return;
 e.target.classList.add('_in'); io.unobserve(e.target);
 });
 }, {rootMargin:'0px 0px -8% 0px', threshold:0.05});
 cards.forEach(function(c){ io.observe(c); });
 setTimeout(function(){
 cards.forEach(function(c){ if (c.getBoundingClientRect().top < innerHeight) c.classList.add('_in'); });
 }, 60);
 });
})();
</script>
