/* ── Northfinder design-manual tokens. Every value here is from the manual or
 marked [derived]. No #000, no grey outside the Carbon tints, no pills,
 no shadows, Montserrat in Medium 500 and Bold 700 only. ───────────────── */
.nfb,.nfb *,.nfb *::before,.nfb *::after{box-sizing:border-box;margin:0;padding:0}
.nfb{width:100vw;position:relative;left:50%;transform:translateX(-50%);overflow-x:clip;background:#FFFFFF;
 --ink:#2B3C48; /* Carbon — all body and heading text */
 --ink-80:#556370; /* [derived] Carbon 80% — meta TEXT. Carbon 60% measures 2.9:1
 on white and fails WCAG AA for normal text, so text never
 uses it; this tint measures 6.1:1. */
 --ink-60:#808A91; /* Carbon 60% — lines, icons, disabled chrome. Never text. */
 --line:#D5D8DA; /* Carbon 20% — 1px dividers, surfaces */
 --red:#E3350E; /* Northfinder Red — large fills only */
 --red-ink:#C72D0C; /* [derived] small red text and 14px button fills, 5.5:1 */
 --red-hover:#AD270A; /* [derived] */
 --red-20:#F9D7CF;
 --r:4px;--r-sm:2px;--r-lg:8px;
 --gutter:48px;--sec-y:96px;--band-y:56px;--block-y:32px;--wrap:1440px;
 --ease:cubic-bezier(.2,.7,.2,1);
 font-family:'Montserrat',system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
 font-weight:500;font-size:16px;line-height:1.6;color:var(--ink);
 -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
@media(max-width:1199px){.nfb{--gutter:32px;--sec-y:72px;--band-y:48px}}
@media(max-width:767px){.nfb{--gutter:20px;--sec-y:56px;--band-y:36px;--block-y:24px}}
.nfb[hidden]{display:none}
.nfb img{display:block;max-width:100%}
.nfb a,.nfb a:visited,.nfb a:hover,.nfb a:active{color:inherit;text-decoration:none}
.nfb button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
/* the UA maps <b> to `bolder`, which resolves to 900 inside a 700 parent — the manual
 loads Medium and Bold only, so pin it */
.nfb b,.nfb strong{font-weight:700}
.nfb ._w{max-width:var(--wrap);margin:0 auto;padding:0 var(--gutter)}
/* type roles — manual's hierarchy, rebased for running text */
/* Type taken from the Best of NF page — big, tight, and capped — but at weight 700:
 that page runs 800, and the manual loads Montserrat in Medium and Bold only. At 44px
 the difference between 700 and 800 is presence, not legibility. */
.nfb ._eyebrow{font-size:11px;font-weight:700;line-height:1.2;letter-spacing:.14em;text-transform:uppercase}
.nfb ._h1{font-size:clamp(36px,26px + 2.6vw,76px);font-weight:700;line-height:.96;letter-spacing:-.03em}
.nfb ._h2{font-size:clamp(26px,20px + 1.5vw,44px);font-weight:700;line-height:1;letter-spacing:-.02em}
/* Caps only on headings of three words or fewer — the manual's rule: a long headline
 is never set in caps. `_up` marks the short ones. */
.nfb ._h2._up{text-transform:uppercase}
.nfb ._body{font-size:16px;font-weight:500;line-height:1.6;max-width:70ch}
/* A last line holding one short word reads as a mistake. `balance` evens out short
 blocks — headings and standfirsts — and `pretty` keeps running text from ending on a
 lone word. Both are progressive: a browser without them simply wraps as before. */
.nfb ._h1,.nfb ._h2,.nfb ._eyebrow{text-wrap:balance}
.nfb ._small{font-size:13px;font-weight:500;line-height:1.5}
/* Phone sizes come straight from the manual's hierarchy table — hero 28px, section
 heading 20px — which is a good deal smaller than the desktop scale. On a phone the
 headline has to make room for what it introduces. */
@media(max-width:767px){
 .nfb ._eyebrow{font-size:10.5px}
 .nfb ._h1{font-size:28px;line-height:1.05}
 .nfb ._h2{font-size:21px;letter-spacing:-.01em}
}
/* buttons — 4px radius, no pills, flat. Primary rests on the derived red so the
 14px uppercase label clears 4.5:1. */
.nfb ._btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 24px;
 border-radius:var(--r);font-size:14px;font-weight:700;line-height:1;letter-spacing:.06em;text-transform:uppercase;
 transition:background-color .18s var(--ease),color .18s var(--ease),border-color .18s var(--ease)}
.nfb ._btn._pri{background:var(--red-ink);color:#FFFFFF}
.nfb ._btn._pri:hover{background:var(--red-hover)}
.nfb ._btn._sec{background:#FFFFFF;color:var(--ink);border:1px solid var(--ink)}
.nfb ._btn._sec:hover{background:var(--ink);color:#FFFFFF}
@media(max-width:767px){.nfb ._btn{height:52px;width:100%}}
/* image placeholder — a post with no cover must not collapse the grid */
.nfb ._ph{position:relative;background:var(--line);overflow:hidden}
.nfb ._ph::before{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(45deg,rgba(43,60,72,.06) 0 10px,rgba(43,60,72,0) 10px 20px)}
.nfb ._sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.nfb a:focus-visible,.nfb button:focus-visible,.nfb input:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
@media(prefers-reduced-motion:reduce){.nfb *,.nfb *::before,.nfb *::after{transition:none!important;animation:none!important}}
/* ── HUB · products and reading ─────────────────────────────────────────────── */
.nfb._hs4{padding:var(--sec-y) 0 0}
.nfb._hs4._arts{padding-top:var(--band-y)}
.nfb._hs4 ._head{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:var(--block-y)}
.nfb._hs4 ._all{flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;
 letter-spacing:.06em;text-transform:uppercase;color:var(--red-ink);
 border-bottom:1px solid var(--red-ink);padding-bottom:2px;white-space:nowrap}
.nfb._hs4 ._all svg{transition:transform .18s var(--ease)}
.nfb._hs4 ._all:hover svg{transform:translateX(3px)}
/* product row */
.nfb._hs4 ._prods{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
.nfb._hs4 ._pimg{position:relative;aspect-ratio:4/5;overflow:hidden;border:1px solid var(--line);
 border-radius:var(--r);background:#FFFFFF}
.nfb._hs4 ._pimg img{width:100%;height:100%;object-fit:contain;padding:6%;transition:transform .5s var(--ease)}
.nfb._hs4 ._pimg ._ph{position:absolute;inset:0}
.nfb._hs4 ._prod:hover ._pimg img{transform:scale(1.04)}
.nfb._hs4 ._prod:hover ._pt{text-decoration:underline;text-underline-offset:3px}
.nfb._hs4 ._sale{position:absolute;left:12px;top:12px;height:24px;padding:0 8px;display:inline-flex;align-items:center;
 border-radius:var(--r-sm);background:var(--red);color:#FFFFFF;font-size:12px;font-weight:700;letter-spacing:.06em}
.nfb._hs4 ._pt{margin-top:14px;font-size:13px;font-weight:700;line-height:1.3;letter-spacing:.02em;
 text-transform:uppercase;text-wrap:balance;
 display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.nfb._hs4 ._pp{margin-top:6px;display:flex;align-items:baseline;gap:7px;font-size:13px;font-weight:700}
.nfb._hs4 ._pp s{font-size:11.5px;font-weight:500;color:var(--ink-80)}
/* reading row */
.nfb._hs4 ._artgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px}
.nfb._hs4 ._ashot{position:relative;aspect-ratio:16/10;overflow:hidden;border:1px solid var(--line);
 border-radius:var(--r);background:var(--line)}
.nfb._hs4 ._ashot img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.nfb._hs4 ._ashot._fit{background:#FFFFFF}
.nfb._hs4 ._ashot._fit img{object-fit:contain;padding:6% 8%}
.nfb._hs4 ._ashot ._ph{position:absolute;inset:0}
.nfb._hs4 ._art:hover ._ashot img{transform:scale(1.03)}
.nfb._hs4 ._art:hover ._ashot._fit img{transform:none}
.nfb._hs4 ._art:hover ._at{text-decoration:underline;text-underline-offset:3px}
.nfb._hs4 ._at{margin-top:14px;font-size:16px;font-weight:700;line-height:1.3;text-wrap:balance;
 display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.nfb._hs4 ._ax{margin-top:6px;font-size:12.5px;font-weight:500;line-height:1.5;color:var(--ink-80);text-wrap:pretty;
 display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
@media(max-width:1199px){.nfb._hs4 ._prods,.nfb._hs4 ._artgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:767px){
 .nfb._hs4 ._head{flex-direction:column;align-items:flex-start;gap:12px}
 .nfb._hs4 ._prods,.nfb._hs4 ._artgrid{gap:24px 14px}
 /* two article cards side by side on a phone leaves ~150px for a headline that runs to
 eight words — the row becomes one card per line and the titles stop shattering */
 .nfb._hs4 ._artgrid{grid-template-columns:minmax(0,1fr)}
 .nfb._hs4 ._art{display:grid;grid-template-columns:96px minmax(0,1fr);gap:14px;align-items:center}
 .nfb._hs4 ._art ._ashot{aspect-ratio:1/1}
 .nfb._hs4 ._at{margin-top:0;-webkit-line-clamp:3;font-size:15px}
 .nfb._hs4 ._ax{display:none}
 .nfb._hs4 ._pt{font-size:12px}
}
</style>
{%- comment -%}
 A lone button asking people to "see the shoes" gives them nothing to want. The row shows
 the actual products — photograph, name, price — so the visitor who just watched a film
 about a boot can see that boot.
{%- endcomment -%}
{%- assign shop_col = collections[SHOP_COLLECTION] -%}
{%- if shop_col != blank and shop_col.products_count > 0 -%}
<section class="nfb _hs4" id="bitc-shop" aria-labelledby="bitc-h2-shop">
 <div class="_w">
 <div class="_head">
 <h2 class="_h2 _up" id="bitc-h2-shop">{{ t_shopline }}</h2>
 <a class="_all" href="{{ SHOP_URL | default: shop_col.url }}">{{ t_shop }}
 <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h8.5M7 3l3.5 3.5L7 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
 </a>
 </div>
 <div class="_prods">
 {%- for p in shop_col.products limit: SHOP_COUNT -%}
 <a class="_prod" href="{{ p.url }}">
 <div class="_pimg">
 {%- if p.featured_image -%}
 <img src="{{ p.featured_image | image_url: width: 600 }}"
 srcset="{{ p.featured_image | image_url: width: 400 }} 400w, {{ p.featured_image | image_url: width: 800 }} 800w"
 sizes="(max-width:767px) 45vw, 22vw" width="600" height="750"
 loading="lazy" decoding="async" alt="{{ p.featured_image.alt | default: p.title | escape }}">
 {%- else -%}
 <div class="_ph"></div>
 {%- endif -%}
 {%- if p.compare_at_price > p.price -%}<span class="_sale">-{{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }}%</span>{%- endif -%}
 </div>
 <p class="_pt">{{ p.title }}</p>
 <p class="_pp">
 <b>{{ p.price | money }}</b>
 {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
 </p>
 </a>
 {%- endfor -%}
 </div>
 </div>
</section>
{%- endif -%}
{%- comment -%}
 The films are the entry, the writing is the depth. Articles are read by handle, so an
 article that has been renamed or unpublished is skipped rather than rendering a dead card.
{%- endcomment -%}
{%- if HUB_ARTICLES != blank -%}
{%- assign art_list = HUB_ARTICLES | split: ',' -%}
{%- assign art_n = 0 -%}
{%- for h in art_list -%}
 {%- capture akey -%}{{ BITC_BLOG }}/{{ h | strip }}{%- endcapture -%}
 {%- assign aa = articles[akey] -%}
 {%- if aa != blank and aa.title != blank -%}{%- assign art_n = art_n | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if art_n > 0 -%}
<section class="nfb _hs4 _arts" id="bitc-reading" aria-labelledby="bitc-h2-reading">
 <div class="_w">
 <div class="_head">
 <h2 class="_h2 _up" id="bitc-h2-reading">{{ t_arts }}</h2>
 <a class="_all" href="{{ bitc_all_url }}">{{ t_archive }}
 <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2 6.5h8.5M7 3l3.5 3.5L7 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
 </a>
 </div>
 <div class="_artgrid">
 {%- for h in art_list -%}
 {%- capture akey -%}{{ BITC_BLOG }}/{{ h | strip }}{%- endcapture -%}
 {%- assign a = articles[akey] -%}
 {%- if a == blank or a.title == blank -%}{%- continue -%}{%- endif -%}
 {%- assign afit = '' -%}
 {%- if a.image and a.image.width < 700 -%}{%- assign afit = ' _fit' -%}{%- endif -%}
 {%- if a.image and a.image.aspect_ratio >= 2.0 -%}{%- assign afit = ' _fit' -%}{%- endif -%}
 <a class="_art" href="{{ a.url }}">
 <div class="_ashot{{ afit }}">
 {%- if a.image -%}
 <img src="{{ a.image | image_url: width: 600 }}" width="600" height="375"
 loading="lazy" decoding="async" alt="{{ a.image.alt | default: a.title | escape }}">
 {%- else -%}
 <div class="_ph"></div>
 {%- endif -%}
 </div>
 <p class="_at">{{ a.title }}</p>
 {%- if a.excerpt_or_content != blank -%}
 <p class="_ax">{{ a.excerpt_or_content | strip_html | truncate: 95 }}</p>
 {%- endif -%}
 </a>
 {%- endfor -%}
 </div>
 </div>
</section>
{%- endif -%}
