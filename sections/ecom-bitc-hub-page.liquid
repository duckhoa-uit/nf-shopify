 {%- comment -%}
 Three identical stills in three identical boxes read as a contact sheet, not as a
 series. The first episode is given the room it deserves and the other two sit beside
 it, each with its running time and one line of what it is about — so the visitor
 chooses by content, not by guessing from three near-identical frames.
 {%- endcomment -%}
 <div class="_films">
 {%- assign film_list = FILMS | split: ';;' -%}
 {%- for f in film_list -%}
 {%- assign fp = f | strip | split: '|' -%}
 {%- assign fid = fp[0] | strip -%}
 {%- assign fname = fp[1] | strip -%}
 {%- assign flen = fp[2] | strip -%}
 {%- assign fblurb = fp[3] | strip -%}
 {%- if forloop.index < 10 -%}{%- assign fnum = forloop.index | prepend: '0' -%}{%- else -%}{%- assign fnum = forloop.index -%}{%- endif -%}
 {%- if forloop.first -%}{%- assign fcls = '_film _lead' -%}{%- else -%}{%- assign fcls = '_film _side' -%}{%- endif -%}
 <article class="{{ fcls }}">
 <button class="_frame" type="button" data-yt="{{ fid }}"
 aria-label="{{ t_watch }}{% if fname != blank %} — {{ fname | escape }}{% endif %}">
 <img src="https://i.ytimg.com/vi/{{ fid }}/maxresdefault.jpg" width="1280" height="720"
 loading="lazy" decoding="async" alt="">
 <span class="_pl" aria-hidden="true">
 <svg width="20" height="24" viewBox="0 0 20 24" fill="currentColor"><path d="M0 0l20 12L0 24z"/></svg>
 </span>
 {%- if flen != blank -%}<span class="_len">{{ flen }}</span>{%- endif -%}
 </button>
 <p class="_ep _eyebrow">{{ t_episode }} {{ fnum }}</p>
 {%- if fname != blank -%}<p class="_ft">{{ fname }}</p>{%- endif -%}
 </article>
 {%- endfor -%}
 </div>
 {%- if FULL_FILM != blank -%}
 <p class="_note"><a class="_btn _sec _full" href="https://www.youtube.com/watch?v={{ FULL_FILM }}" target="_blank" rel="noopener">
 <svg width="14" height="17" viewBox="0 0 14 17" fill="currentColor" aria-hidden="true"><path d="M0 0l14 8.5L0 17z"/></svg>
 {{ t_fullfilm }}
 </a></p>
 {%- endif -%}
 </div>
</section>
{%- endif -%}
