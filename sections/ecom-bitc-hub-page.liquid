 /* On a phone the copy needs most of the screen, which leaves the film as a dark strip
 behind text — both suffer. So the two stop competing: the film plays in a 4:5 block
 at the top, the copy sits under it on solid Carbon. The film is actually watchable and
 the text measures 11.4:1 instead of whatever the frame happens to be. */
 .nfb._hs1 ._hero{aspect-ratio:auto;min-height:0;display:block}
 .nfb._hs1 ._hero ._vid,.nfb._hs1 ._hero img,.nfb._hs1 ._hero ._ph{position:relative;inset:auto;
 width:100%;height:auto;aspect-ratio:4/5;object-fit:cover}
 .nfb._hs1 ._scrim{display:none}
 .nfb._hs1 ._copy{position:relative;inset:auto;bottom:auto;background:var(--ink);padding:24px 0 32px}
 .nfb._hs1 ._h1{margin-top:0;max-width:none}
 .nfb._hs1 ._intro{font-size:14.5px;line-height:1.5;max-width:none}
