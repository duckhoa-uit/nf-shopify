<style>
/* ── Northfinder design-manual tokens. Every value here is from the manual or
 marked [derived]. No #000, no grey outside the Carbon tints, no pills,
 no shadows, Montserrat in Medium 500 and Bold 700 only. ───────────────── */
.nfb,.nfb *,.nfb *::before,.nfb *::after{box-sizing:border-box;margin:0;padding:0}
.nfb{width:100vw;position:relative;left:50%;transform:translateX(-50%);overflow-x:clip;background:#FFFFFF;
 --ink:#2B3C48; /* Carbon — all body and heading text */
 --ink-80:#556370; /* [derived] Carbon 80% — meta TEXT. Carbon 60% measures 2.9:1
 on white and fails WCAG AA for normal text, so text never
 uses it; this tint measures 6.1:1. */
 --ink-60:#808A91; /* Carbon 60% — lines, icons, disabled chrome. Never text. */
 --line:#D5D8DA; /* Carbon 20% — 1px dividers, surfaces */
 --red:#E3350E; /* Northfinder Red — large fills only */
 --red-ink:#C72D0C; /* [derived] small red text and 14px button fills, 5.5:1 */
 --red-hover:#AD270A; /* [derived] */
 --red-20:#F9D7CF;
 --r:4px;--r-sm:2px;--r-lg:8px;
 --gutter:48px;--sec-y:96px;--band-y:56px;--block-y:32px;--wrap:1440px;
 --ease:cubic-bezier(.2,.7,.2,1);
 font-family:'Montserrat',system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
 font-weight:500;font-size:16px;line-height:1.6;color:var(--ink);
 -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
@media(max-width:1199px){.nfb{--gutter:32px;--sec-y:72px;--band-y:48px}}
@media(max-width:767px){.nfb{--gutter:20px;--sec-y:56px;--band-y:36px;--block-y:24px}}
.nfb[hidden]{display:none}
.nfb img{display:block;max-width:100%}
.nfb a,.nfb a:visited,.nfb a:hover,.nfb a:active{color:inherit;text-decoration:none}
.nfb button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
/* the UA maps <b> to `bolder`, which resolves to 900 inside a 700 parent — the manual
 loads Medium and Bold only, so pin it */
.nfb b,.nfb strong{font-weight:700}
.nfb ._w{max-width:var(--wrap);margin:0 auto;padding:0 var(--gutter)}
/* type roles — manual's hierarchy, rebased for running text */
/* Type taken from the Best of NF page — big, tight, and capped — but at weight 700:
 that page runs 800, and the manual loads Montserrat in Medium and Bold only. At 44px
 the difference between 700 and 800 is presence, not legibility. */
.nfb ._eyebrow{font-size:11px;font-weight:700;line-height:1.2;letter-spacing:.14em;text-transform:uppercase}
.nfb ._h1{font-size:clamp(36px,26px + 2.6vw,76px);font-weight:700;line-height:.96;letter-spacing:-.03em}
.nfb ._h2{font-size:clamp(26px,20px + 1.5vw,44px);font-weight:700;line-height:1;letter-spacing:-.02em}
/* Caps only on headings of three words or fewer — the manual's rule: a long headline
 is never set in caps. `_up` marks the short ones. */
.nfb ._h2._up{text-transform:uppercase}
.nfb ._body{font-size:16px;font-weight:500;line-height:1.6;max-width:70ch}
/* A last line holding one short word reads as a mistake. `balance` evens out short
 blocks — headings and standfirsts — and `pretty` keeps running text from ending on a
 lone word. Both are progressive: a browser without them simply wraps as before. */
.nfb ._h1,.nfb ._h2,.nfb ._eyebrow{text-wrap:balance}
.nfb ._small{font-size:13px;font-weight:500;line-height:1.5}
/* Phone sizes come straight from the manual's hierarchy table — hero 28px, section
 heading 20px — which is a good deal smaller than the desktop scale. On a phone the
 headline has to make room for what it introduces. */
@media(max-width:767px){
 .nfb ._eyebrow{font-size:10.5px}
 .nfb ._h1{font-size:28px;line-height:1.05}
 .nfb ._h2{font-size:21px;letter-spacing:-.01em}
}
/* buttons — 4px radius, no pills, flat. Primary rests on the derived red so the
 14px uppercase label clears 4.5:1. */
.nfb ._btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 24px;
 border-radius:var(--r);font-size:14px;font-weight:700;line-height:1;letter-spacing:.06em;text-transform:uppercase;
 transition:background-color .18s var(--ease),color .18s var(--ease),border-color .18s var(--ease)}
.nfb ._btn._pri{background:var(--red-ink);color:#FFFFFF}
.nfb ._btn._pri:hover{background:var(--red-hover)}
.nfb ._btn._sec{background:#FFFFFF;color:var(--ink);border:1px solid var(--ink)}
.nfb ._btn._sec:hover{background:var(--ink);color:#FFFFFF}
@media(max-width:767px){.nfb ._btn{height:52px;width:100%}}
/* image placeholder — a post with no cover must not collapse the grid */
.nfb ._ph{position:relative;background:var(--line);overflow:hidden}
.nfb ._ph::before{content:"";position:absolute;inset:0;background-image:repeating-linear-gradient(45deg,rgba(43,60,72,.06) 0 10px,rgba(43,60,72,0) 10px 20px)}
.nfb ._sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.nfb a:focus-visible,.nfb button:focus-visible,.nfb input:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
@media(prefers-reduced-motion:reduce){.nfb *,.nfb *::before,.nfb *::after{transition:none!important;animation:none!important}}
/* ── HUB · films and shorts ─────────────────────────────────────────────────── */
.nfb._hs3{padding:var(--sec-y) 0 0}
.nfb._hs3 + ._hs3{padding-top:var(--band-y)}
.nfb._hs3 ._h2{margin-bottom:var(--block-y)}
/* films: the first episode leads, the other two sit beside it */
.nfb._hs3 ._films{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);
 grid-template-rows:auto auto;gap:24px}
.nfb._hs3 ._film._lead{grid-row:1 / span 2}
.nfb._hs3 ._film ._frame{aspect-ratio:16/9}
.nfb._hs3 ._ep{margin-top:14px;color:var(--ink-80)}
.nfb._hs3 ._ft{margin-top:6px;font-size:18px;font-weight:700;line-height:1.3;text-wrap:balance}
.nfb._hs3 ._lead ._ft{font-size:clamp(20px,17px + .5vw,26px)}
/* running time, so nobody starts a 13-minute film by accident */
.nfb._hs3 ._len{position:absolute;right:10px;bottom:10px;height:24px;padding:0 8px;display:inline-flex;align-items:center;
 border-radius:var(--r-sm);background:rgba(43,60,72,.88);color:#FFFFFF;font-size:12px;font-weight:700;letter-spacing:.04em}
/* shorts: a 9:16 row that scrolls sideways, the way the format is watched */
.nfb._hs3 ._shorts{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(190px,1fr);gap:16px;
 overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none;padding-bottom:4px}
.nfb._hs3 ._shorts::-webkit-scrollbar{display:none}
.nfb._hs3 ._short{scroll-snap-align:start}
.nfb._hs3 ._short ._frame{aspect-ratio:9/16}
/* the frame: a thumbnail with a play control, or an empty grey field while there is none */
.nfb._hs3 ._frame{position:relative;overflow:hidden;border-radius:var(--r);border:1px solid var(--line);
 background:var(--line);width:100%;display:block;padding:0}
.nfb._hs3 ._frame img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.nfb._hs3 ._frame ._ph{position:absolute;inset:0}
.nfb._hs3 ._frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.nfb._hs3 ._frame ._pl{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
 width:64px;height:64px;border-radius:var(--r);background:var(--red);color:#FFFFFF;display:grid;place-items:center;
 transition:background-color .18s var(--ease),transform .18s var(--ease)}
.nfb._hs3 button._frame{cursor:pointer}
.nfb._hs3 button._frame:hover img{transform:scale(1.03)}
.nfb._hs3 button._frame:hover ._pl{background:var(--red-hover);transform:translate(-50%,-50%) scale(1.06)}
.nfb._hs3 ._short ._pl{width:48px;height:48px}
/* the full cut is the second thing a visitor wants after an episode, so it gets a
 control sized like one rather than a caption-sized link */
.nfb._hs3 ._note{margin-top:var(--block-y);text-align:center}
.nfb._hs3 ._full{padding:0 32px}
.nfb._hs3 ._full svg{transition:transform .18s var(--ease)}
.nfb._hs3 ._full:hover svg{transform:translateX(2px)}
@media(max-width:1199px){
 .nfb._hs3 ._films{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto}
 .nfb._hs3 ._film._lead{grid-row:auto;grid-column:1 / -1}
}
@media(max-width:767px){
 .nfb._hs3 ._note{text-align:stretch}
 .nfb._hs3 ._films{grid-template-columns:minmax(0,1fr);gap:28px}
 .nfb._hs3 ._film._lead{grid-column:auto}
 .nfb._hs3 ._lead ._ft{font-size:17px}
 .nfb._hs3 ._ft{font-size:15.5px}
 /* a phone swipes the shorts row; wider cards mean fewer, larger targets */
 .nfb._hs3 ._shorts{grid-auto-columns:minmax(150px,1fr)}
 .nfb._hs3 ._shorts{grid-auto-columns:minmax(160px,1fr);margin:0 calc(var(--gutter) * -1);padding:0 var(--gutter) 4px}
}
/* the one commercial exit on the page: watched a film, now go see the shoes */
.nfb._hs3._shopband{padding-top:var(--band-y)}
.nfb._hs3 ._shop{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;
 padding:clamp(24px,3vw,40px);border:1px solid var(--line);border-radius:var(--r)}
.nfb._hs3 ._shop ._h2{margin-bottom:0}
@media(max-width:767px){.nfb._hs3 ._shop{flex-direction:column;align-items:stretch;text-align:left}}
