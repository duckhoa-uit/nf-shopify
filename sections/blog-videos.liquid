{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .blog-videos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .blog-videos-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .article-video-card-wrapper {
    height: 100%;
  }

  .article-video-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .article-video-card__image-wrapper {
    width: 100%;
  }

  .video-embed {
    width: 100%;
    height: 0;
    padding-bottom: 56.25%;
    position: relative;
    background-color: #f5f5f5;
    border-radius: 3px;
    overflow: hidden;
  }

  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .article-video-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
  }

  .article-video-card__excerpt {
    flex: 1;
    margin-bottom: 1rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .article-video-card__title {
    font-weight: 500;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .article-video-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .article-video-card__tag {
    color: #EC0009;
    font-size: 0.875rem;
  }

  .blog-videos .blog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #d1d0d0;
    padding-bottom: 1rem;
  }

  .blog-videos .blog-category {
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    position: relative;
  }

  .blog-videos .blog-category.active {
    color: #EC0009;
  }

  .blog-videos .blog-category.active::after {
    content: '';
    position: absolute;
    bottom: -1rem;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #EC0009;
  }

  .blog-videos .no-results-message {
    text-align: center;
    padding: 2rem 0;
    font-size: 1rem;
    color: #666;
    display: none;
  }

  .blog-videos .load-more-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* Use unified button system - override specific properties for load-more */
  .blog-videos .load-more-button.button {
    min-width: 160px;
    padding: 12px 60px;
  }
{%- endstyle -%}

<div class="blog-videos page-width section-{{ section.id }}-padding">
  <h2 class="text-left font-extrabold font-archivo-expanded text-base lg:text-2xl leading-7 text-[#0F0F0F] uppercase mb-3 md:mb-6">
    {{ section.settings.heading | escape }}
  </h2>

  {% if section.settings.enable_filtering %}
    <div class="blog-categories">
      <div class="blog-category active" data-category="all">{{ 'blogs.main_blog.all_articles' | t }}</div>

      {% comment %}Use Shopify's built-in blog.all_tags for better performance{% endcomment %}
      {%- for tag in blogs.video.all_tags -%}
        {%- assign tag_lower = tag | downcase -%}
        <div class="blog-category" data-category="{{ tag_lower }}">#{{ tag_lower }}</div>
      {%- endfor -%}

      {% comment %}Fallback to predefined categories if no tags found{% endcomment %}
      {% if blogs.video.all_tags.size == 0 %}
        <div class="blog-category" data-category="northkit">#northkit</div>
        <div class="blog-category" data-category="vlog">#vlog</div>
      {% endif %}
    </div>
  {% endif %}

  {%- paginate blogs.video.articles by section.settings.posts_per_page -%}
    <div class="blog-videos-grid"
         data-total-pages="{{ paginate.pages }}"
         data-current-page="{{ paginate.current_page }}"
         data-posts-per-page="{{ section.settings.posts_per_page }}">
      <div class="no-results-message">{{ 'blogs.main_blog.no_results' | t }}</div>
      {%- for article in blogs.video.articles -%}
        <div
          class="blog-videos-grid__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {% if article.tags.size > 0 %}
            data-tags="{{ article.tags | join: ' ' | downcase }}"
          {% endif %}
        >
          <div class="article-video-card-wrapper card-wrapper">
            <div class="article-video-card">
              <div class="article-video-card__image-wrapper">
                <div class="video-embed">
                  {% if article.metafields.custom.video_thumbnail != blank %}
                    {% assign video_url = article.metafields.custom.video_thumbnail %}
                    {% assign video_id = '' %}

                    {%- # Extract YouTube ID -%}
                    {%- if video_url contains 'youtube.com' -%}
                      {%- if video_url contains 'v=' -%}
                        {%- assign video_id = video_url | split: 'v=' | last | split: '&' | first -%}
                      {%- elsif video_url contains 'embed/' -%}
                        {%- assign video_id = video_url | split: 'embed/' | last | split: '?' | first -%}
                      {%- endif -%}
                    {%- elsif video_url contains 'youtu.be/' -%}
                      {%- assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
                    {%- endif -%}

                    {% if video_id != '' %}
                      <iframe
                        src="https://www.youtube.com/embed/{{ video_id }}?rel=0&showinfo=0&controls=1"
                        frameborder="0"
                        allowfullscreen
                        loading="lazy"
                        title="{{ article.title | escape }}"
                        class="w-full h-full"
                      >
                      </iframe>
                    {% else %}
                      <iframe
                        src="{{ video_url }}"
                        title="{{ article.title | escape }}"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        loading="lazy"
                        class="w-full h-full"
                      >
                      </iframe>
                    {% endif %}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
                {% comment %} {% if article.tags.size > 0 %}
                  <div class="article-card__image-tags">
                    {% for tag in article.tags limit: 3 %}
                      <span class="article-card__image-tag">#{{ tag }}</span>
                    {% endfor %}
                  </div>
                {% endif %} {% endcomment %}
              </div>

              <div class="article-video-card__content">
                {% if article.tags.size > 0 %}
                  <div class="article-card__tags">
                    {% for tag in article.tags %}
                      <span class="article-card__tag">#{{ tag }}</span>
                    {% endfor %}
                  </div>
                {% endif %}

                <h4 class="article-video-card__title">
                  <a href="{{ article.url }}" class="article-video-card__title-link">
                    {{ article.title | escape }}
                  </a>
                </h4>

                <div class="article-video-card__excerpt">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html }}
                  {%- else -%}
                    {{ article.content | strip_html }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {% if section.settings.enable_load_more %}
      <div class="load-more-container">
        <button class="button load-more-button" id="blog-videos-load-more-button" {% if paginate.pages <= 1 %}disabled{% endif %}>
          <span class="button-text">{{ 'blogs.main_blog.view_more' | t }}</span>
          <span class="button-spinner" style="display: none;">
            {{- 'loading-spinner.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    {% else %}
      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {% endif %}
  {%- endpaginate -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Get DOM elements - scope to this section only
    const blogVideosSection = document.querySelector('.blog-videos');
    if (!blogVideosSection) return; // Exit if this section is not on the page

    const categories = blogVideosSection.querySelectorAll('.blog-category');
    const articles = blogVideosSection.querySelectorAll('.blog-videos-grid__article');

    // Fix YouTube iframes if needed
    function fixYouTubeEmbeds() {
      const iframes = blogVideosSection.querySelectorAll('.video-embed iframe');
      iframes.forEach((iframe) => {
        const src = iframe.getAttribute('src');
        if (src && (src.includes('youtube.com') || src.includes('youtu.be'))) {
          // Check if it's already an embed URL
          if (!src.includes('youtube.com/embed/')) {
            let videoId = '';

            // Extract video ID from various YouTube URL formats
            if (src.includes('youtube.com')) {
              if (src.includes('v=')) {
                videoId = src.split('v=')[1].split('&')[0];
              } else if (src.includes('embed/')) {
                videoId = src.split('embed/')[1].split('?')[0];
              }
            } else if (src.includes('youtu.be/')) {
              videoId = src.split('youtu.be/')[1].split('?')[0];
            }

            if (videoId) {
              iframe.setAttribute('src', `https://www.youtube.com/embed/${videoId}?rel=0&showinfo=0&controls=1`);
            }
          }
        }
      });
    }

    // Run the fix on page load
    fixYouTubeEmbeds();

    // Current filters state
    let currentCategory = 'all';
    let currentPage = 1;
    let isLoadingPosts = false;
    let loadedPages = new Set([1]); // Track which pages we've loaded

    // Initialize category from URL parameters for deep linking
    const urlParams = new URLSearchParams(window.location.search);
    const categoryFromUrl = urlParams.get('video_category');

    if (categoryFromUrl) {
      currentCategory = categoryFromUrl;
      // Update active category tab
      categories.forEach((cat) => cat.classList.remove('active'));
      const activeCategory = blogVideosSection.querySelector(`[data-category="${categoryFromUrl}"]`);
      if (activeCategory) {
        activeCategory.classList.add('active');
      }
    }

    // Function to load posts from a specific page
    async function loadPostsFromPage(pageNumber) {
      if (isLoadingPosts || loadedPages.has(pageNumber)) {
        return [];
      }

      isLoadingPosts = true;
      const nextPageUrl = window.location.pathname + '?page=' + pageNumber;

      try {
        const response = await fetch(nextPageUrl);
        if (!response.ok) {
          throw new Error('Network response was not ok');
        }

        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newArticles = doc.querySelectorAll('.blog-videos-grid__article');

        loadedPages.add(pageNumber);
        return Array.from(newArticles);
      } catch (error) {
        console.error('Error loading posts from page', pageNumber, ':', error);
        return [];
      } finally {
        isLoadingPosts = false;
      }
    }

    // Function to automatically load posts until we find matches for the current filter
    async function loadPostsForFilter(maxPages = 3) {
      if (currentCategory === 'all') {
        return; // No need to load more for 'all' filter
      }

      const gridContainer = blogVideosSection.querySelector('.blog-videos-grid');
      const totalPages = parseInt(gridContainer.getAttribute('data-total-pages')) || 1;
      const loadMoreButton = document.getElementById('blog-videos-load-more-button');

      // Show loading state on load more button if it exists
      if (loadMoreButton) {
        loadMoreButton.classList.add('loading');
      }

      let foundMatches = false;
      let pagesToLoad = Math.min(maxPages, totalPages - loadedPages.size);

      for (let i = 1; i <= pagesToLoad; i++) {
        const nextPage = Math.max(...loadedPages) + 1;
        if (nextPage > totalPages) break;

        const newArticles = await loadPostsFromPage(nextPage);

        if (newArticles.length > 0) {
          // Add articles to DOM
          newArticles.forEach((article) => {
            const clonedArticle = article.cloneNode(true);
            gridContainer.appendChild(clonedArticle);

            // Check if this article matches current filter
            if (currentCategory !== 'all') {
              const tags = clonedArticle.getAttribute('data-tags') || '';
              const categoryLower = currentCategory.toLowerCase().trim();
              const tagsLower = tags.toLowerCase().trim();
              const tagsArray = tagsLower.split(/\s+/).filter(tag => tag.length > 0);

              if (tagsArray.includes(categoryLower)) {
                foundMatches = true;
              }
            }
          });

          // Fix YouTube embeds in newly loaded content
          fixYouTubeEmbeds();
        }
      }

      // Remove loading state
      if (loadMoreButton) {
        loadMoreButton.classList.remove('loading');
      }

      // Update load more button visibility after loading
      updateLoadMoreButton();

      return foundMatches;
    }

    // Function to update load more button visibility
    function updateLoadMoreButton() {
      const loadMoreButton = document.getElementById('blog-videos-load-more-button');
      if (!loadMoreButton) return;

      const gridContainer = blogVideosSection.querySelector('.blog-videos-grid');
      const totalPages = parseInt(gridContainer.getAttribute('data-total-pages')) || 1;
      const postsPerPage = parseInt(gridContainer.getAttribute('data-posts-per-page')) || 4;
      const currentArticles = blogVideosSection.querySelectorAll('.blog-videos-grid__article');

      // Count visible articles
      let visibleCount = 0;
      currentArticles.forEach((article) => {
        if (article.style.display !== 'none') {
          visibleCount++;
        }
      });

      // New approach: Show button based on content availability rather than page tracking
      const hasVisibleContent = visibleCount > 0;

      // For "all" filter: show if we haven't loaded all pages OR if visible content suggests more pages
      // For specific filters: show if visible count > posts per page (indicating more content available)
      let shouldShowButton = false;

      if (currentCategory === 'all') {
        // For "all": show button if there are more pages to load OR if we have exactly posts-per-page visible (suggesting more)
        const hasMorePagesToLoad = loadedPages.size < totalPages;
        const hasFullPageOfContent = visibleCount >= postsPerPage && totalPages > 1;
        shouldShowButton = hasVisibleContent && (hasMorePagesToLoad || hasFullPageOfContent);
      } else {
        // For specific filters: show if we have more than one page worth of visible content
        shouldShowButton = hasVisibleContent && visibleCount > postsPerPage;
      }

      if (shouldShowButton) {
        loadMoreButton.style.display = 'flex';
        loadMoreButton.removeAttribute('disabled');
        loadMoreButton.classList.remove('opacity-50', 'cursor-not-allowed');
      } else {
        loadMoreButton.style.display = 'none';
      }

      // Debug info to understand the issue
      console.log('Button visibility debug:', {
        currentCategory,
        hasVisibleContent,
        visibleCount,
        postsPerPage,
        totalPages,
        loadedPagesSize: loadedPages.size,
        loadedPagesArray: Array.from(loadedPages),
        shouldShowButton,
        logic: currentCategory === 'all' ? 'all-filter' : 'specific-filter'
      });





    }

    // Function to filter articles based on category
    async function filterArticles() {
      let visibleCount = 0;
      const noResultsMessage = blogVideosSection.querySelector('.no-results-message');

      // Get all current articles (including newly loaded ones)
      const currentArticles = blogVideosSection.querySelectorAll('.blog-videos-grid__article');

      currentArticles.forEach((article) => {
        let showByCategory = true;

        // Category filtering
        if (currentCategory !== 'all') {
          const tags = article.getAttribute('data-tags') || '';

          // Simple and robust matching
          const categoryLower = currentCategory.toLowerCase().trim();
          const tagsLower = tags.toLowerCase().trim();

          // Split tags into array and check for exact match
          const tagsArray = tagsLower.split(/\s+/).filter(tag => tag.length > 0);
          showByCategory = tagsArray.includes(categoryLower);
        }
        // If currentCategory === 'all', showByCategory remains true for all articles

        // Always set display style based on filter result
        if (showByCategory) {
          article.style.display = 'block';
          visibleCount++;
        } else {
          article.style.display = 'none';
        }
      });

      // If no results found and we have a specific category filter, try loading more posts
      if (visibleCount === 0 && currentCategory !== 'all') {
        const foundMatches = await loadPostsForFilter();

        if (foundMatches) {
          // Re-run filtering after loading new posts
          return filterArticles();
        }
      }

      // Show/hide no results message
      if (visibleCount === 0) {
        noResultsMessage.style.display = 'block';
      } else {
        noResultsMessage.style.display = 'none';
      }

      // Note: updateLoadMoreButton() will be called by the calling function
    }

    // Function to update URL with current category filter
    function updateURL() {
      const urlParams = new URLSearchParams(window.location.search);

      // Add category if not 'all'
      if (currentCategory !== 'all') {
        urlParams.set('video_category', currentCategory);
      } else {
        urlParams.delete('video_category');
      }

      // Build new URL
      const newUrl = urlParams.toString() ?
        `${window.location.pathname}?${urlParams.toString()}` :
        window.location.pathname;

      // Update URL without page reload
      history.pushState({
        video_category: currentCategory
      }, '', newUrl);
    }

    // Category filtering
    categories.forEach((category) => {
      category.addEventListener('click', async function (event) {
        // Prevent default behavior
        event.preventDefault();

        // Remove active class from all categories
        categories.forEach((cat) => cat.classList.remove('active'));

        // Add active class to clicked category
        this.classList.add('active');

        // Update current category
        const newCategory = this.getAttribute('data-category');

        // If switching to "all" from a specific filter, reset pagination state
        if (newCategory === 'all' && currentCategory !== 'all') {
          // Reset to initial state - only page 1 loaded
          loadedPages.clear();
          loadedPages.add(1);

          // Remove any articles that were auto-loaded beyond the first page
          const gridContainer = blogVideosSection.querySelector('.blog-videos-grid');
          const allArticles = gridContainer.querySelectorAll('.blog-videos-grid__article');
          const postsPerPage = parseInt(gridContainer.getAttribute('data-posts-per-page')) || 4;

          // Keep only the first postsPerPage articles
          allArticles.forEach((article, index) => {
            if (index >= postsPerPage) {
              article.remove();
            }
          });
        }

        currentCategory = newCategory;

        // Update URL with current filter
        updateURL();

        // Apply filters (now async)
        await filterArticles();

        // Ensure button visibility is updated after filtering
        updateLoadMoreButton();
      });
    });

    // Load more functionality
    const loadMoreButton = document.getElementById('blog-videos-load-more-button');
    const loadMoreText = loadMoreButton ? loadMoreButton.querySelector('.button-text') : null;
    const loadingSpinner = loadMoreButton ? loadMoreButton.querySelector('.button-spinner') : null;

    if (loadMoreButton) {
      // Remove any initial disabled state - we'll handle this in JavaScript
      loadMoreButton.removeAttribute('disabled');
      loadMoreButton.classList.remove('opacity-50', 'cursor-not-allowed');

      loadMoreButton.addEventListener('click', async function () {
        // Don't do anything if button is disabled
        if (loadMoreButton.hasAttribute('disabled')) {
          return;
        }

        // Show loading state using unified button system
        loadMoreButton.classList.add('loading');

        const gridContainer = blogVideosSection.querySelector('.blog-videos-grid');
        const totalPages = parseInt(gridContainer.getAttribute('data-total-pages')) || 1;
        const nextPage = Math.max(...loadedPages) + 1;

        if (nextPage > totalPages) {
          loadMoreButton.style.display = 'none';
          loadMoreButton.classList.remove('loading');
          return;
        }

        try {
          const newArticles = await loadPostsFromPage(nextPage);
          const articlesContainer = blogVideosSection.querySelector('.blog-videos-grid');

          // Check if we got any new articles
          if (newArticles.length === 0) {
            console.log('No more articles to load');
            // Hide the button completely
            loadMoreButton.style.display = 'none';
            return;
          }

          // Add new articles to the grid
          newArticles.forEach((article) => {
            const clonedArticle = article.cloneNode(true);
            articlesContainer.appendChild(clonedArticle);

            // Apply current filters to newly loaded articles
            if (currentCategory !== 'all') {
              const tags = clonedArticle.getAttribute('data-tags') || '';
              const categoryLower = currentCategory.toLowerCase().trim();
              const tagsLower = tags.toLowerCase().trim();
              const tagsArray = tagsLower.split(/\s+/).filter(tag => tag.length > 0);
              const showByCategory = tagsArray.includes(categoryLower);

              // Show article only if it passes the filter
              if (!showByCategory) {
                clonedArticle.style.display = 'none';
              }
            }
          });

          // Fix YouTube embeds in newly loaded content
          fixYouTubeEmbeds();

          // Update load more button visibility
          updateLoadMoreButton();
        } catch (error) {
          console.error('Error loading more articles:', error);
          // Update button visibility on error too
          updateLoadMoreButton();
        } finally {
          // Reset loading state using unified button system
          loadMoreButton.classList.remove('loading');
        }
      });
    }

    // Handle browser back/forward buttons
    window.addEventListener('popstate', async function(event) {
      if (event.state && event.state.video_category !== undefined) {
        const newCategory = event.state.video_category || 'all';

        // If switching to "all" from a specific filter, reset pagination state
        if (newCategory === 'all' && currentCategory !== 'all') {
          // Reset to initial state - only page 1 loaded
          loadedPages.clear();
          loadedPages.add(1);

          // Remove any articles that were auto-loaded beyond the first page
          const gridContainer = blogVideosSection.querySelector('.blog-videos-grid');
          const allArticles = gridContainer.querySelectorAll('.blog-videos-grid__article');
          const postsPerPage = parseInt(gridContainer.getAttribute('data-posts-per-page')) || 4;

          // Keep only the first postsPerPage articles
          allArticles.forEach((article, index) => {
            if (index >= postsPerPage) {
              article.remove();
            }
          });
        }

        // Restore category state from history
        currentCategory = newCategory;

        // Update active category tab
        categories.forEach((cat) => cat.classList.remove('active'));
        const activeCategory = blogVideosSection.querySelector(`[data-category="${currentCategory}"]`);
        if (activeCategory) {
          activeCategory.classList.add('active');
        }

        // Apply filters (now async)
        await filterArticles();

        // Ensure button visibility is updated after filtering
        updateLoadMoreButton();
      }
    });

    // Apply initial filters based on URL parameters (now async)
    filterArticles().then(() => {
      // Ensure load more button is visible initially if needed
      updateLoadMoreButton();
    });
  });
</script>

{% schema %}
{
  "name": "Blog Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Videos",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_filtering.label"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 4,
      "label": "t:sections.main-blog.settings.posts_per_page.label"
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "default": true,
      "label": "t:sections.main-blog.settings.enable_load_more.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Blog Videos"
    }
  ]
}
{% endschema %}
