#nfsh .nfsh-grid{max-width:1440px;margin:0 auto;padding:0 48px;display:grid;
 grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px}
#nfsh .nfsh-col{grid-column:3 / span 6;min-width:0}
#nfsh .nfsh-full{grid-column:1 / -1;min-width:0}
#nfsh .nfsh-ph{background:var(--soft);
 background-image:repeating-linear-gradient(45deg,rgba(17,17,17,.045) 0 10px,rgba(17,17,17,0) 10px 20px);
 display:flex;align-items:center;justify-content:center;text-align:center;
 color:#8d8d8f;font-size:12px;line-height:1.4;letter-spacing:.03em;padding:12px;overflow:hidden}
#nfsh .nfsh-ph::after{content:attr(data-ph)}
#nfsh .nfsh-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
 clip:rect(0 0 0 0);white-space:nowrap;border:0}
/* Keyboard focus. The audit found exactly one :focus-visible rule on the page, so
 every link, TOC entry and product card was falling back to the browser default —
 which on a black button is a dark ring on dark and effectively invisible. */
#nfsh a:focus-visible,#nfsh button:focus-visible,#nfsh summary:focus-visible{
 outline:2px solid var(--ink);outline-offset:3px}
#nfsh .nfsh-btn--dark:focus-visible{outline-color:#fff;outline-offset:-5px}
/* buttons — identical to the buying-guide template: 2px radius, black primary */
#nfsh .nfsh-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;
 padding:0 22px;border-radius:2px;font-size:14.5px;font-weight:600;line-height:1;
 transition:background .15s ease,color .15s ease,border-color .15s ease;white-space:nowrap}
#nfsh .nfsh-btn--dark{background:var(--ink);color:#fff}
#nfsh .nfsh-btn--dark:hover{background:#000}
#nfsh .nfsh-btn--dark[aria-disabled="true"]{background:#c9c9c9;cursor:not-allowed}
#nfsh .nfsh-btn--ghost{border:1px solid #b7b7b7;color:var(--ink)}
#nfsh .nfsh-btn--ghost:hover{border-color:var(--ink);background:var(--soft)}
#nfsh .nfsh-btn--wide{width:100%;height:48px;font-size:15.5px}
/* product card — shared, because it is used both inline in the article and in
 the closing grid, and the two sections carry separate copies of this prelude */
#nfsh .s-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
/* .s-grid.s-grid--2, not .s-grid--2: this prelude is repeated in every section,
 so a later section's copy of `#nfsh .s-grid` would otherwise win on source
 order and force the inline pair back to four columns. Any future modifier on
 a prelude class needs the same treatment. */
#nfsh .s-grid.s-grid--2{grid-template-columns:repeat(2,minmax(0,1fr))}
#nfsh .s-card a{display:block}
#nfsh .s-card img{width:100%;aspect-ratio:3/2;object-fit:cover;background:var(--soft)}
#nfsh .s-name{margin-top:14px !important;font-size:16.5px !important;
 line-height:1.25 !important;font-weight:700;letter-spacing:.02em}
#nfsh .s-sub{margin-top:4px !important;font-size:14px !important;
 line-height:1.45 !important;color:var(--grey)}
/* The Vibram compound is its own element and the separator is a CSS pseudo, so it can
 never end up orphaned at a line break — which is what made the two rows of the pair
 card look different from each other: one line started with the middot, the other
 ended with it. In the closing grid the compound is always its own line, because a
 318 px cell cannot hold both on one. */
#nfsh .s-tech::before{content:"\00a0\00b7\00a0"}
#nfsh .s-grid .s-tech{display:block}
#nfsh .s-grid .s-tech::before{content:none}
/* the price keeps its height while Shopify is asked for the real number, so
 filling it in cannot shift the grid */
#nfsh .s-price{margin-top:8px !important;font-size:15px !important;
 line-height:1.4 !important;font-weight:600;min-height:1.4em}
#nfsh .s-card a:hover .s-name{text-decoration:underline;text-underline-offset:4px;
 text-decoration-thickness:1px}
/* the pair card as two horizontal rows: thumb, then name + price on one line with the
 descriptor under it. Half the height of the 2-column version and the descriptor
 stops wrapping. */
#nfsh .s-rows{display:flex;flex-direction:column}
#nfsh .s-rows > li + li{border-top:1px solid var(--line)}
#nfsh .s-rows a{display:grid;grid-template-columns:140px minmax(0,1fr);gap:18px;
 align-items:center;padding:16px 0}
/* the kicker's rule now provides the top separation, so the first row keeps its own
 padding and the rhythm inside the card is even */
#nfsh .s-rows > li:first-child a{padding-top:15px}
/* the last row keeps its padding too: with the header rule above, dropping it made
 the bottom of the card tighter than the top */
#nfsh .s-rows > li:last-child a{padding-bottom:14px}
#nfsh .s-row-top{display:flex;align-items:baseline;justify-content:space-between;gap:14px}
#nfsh .s-rows .s-name{margin-top:0 !important}
#nfsh .s-rows .s-sub{margin-top:5px !important}
#nfsh .s-rows .s-price{margin-top:0 !important;min-height:0;white-space:nowrap}
@media (max-width:1023px){
 #nfsh .a-prod-kicker{font-size:12px !important}
 #nfsh .nfsh-grid{padding:0 24px;grid-template-columns:minmax(0,1fr);column-gap:0}
 #nfsh .nfsh-col,#nfsh .nfsh-full{grid-column:1}
 #nfsh .s-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 16px}
 /* 92px thumb, not 108: the text column was 169px, one character short of holding
 "Dámske turistické topánky" on a line, so every Slavic locale wrapped it */
 #nfsh .s-rows a{grid-template-columns:92px minmax(0,1fr);gap:14px;padding:14px 0}
 /* on a phone the descriptor and the compound each get their own line, so neither
 wraps mid-phrase */
 #nfsh .s-rows .s-tech{display:block}
 #nfsh .s-rows .s-tech::before{content:none}
 #nfsh .s-name{font-size:15.5px !important}
 #nfsh .s-sub{font-size:13px !important}
}
/* ── Section 5 · the models from this article, then the whole collection ────
 A product grid, not a big landscape: at the end of the page the reader wants
 something to click, and the four models the article names are that something.
 The grid and card rules live in the shared prelude (base.css), NOT here — this
 file loads after every other section's copy of the prelude, so a duplicate rule
 here silently wins on source order and overrides the real one. That has already
 happened twice. Keep this file to section-specific things only. */
#nfsh.nfsh-shop{padding:clamp(24px,3vw,36px) 0 clamp(48px,5vw,72px)}
#nfsh .s-head h2{font-size:var(--fs-h2);line-height:var(--lh-h2);font-weight:600;
 letter-spacing:-.01em;scroll-margin-top:104px;margin-bottom:22px}
#nfsh .s-cta{margin-top:38px;display:flex;justify-content:center}
#nfsh .s-cta .nfsh-btn{max-width:420px}
@media (max-width:1023px){
 #nfsh .s-head h2{margin-bottom:18px}
 #nfsh .s-cta{margin-top:30px}
}
