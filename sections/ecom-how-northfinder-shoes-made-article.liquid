<script>
(function(){
 if(window.__nfshShop) return;
 window.__nfshShop = 1;
 /* Prices are not baked into the page. Each card carries the Shopify handle and
 the page asks the CURRENT market for the real number, so a price can never go
 stale or be wrong for a market we have not verified. If the handle does not
 exist on this market the request simply fails and the line stays empty. */
 function money(cents){
 var cur = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'EUR';
 var loc = (window.Shopify && window.Shopify.locale) || 'en';
 try {
 return new Intl.NumberFormat(loc, {style:'currency', currency:cur,
 minimumFractionDigits:0, maximumFractionDigits:2}).format(cents / 100);
 } catch(e) {
 return (cents / 100).toFixed(2) + ' ' + cur;
 }
 }
 function load(card){
 var handle = card.getAttribute('data-nfsh-h');
 var out = card.querySelector('[data-nfsh-price]');
 if(!handle || !out || card.dataset.done) return;
 card.dataset.done = '1';
 fetch('/products/' + handle + '.js', {headers:{'Accept':'application/json'}})
 .then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); })
 .then(function(d){
 if(typeof d.price === 'number') out.textContent = money(d.price);
 if(d.available === false) card.setAttribute('data-soldout', '1');
 })
 .catch(function(){ /* leave the line empty rather than show a guess */ });
 }
 function boot(){
 var cards = document.querySelectorAll('#nfsh .s-card[data-nfsh-h]');
 if(!cards.length) return;
 [].forEach.call(cards, load);
 }
 if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
 else boot();
})();
