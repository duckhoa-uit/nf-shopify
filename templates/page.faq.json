        "faq-6": {
          "type": "faq_item",
          "settings": {
            "category": "payments-and-invoices",
            "question": "Can an invoice be issued to a company?",
            "answer": "<p>If you wish to have an invoice issued to a company, please contact us by email as soon as possible after placing your order. Please include the company’s billing information in the email— company name, ID number, tax ID, and VAT ID (if the company is a VAT payer). The invoice is issued once the order is processed, and the billing information cannot be modified after it has been issued. </p>"
          }
        },
        "faq-7": {
          "type": "faq_item",
          "settings": {
            "category": "payments-and-invoices",
            "question": "How can I pay for my order?",
            "answer": "<p>You can pay for your order in several ways. You can pay online via an internet payment system or pay cash on delivery when you pick up the goods </p>"
          }
        },
        "faq-8": {
          "type": "faq_item",
          "settings": {
            "category": "payments-and-invoices",
            "question": "Can I pay upon pickup?",
            "answer": "<p>Yes, when placing your order, you have the option to choose cash on delivery. In that case, you will pay for the order upon pickup. </p>"
          }
        },
