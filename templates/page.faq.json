        },
        "faq-11": {
          "type": "faq_item",
          "settings": {
            "category": "order-changes-and-cancellations",
            "question": "Can I change the contents of my order after confirmation? Can I add or remove items frommy order?",
            "answer": "<p>Unfortunately, once an order has been submitted, it is no longer possible to change its contents or add or remove individual items. We therefore recommend that you carefully review your shopping cart before confirming your order to avoid any complications during order processing. </p>"
          }
        },
        "faq-12": {
          "type": "faq_item",
          "settings": {
            "category": "order-changes-and-cancellations",
            "question": "Can I combine multiple orders into one?",
            "answer": "<p>Unfortunately, it is not possible to combine multiple orders into one. Each order is processed and shipped separately, partly because shipments are dispatched from multiple warehouses. </p>"
          }
        },
        "faq-13": {
          "type": "faq_item",
          "settings": {
            "category": "order-changes-and-cancellations",
            "question": "Can I split my order into several packages with diƯerent shipping addresses?",
            "answer": "<p>It is not possible to split an order. </p>"
          }
        },
        "faq-14": {
          "type": "faq_item",
          "settings": {
            "category": "order-changes-and-cancellations",
            "question": "How can I cancel my order?",
            "answer": "<p>An order can only be canceled if it has not yet entered the processing stage. If you decide to cancel your order, please notify us via email as soon as possible. </p>"
          }
        },
