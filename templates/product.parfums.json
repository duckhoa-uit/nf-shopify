{
  "layout": "theme",
  "wrapper": "div.product-parfums-template",
  "sections": {
    "main": {
      "type": "main-product-parfums",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "disabled": true,
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": false
          }
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share",
            "featured_image_info": "Share a product image",
            "title_info": "Share a product title"
          }
        },
        "collapsible_tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care Instructions",
            "icon": "care",
            "content": "<p>Detailed care instructions for your parfum products.</p>",
            "page": ""
          }
        },
        "collapsible_tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "shipping",
            "content": "<p>Information about shipping and return policies.</p>",
            "page": ""
          }
        },
        "collapsible_tab_ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Ingredients",
            "icon": "ingredients",
            "content": "<p>Complete list of ingredients and fragrance notes.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "inventory",
        "rating",
        "share",
        "collapsible_tab_care",
        "collapsible_tab_shipping",
        "collapsible_tab_ingredients"
      ],
      "settings": {
        "image_zoom": "lightbox",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "recently_viewed": {
      "type": "recently-viewed-products",
      "settings": {
        "heading": "Recently viewed",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "product_recommendations",
    "recently_viewed"
  ]
}
