nútorné vrecko -->\n        <div class=\"nk-dot dir-left\" style=\"left:58%; top:56%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://northfinder.com/sk/modules/jscomposer/uploads/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit-3-2.png\" alt=\"Inner pocket\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\" data-i18n=\"f03t\">Inner Storage</div>\n                <div class=\"nk-popup-desc\" data-i18n=\"f03d\">3 secure zippered pockets for storing your phone, keys and cards.</div>\n              </div>\n              <div class=\"nk-popup-num\">03</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 4. Pod pazuchou -->\n        <div class=\"nk-dot dir-left\" style=\"left:67%; top:44%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192768-original_default/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit.webp\" alt=\"Underarm\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\" data-i18n=\"f04t\">Underarm Ventilation</div>\n                <div class=\"nk-popup-desc\" data-i18n=\"f04d\">Breathable underarm construction for optimal ventilation.</div>\n              </div>\n              <div class=\"nk-popup-num\">04</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 5. Nastaviteľný lem -->\n        <div class=\"nk-dot dir-left\" style=\"left:62%; top:82%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192765-original_default/bu-32682sii-panska-nepremokava-multisport