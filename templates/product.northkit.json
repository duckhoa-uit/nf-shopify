drop-filter: blur(4px);\n}\n</style>\n\n<div class=\"nk-lb\">\n\n\n  <div class=\"nk-lb-scene\">\n    <div class=\"nk-lb-img-wrap\">\n    <div class=\"nk-lb-inner\" id=\"nkFlipInner\">\n\n      <!-- ══ PREDNÁ STRANA ══ -->\n      <div class=\"nk-lb-face\">\n        <img class=\"nk-lb-base\"\n             src=\"https://b2b.northfinder.com/143219-original_default/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit.webp\"\n             alt=\"Northkit — front view\">\n\n        <!-- 1. Kapucňa -->\n        <div class=\"nk-dot dir-right\" style=\"left:52%; top:21%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192767-original_default/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit.webp\" alt=\"Hood\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\">2D Hood</div>\n                <div class=\"nk-popup-desc\">Anatomical built-in hood for maximum protection.</div>\n              </div>\n              <div class=\"nk-popup-num\">01</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 2. Patentka -->\n        <div class=\"nk-dot dir-left\" style=\"left:43%; top:48%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192773-original_default/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit.webp\" alt=\"Snap Fastener\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\">Snap Fastener</div>\n                <div class=\"nk-popup-desc\">Practical snap fastener for comfortable ventilation when moving with the jacket unzipped.</div>\n              </div>\n              <div class=\"nk-popup-num\">02</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 3. Vnútorné vrecko -->\n        <div class=\"nk-dot dir-left\" style=\"left:58%; top:56%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://northfinder.com/sk/modules/jscomposer/uploads/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit-3-2.png\" alt=\"Inner pocket\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\">Inner Storage</div>\n                <div class=\"nk-popup-desc\">3 secure zippered pockets for storing your phone, keys and cards.</div>\n              </div>\n              <div class=\"nk-popup-num\">03</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 4. Pod pazuchou -->\n        <div class=\"nk-dot dir-left\" style=\"left:67%; top:44%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192768-original_default/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit.webp\" alt=\"Underarm\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\">Underarm Ventilation</div>\n                <div class=\"nk-popup-desc\">Breathable underarm construction for optimal ventilation.</div>\n              </div>\n              <div class=\"nk-popup-num\">04</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 5. Nastaviteľný lem -->\n        <div class=\"nk-dot dir-left\" style=\"left:62%; top:82%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192765-original_default/bu-32682sii-panska-ne