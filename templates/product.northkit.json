unda-zbalitelna-2l-northkit.webp\" alt=\"Sleeve cuff\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\">Thumb Loop</div>\n                <div class=\"nk-popup-desc\">Thumb hole in the sleeve that keeps the cuff in place and prevents it from riding up during movement.</div>\n              </div>\n              <div class=\"nk-popup-num\">07</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- B3. Zadný lem -->\n        <div class=\"nk-dot dir-right\" style=\"left:50%; top:68%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192774-original_default/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit.webp\" alt=\"Back hem\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\">Back Ventilation</div>\n                <div class=\"nk-popup-desc\">Back ventilation opening helps release excess heat and improves comfort during activity.</div>\n              </div>\n              <div class=\"nk-popup-num\">08</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- B4. Vrecko na fľašu -->\n        <div class=\"nk-dot dir-left\" style=\"left:62%; top:74%;\">\n          <div class=\"nk-dot-ring\"></div><div class=\"nk-dot-core\"></div>\n          <div class=\"nk-popup\">\n            <img src=\"https://b2b.northfinder.com/192766-original_default/bu-32682sii-panska-nepremokava-multisportova-bunda-zbalitelna-2l-northkit.webp\" alt=\"Water bottle pocket\">\n            <div class=\"nk-popup-body\">\n              <div class=\"nk-popup-text\">\n                <div class=\"nk-popup-title\">Water Bottle Pocket</div>\n                <div class=\"nk-popup-desc\">Spacious side pocket for easy access to your water bottle.</div>\n              </div>\n              <div class=\"nk-popup-num\">09</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div><!-- /nk-lb-inner -->\n\n    <!-- Overlay — zakrýva celú plochu fotky -->\n    <div class=\"nk-overlay\" id=\"nkOverlay\">\n      <div class=\"nk-overlay-card\">\n        <button class=\"nk-overlay-close\" id=\"nkOverlayClose\">✕</button>\n        <img class=\"nk-overlay-img\" id=\"nkOverlayImg\" src=\"\" alt=\"\">\n        <div class=\"nk-overlay-body\">\n          <div class=\"nk-overlay-text\">\n            <div class=\"nk-overlay-title\" id=\"nkOverlayTitle\"></div>\n            <div class=\"nk-overlay-desc\" id=\"nkOverlayDesc\"></div>\n          </div>\n          <div class=\"nk-overlay-num\" id=\"nkOverlayNum\"></div>\n        </div>\n      </div>\n    </div>\n\n    </div><!-- /nk-lb-img-wrap -->\n\n    <div class=\"nk-lb-btn-wrap\">\n      <button class=\"nk-lb-btn\" id=\"nkFlipBtn\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 0 0 5.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 0 1 3.51 15\"/></svg>\n        <span id=\"nkFlipLabel\">View from back</span>\n      </button>\n    </div>\n  </div>\n</div>\n\n<script>\n(function() {\n  var inner   = document.getElementById('nkFlipInner');\n  var btn     = document.getElementById('nkFlipBtn');\n  var label   = document.getElementById('nkFlipLabel');\n  var overlay = document.getElementById('nkOverlay');\n  var oImg    = document.getElementById('nkOverlayImg');\n  var oNum    = document.getElementById('nkOverlayNum');\n  var oTitle  = document.getElementById('nkOverlayTitle');\n  var oDesc   = document.getElementById('nkOverlayDesc');\n  var oClose  = document.getElementById('nkOverlayClose');\n\n  function isMobile() { return window.innerWidth <= 640; }\n\n  function clampPopup(dot) {\n    var popup = dot.querySelector('.nk-popup');\n    if (!popup || isMobile()) return;\n    popup.style.marginLeft = '';\n    var dotRect  = dot.getBoundingClientRect();\n    var popupW   = popup.offsetWidth || 240;\n    var pad      = 10;\n    var gap      = 14;\n    if (dot.classList.contains('dir-right')) {\n      var over = (dotRect.right + gap + popupW) - (window.innerWidth - pad);\n      if (over > 0) popup.style.marginLeft = (-over) + 'px';\n    } else if (dot.classList.contains('dir-left')) {\n      var over2 = pad - (dotRect.left - gap - popupW);\n      if (over2 > 0) popup.style.marginLeft = over2 + 'px';\n    }\n  }\n\n  function resetPopup(dot) {\n    var popup = dot.querySelector('.nk-popup');\n    if (popup) { popup.style.marginLeft = ''; }\n  }\n\n  function closeOverlay() {\n    overlay.classList.remove('visible');\n    document.querySelectorAll('.nk-dot').forEach(function(d) { d.classList.remove('active'); });\n  }\n\n  function openOverlay(dot) {\n    var popup = dot.querySelector('.nk-popup');\n    if (!popup) return;\n    oImg.src   = popup.querySelector('img').getAttribute('src');\n    oImg.alt   = popup.querySelector('img').getAttribute('alt');\n    oNum.textContent = popup.querySelector('.nk-popup-num').textContent;\n    oTitle.textContent = popup.querySelector('.nk-popup-title').textContent;\n    oDesc.textContent  = popup.querySelector('.nk-popup-desc').textContent;\n    overlay.classList.add('visible');\n  }\n\n  // Flip\n  btn.addEventListener('click', function() {\n    var flipped = inner.classList.toggle('is-flipped');\n    label.textContent = flipped ? 'View from front' : 'View from back';\n    closeOverlay();\n  });\n\n  // Dots\n  document.querySelectorAll('.nk-dot').forEach(function(dot) {\n    dot.addEventListener('mouseenter', function() { clampPopup(dot); });\n    dot.addEventListener('mouseleave', function() { resetPopup(dot); });\n\n    dot.addEventListener('click', function(e) {\n      e.stopPropagation();\n      var isActive = dot.classList.contains('active');\n      document.querySelectorAll('.nk-dot').forEach(function(d) { d.classList.remove('active'); resetPopup(d); });\n      if (!isActive) {\n        dot.classList.add('active');\n        if (isMobile()) openOverlay(dot);\n        else clampPopup(dot);\n      } else {\n        if (isMobile()) closeOverlay();\n      }\n    });\n  });\n\n  oClose.addEventListener('click', function(e) { e.stopPropagation(); closeOverlay(); });\n  overlay.addEventListener('click', closeOverlay);\n  overlay.querySelector('.nk-overlay-card').addEventListener('click', function(e) { e.stopPropagation(); });\n\n  document.addEventListener('click', function() {\n    if (!isMobile()) {\n      document.querySelectorAll('.nk-dot').forEach(function(d) { d.classList.remove('active'); });\n    }\n  });\n})();\n</script>"
          }
        }
