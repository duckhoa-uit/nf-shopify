        "custom_liquid_Fhf3iy": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.nk-lb {\n  font-family: var(--font-heading-family);\n  box-sizing: border-box;\n  background: #ffffff;\n  color: #1a1a1a;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 0;\n}\n\n.nk-lb *, .nk-lb *::before, .nk-lb *::after {\n  box-sizing: border-box;\n}\n\n.nk-lb-title {\n  font-size: clamp(22px, 3vw, 38px);\n  font-weight: 600;\n  letter-spacing: -0.01em;\n  margin-bottom: 32px;\n  text-align: center;\n}\n\n/* ── Flip scene ── */\n.nk-lb-scene {\n  width: 100%;\n  max-width: 540px;\n  perspective: 1200px;\n}\n\n.nk-lb-inner {\n  position: relative;\n  width: 100%;\n  transform-style: preserve-3d;\n  transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.nk-lb-inner.is-flipped {\n  transform: rotateY(180deg);\n}\n\n.nk-lb-face {\n  position: relative;\n  width: 100%;\n  backface-visibility: hidden;\n  -webkit-backface-visibility: hidden;\n}\n\n.nk-lb-face-back {\n  position: absolute;\n  top: 0; left: 0; width: 100%;\n  transform: rotateY(180deg);\n}\n\n.nk-lb-face img.nk-lb-base {\n  width: 100%;\n  display: block;\n  border-radius: 4px;\n}\n\n/* Skryť bodky na neaktívnej strane */\n.nk-lb-inner:not(.is-flipped) .nk-lb-face-back .nk-dot { visibility: hidden; }\n.nk-lb-inner.is-flipped .nk-lb-face:not(.nk-lb-face-back) .nk-dot { visibility: hidden; }\n.nk-lb-inner:not(.is-flipped) .nk-lb-face-back { pointer-events: none; }\n.nk-lb-inner.is-flipped .nk-lb-face:not(.nk-lb-face-back) { pointer-events: none; }\n\n/* ── Flip button ── */\n.nk-lb-btn-wrap {\n  display: flex;\n  justify-content: center;\n  margin-top: 20px;\n}\n\n.nk-lb-btn {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  background: none;\n  border: 1px solid rgba(197,217,58,0.5);\n  border-radius: 4px;\n  color: #7a8a00;\n  font-family: var(--font-heading-family);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 9px 20px;\n  cursor: pointer;\n  transition: background 0.2s, border-color 0.2s;\n  text-decoration: none !important;\n}\n\n.nk-lb-btn:hover {\n  background: rgba(197,217,58,0.1);\n  border-color: rgba(197,217,58,0.8);\n}\n\n.nk-lb-btn svg {\n  width: 16px;\n  height: 16px;\n  stroke: #7a8a00;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  flex-shrink: 0;\n}\n\n/* ── Dots ── */\n.nk-dot {\n  position: absolute;\n  width: 28px;\n  height: 28px;\n  transform: translate(-50%, -50%);\n  cursor: pointer;\n  z-index: 10;\n}\n\n.nk-dot:hover, .nk-dot.active { z-index: 50; }\n\n.nk-dot-ring {\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  border: 2px solid rgba(197,217,58,0.9);\n  animation: nk-pulse 2.4s ease-out infinite;\n}\n\n.nk-dot-core {\n  position: absolute;\n  inset: 6px;\n  border-radius: 50%;\n  background: #c5d93a;\n  transition: transform 0.2s;\n}\n\n.nk-dot:hover .nk-dot-core,\n.nk-dot.active .nk-dot-core {\n  transform: scale(1.25);\n}\n\n@keyframes nk-pulse {\n  0%   { transform: scale(1);   opacity: 0.9; }\n  70%  { transform: scale(1.9); opacity: 0; }\n  100% { transform: scale(1.9); opacity: 0; }\n}\n\n/* ── Popup ── */\n.nk-popup {\n  position: absolute;\n  width: 240px;\n  background: #1a1c15;\n  border: 1px solid rgba(197,217,58,0.2);\n  border-radius: 4px;\n  overflow: hidden;\n  opacity: 0;\n  pointer-events: none;\n  transform: scale(0.92) translateY(6px);\n  transition: opacity 0.25s ease, transform 0.25s ease;\n  z-index: 20;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.5);\n}\n\n.nk-dot:hover .nk-popup,\n.nk-dot.active .nk-popup {\n  opacity: 1;\n  pointer-events: auto;\n  transform: scale(1) translateY(0);\n}\n\n.nk-popup img {\n  width: 100%;\n  height: 200px;\n  object-fit: cover;\n  object-position: center top;\n  display: block;\n}\n\n.nk-popup-body {\n  padding: 12px 14px 14px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.nk-popup-text { flex: 1; }\n\n.nk-popup-num {\n  flex-shrink: 0;\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  border: 1px solid rgba(197,217,58,0.55);\n  color: #c5d93a;\n  font-size: 11px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  align-self: flex-start;\n  margin-top: 2px;\n}\n\n.nk-popup-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: #f5f5f0;\n  margin-bottom: 4px;\n}\n\n.nk-popup-desc {\n  font-size: 14px;\n  font-weight: 300;\n  color: #f5f5f0;\n  line-height: 1.55;\n}\n\n/* Smer popupu */\n.nk-dot.dir-right .nk-popup {\n  left: calc(100% + 14px); top: 50%;\n  transform-origin: left center;\n  transform: scale(0.92) translateX(-6px);\n}\n.nk-dot.dir-right:hover .nk-popup,\n.nk-dot.dir-right.active .nk-popup {\n  transform: scale(1) translateX(0);\n  top: 50%;\n  margin-top: -130px;\n}\n\n.nk-dot.dir-left .nk-popup {\n  right: calc(100% + 14px); top: 50%;\n  transform-origin: right center;\n  transform: scale(0.92) translateX(6px);\n}\n.nk-dot.dir-left:hover .nk-popup,\n.nk-dot.dir-left.active .nk-popup {\n  transform: scale(1) translateX(0);\n  top: 50%;\n  margin-top: -130px;\n}\n\n.nk-dot.pin-above .nk-popup {\n  left: 50%; bottom: calc(100% + 14px); top: auto;\n  transform-origin: bottom center;\n  transform: scale(0.92) translateY(6px);\n  margin-left: -120px;\n}\n.nk-dot.pin-above:hover .nk-popup,\n.nk-dot.pin-above.active .nk-popup {\n  transform: scale(1) translateY(0);\n  bottom: calc(100% + 14px); top: auto; margin-top: 0;\n}\n\n.nk-dot.pin-below .nk-popup {\n  left: 50%; top: calc(100% + 14px);\n  transform-origin: top center;\n  transform: scale(0.92) translateY(-6px);\n  margin-left: -120px;\n}\n.nk-dot.pin-below:hover .nk-popup,\n.nk-dot.pin-below.active .nk-popup {\n  transform: scale(1) translateY(0);\n  top: calc(100% + 14px); margin-top: 0;\n}\n\n/* ── Mobile: skryť inline popupy, používa sa overlay ── */\n@media (max-width: 640px) {\n  .nk-dot .nk-popup { display: none !important; }\n}\n\n/* ── Overlay wrapper ── */\n.nk-lb-img-wrap {\n  position: relative;\n  width: 100%;\n}\n\n.nk-overlay {\n  display: none;\n  position: absolute;\n  inset: 0;\n  z-index: 50;\n  pointer-events: none;\n}\n\n.nk-overlay.visible {\n  display: flex;\n  pointer-events: auto;\n}\n\n.nk-overlay-card {\n  background: #1a1c15;\n  border-radius: 4px;\n  overflow: hidden;\n  position: relative;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  transform: scale(0.97);\n  opacity: 0;\n  transition: transform 0.28s ease, opacity 0.28s ease;\n}\n\n.nk-overlay.visible .nk-overlay-card {\n  transform: scale(1);\n  opacity: 1;\n}\n\n.nk-overlay-img {\n  flex: 1;\n  width: 100%;\n  min-height: 0;\n  object-fit: cover;\n  object-position: center top;\n  display: block;\n}\n\n.nk-overlay-body {\n  padding: 14px 16px 18px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.nk-overlay-text {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.nk-overlay-num {\n  flex-shrink: 0;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  border: 1px solid rgba(197,217,58,0.55);\n  color: #c5d93a;\n  font-size: 12px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  align-self: flex-start;\n  margin-top: 2px;\n}\n\n.nk-overlay-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: #f5f5f0;\n}\n\n.nk-overlay-desc {\n  font-size: 14px;\n  font-weight: 300;\n  color: #f5f5f0;\n  line-height: 1.5;\n}\n\n.nk-overlay-close {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  background: rgba(20,20,20,0.65);\n  border: 1px solid rgba(255,255,255,0.2);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  font-size: 14px;\n  line-height: 1;\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n}\n</style>\n\n<div class=\"nk-lb\">\n\n\n  <div class=\"nk-lb-scene\">\n    <div class=\"nk-lb-img-wrap\">\n    <div class=\"nk-lb-inner\" id=\"nk