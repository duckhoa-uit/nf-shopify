    "custom_liquid_hxeg6z": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign nf_id = ''\n  assign nf_title = ''\n  if product.tags contains 'nf-video-barefoot'\n    assign nf_id = 'gWiUQ-hf6pw'\n    assign nf_title = 'Barefoot do hôr?'\n  elsif product.tags contains 'nf-video-hiking'\n    assign nf_id = 'VXDwjqlKohM'\n    assign nf_title = 'Ktorá podrážka podľa teba drží v horách lepšie?'\n  elsif product.tags contains 'nf-video-multisport'\n    assign nf_id = 'TkiJubK8q58'\n    assign nf_title = 'Prečo musia hikingové topánky vyzerať všetky rovnako?'\n  endif\n-%}\n{%- if nf_id != blank and request.locale.iso_code == 'sk' -%}\n<div class=\"nf-pdp-video\">\n  <div class=\"nf-pdp-video__inner\">\n    <h2 class=\"nf-pdp-video__title\">{{ nf_title }}</h2>\n    <div class=\"nf-pdp-video__frame\">\n      <iframe src=\"https://www.youtube-nocookie.com/embed/{{ nf_id }}?rel=0\"\n              title=\"{{ nf_title | escape }}\" loading=\"lazy\" allowfullscreen\n              allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"></iframe>\n    </div>\n  </div>\n</div>\n<style>\n/* skryje sekciu Inspiracia len tam, kde je video */\n[id$=\"__inspiration_banner\"]{display:none !important}\n\n.nf-pdp-video{\n  --nf-gap: 32px;\n  --nf-pull: -100px;\n  max-width:1440px;\n  margin:var(--nf-pull) auto 0;\n  padding:var(--nf-gap) 20px var(--nf-gap);\n}\n.nf-pdp-video__inner{max-width:480px}\n.nf-pdp-video__title{font-family:Montserrat,sans-serif;font-weight:700;font-size:20px;line-height:1.25;color:#2B3C48;margin:0 0 16px}\n.nf-pdp-video__frame{position:relative;padding-top:56.25%;border-radius:4px;overflow:hidden;background:#D5D8DA}\n.nf-pdp-video__frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}\n@media(min-width:990px){\n  .nf-pdp-video{--nf-gap:48px;--nf-pull:-190px;padding-left:48px;padding-right:48px}\n  .nf-pdp-video__inner{max-width:900px}\n  .nf-pdp-video__title{font-size:24px}\n}\n</style>\n{%- endif -%}",
