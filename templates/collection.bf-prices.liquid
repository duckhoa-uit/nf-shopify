{%- layout none -%}
{%- comment -%}
  Compact live price list for the Black Friday landing page, read by
  assets/bf-live-pricing.js as /collections/<handle>?view=bf-prices&page=N.
  One row per product: [handle, price (cents), compare-at price (cents),
  filename of the first catalogue photo]. The photo filename carries the
  catalogue SKU (NF-<SKU>-...), which is how the page matches products whose
  handle differs between markets. products.json would give the same prices,
  but at ~7 MB per 250 products it is far too slow to wait on before the
  first render.
{%- endcomment -%}
{%- paginate collection.products by 250 -%}
  {"page":{{ paginate.current_page }},"pages":{{ paginate.pages }},"items":[
  {%- for product in collection.products -%}
    {%- liquid
      assign photo = product.featured_image.src | split: '/' | last
      unless photo contains 'NF-'
        for media_image in product.images limit: 10
          if media_image.src contains 'NF-'
            assign photo = media_image.src | split: '/' | last
            break
          endif
        endfor
      endunless
    -%}
    [{{ product.handle | json }},{{ product.price_max }},{{ product.compare_at_price_max | default: 0 }},{{ photo | default: '' | json }}]
    {%- unless forloop.last %},{% endunless -%}
  {%- endfor -%}
  ]}
{%- endpaginate -%}
